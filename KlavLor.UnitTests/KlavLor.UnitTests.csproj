<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- No DbContext, no Testcontainers, no Docker. KlavLor.Application carries the pure loot maths;
       KlavLor.Web is referenced only so the architecture tests can reflect over its components.
       FrameworkReference is required to see ComponentBase from a non-Web SDK project. -->
  <ItemGroup>
    <ProjectReference Include="..\KlavLor.Application\KlavLor.Application.csproj" />
    <ProjectReference Include="..\KlavLor.Web\KlavLor.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
