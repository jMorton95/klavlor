@using KlavLor.Application.Features.ApiKeys.Search
@using KlavLor.Web.Components.Generic.Form

<div id="api-key-section" class="max-w-2xl mt-8">
    <h3 class="text-lg font-semibold text-slate-700 dark:text-slate-300 mb-4">API Key</h3>

    @if (GeneratedKey is not null)
    {
        <div class="rounded-lg bg-green-50 dark:bg-green-950 border border-green-200 dark:border-green-800 p-4 mb-4">
            <p class="text-sm font-semibold text-green-800 dark:text-green-300 mb-2">API key generated successfully</p>
            <div class="flex items-center gap-2 mb-2">
                <input type="text" readonly value="@GeneratedKey"
                       class="flex-1 px-3 py-2 bg-white dark:bg-slate-800 border border-green-300 dark:border-green-700 rounded-lg text-sm font-mono text-slate-800 dark:text-slate-200" />
                <button type="button" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)"
                        class="px-3 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
                    Copy
                </button>
            </div>
            <p class="text-xs text-amber-700 dark:text-amber-400 font-medium">This key will not be shown again. Copy it now.</p>
        </div>
    }

    @if (ActiveKey is not null)
    {
        <div class="rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 mb-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300">
                        <span class="font-mono">@(ActiveKey.KeyPrefix)...</span>
                    </p>
                    <p class="text-xs text-slate-500 dark:text-white mt-1">
                        @ActiveKey.Name
                        &mdash;
                        @if (ActiveKey.LastUsedAt.HasValue)
                        {
                            <span>Last used @ActiveKey.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                        }
                        else
                        {
                            <span>Never used</span>
                        }
                    </p>
                </div>
                <button type="button"
                        hx-post="@AppRoutes.UserApiKeyRevoke.WithId(UserId).FromApi()"
                        hx-target="#api-key-section"
                        hx-swap="outerHTML"
                        class="px-3 py-1.5 bg-red-600 text-white text-xs font-medium rounded-lg hover:bg-red-700 transition-colors">
                    Revoke
                </button>
            </div>
        </div>
    }
    else if (GeneratedKey is null)
    {
        <p class="text-sm text-slate-500 dark:text-white mb-4">No active API key.</p>
    }

    <button type="button"
            hx-post="@AppRoutes.UserApiKeyGenerate.WithId(UserId).FromApi()"
            hx-target="#api-key-section"
            hx-swap="outerHTML"
            class="px-4 py-2 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">
        Generate New Key
    </button>

    @if (ErrorMessage is not null)
    {
        <div class="mt-4">
            <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
        </div>
    }
</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public ApiKeySearchResponse? ActiveKey { get; set; }
    [Parameter] public string? GeneratedKey { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
}
