@using KlavLor.Application.Features.Characters

<div id="admin-character-section" class="mt-8 border-t border-slate-200 dark:border-slate-700 pt-6">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Game Characters</h3>
        <button hx-get="@AppRoutes.AdminUserDeleteLoot.WithId(UserId).FromApi()"
                hx-target="#hx-modal-container"
                hx-swap="innerHTML"
                class="px-3 py-1.5 text-xs font-medium text-red-600 hover:text-red-700 dark:text-red-400 border border-red-300 dark:border-red-700 rounded-lg hover:bg-red-50 dark:hover:bg-red-950 transition-colors cursor-pointer">
            Delete All Loot Data
        </button>
    </div>

    @if (Characters is not null && Characters.Count > 0)
    {
        <div class="bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                        <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase">RuneLite ID</th>
                        <th class="px-4 py-2 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase">Display Name</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase">Visible</th>
                        <th class="px-4 py-2 text-center text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase">Admin Hidden</th>
                        <th class="px-4 py-2 text-right text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var character in Characters)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                            <td class="px-4 py-2 text-sm font-mono text-slate-700 dark:text-slate-300">@character.RuneLiteId</td>
                            <td class="px-4 py-2 text-sm text-slate-700 dark:text-slate-300">@(character.DisplayName ?? "—")</td>
                            <td class="px-4 py-2 text-center">
                                @if (character.IsVisible)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300">Yes</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">No</span>
                                }
                            </td>
                            <td class="px-4 py-2 text-center">
                                <button hx-post="@AppRoutes.AdminCharacterToggleHidden.Replace("{id:int}", UserId.ToString()).Replace("{characterId:int}", character.Id.ToString()).FromApi()"
                                        hx-target="#admin-character-section"
                                        hx-swap="outerHTML"
                                        class="cursor-pointer">
                                    @if (character.IsAdminHidden)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300">Hidden</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">Visible</span>
                                    }
                                </button>
                            </td>
                            <td class="px-4 py-2 text-right">
                                <button hx-get="@AppRoutes.AdminCharacterDelete.Replace("{id:int}", UserId.ToString()).Replace("{characterId:int}", character.Id.ToString()).FromApi()"
                                        hx-target="#hx-modal-container"
                                        hx-swap="innerHTML"
                                        class="text-xs text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 cursor-pointer">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">No characters found for this user.</p>
    }
</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public List<CharacterSummary>? Characters { get; set; }
}
