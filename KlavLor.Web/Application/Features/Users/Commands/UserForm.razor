@using Microsoft.AspNetCore.Components.Forms
@using KlavLor.Application.Features.Users.Create
@using KlavLor.Application.Features.Users.Edit
@using KlavLor.Web.Components.Generic.Form
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@(IsEditing ? "KlavLor - Edit User" : "KlavLor - Create User")"
               Title="@(IsEditing ? "Edit User" : "Create User")"
               Description="@(IsEditing ? "Update user details" : "Add a new user to the system")" />

<CascadingValue Value="ValidationErrors">
    @if (IsEditing)
    {
        var editCommand = Command as UserEditCommand;
        var editRoute = AppRoutes.UsersEdit.WithId(editCommand!.Id).FromApi();

        <EditForm EditContext="_editContext" hx-post="@editRoute" hx-target="#hx-page-container" hx-swap="innerHTML transition:true" class="max-w-2xl space-y-6">
            @RenderFormFields()

            <div class="group">
                <label class="flex items-center gap-2">
                    <InputCheckbox @bind-Value="editCommand.IsActive" Name="IsActive" class="w-4 h-4 text-amber-600 border-slate-300 rounded" />
                    <span class="text-sm font-medium text-slate-700">Active</span>
                </label>
            </div>

            @if (ErrorMessage != null)
            {
                <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
            }

            <div class="flex gap-3">
                <button type="submit" class="px-6 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">Save Changes</button>
                <a href="@AppRoutes.UsersSearch" hx-get="@AppRoutes.UsersSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.UsersSearch" class="px-6 py-2.5 text-slate-600 text-sm font-medium border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">Cancel</a>
            </div>
        </EditForm>
    }
    else
    {
        var createCommand = Command as UserCreateCommand;

        <EditForm EditContext="_editContext" hx-post="@AppRoutes.UsersCreate.FromApi()" hx-target="#hx-page-container" hx-swap="innerHTML transition:true" class="max-w-2xl space-y-6">
            @RenderFormFields()

            <div class="group">
                <label for="passwordOne" class="block text-sm font-semibold text-slate-700 mb-2">Password</label>
                <InputText @bind-Value="createCommand!.PasswordOne" Name="PasswordOne" id="passwordOne" type="password"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserCreateCommand" For="@(x => x.PasswordOne)" />
                <p class="mt-1 text-xs text-slate-500">Min 12 characters, uppercase, lowercase, and number required.</p>
            </div>

            <div class="group">
                <label for="passwordTwo" class="block text-sm font-semibold text-slate-700 mb-2">Confirm Password</label>
                <InputText @bind-Value="createCommand!.PasswordTwo" Name="PasswordTwo" id="passwordTwo" type="password"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserCreateCommand" For="@(x => x.PasswordTwo)" />
            </div>

            @if (ErrorMessage != null)
            {
                <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
            }

            <div class="flex gap-3">
                <button type="submit" class="px-6 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">Create User</button>
                <a href="@AppRoutes.UsersSearch" hx-get="@AppRoutes.UsersSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.UsersSearch" class="px-6 py-2.5 text-slate-600 text-sm font-medium border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">Cancel</a>
            </div>
        </EditForm>
    }
</CascadingValue>

@code {
    [Parameter] public object Command { get; set; } = new UserCreateCommand();
    [Parameter] public Dictionary<string, string[]>? ValidationErrors { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool IsEditing { get; set; }

    private EditContext? _editContext;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Command);
    }

    private RenderFragment RenderFormFields() => __builder =>
    {
        <div class="group">
            <label for="firstName" class="block text-sm font-semibold text-slate-700 mb-2">First Name</label>
            @if (IsEditing)
            {
                var cmd = (UserEditCommand)Command;
                <InputText @bind-Value="cmd.FirstName" Name="FirstName" id="firstName"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserEditCommand" For="@(x => x.FirstName)" />
            }
            else
            {
                var cmd = (UserCreateCommand)Command;
                <InputText @bind-Value="cmd.FirstName" Name="FirstName" id="firstName"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserCreateCommand" For="@(x => x.FirstName)" />
            }
        </div>

        <div class="group">
            <label for="lastName" class="block text-sm font-semibold text-slate-700 mb-2">Last Name</label>
            @if (IsEditing)
            {
                var cmd = (UserEditCommand)Command;
                <InputText @bind-Value="cmd.LastName" Name="LastName" id="lastName"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserEditCommand" For="@(x => x.LastName)" />
            }
            else
            {
                var cmd = (UserCreateCommand)Command;
                <InputText @bind-Value="cmd.LastName" Name="LastName" id="lastName"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserCreateCommand" For="@(x => x.LastName)" />
            }
        </div>

        <div class="group">
            <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
            @if (IsEditing)
            {
                var cmd = (UserEditCommand)Command;
                <InputText @bind-Value="cmd.Email" Name="Email" id="email" type="email"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserEditCommand" For="@(x => x.Email)" />
            }
            else
            {
                var cmd = (UserCreateCommand)Command;
                <InputText @bind-Value="cmd.Email" Name="Email" id="email" type="email"
                           class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none" />
                <FormMemberValidationError TModel="UserCreateCommand" For="@(x => x.Email)" />
            }
        </div>
    };
}
