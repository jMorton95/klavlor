@using KlavLor.Domain.Entities
@using KlavLor.Application.Features.Viewer.ViewerData
@using KlavLor.Web.Application
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@($"KlavLor - {Template.Name}")" Title="@Template.Name" Description="@(Template.Description ?? "Gear Progression Template")" />

<div class="flex flex-col h-[calc(100vh-8rem)] gap-4 overflow-hidden">
    <ViewerHeader Template="@Template" CompletionDates="@CompletionDates" IsOwner="@IsOwner" CanTrackCompletion="@CanTrackCompletion" IsAuthenticated="@IsAuthenticated" />

    @* Canvas + overlay panels *@
    <div class="relative flex-1 min-h-0">
        <ViewerCanvas Template="@Template" CompletionDates="@CompletionDates" CanTrackCompletion="@CanTrackCompletion" />
        @if (IsAuthenticated)
        {
            <HistoryPanel Template="@Template" CompletionDates="@CompletionDates" />
        }
    </div>
</div>

@code {
    [Parameter] public required Template Template { get; set; }
    [Parameter] public Dictionary<int, CompletionInfo> CompletionDates { get; set; } = [];
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public bool CanTrackCompletion { get; set; }
    [Parameter] public bool IsAuthenticated { get; set; }
}
