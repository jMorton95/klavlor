@using KlavLor.Domain.Entities
@using KlavLor.Web.Application
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@($"KlavLor - {Template.Name}")" Title="@Template.Name" Description="@(Template.Description ?? "Gear Progression Template")" />

<div class="flex flex-col h-[calc(100vh-8rem)] gap-4 overflow-hidden">
    @* Template info bar *@
    <div class="flex items-center justify-between bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-4 py-3">
        <div class="flex items-center gap-3">
            <a hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesSearch" hx-swap="innerHTML transition:true"
               class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 flex items-center gap-1 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                Back to Templates
            </a>
            <span class="text-slate-300 dark:text-slate-600">|</span>
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@Template.Name</span>
            @if (Template.IsPublic)
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-300">Public</span>
            }
            else
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">Private</span>
            }
            <span class="text-sm text-slate-500 dark:text-slate-400">by @(Template.CreatedBy?.FirstName ?? "Unknown") @(Template.CreatedBy?.LastName ?? "")</span>
            @if (CanTrackCompletion)
            {
                <span class="text-slate-300 dark:text-slate-600">|</span>
                <div class="flex items-center gap-2 text-sm">
                    <span class="text-slate-500 dark:text-slate-400">Progress:</span>
                    <span class="font-semibold text-amber-600 dark:text-amber-400">@CompletedNodeIds.Count / @Template.Nodes.Count</span>
                    @if (Template.Nodes.Count > 0)
                    {
                        var pct = (int)(CompletedNodeIds.Count * 100.0 / Template.Nodes.Count);
                        <div class="w-24 h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                            <div class="h-full bg-amber-500 rounded-full transition-all duration-300" style="width: @(pct)%"></div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="view-mode-toggle inline-flex items-center px-2 py-1 text-xs font-medium rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors text-slate-600 dark:text-slate-400 cursor-pointer" title="Toggle icon-only view">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            </button>
            @if (IsOwner)
            {
                <a hx-get="@AppRoutes.Builder.WithId(Template.Id).FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.Builder.WithId(Template.Id)" hx-swap="innerHTML transition:true"
                   class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-amber-600 dark:text-amber-400 border border-amber-300 dark:border-amber-600 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-950 transition-colors cursor-pointer">
                    Edit in Builder
                </a>
            }
        </div>
    </div>

    @* Canvas *@
    <ViewerCanvas Template="@Template" CompletedNodeIds="@CompletedNodeIds" CanTrackCompletion="@CanTrackCompletion" />
</div>

@code {
    [Parameter] public required Template Template { get; set; }
    [Parameter] public HashSet<int> CompletedNodeIds { get; set; } = [];
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public bool CanTrackCompletion { get; set; }
}
