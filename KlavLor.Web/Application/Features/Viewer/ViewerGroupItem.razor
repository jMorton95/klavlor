@using KlavLor.Domain.Entities

@{
    var completedClass = IsCompleted ? "bg-green-50 dark:bg-green-950" : "bg-white dark:bg-slate-800/90";
    var borderColor = IsCompleted ? "border-green-400" : GetNodeBorderColor(Node.NodeType);
}

@if (CanToggle)
{
    <div id="viewer-node-@Node.Id"
         class="flex items-center gap-1.5 px-1.5 py-1 rounded border-2 shadow-sm cursor-pointer @completedClass @borderColor"
         data-completed="@IsCompleted.ToString().ToLower()"
         hx-post="@($"/api/templates/{TemplateId}/completion/{Node.Id}")"
         hx-target="@($"#viewer-node-{Node.Id}")"
         hx-swap="outerHTML">
        @if (!string.IsNullOrEmpty(Node.IconUrl))
        {
            <img src="@Node.IconUrl" alt="" class="w-5 h-5 object-contain flex-shrink-0"
                 onerror="this.style.display='none'" />
        }
        <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1" title="@Node.Label">@Node.Label</span>
        @if (IsCompleted)
        {
            <svg class="w-3 h-3 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        }
    </div>
}
else
{
    <div id="viewer-node-@Node.Id"
         class="flex items-center gap-1.5 px-1.5 py-1 rounded border-2 shadow-sm @completedClass @borderColor"
         data-completed="@IsCompleted.ToString().ToLower()">
        @if (!string.IsNullOrEmpty(Node.IconUrl))
        {
            <img src="@Node.IconUrl" alt="" class="w-5 h-5 object-contain flex-shrink-0"
                 onerror="this.style.display='none'" />
        }
        <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1" title="@Node.Label">@Node.Label</span>
        @if (IsCompleted)
        {
            <svg class="w-3 h-3 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        }
    </div>
}

@code {
    [Parameter] public required TemplateNode Node { get; set; }
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public bool IsCompleted { get; set; }
    [Parameter] public bool CanToggle { get; set; }

    private static string GetNodeBorderColor(NodeType nodeType) => nodeType switch
    {
        NodeType.Item => "border-amber-400",
        NodeType.Skill => "border-blue-400",
        NodeType.Prayer => "border-purple-400",
        NodeType.Quest => "border-green-400",
        NodeType.Construction => "border-orange-400",
        NodeType.Slayer => "border-red-400",
        NodeType.Spell => "border-indigo-400",
        _ => "border-slate-300"
    };
}
