@using KlavLor.Domain.Entities

@{
    var bgClass = IsCompleted ? "bg-green-50 dark:bg-green-950"
        : IsNext ? "bg-amber-50 dark:bg-amber-950/50"
        : "bg-white dark:bg-slate-800/90";
    var borderColor = IsCompleted ? "border-green-400"
        : IsNext ? "border-amber-400"
        : GetNodeBorderColor(Node.Color);
    var pulseClass = IsNext ? "animate-next-pulse" : "";
}

<div id="viewer-node-@Node.Id" class="group/tooltip relative">
    @if (CanToggle && IsCompleted)
    {
        @* Completed + toggleable: click to un-complete directly *@
        <div class="flex items-center gap-1.5 px-1.5 py-1 rounded border-2 shadow-sm cursor-pointer @bgClass @borderColor @pulseClass"
             data-completed="true"
             hx-post="@($"/api/templates/{TemplateId}/completion/{Node.Id}")"
             hx-target="@($"#viewer-node-{Node.Id}")"
             hx-swap="outerHTML">
            @NodeIcon
            <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1">@Node.Label</span>
            <svg class="w-3 h-3 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        </div>
    }
    else if (CanToggle)
    {
        @* Not completed + toggleable: click opens completion popover *@
        <div class="flex items-center gap-1.5 px-1.5 py-1 rounded border-2 shadow-sm cursor-pointer @bgClass @borderColor @pulseClass"
             data-completed="false"
             onclick="openCompletionPopover(@Node.Id)">
            @NodeIcon
            <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1">@Node.Label</span>
            <svg class="w-3 h-3 text-green-500 flex-shrink-0 invisible" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        </div>
        @* Completion popover (hidden by default) *@
        <div id="completion-popover-@Node.Id" class="hidden absolute left-0 top-full mt-1 z-50 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg shadow-lg p-2 w-56">
            <form hx-post="@($"/api/templates/{TemplateId}/completion/{Node.Id}")"
                  hx-target="@($"#viewer-node-{Node.Id}")"
                  hx-swap="outerHTML"
                  class="flex flex-col gap-1.5">
                <input type="text" name="note" placeholder="Optional note (e.g. CoX drop)"
                       class="w-full text-xs px-2 py-1 border border-slate-300 dark:border-slate-600 rounded bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 placeholder-slate-400"
                       maxlength="500" />
                <div class="flex items-center gap-1.5">
                    <button type="submit" class="flex-1 text-xs font-medium px-2 py-1 bg-green-500 text-white rounded hover:bg-green-600 cursor-pointer">Complete</button>
                    <button type="button" onclick="closeCompletionPopover(@Node.Id)" class="text-xs font-medium px-2 py-1 text-slate-500 hover:text-slate-700 dark:hover:text-slate-300 cursor-pointer">Cancel</button>
                </div>
            </form>
        </div>
    }
    else
    {
        @* Read-only *@
        <div class="flex items-center gap-1.5 px-1.5 py-1 rounded border-2 shadow-sm @bgClass @borderColor @pulseClass"
             data-completed="@IsCompleted.ToString().ToLower()">
            @NodeIcon
            <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1">@Node.Label</span>
            <svg class="w-3 h-3 text-green-500 flex-shrink-0 @(IsCompleted ? "" : "invisible")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        </div>
    }

    @* Custom tooltip *@
    <div class="hidden group-hover/tooltip:block absolute left-1/2 -translate-x-1/2 bottom-full mb-2 z-50 pointer-events-none">
        <div class="bg-slate-900 dark:bg-slate-700 text-white text-[10px] rounded-md px-2.5 py-1.5 shadow-lg whitespace-nowrap max-w-[220px]">
            <span class="font-semibold">@Node.Label</span>
            @if (IsCompleted && CompletedAt.HasValue)
            {
                <br /><span class="text-green-300">Completed @CompletedAt.Value.ToString("MMM d, yyyy h:mm tt")</span>
            }
            @if (!string.IsNullOrEmpty(CompletionNote))
            {
                <br /><span class="italic text-amber-300">@CompletionNote</span>
            }
            @if (IsNext)
            {
                <br /><span class="text-amber-300">Up next</span>
            }
            <div class="absolute left-1/2 -translate-x-1/2 top-full w-0 h-0 border-l-4 border-r-4 border-t-4 border-l-transparent border-r-transparent border-t-slate-900 dark:border-t-slate-700"></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public required TemplateNode Node { get; set; }
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public bool IsCompleted { get; set; }
    [Parameter] public DateTimeOffset? CompletedAt { get; set; }
    [Parameter] public string? CompletionNote { get; set; }
    [Parameter] public bool IsNext { get; set; }
    [Parameter] public bool CanToggle { get; set; }

    private RenderFragment NodeIcon => __builder =>
    {
        if (!string.IsNullOrEmpty(Node.IconUrl))
        {
            <img src="@Node.IconUrl" alt="" class="w-5 h-5 object-contain flex-shrink-0"
                 loading="lazy" onerror="this.style.display='none'" />
        }
    };

    private static string GetNodeBorderColor(string color) => color switch
    {
        "amber" => "border-amber-400",
        "blue" => "border-blue-400",
        "purple" => "border-purple-400",
        "green" => "border-green-400",
        "orange" => "border-orange-400",
        "red" => "border-red-400",
        "indigo" => "border-indigo-400",
        _ => "border-slate-300"
    };
}
