@page "/templates/{Id:int}"
@using KlavLor.Domain.Entities
@using KlavLor.Application.Features.Viewer.ViewerData
@using KlavLor.Application.Interfaces.Authentication
@using KlavLor.Web.Application
@using KlavLor.Web.Components.Layout

@inject ViewerDataHandler ViewerDataHandler
@inject ISessionStateManager SessionStateManager
@inject NavigationManager NavigationManager

<PageLayout PageTitle="@($"KlavLor - {_response?.Template.Name}")" Title="@(_response?.Template.Name ?? "")" Description="@(_response?.Template.Description ?? "Gear Progression Template")">
    @if (_response is not null)
    {
        <div class="flex flex-col h-[calc(100vh-8rem)] gap-4 overflow-hidden">
            <ViewerHeader Template="@_response.Template" CompletionDates="@_response.CompletionDates" IsOwner="@_response.IsOwner" CanTrackCompletion="@_response.CanTrackCompletion" IsAuthenticated="@_response.IsAuthenticated" />
            <div class="relative flex-1 min-h-0">
                <ViewerCanvas Template="@_response.Template" CompletionDates="@_response.CompletionDates" CanTrackCompletion="@_response.CanTrackCompletion" />
                @if (_response.IsAuthenticated)
                {
                    <HistoryPanel Template="@_response.Template" CompletionDates="@_response.CompletionDates" />
                }
            </div>
        </div>
    }
</PageLayout>

@code {
    [Parameter] public int Id { get; set; }

    private ViewerDataResponse? _response;

    protected override async Task OnInitializedAsync()
    {
        var result = await ViewerDataHandler.Handle(new ViewerDataQuery { TemplateId = Id });
        if (result.IsSuccess)
        {
            _response = result.Value;
        }
        else
        {
            NavigationManager.NavigateTo(AppRoutes.TemplatesSearch);
        }
    }
}
