@using KlavLor.Domain.Entities

<div class="viewer-group absolute select-none"
     data-group-id="@Group.Id"
     style="left: @(Group.PositionX)px; top: @(Group.PositionY)px; z-index: 2;">

    <div class="bg-white/90 dark:bg-slate-800/90 rounded-lg border-2 border-slate-400 dark:border-slate-500 shadow-md">
        <div class="p-1.5 space-y-0.5">
            @foreach (var node in GroupedNodes)
            {
                var completedAt = CompletionDates.GetValueOrDefault(node.Id);
                <ViewerGroupItem Node="@node" TemplateId="@TemplateId"
                                 IsCompleted="@(completedAt != default)"
                                 CompletedAt="@(completedAt != default ? completedAt : null)"
                                 CanToggle="@CanTrackCompletion" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required TemplateNodeGroup Group { get; set; }
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public List<TemplateNode> GroupedNodes { get; set; } = [];
    [Parameter] public Dictionary<int, DateTimeOffset> CompletionDates { get; set; } = [];
    [Parameter] public bool CanTrackCompletion { get; set; }
}
