@using KlavLor.Application.Features.Loot.ItemValues

@* Items the site has only ever recorded at 0 GP. Collection-log items sort first because those are
   the ones worth valuing; everything below them is usually genuine junk. Clicking a row fills the
   panel's form, same as the search results. *@

@if (Items.Count == 0)
{
    <p class="text-sm text-slate-400 dark:text-white py-2">Nothing found — every item on record has a price.</p>
}
else
{
    <p class="text-xs text-slate-400 dark:text-white mb-2">
        @Items.Count.ToString("N0") item@(Items.Count == 1 ? "" : "s") recorded only at 0 GP. Collection-log items are listed first and marked; those are the ones likely to want a value.
    </p>
    <div class="space-y-1 max-h-96 overflow-y-auto pr-1">
        @foreach (var item in Items)
        {
            <button type="button" onclick="@SelectScript(item)"
                    class="w-full flex items-center gap-2 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-left hover:border-amber-400 dark:hover:border-amber-500 cursor-pointer">
                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.ItemName)" alt="@item.ItemName"
                     class="w-4 h-4 object-contain shrink-0" loading="lazy" onerror="this.style.display='none'" />
                <span class="text-sm text-slate-700 dark:text-slate-100 truncate">@item.ItemName</span>
                @if (item.IsCollectionLogItem)
                {
                    <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 shrink-0">clog</span>
                }
                <span class="text-[10px] text-slate-400 dark:text-white shrink-0 ml-auto">
                    id @item.ItemId · @item.DropCount.ToString("N0") drop@(item.DropCount == 1 ? "" : "s")
                </span>
            </button>
        }
    </div>
}

@code {
    [Parameter] public List<ZeroValueItem> Items { get; set; } = [];

    // Item names come from the drop table, so they're escaped as a JS string literal.
    private static string SelectScript(ZeroValueItem item)
    {
        var name = System.Text.Json.JsonSerializer.Serialize(item.ItemName);
        return $"document.getElementById('ivp-item-id').value={item.ItemId};"
             + $"document.getElementById('ivp-item-name').value={name};"
             + "document.getElementById('ivp-value').focus();";
    }
}
