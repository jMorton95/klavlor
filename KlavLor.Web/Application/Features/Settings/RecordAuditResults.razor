@using KlavLor.Application.Interfaces.Repositories

@* One page of records for a character, each with its drops, and the three repairs.

   Every control here carries the full query as hx-vals rather than reading the form inputs. The
   pager, the delete and both toggles need to reproduce the exact search that produced this page, and
   after a swap the original inputs are still on screen but the page number in them is stale.
   Round-tripping the parameters through the markup keeps them in step.

   THE DROPS COME FROM THE CANONICAL DropsJson, not the LootDrops projection, and this panel is the
   only place on the site that does. Blacklisting a drop removes it from the projection — that
   absence is exactly how it disappears everywhere else — so reading the projection here would make
   a blacklisted drop invisible on the one screen that has to be able to see it and put it back. *@

@if (Page.TotalRows == 0)
{
    <p class="text-sm text-white">No records match.</p>
}
else
{
    <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
        <p class="text-xs text-white">
            @Page.TotalRows.ToString("N0") record@(Page.TotalRows == 1 ? "" : "s")
            · page @Page.Page of @Page.TotalPages
        </p>
        <div class="inline-flex gap-1">
            <button type="button" disabled="@(!Page.HasPrevious)"
                    hx-get="@PageUrl(Page.Page - 1)" hx-target="#ra-results" hx-swap="innerHTML"
                    class="px-2 py-1 text-[11px] rounded border border-slate-600 disabled:opacity-40 cursor-pointer disabled:cursor-default text-slate-200">Previous</button>
            <button type="button" disabled="@(!Page.HasNext)"
                    hx-get="@PageUrl(Page.Page + 1)" hx-target="#ra-results" hx-swap="innerHTML"
                    class="px-2 py-1 text-[11px] rounded border border-slate-600 disabled:opacity-40 cursor-pointer disabled:cursor-default text-slate-200">Next</button>
        </div>
    </div>

    <div class="divide-y divide-slate-800 border border-slate-700 rounded-lg overflow-hidden">
        @foreach (var row in Page.Rows)
        {
            <div class="flex items-start gap-3 px-3 py-2 bg-slate-900">
                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="text-xs font-semibold tabular-nums text-slate-200">@row.OccurredAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</span>
                        @* The source is shown per row now: a search can span every source the
                           character has, so the row can no longer assume the header says which. *@
                        <span class="text-[11px] text-slate-300">@row.SourceName</span>
                        @if (row.KillCount is { } kc)
                        {
                            <span class="text-[10px] tabular-nums text-amber-400">KC @kc.ToString("N0")</span>
                        }
                        <span class="text-[10px] tabular-nums text-white">@row.TotalValue.ToString("N0") gp</span>
                        @if (row.IsImported)
                        {
                            @* Imported records came from a historical backfill rather than a live
                               kill, which is worth knowing before deleting one. *@
                            <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-800 text-slate-300">imported</span>
                        }
                        @if (row.ExcludedFromLuck)
                        {
                            @* States the consequence rather than the flag: "excluded" alone reads as
                               "hidden", and this record is still counted everywhere except luck. *@
                            <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-amber-950/60 text-amber-300"
                                  title="This record's drops are skipped by the luck leaderboard, the collection panel and the feed's lucky/dry line. The kill still counts as a roll.">no luck</span>
                        }
                        <span class="text-[10px] text-slate-500">#@row.Id</span>
                    </div>

                    @* Each drop is its own control. Clicking one hides that item site-wide and
                       leaves the kill and every other drop alone; clicking a hidden one puts it
                       back. Reversible either way, so no confirm — the chip says which state it is
                       in and one more click undoes it. *@
                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                        @if (row.Drops.Count == 0)
                        {
                            <span class="text-[11px] text-slate-500">no drops</span>
                        }
                        @foreach (var drop in row.Drops)
                        {
                            <button type="button"
                                    hx-post="@BlacklistUrl(row.Id, drop, !drop.Blacklisted)"
                                    hx-target="#ra-results"
                                    hx-swap="innerHTML"
                                    title="@(drop.Blacklisted
                                        ? $"Restore {drop.Name}: it becomes visible again everywhere and counts for gold as before."
                                        : $"Hide {drop.Name} across the whole site — drop lists, gold totals, the collection log and the live feed. The kill still counts as a roll and this record's other drops are unaffected.")"
                                    class="group inline-flex items-baseline gap-1 px-1.5 py-0.5 rounded border text-[11px] cursor-pointer @(drop.Blacklisted
                                        ? "border-red-900 bg-red-950/40 text-red-400 line-through decoration-red-500/70"
                                        : "border-slate-700 text-slate-300 hover:border-red-900 hover:text-red-400")">
                                <span>@drop.Name@(drop.Quantity > 1 ? $" ×{drop.Quantity:N0}" : "")</span>
                                <span class="@(drop.Blacklisted ? "text-red-500/70" : "text-slate-500")">@((drop.Quantity * drop.Price).ToString("N0"))</span>
                            </button>
                        }
                    </div>

                    @if (row.Drops.Any(d => d.Blacklisted))
                    {
                        <p class="text-[10px] text-red-400/80 mt-1">Struck through = hidden everywhere. Click to restore.</p>
                    }
                </div>

                @* Reversible and non-destructive, so no confirm: the button says which way it is
                   about to go and one more click puts it back. *@
                <button type="button"
                        hx-post="@ExcludeUrl(row.Id, !row.ExcludedFromLuck)"
                        hx-target="#ra-results"
                        hx-swap="innerHTML"
                        title="@(row.ExcludedFromLuck
                            ? "Count this record's drops in luck figures again."
                            : "Keep the record and its roll, but stop its drops informing the luck leaderboard, the collection panel and the feed's lucky/dry line.")"
                        class="shrink-0 px-2 py-1 text-[11px] rounded border cursor-pointer @(row.ExcludedFromLuck
                            ? "border-amber-800 text-amber-300 hover:bg-amber-950/40"
                            : "border-slate-600 text-slate-300 hover:bg-slate-800")">
                    @(row.ExcludedFromLuck ? "Count for luck" : "Exclude from luck")
                </button>

                @* Native confirm: destructive, unrecoverable, and one click from a list. *@
                <button type="button"
                        hx-delete="@DeleteUrl(row.Id)"
                        hx-target="#ra-results"
                        hx-swap="innerHTML"
                        hx-confirm="Delete this record and its drops? This cannot be undone — it will be logged in the modifications list, but the record itself is gone."
                        class="shrink-0 px-2 py-1 text-[11px] rounded border border-red-800 text-red-400 hover:bg-red-950/40 cursor-pointer">
                    Delete
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public required AuditRecordPage Page { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public string SourceName { get; set; } = "";
    [Parameter] public string Term { get; set; } = "";

    private string Query(int page) =>
        $"?characterId={CharacterId}" +
        $"&sourceName={Uri.EscapeDataString(SourceName)}" +
        $"&term={Uri.EscapeDataString(Term)}" +
        $"&page={page}&pageSize={Page.PageSize}";

    private string PageUrl(int page) => AppRoutes.AdminRecordAuditSearch.FromApi() + Query(page);

    /// Deleting re-runs the search on the SAME page, so the list closes up around the removed row.
    private string DeleteUrl(int recordId) =>
        AppRoutes.AdminRecordAuditDelete.Replace("{recordId:int}", recordId.ToString()).FromApi() + Query(Page.Page);

    /// The target state travels in the URL rather than being inferred server-side, so a double
    /// click cannot flip the record twice - the second request asks for the state it is already in,
    /// which the handler treats as a no-op.
    private string ExcludeUrl(int recordId, bool excluded) =>
        AppRoutes.AdminRecordAuditExclude.Replace("{recordId:int}", recordId.ToString()).FromApi()
        + Query(Page.Page) + $"&excluded={excluded.ToString().ToLowerInvariant()}";

    /// Same idempotent shape as the exclude toggle. The item id AND name both travel because
    /// together they are the blacklist's key — an untradeable can be logged with no usable id, so
    /// the id alone would not distinguish two of them on one kill.
    private string BlacklistUrl(int recordId, AuditRecordDrop drop, bool blacklisted) =>
        AppRoutes.AdminRecordAuditBlacklist.Replace("{recordId:int}", recordId.ToString()).FromApi()
        + Query(Page.Page)
        + $"&itemId={drop.ItemId}"
        + $"&itemName={Uri.EscapeDataString(drop.Name)}"
        + $"&blacklisted={blacklisted.ToString().ToLowerInvariant()}";
}
