@* Apply form + optional source search + current-modifiers list. The form posts source/item/
   multiplier and re-renders the current list; the search box confirms exact source names. *@

<div class="flex flex-wrap items-end gap-3 mb-4">
    <div>
        <label class="block text-[10px] uppercase tracking-wider text-slate-500 dark:text-white mb-1">Source</label>
        <input id="srm-source" name="sourceName" type="text" placeholder="e.g. Perilous Moons" autocomplete="off"
               class="w-56 px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
    </div>
    <div>
        <label class="block text-[10px] uppercase tracking-wider text-slate-500 dark:text-white mb-1">Item (optional)</label>
        <input id="srm-item" name="itemName" type="text" placeholder="blank = all items" autocomplete="off"
               class="w-56 px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
    </div>
    <div>
        <label class="block text-[10px] uppercase tracking-wider text-slate-500 dark:text-white mb-1">Multiplier</label>
        <input id="srm-mult" name="multiplier" type="number" step="0.05" min="0" value="1"
               class="w-28 px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
    </div>
    <button type="button"
            hx-post="@AppRoutes.AdminSourceModifierApply.FromApi()"
            hx-include="#srm-source, #srm-item, #srm-mult"
            hx-target="#srm-results"
            hx-swap="innerHTML"
            hx-disabled-elt="this"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium bg-amber-500 text-white hover:bg-amber-600 cursor-pointer disabled:opacity-50">
        Apply
    </button>
</div>

<p class="text-xs text-slate-400 dark:text-white mb-3">
    A multiplier scales the expected kills-to-drop: 2 means twice as many kills expected (twice as dry), 0.5 means half. Setting it to 1 removes the modifier. It applies on top of any built-in model (raids, Doom) and takes effect on the character page immediately and on the next hourly leaderboard rebuild.
</p>

<div class="relative max-w-md mb-3">
    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input type="search" name="searchTerm" placeholder="Search sources to confirm the exact name…"
           autocomplete="off"
           hx-get="@AppRoutes.AdminSourceModifierSearch.FromApi()"
           hx-trigger="keyup changed delay:300ms"
           hx-target="#srm-search-results"
           hx-swap="innerHTML"
           class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
</div>
<div id="srm-search-results" class="mb-4"></div>

<h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-2">Current modifiers</h3>
@* Loads when its admin-hub section is first expanded, not on page load, so a collapsed hub
   issues no panel requests. Falls back to load when there is no enclosing <details>. *@
<div id="srm-results" hx-get="@AppRoutes.AdminSourceModifierSearch.FromApi()" hx-trigger="toggle once from:closest details" hx-swap="innerHTML">
    <div class="h-12 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
</div>
