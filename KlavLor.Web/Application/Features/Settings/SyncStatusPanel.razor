@using KlavLor.Application.Features.Maintenance

<div id="sync-status" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">

    <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
        <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Collection log</span>
            <button hx-post="@AppRoutes.AdminClogSyncNow.FromApi()"
                    hx-target="#sync-status" hx-swap="outerHTML" hx-disabled-elt="this"
                    class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 hover:text-amber-700 dark:hover:text-amber-300 cursor-pointer disabled:opacity-50">
                Sync now
            </button>
        </div>
        <p class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">@Status.ClogItemCount.ToString("N0")<span class="text-xs font-normal text-slate-400"> items</span></p>
        <p class="text-[11px] text-slate-400 dark:text-white">synced @Ago(Status.ClogLastSynced)</p>
    </div>

    <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
        <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Drop rates</span>
        <p class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">@Status.DropRateSourceCount.ToString("N0")<span class="text-xs font-normal text-slate-400"> sources · @Status.DropRateCount.ToString("N0") rates</span></p>
        <p class="text-[11px] text-slate-400 dark:text-white">synced @Ago(Status.DropRateLastSynced)</p>
    </div>

    <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
        <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Cached images</span>
        <p class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">@Status.CachedImageCount.ToString("N0")</p>
        <p class="text-[11px] text-slate-400 dark:text-white">stored blobs</p>
    </div>

    <IconStatCard Title="Item icons" Stats="Status.ItemIcons" />
    <IconStatCard Title="Source icons" Stats="Status.SourceIcons" />
</div>

@code {
    [Parameter] public required SyncStatus Status { get; set; }

    private static string Ago(DateTimeOffset? at)
    {
        if (at is null) return "never";
        var span = DateTimeOffset.UtcNow - at.Value;
        if (span < TimeSpan.FromMinutes(1)) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes}m ago";
        if (span < TimeSpan.FromDays(1)) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}
