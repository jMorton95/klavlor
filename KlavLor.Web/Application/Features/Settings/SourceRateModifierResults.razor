@using KlavLor.Application.Features.Loot.SourceModels

@if (Items.Count == 0)
{
    <p class="text-sm text-slate-400 dark:text-white py-2">
        @(IsSearch ? "No sources match your search." : "No rate modifiers configured yet.")
    </p>
}
else
{
    <div class="space-y-1">
        @foreach (var m in Items)
        {
            <div class="flex items-center justify-between gap-3 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2">
                <span class="inline-flex items-center gap-2 min-w-0">
                    <img src="/api/images/source-icon?name=@Uri.EscapeDataString(m.SourceName)" alt="@m.SourceName"
                         class="w-5 h-5 rounded object-contain shrink-0" loading="lazy" onerror="this.style.display='none'" />
                    <span class="text-sm text-slate-700 dark:text-slate-100 truncate">@m.SourceName</span>
                    <span class="text-[10px] text-slate-400 dark:text-white shrink-0">· @(string.IsNullOrEmpty(m.ItemName) ? "all items" : m.ItemName)</span>
                </span>
                <span class="inline-flex items-center gap-2 shrink-0">
                    <span class="text-xs font-mono @(IsNeutral(m.Multiplier) ? "text-slate-400 dark:text-white" : "text-amber-600 dark:text-amber-400")">×@m.Multiplier.ToString("0.###")</span>
                    @if (!IsSearch && !IsNeutral(m.Multiplier))
                    {
                        <button hx-post="@RemoveUrl(m)" hx-target="#srm-results" hx-swap="innerHTML"
                                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-red-100 dark:hover:bg-red-900/50 hover:text-red-700 dark:hover:text-red-300 cursor-pointer"
                                title="Remove this modifier (reset to 1×)">
                            Remove
                        </button>
                    }
                </span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<SourceRateModifierRow> Items { get; set; } = [];
    // When rendered as search results we show current values but no remove button (a searched
    // source with no override reads as ×1 and there's nothing to remove).
    [Parameter] public bool IsSearch { get; set; }

    private static bool IsNeutral(double m) => Math.Abs(m - 1.0) < 1e-9;

    private static string RemoveUrl(SourceRateModifierRow m) =>
        $"{AppRoutes.AdminSourceModifierRemove.FromApi()}?source={Uri.EscapeDataString(m.SourceName)}&item={Uri.EscapeDataString(m.ItemName)}";
}
