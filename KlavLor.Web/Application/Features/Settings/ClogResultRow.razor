@using KlavLor.Application.Features.CollectionLog

<div id="clog-row-@Item.ItemId" class="flex items-center justify-between gap-3 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2">
    <span class="inline-flex items-center gap-2 min-w-0">
        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Item.Name)" alt="@Item.Name"
             class="w-5 h-5 shrink-0" loading="lazy" onerror="this.style.display='none'" />
        <span class="text-sm text-slate-700 dark:text-slate-100 truncate">@Item.Name</span>
        <span class="text-[10px] text-slate-400 dark:text-white shrink-0">#@Item.ItemId</span>
    </span>

    @if (Item.IsExcluded)
    {
        <button hx-post="@ToggleUrl(AppRoutes.AdminClogInclude)"
                hx-target="#clog-row-@Item.ItemId" hx-swap="outerHTML"
                class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 cursor-pointer"
                title="Re-include this item in collection logs">
            Excluded — remove
        </button>
    }
    else
    {
        <button hx-post="@ToggleUrl(AppRoutes.AdminClogExclude)"
                hx-target="#clog-row-@Item.ItemId" hx-swap="outerHTML"
                class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 hover:text-amber-700 dark:hover:text-amber-300 cursor-pointer"
                title="Exclude this item from collection logs">
            Exclude
        </button>
    }
</div>

@code {
    [Parameter] public required ClogItemRow Item { get; set; }

    private string ToggleUrl(string route) =>
        $"{route.FromApi()}?itemId={Item.ItemId}&itemName={Uri.EscapeDataString(Item.Name)}";
}
