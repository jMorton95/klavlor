@using KlavLor.Application.Features.Loot.Leaderboard

<div id="lbxi-row-@RowIndex" class="flex items-center justify-between gap-3 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2">
    <span class="inline-flex items-center gap-2 min-w-0">
        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Item.ItemName)" alt="@Item.ItemName"
             class="w-5 h-5 object-contain shrink-0" loading="lazy" onerror="this.style.display='none'" />
        <span class="text-sm text-slate-700 dark:text-slate-100 truncate">@Item.ItemName</span>
        @if (Item.DropCount > 0)
        {
            <span class="text-[10px] text-slate-400 dark:text-white shrink-0">@Item.DropCount.ToString("N0") drops</span>
        }
    </span>

    @if (Item.IsExcluded)
    {
        <button hx-post="@ToggleUrl(AppRoutes.AdminLeaderboardItemExclusionInclude)"
                hx-target="#lbxi-row-@RowIndex" hx-swap="outerHTML"
                class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 cursor-pointer"
                title="Show this item on the leaderboards again">
            Excluded — remove
        </button>
    }
    else
    {
        <button hx-post="@ToggleUrl(AppRoutes.AdminLeaderboardItemExclusionExclude)"
                hx-target="#lbxi-row-@RowIndex" hx-swap="outerHTML"
                class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 hover:text-amber-700 dark:hover:text-amber-300 cursor-pointer"
                title="Hide this item from the leaderboards (all sources)">
            Exclude
        </button>
    }
</div>

@code {
    [Parameter] public required LeaderboardItemRow Item { get; set; }
    [Parameter] public int RowIndex { get; set; }

    private string ToggleUrl(string route) =>
        $"{route.FromApi()}?item={Uri.EscapeDataString(Item.ItemName)}&count={Item.DropCount}&rowIndex={RowIndex}";
}
