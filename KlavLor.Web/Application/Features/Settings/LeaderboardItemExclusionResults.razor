@using KlavLor.Application.Features.Loot.Leaderboard

@if (Items.Count == 0)
{
    <p class="text-sm text-slate-400 dark:text-white py-2">
        @(string.IsNullOrWhiteSpace(SearchTerm) ? "No items are excluded from the leaderboards." : "No items match your search.")
    </p>
}
else
{
    @if (string.IsNullOrWhiteSpace(SearchTerm))
    {
        <p class="text-xs text-slate-400 dark:text-white mb-2">@Items.Count excluded item@(Items.Count == 1 ? "" : "s")</p>
    }
    <div class="space-y-1">
        @for (var i = 0; i < Items.Count; i++)
        {
            <LeaderboardItemExclusionRow Item="@Items[i]" RowIndex="@i" />
        }
    </div>
}

@code {
    [Parameter] public List<LeaderboardItemRow> Items { get; set; } = [];
    [Parameter] public string? SearchTerm { get; set; }
}
