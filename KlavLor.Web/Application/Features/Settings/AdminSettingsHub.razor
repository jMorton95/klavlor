@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Components.Layout

@inject ISystemSettingsCache SystemSettingsCache

<TopBarMetaData PageTitle="KlavLor - Admin Area" Title="Admin Area" Description="Site administration" />

<div class="space-y-8 max-w-3xl pb-32">
    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Sync status</h2>
        <div hx-get="@AppRoutes.AdminSyncStatus.FromApi()" hx-trigger="load" hx-swap="innerHTML">
            <div class="h-24 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Leagues</h2>
        <AdminSettingsToggleLeagues IsLeaguesEnabled="@SystemSettingsCache.IsLeaguesEnabled" />
    </section>

    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Management</h2>
        <div class="flex flex-wrap gap-3">
            <a hx-get="@AppRoutes.UsersSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.UsersSearch" hx-swap="innerHTML transition:true"
               class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:border-amber-200 dark:hover:border-amber-700 text-slate-700 dark:text-slate-200 cursor-pointer transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                User Management
            </a>
            <a hx-get="@AppRoutes.SyncLog.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.SyncLog" hx-swap="innerHTML transition:true"
               class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:border-amber-200 dark:hover:border-amber-700 text-slate-700 dark:text-slate-200 cursor-pointer transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Sync Logs
            </a>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">Collection log blacklist</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
            Excluded items stop counting as collection-log drops everywhere — recent clogs, first-time feeds, activity counts and the live feed. Search to add; the list below shows what's currently excluded.
        </p>
        <div class="relative max-w-md mb-3">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="search" name="searchTerm" placeholder="Search collection-log items to exclude…"
                   autocomplete="off"
                   hx-get="@AppRoutes.AdminClogSearch.FromApi()"
                   hx-trigger="keyup changed delay:300ms, load"
                   hx-target="#clog-results"
                   hx-swap="innerHTML"
                   class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
        </div>
        <div id="clog-results">
            <div class="h-20 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">Drop rates</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
            Manually fetch per-source drop rates from the wiki when some are missing. The list below shows sources with loot but no stored rates; search to re-fetch any source.
        </p>
        <div class="relative max-w-md mb-3">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="search" name="searchTerm" placeholder="Search sources (blank = missing rates)…"
                   autocomplete="off"
                   hx-get="@AppRoutes.AdminDropRatesSearch.FromApi()"
                   hx-trigger="keyup changed delay:300ms, load"
                   hx-target="#drate-results"
                   hx-swap="innerHTML"
                   class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
        </div>
        <div id="drate-results">
            <div class="h-20 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
        </div>

        <div class="mt-4">
            <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-1">Collection-log items with no drop rate</h3>
            <div id="drate-missing" hx-get="@AppRoutes.AdminDropRatesMismatches.FromApi()" hx-trigger="load" hx-swap="innerHTML">
                <div class="h-16 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
            </div>
        </div>
    </section>

    <section>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">Broken icons</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
            Item and source icons that gave up after repeated failed wiki lookups (so they show no image anywhere). Retry clears the failure and the backfill re-attempts within a couple of minutes.
        </p>
        <div id="icon-results" hx-get="@AppRoutes.AdminIcons.FromApi()" hx-trigger="load" hx-swap="innerHTML">
            <div class="h-20 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
        </div>
    </section>
</div>
