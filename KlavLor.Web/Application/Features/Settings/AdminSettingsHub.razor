@using KlavLor.Web.Components.Layout

@* The admin shell: persistent section nav plus exactly one section's panel.

   This replaced a single page carrying all thirteen sections as collapsible <details>. That page
   shipped every section's markup on every visit, nothing was linkable, and finding a section meant
   scrolling. Now each section is its own URL — /admin/settings/{slug} — so a section is
   bookmarkable, linkable and back-button-navigable, and only its own panel is fetched.

   The nav uses hx-get to the shell's /api route with an explicit hx-push-url to the page route (the
   two differ by the /api prefix, so HtmxNavigationFilter's blanket strip can't derive it). Every
   link also carries a real href, so a middle-click or a JS-less load still works.

   Adding a section: one row in AdminSections.All and one branch in Body below. No panel-body
   endpoint has to move. *@
@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@($"KlavLor - {Current.Title}")" Title="Admin Area" Description="@Current.Title" />
}

<div class="max-w-6xl mx-auto pb-32 lg:flex lg:gap-8 lg:items-start">

    <nav class="w-full lg:w-56 shrink-0 lg:sticky lg:top-4 self-start mb-6 lg:mb-0">
        @foreach (var group in AdminSections.Grouped())
        {
            <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-white mb-1.5 mt-4 first:mt-0 px-3">@group.Key</p>
            <ul class="space-y-0.5 text-sm mb-2">
                @* Loop variable is deliberately not called "section" — Razor parses a leading
                   @section as the section directive, not as an expression. *@
                @foreach (var entry in group)
                {
                    <li>
                        <a href="@PageUrl(entry)"
                           hx-get="@PageUrl(entry).FromApi()"
                           hx-target="#hx-page-container"
                           hx-swap="innerHTML transition:true"
                           hx-push-url="@PageUrl(entry)"
                           class="@NavClasses(entry)">
                            @entry.NavLabel
                        </a>
                    </li>
                }
            </ul>
        }
    </nav>

    <div class="flex-1 min-w-0">
        <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white/60 dark:bg-slate-900/40 p-5">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">@Current.Title</h2>
            @if (Current.Description is { Length: > 0 } description)
            {
                <p class="text-sm text-slate-500 dark:text-white mb-4">@description</p>
            }
            else
            {
                <div class="mb-4"></div>
            }

            @Body
        </div>
    </div>
</div>

@code {
    /// True when served as an HTMX fragment (renders the OOB header); false when hosted inside
    /// PageLayout on a full page load (PageLayout renders the header instead).
    [Parameter] public bool UpdateHeader { get; set; } = true;

    /// Slug from the route. Unknown or absent resolves to the first section.
    [Parameter] public string? Section { get; set; }

    private AdminSection Current => AdminSections.Resolve(Section);

    private static string PageUrl(AdminSection section) => $"{AppRoutes.AdminSettings}/{section.Slug}";

    private string NavClasses(AdminSection section) =>
        section.Slug == Current.Slug
            ? "block px-3 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 font-medium"
            : "block px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-amber-700 dark:hover:text-amber-300 transition-colors";

    /// One branch per section. Explicit rather than reflective, matching how endpoints and source
    /// loot strategies are registered here — a missing branch is a compile-visible omission.
    private RenderFragment Body => Current.Slug switch
    {
        "sync-status"    => @<AdminPanelLoader Route="@AppRoutes.AdminSyncStatus" />,
        "jobs"           => @<AdminPanelLoader Route="@AppRoutes.AdminJobHealth" />,
        "management"     => @<AdminSectionManagement />,
        "icons"          => @<AdminPanelLoader Route="@AppRoutes.AdminIcons" Id="icon-results" HeightClass="h-20" />,
        "collection-log" => @<AdminSectionCollectionLog />,
        "drop-rates"     => @<AdminSectionDropRates />,
        "record-audit"   => @<AdminPanelLoader Route="@AppRoutes.AdminRecordAudit" />,
        "sources"        => @<AdminSectionSourceNames />,
        "rate-modifiers" => @<SourceRateModifierPanel />,
        "baselines"      => @<AdminPanelLoader Route="@AppRoutes.AdminBaseline" />,
        "delve-depths"   => @<AdminPanelLoader Route="@AppRoutes.AdminDelveDepth" />,
        "leaderboards"   => @<AdminSectionLeaderboards />,
        "item-values"    => @<AdminPanelLoader Route="@AppRoutes.AdminItemValues" />,
        "special-loot"   => @<AdminPanelLoader Route="@AppRoutes.AdminSpecialLoot" />,
        _                => @<AdminPanelLoader Route="@AppRoutes.AdminSyncStatus" />
    };
}
