@using KlavLor.Application.Features.Maintenance
@using KlavLor.Domain.Entities

@* Grid view. Each card is a button that expands to a full-width single-job view by swapping
   #job-health-root (shared root id with JobHealthExpanded) via its own HTMX request. *@
<div id="job-health-root">
    @if (Rows.Count == 0)
    {
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-4 text-sm text-slate-500 dark:text-white">
            No background-job runs recorded yet. Each service records its first run here once it completes a cycle after startup.
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var row in Rows)
            {
                var bad = row.IsStuck || row.Outcome == JobRunOutcome.Failed;
                <button type="button"
                        hx-get="@($"{AppRoutes.AdminJobHealth.FromApi()}?expand={Uri.EscapeDataString(row.JobName)}")"
                        hx-target="#job-health-root"
                        hx-swap="outerHTML"
                        class="text-left rounded-lg border p-3 cursor-pointer transition-colors hover:border-amber-300 dark:hover:border-amber-700 @(bad ? "border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-950/30" : "border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900")">
                    <div class="flex items-center justify-between gap-2 mb-1">
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 truncate">@row.JobName</span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full whitespace-nowrap @BadgeClass(row)">@Label(row)</span>
                    </div>
                    <p class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">
                        @row.ItemsProcessed.ToString("N0")<span class="text-xs font-normal text-slate-400"> processed</span>
                    </p>
                    <p class="text-[11px] text-slate-500 dark:text-white">
                        ran @Ago(row.StartedAt)@(row.DurationSeconds is { } d ? $" · {Duration(d)}" : "")
                    </p>
                    <p class="text-[10px] text-amber-600 dark:text-amber-400 mt-1 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/></svg>
                        Expand
                    </p>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public required IReadOnlyList<JobHealthRow> Rows { get; set; }

    private static string Label(JobHealthRow row) =>
        row.IsStuck ? "Stuck" : row.Outcome switch
        {
            JobRunOutcome.Succeeded => "OK",
            JobRunOutcome.NoWork => "Idle",
            JobRunOutcome.Failed => "Failed",
            JobRunOutcome.Running => "Running",
            JobRunOutcome.Cancelled => "Cancelled",
            _ => row.Outcome.ToString()
        };

    private static string BadgeClass(JobHealthRow row)
    {
        if (row.IsStuck || row.Outcome == JobRunOutcome.Failed)
            return "bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300";
        return row.Outcome switch
        {
            JobRunOutcome.Succeeded => "bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300",
            JobRunOutcome.Running => "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300",
            _ => "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-200"
        };
    }

    private static string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.UtcNow - at;
        if (span < TimeSpan.FromMinutes(1)) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes}m ago";
        if (span < TimeSpan.FromDays(1)) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private static string Duration(double seconds)
    {
        if (seconds < 1) return "<1s";
        if (seconds < 60) return $"{seconds:0}s";
        if (seconds < 3600) return $"{seconds / 60:0}m {seconds % 60:0}s";
        return $"{seconds / 3600:0.0}h";
    }
}
