@using KlavLor.Application.Features.Maintenance

<div id="icon-row-@Icon.Kind-@Icon.Id" class="flex items-center justify-between gap-3 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2">
    <span class="inline-flex items-center gap-2 min-w-0">
        <img src="@IconUrl" alt="@Icon.Name" class="w-5 h-5 shrink-0" loading="lazy" onerror="this.style.display='none'" />
        <span class="min-w-0">
            <span class="block text-sm text-slate-700 dark:text-slate-100 truncate">@Icon.Name</span>
            <span class="block text-[10px] text-slate-400 dark:text-slate-500">@KindLabel · failed @Icon.FailCount×</span>
        </span>
    </span>

    @if (Queued)
    {
        <span class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300">
            Queued for retry
        </span>
    }
    else
    {
        <button hx-post="@RetryUrl"
                hx-target="#icon-row-@Icon.Kind-@Icon.Id" hx-swap="outerHTML"
                hx-disabled-elt="this"
                class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 hover:text-amber-700 dark:hover:text-amber-300 cursor-pointer disabled:opacity-50"
                title="Clear the failure so the backfill re-attempts this icon">
            Retry
        </button>
    }
</div>

@code {
    [Parameter] public required FailedIcon Icon { get; set; }
    [Parameter] public bool Queued { get; set; }

    private string KindLabel => Icon.Kind == IconKind.Item ? "Item" : "Source";

    private string IconUrl => Icon.Kind == IconKind.Item
        ? $"/api/images/item-icon?name={Uri.EscapeDataString(Icon.Name)}"
        : $"/api/images/source-icon?name={Uri.EscapeDataString(Icon.Name)}";

    private string RetryUrl =>
        $"{AppRoutes.AdminIconsRetry.FromApi()}?kind={Icon.Kind}&id={Icon.Id}&name={Uri.EscapeDataString(Icon.Name)}";
}
