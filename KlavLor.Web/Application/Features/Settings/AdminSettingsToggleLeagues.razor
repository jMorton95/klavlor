@using KlavLor.Web.Application

<div id="admin-settings-leagues" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-slate-900 border border-slate-700">
    <div class="flex flex-col">
        <span class="text-xs font-semibold text-slate-200">Leagues feature</span>
        <span class="text-[11px] text-white">
            Controls the Leagues feed, sidebar link, and the Leagues toggle on characters.
        </span>
    </div>
    <button hx-post="@AppRoutes.AdminSettingsLeaguesToggle.FromApi()"
            hx-target="#admin-settings-leagues"
            hx-swap="outerHTML"
            class="ml-auto cursor-pointer"
            title="Toggle the Leagues feature site-wide">
        @if (IsLeaguesEnabled)
        {
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-900/50 text-amber-300">
                Enabled
            </span>
        }
        else
        {
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800 text-white">
                Disabled
            </span>
        }
    </button>
</div>

@code {
    [Parameter] public bool IsLeaguesEnabled { get; set; }
}
