@using KlavLor.Application.Features.Maintenance

<div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 p-3">
    <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">@Title</span>
    <p class="text-lg font-bold text-slate-900 dark:text-slate-100 tabular-nums">
        @Stats.Cached.ToString("N0")<span class="text-xs font-normal text-slate-400"> / @Stats.Total.ToString("N0") cached</span>
    </p>
    <p class="text-[11px] text-slate-400 dark:text-slate-500">
        @Stats.Pending pending
        @if (Stats.Failed > 0)
        {
            <span class="text-red-600 dark:text-red-400">· @Stats.Failed failed</span>
        }
    </p>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public required IconStats Stats { get; set; }
}
