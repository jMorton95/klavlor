@using KlavLor.Application.Features.DropRates

@if (Items.Count == 0)
{
    <p class="text-sm text-slate-400 dark:text-white py-2">
        @(string.IsNullOrWhiteSpace(SearchTerm) ? "Every source with loot already has drop rates." : "No sources match your search.")
    </p>
}
else
{
    @if (string.IsNullOrWhiteSpace(SearchTerm))
    {
        <p class="text-xs text-slate-400 dark:text-white mb-2">@Items.Count source@(Items.Count == 1 ? "" : "s") with loot but no stored drop rates</p>
    }
    <div class="space-y-1">
        @foreach (var item in Items)
        {
            <DropRateRow Item="@item" />
        }
    </div>
}

@code {
    [Parameter] public List<DropRateSourceRow> Items { get; set; } = [];
    [Parameter] public string? SearchTerm { get; set; }
}
