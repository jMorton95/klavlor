@using KlavLor.Application.Features.CollectionLog

@if (Items.Count == 0)
{
    <p class="text-sm text-slate-400 dark:text-white py-2">No collection-log items match your search.</p>
}
else
{
    <div class="space-y-1">
        @foreach (var item in Items)
        {
            <div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-1.5">
                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.Name)" alt="@item.Name"
                     class="w-4 h-4 object-contain shrink-0" loading="lazy" onerror="this.style.display='none'" />
                <span class="text-sm text-slate-700 dark:text-slate-100 truncate">@item.Name</span>
                <span class="text-[10px] text-slate-400 dark:text-white shrink-0 ml-auto">id @item.ItemId</span>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<ClogItemRow> Items { get; set; } = [];
}
