@using KlavLor.Application.Interfaces.Repositories

@* Everything an admin has manually done through this panel, newest first.

   The list exists because two of the three repairs are invisible once made — a blacklisted drop is
   gone from every surface by design, and a luck exclusion shows only as the absence of a verdict —
   so without this there was no way to answer "what have I changed, and why is this missing".

   Deletions are here too, and they are the reason the list is a HISTORY rather than a set of
   toggles: the other two are live rows that can be undone, a deletion is a log line and the record
   is gone. The kind badge is what separates them, and the deleted rows deliberately carry no
   button — offering one that could not work would be worse than saying so. *@

<div class="flex items-baseline justify-between gap-3 mb-2">
    <p class="text-xs text-white">
        @if (Rows.Count == 0)
        {
            <span>No manual changes yet.</span>
        }
        else
        {
            <span>@Rows.Count.ToString("N0") change@(Rows.Count == 1 ? "" : "s")</span>
        }
    </p>
    <button type="button"
            hx-get="@AppRoutes.AdminRecordAuditModifications.FromApi()"
            hx-target="#ra-modifications"
            hx-swap="innerHTML"
            class="px-2 py-1 text-[11px] rounded border border-slate-600 text-slate-300 hover:bg-slate-800 cursor-pointer">
        Refresh
    </button>
</div>

@if (Rows.Count > 0)
{
    <div class="divide-y divide-slate-800 border border-slate-700 rounded-lg overflow-hidden">
        @foreach (var row in Rows)
        {
            <div class="flex items-start gap-3 px-3 py-2 bg-slate-900">
                <span class="shrink-0 mt-0.5 text-[10px] px-1.5 py-0.5 rounded-full @KindClasses(row.Kind)"
                      title="@KindTitle(row.Kind)">
                    @KindLabel(row.Kind)
                </span>

                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="text-xs font-semibold text-slate-200">@row.CharacterName</span>
                        <span class="text-[11px] text-slate-300">@row.SourceName</span>
                        @if (row.KillCount is { } kc)
                        {
                            <span class="text-[10px] tabular-nums text-amber-400">KC @kc.ToString("N0")</span>
                        }
                        <span class="text-[10px] tabular-nums text-white">@row.OccurredAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</span>
                        <span class="text-[10px] text-slate-500">#@row.RecordId</span>
                    </div>

                    @* What actually changed: the item for a blacklist, the kill's contents for a
                       deletion, and the plain fact for a luck exclusion, which has no sub-unit. *@
                    <p class="text-[11px] mt-0.5 @(row.Kind == AuditModificationKind.Deleted ? "text-slate-400" : "text-slate-300")">
                        @row.Detail
                    </p>

                    @if (!string.IsNullOrWhiteSpace(row.Reason))
                    {
                        <p class="text-[10px] text-slate-400 mt-0.5 italic">@row.Reason</p>
                    }

                    <p class="text-[10px] text-slate-500 mt-0.5">
                        @row.ChangedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(row.ChangedBy))
                        {
                            <span> · @row.ChangedBy</span>
                        }
                    </p>
                </div>

                @if (row.Restorable)
                {
                    @* Undo goes through the same endpoint the results list uses, asking for the
                       opposite state, so there is one code path per decision rather than a second
                       spelling of it here. It re-renders THIS list rather than the results below,
                       because that is what the admin is looking at. *@
                    <button type="button"
                            hx-post="@UndoUrl(row)"
                            hx-target="#ra-modifications"
                            hx-swap="innerHTML"
                            title="@UndoTitle(row.Kind)"
                            class="shrink-0 px-2 py-1 text-[11px] rounded border border-slate-600 text-slate-300 hover:bg-slate-800 cursor-pointer">
                        @(row.Kind == AuditModificationKind.BlacklistedDrop ? "Restore" : "Count for luck")
                    </button>
                }
                else
                {
                    <span class="shrink-0 px-2 py-1 text-[11px] text-slate-600" title="A deleted record cannot be brought back. This line is the record that it was removed deliberately.">
                        gone
                    </span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<AuditModification> Rows { get; set; } = [];

    private static string KindLabel(AuditModificationKind kind) => kind switch
    {
        AuditModificationKind.BlacklistedDrop => "HIDDEN",
        AuditModificationKind.LuckExcluded => "NO LUCK",
        _ => "DELETED"
    };

    private static string KindClasses(AuditModificationKind kind) => kind switch
    {
        AuditModificationKind.BlacklistedDrop => "bg-red-950/60 text-red-300",
        AuditModificationKind.LuckExcluded => "bg-amber-950/60 text-amber-300",
        _ => "bg-slate-800 text-slate-300"
    };

    private static string KindTitle(AuditModificationKind kind) => kind switch
    {
        AuditModificationKind.BlacklistedDrop =>
            "This item is hidden across the whole site. The kill still counts as a roll and the record's other drops are unaffected.",
        AuditModificationKind.LuckExcluded =>
            "This record's drops inform no luck figures. They still show everywhere and still count for gold.",
        _ => "This record was deleted. The row is gone; this line is the log of it."
    };

    private static string UndoTitle(AuditModificationKind kind) => kind switch
    {
        AuditModificationKind.BlacklistedDrop => "Make this item visible again everywhere, counting for gold as before.",
        _ => "Count this record's drops in luck figures again."
    };

    /// Points at the same endpoint the results list posts to, asking for the opposite state, so
    /// there is one code path per decision rather than a second spelling of it here. `view` tells
    /// that endpoint to render THIS list back rather than the record search, because that is the
    /// container htmx will swap the response into.
    private static string UndoUrl(AuditModification row) => row.Kind switch
    {
        AuditModificationKind.BlacklistedDrop =>
            AppRoutes.AdminRecordAuditBlacklist.Replace("{recordId:int}", row.RecordId.ToString()).FromApi()
            + $"?itemId={row.ItemId}&itemName={Uri.EscapeDataString(row.Detail)}&blacklisted=false"
            + $"&view={AdminSettingsEndpoint.ModificationsView}",
        _ =>
            AppRoutes.AdminRecordAuditExclude.Replace("{recordId:int}", row.RecordId.ToString()).FromApi()
            + $"?excluded=false&view={AdminSettingsEndpoint.ModificationsView}"
    };
}
