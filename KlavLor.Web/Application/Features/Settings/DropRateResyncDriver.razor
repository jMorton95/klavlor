@using System.Text.Json

@* The engine of the self-chaining bulk resync. This form auto-fires one step after
   a short polite delay, posting the remaining queue + running tallies. The step
   endpoint syncs the head source and swaps this driver out for [result row + next
   driver], so the chain advances one source at a time with the browser watching. *@
<form class="drate-resync-driver flex items-center gap-2 px-3 py-2 text-xs text-slate-600 dark:text-slate-300"
      hx-post="@AppRoutes.AdminDropRatesResyncStep.FromApi()"
      hx-trigger="load delay:500ms"
      hx-target="this"
      hx-swap="outerHTML">
    <input type="hidden" name="queue" value="@JsonSerializer.Serialize(Queue)" />
    <input type="hidden" name="stored" value="@Stored" />
    <input type="hidden" name="noData" value="@NoData" />
    <input type="hidden" name="failed" value="@Failed" />
    <input type="hidden" name="total" value="@Total" />
    <svg class="w-3.5 h-3.5 animate-spin text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
    <span class="truncate">
        Processed @(Total - Queue.Count) of @Total — @Stored stored, @NoData no wiki data, @Failed failed. Fetching @NextName…
    </span>
</form>

@code {
    [Parameter] public required IReadOnlyList<string> Queue { get; set; }
    [Parameter] public int Stored { get; set; }
    [Parameter] public int NoData { get; set; }
    [Parameter] public int Failed { get; set; }
    [Parameter] public int Total { get; set; }

    private string NextName => Queue.Count > 0 ? Queue[0] : "";
}
