@* A single inline number-and-label pair for a compact summary strip. Stat.razor stacks the label
   above the value in a grid cell, which is right for a wide dashboard row and wrong here — eight of
   them spread the drop page's header over two tall rows of mostly whitespace. *@
<span class="inline-flex items-baseline gap-1 whitespace-nowrap">
    <span class="font-semibold tabular-nums @(Accent ? "text-amber-600 dark:text-amber-400" : "text-slate-900 dark:text-slate-100")">@Value</span>
    <span class="text-[11px] text-slate-500 dark:text-white">@Label</span>
</span>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Accent { get; set; }
}
