@page "/drop/character"
@using KlavLor.Application.Features.Drop
@using KlavLor.Web.Components.Layout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@* Matches the drop page's own authorization: the global drop surface is User-only, and a routable
   page carries no fallback policy, so this attribute is what keeps a direct URL load in step with
   the endpoint that serves the HTMX-navigated version. *@
@inject GlobalDropHandler Handler

<PageLayout PageTitle="@($"KlavLor - {Name}")" Title="@(Name ?? "Drop")" Description="Item sources for one character">
    @if (!string.IsNullOrWhiteSpace(Name) && CharacterId is > 0)
    {
        <DropCharacterSourcesDetail ItemName="@Name" Data="@_data" />
    }
</PageLayout>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "characterId")]
    public int? CharacterId { get; set; }

    private DropCharacterSources? _data;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Name) || CharacterId is not > 0) return;
        _data = await Handler.GetCharacterSources(Name, CharacterId.Value);
    }
}
