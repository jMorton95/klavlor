@using KlavLor.Application.Common
@using KlavLor.Application.Features.Drop

<div id="drop-sources-table">
    @* Hidden sort state — lives inside the swapped region so the search box (which hx-includes
       these by id) always sends the current sort after a header click. *@
    <input type="hidden" id="ds-sort" name="sortBy" value="@Table.SortBy" />
    <input type="hidden" id="ds-dir" name="sortDirection" value="@Table.SortDirection" />

    <div class="bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th class="px-3 py-2 text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 @(col.Right ? "text-right" : "text-left")">
                            @if (col.Key is null)
                            {
                                <span>@col.Label</span>
                            }
                            else
                            {
                                <a hx-get="@SortUrl(col.Key)" hx-target="#drop-sources-table" hx-swap="outerHTML"
                                   class="inline-flex items-center gap-1 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 @(IsActive(col.Key) ? "text-amber-600 dark:text-amber-400" : "")">
                                    <span>@col.Label</span>
                                    <span class="text-[8px] leading-none w-2">@Arrow(col.Key)</span>
                                </a>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700/50">
                @if (Table.Rows.Count == 0)
                {
                    <tr><td colspan="@Columns.Length" class="px-3 py-8 text-center text-sm text-slate-400 dark:text-slate-500">No sources match.</td></tr>
                }
                else
                {
                    @foreach (var row in Table.Rows)
                    {
                        <DropSourceRowItem Row="row" />
                    }
                }
            </tbody>
            @if (Table.TotalSources > 0)
            {
                <tfoot class="border-t-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 font-medium">
                    <tr>
                        <td class="px-3 py-2 text-slate-600 dark:text-slate-300">@Table.TotalSources.ToString("N0") source@(Table.TotalSources == 1 ? "" : "s")</td>
                        <td class="px-3 py-2"></td>
                        <td class="px-3 py-2 text-right tabular-nums text-slate-600 dark:text-slate-300">@Table.TotalDrops.ToString("N0")</td>
                        <td class="px-3 py-2" colspan="3"></td>
                        <td class="px-3 py-2 text-right tabular-nums text-slate-500 dark:text-slate-400">@Table.TotalQuantity.ToString("N0")</td>
                        <td class="px-3 py-2 text-right tabular-nums text-amber-600 dark:text-amber-400">@GoldFormat.Format(Table.TotalValue)</td>
                        <td class="px-3 py-2" colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@code {
    [Parameter] public string ItemName { get; set; } = "";
    [Parameter] public required DropSourceTable Table { get; set; }

    // (Label, sort key | null for non-sortable, right-aligned)
    private static readonly (string Label, string? Key, bool Right)[] Columns =
    {
        ("Source", "source", false), ("Type", null, false), ("Drops", "drops", true), ("Kills", "kills", true),
        ("Obs. rate", "rate", true), ("Wiki rate", null, true), ("Qty", "qty", true), ("Value", "value", true),
        ("First", "first", true), ("Last", "last", true)
    };

    private bool IsActive(string key) => string.Equals(Table.SortBy, key, StringComparison.OrdinalIgnoreCase);
    private string Arrow(string key) => !IsActive(key) ? "" : (Table.SortDirection == SortDirection.Ascending ? "▲" : "▼");

    private string SortUrl(string key)
    {
        // Toggle direction when re-clicking the active column; otherwise default to descending.
        var dir = IsActive(key) && Table.SortDirection == SortDirection.Descending ? "Ascending" : "Descending";
        var url = $"{AppRoutes.DropSources.FromApi()}?name={Uri.EscapeDataString(ItemName)}&sortBy={key}&sortDirection={dir}";
        if (!string.IsNullOrEmpty(Table.SearchTerm))
            url += $"&searchTerm={Uri.EscapeDataString(Table.SearchTerm)}";
        return url;
    }
}
