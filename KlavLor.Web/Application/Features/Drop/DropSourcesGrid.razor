@using KlavLor.Application.Common
@using KlavLor.Application.Features.Drop

@* Tiles, not a table. The old ten-column grid carried Type, Rolls, an observed rate and the wiki
   rate; on an item page none of those is what you came for, and the rate columns implied a
   precision a handful of drops can't support. Four facts per source — name, drops, quantity, value
   — with the date range as a subtitle.

   Sorting stays server-side and is preserved by the search box, which hx-includes the hidden
   inputs below. Default is most-dropped first (GlobalDropHandler.DefaultSourceSort). *@
<div id="drop-sources-table">
    <input type="hidden" id="ds-sort" name="sortBy" value="@Table.SortBy" />
    <input type="hidden" id="ds-dir" name="sortDirection" value="@Table.SortDirection" />

    @if (Table.Rows.Count == 0)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-8 text-center text-sm text-slate-400 dark:text-white">
            No sources match.
        </div>
    }
    else
    {
        <div class="flex items-center gap-1.5 mb-2 flex-wrap text-[10px] uppercase tracking-wider text-slate-400 dark:text-white">
            <span class="mr-1">Sort</span>
            @foreach (var (label, key) in SortOptions)
            {
                <a hx-get="@SortUrl(key)" hx-target="#drop-sources-table" hx-swap="outerHTML"
                   class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full cursor-pointer transition-colors @(IsActive(key) ? "bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200")">
                    <span>@label</span>
                    <span class="text-[8px] leading-none">@Arrow(key)</span>
                </a>
            }
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-2">
            @foreach (var row in Table.Rows)
            {
                <DropSourceTile Row="row" />
            }
        </div>

        <div class="flex items-baseline justify-between gap-3 mt-2.5 px-1 text-xs text-slate-500 dark:text-white">
            <span>@Table.TotalSources.ToString("N0") source@(Table.TotalSources == 1 ? "" : "s")</span>
            <span class="tabular-nums">
                @Table.TotalDrops.ToString("N0") drops · @Table.TotalQuantity.ToString("N0") qty ·
                <span class="font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(Table.TotalValue)</span>
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public string ItemName { get; set; } = "";
    [Parameter] public required DropSourceTable Table { get; set; }

    // Only the four the tile actually shows. Type/rolls/rate are gone, so sorting by them would
    // reorder the grid on a value nothing on screen displays.
    private static readonly (string Label, string Key)[] SortOptions =
    {
        ("Quantity", "qty"), ("Drops", "drops"), ("Value", "value"), ("Recent", "last"), ("Name", "source")
    };

    private bool IsActive(string key) => string.Equals(Table.SortBy, key, StringComparison.OrdinalIgnoreCase);
    private string Arrow(string key) => !IsActive(key) ? "" : (Table.SortDirection == SortDirection.Ascending ? "▲" : "▼");

    private string SortUrl(string key)
    {
        // Toggle direction when re-clicking the active option; otherwise default to descending.
        var dir = IsActive(key) && Table.SortDirection == SortDirection.Descending ? "Ascending" : "Descending";
        var url = $"{AppRoutes.DropSources.FromApi()}?name={Uri.EscapeDataString(ItemName)}&sortBy={key}&sortDirection={dir}";
        if (!string.IsNullOrEmpty(Table.SearchTerm))
            url += $"&searchTerm={Uri.EscapeDataString(Table.SearchTerm)}";
        return url;
    }
}
