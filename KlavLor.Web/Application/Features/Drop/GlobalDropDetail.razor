@using KlavLor.Application.Common
@using KlavLor.Application.Features.Drop
@using KlavLor.Web.Application.Features.Source
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@($"KlavLor - {ItemName}")" Title="@ItemName" Description="Drop overview across all sources and players" />

<div class="space-y-6 pb-64">
    <a onclick="history.back()"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 dark:text-white dark:hover:text-amber-400 cursor-pointer transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
    </a>

    @if (Overview is null)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">No data for this item</h3>
            <p class="text-sm text-slate-500 dark:text-white">No tracked, visible characters have recorded &ldquo;@ItemName&rdquo; as a drop yet.</p>
        </div>
    }
    else
    {
        @* Summary strip. Eight facts on one line rather than a six-wide Stat grid with a second row
           under it — the old card was mostly whitespace and pushed the actual content below the
           fold. Wraps to two lines on narrow screens and no further. *@
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 px-4 py-3">
            <div class="flex items-center gap-3 flex-wrap">
                <div class="flex items-center gap-2 min-w-0 mr-1">
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(ItemName)" alt=""
                         class="w-7 h-7 shrink-0" loading="lazy" onerror="this.style.display='none'" />
                    <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100 truncate">@ItemName</h1>
                </div>

                <div class="flex items-center gap-x-4 gap-y-1 flex-wrap text-sm">
                    <Fact Label="drops" Value="@Overview.TotalDrops.ToString("N0")" />
                    <Fact Label="qty" Value="@Overview.TotalQuantity.ToString("N0")" />
                    <Fact Label="value" Value="@($"{GoldFormat.Format(Overview.TotalValue)} gp")" Accent="true" />
                    <Fact Label="sources" Value="@Overview.DistinctSources.ToString("N0")" />
                    <Fact Label="characters" Value="@Overview.DistinctCharacters.ToString("N0")" />
                    <Fact Label="players" Value="@Overview.DistinctPlayers.ToString("N0")" />
                    <span class="text-xs text-slate-400 dark:text-white whitespace-nowrap"
                          title="First and last time any visible character recorded this item">
                        @(Overview.FirstSeen?.ToString("d MMM yyyy") ?? "—") – @(Overview.LastSeen?.ToString("d MMM yyyy") ?? "—")
                    </span>
                </div>
            </div>
        </div>

        @* Panel order is by what an item page is actually for: who has it, when it arrived, the
           sessions it came from, and only then the full source breakdown.

           Staggered by 400ms down the page rather than all firing on load — four panels racing on
           one request would open four concurrent queries (the rule in CLAUDE.md). *@

        @* Characters (sortable + filterable). *@
        <div hx-get="@Url(AppRoutes.DropCharacters)" hx-trigger="load" hx-swap="outerHTML">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Characters</h2>
            <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <div class="h-40 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
        </div>

        @* Drops over time. *@
        <div hx-get="@Url(AppRoutes.DropTrend)" hx-trigger="load delay:400ms" hx-swap="outerHTML">
            <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <div class="h-32 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
        </div>

        @* Recent sessions (across all players) that dropped this item. *@
        <div hx-get="@Url(AppRoutes.DropSessions)" hx-trigger="load delay:800ms" hx-swap="outerHTML">
            <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <div class="h-40 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
        </div>

        @* Sources last: the reference breakdown, not the headline. *@
        <div hx-get="@Url(AppRoutes.DropSources)" hx-trigger="load delay:1200ms" hx-swap="outerHTML">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Sources</h2>
            <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <div class="h-40 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string ItemName { get; set; } = "";
    [Parameter] public GlobalDropOverview? Overview { get; set; }

    private string Url(string route) => $"{route.FromApi()}?name={Uri.EscapeDataString(ItemName)}";
}
