@using KlavLor.Application.Features.Source

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Recent collection logs</h2>

    @if (Events.Count == 0)
    {
        <p class="text-sm text-slate-400 dark:text-white">No collection-log items have been logged here yet.</p>
    }
    else
    {
        <div class="space-y-1">
            @foreach (var e in Events)
            {
                <div class="flex items-center gap-3 py-1.5 border-b border-slate-100 dark:border-slate-800/60 last:border-0">
                    <span class="px-1 py-0 text-[9px] font-semibold rounded-sm bg-cyan-700 text-white shrink-0">CLOG</span>
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(e.ItemName)" alt="@e.ItemName"
                         class="w-5 h-5 shrink-0" loading="lazy" onerror="this.style.display='none'" />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm text-slate-900 dark:text-slate-100 truncate">
                            <span class="font-medium">@e.ItemName</span>
                            <span class="text-slate-400 dark:text-white">by</span>
                            <a hx-get="@CharacterUrl(e.GameCharacterId).FromApi()"
                               hx-target="#hx-page-container"
                               hx-push-url="@CharacterUrl(e.GameCharacterId)"
                               hx-swap="innerHTML transition:true"
                               class="font-medium text-amber-600 dark:text-amber-400 hover:underline cursor-pointer">@e.CharacterName</a>
                        </p>
                    </div>
                    <div class="text-right shrink-0">
                        <div class="text-xs text-slate-500 dark:text-white">@e.OccurredAt.ToString("d MMM yyyy")</div>
                        @if (e.KillCount is > 0)
                        {
                            <div class="text-[10px] text-slate-400 dark:text-white">KC #@e.KillCount.Value.ToString("N0")</div>
                        }
                        else
                        {
                            <div class="text-[10px] text-slate-400 dark:text-white" title="Position in the kill log at this source (RuneLite didn't report an in-game kill count)">Kill #@e.KillOrdinal.ToString("N0")</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string SourceName { get; set; } = "";
    [Parameter] public List<SourceClogEvent> Events { get; set; } = [];

    private string CharacterUrl(int gameCharacterId) =>
        AppRoutes.LootLogSource.WithId(gameCharacterId) + "?name=" + Uri.EscapeDataString(SourceName);
}
