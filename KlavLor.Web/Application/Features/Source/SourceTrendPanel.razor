@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Source
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-baseline justify-between gap-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Activity</h2>
        <span class="text-xs text-slate-400 dark:text-slate-500">kills per month, by character</span>
    </div>

    @if (_bars.Count == 0 || _totalKills == 0)
    {
        <p class="text-sm text-slate-400 dark:text-slate-500">No activity recorded.</p>
    }
    else
    {
        <HistogramBars Bars="@_bars" FormatValue="@FormatCount" ChartHeightPx="240" />

        @if (_legend.Count > 0)
        {
            <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-[10px] text-slate-500 dark:text-slate-400">
                @foreach (var entry in _legend)
                {
                    <span class="inline-flex items-center gap-1.5">
                        <span class="inline-block w-2.5 h-2.5 rounded-sm @entry.FillClass"></span>
                        <span class="text-slate-600 dark:text-slate-300">@entry.Name</span>
                    </span>
                }
            </div>
        }

        <p class="text-xs text-slate-400 dark:text-slate-500 mt-3">@_totalKills.ToString("N0") kills over @_recentCount months · hover a segment for the character breakdown.</p>
    }
</div>

@code {
    [Parameter] public List<SourceTrendPoint> Points { get; set; } = [];

    // 10 distinguishable palette entries, listed literally so Tailwind's content
    // scanner emits the classes. Order: biggest overall contributor first.
    private static readonly string[] Palette =
    {
        "bg-amber-500 dark:bg-amber-400",
        "bg-emerald-500 dark:bg-emerald-400",
        "bg-cyan-500 dark:bg-cyan-400",
        "bg-violet-500 dark:bg-violet-400",
        "bg-rose-500 dark:bg-rose-400",
        "bg-blue-500 dark:bg-blue-400",
        "bg-orange-500 dark:bg-orange-400",
        "bg-pink-500 dark:bg-pink-400",
        "bg-teal-500 dark:bg-teal-400",
        "bg-lime-500 dark:bg-lime-400",
    };
    private const string OtherFill = "bg-slate-400 dark:bg-slate-600";

    private List<HistogramBars.Bar> _bars = [];
    private List<LegendEntry> _legend = [];
    private long _totalKills;
    private int _recentCount;

    private sealed record LegendEntry(string Name, string FillClass);

    protected override void OnParametersSet()
    {
        var recent = Points.Count > 12 ? Points.GetRange(Points.Count - 12, 12) : Points;
        _recentCount = recent.Count;
        _totalKills = recent.Sum(p => p.Kills);

        // Rank characters by total kills across the window so colours are stable; the
        // top-N get palette colours, everyone else folds into "Other" within each bar.
        var totals = new Dictionary<string, long>();
        foreach (var month in recent)
            foreach (var c in month.Characters)
            {
                totals.TryGetValue(c.CharacterName, out var existing);
                totals[c.CharacterName] = existing + c.Kills;
            }

        var top = totals
            .OrderByDescending(kv => kv.Value)
            .Take(Palette.Length)
            .Select((kv, i) => (kv.Key, Fill: Palette[i]))
            .ToList();

        var fillByName = top.ToDictionary(t => t.Key, t => t.Fill);
        _legend = top.Select(t => new LegendEntry(t.Key, t.Fill)).ToList();

        _bars = new List<HistogramBars.Bar>(recent.Count);
        int? lastYearLabelled = null;
        foreach (var (m, i) in recent.Select((m, i) => (m, i)))
        {
            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month);
            var label = (i == 0 || m.Month == 1 || lastYearLabelled != m.Year)
                ? $"{monthShort} '{(m.Year % 100):D2}"
                : monthShort;
            lastYearLabelled = m.Year;

            var named = new List<HistogramBars.BarSegment>();
            var outsiders = new List<HistogramBars.BarSegment>();
            long namedTotal = 0;
            foreach (var c in m.Characters.OrderByDescending(c => c.Kills))
            {
                // The character's collection-log unlocks that month become the tooltip's
                // detail list (item · KC). Real RuneLite KC shows as "KC #N"; otherwise we
                // fall back to the derived "Kill #N" ordinal, matching LootLogKillEntry.
                var clogItems = c.Clogs.Count > 0
                    ? c.Clogs.Select(cl => new HistogramBars.BarSegment(
                        Label: cl.ItemName,
                        Value: 0,
                        FillClass: "bg-cyan-500 dark:bg-cyan-400",
                        ItemName: cl.ItemName,
                        ValueText: cl.KillCount is > 0 ? $"KC #{cl.KillCount.Value:N0}" : $"Kill #{cl.KillOrdinal:N0}")).ToList()
                    : null;

                if (fillByName.TryGetValue(c.CharacterName, out var fill))
                {
                    named.Add(new HistogramBars.BarSegment(
                        Label: c.CharacterName,
                        Value: c.Kills,
                        FillClass: fill,
                        ItemName: c.CharacterName,
                        ValueText: $"{c.Kills:N0} kills",
                        OverflowItems: clogItems));
                    namedTotal += c.Kills;
                }
                else
                {
                    outsiders.Add(new HistogramBars.BarSegment(
                        Label: c.CharacterName,
                        Value: c.Kills,
                        FillClass: OtherFill,
                        ItemName: c.CharacterName,
                        ValueText: $"{c.Kills:N0} kills"));
                }
            }

            var other = Math.Max(0, m.Kills - namedTotal);
            if (other > 0)
            {
                named.Add(new HistogramBars.BarSegment(
                    Label: "Other",
                    Value: other,
                    FillClass: OtherFill,
                    ItemName: "Other",
                    SourceName: $"characters outside the top {Palette.Length}",
                    ValueText: $"{other:N0} kills",
                    OverflowItems: outsiders.Count > 0 ? outsiders : null));
            }

            _bars.Add(new HistogramBars.Bar(
                Label: label,
                Value: m.Kills,
                Tooltip: $"{monthShort} {m.Year} — {m.Kills:N0} kills · {GoldFormat.Format(m.Value)} gp",
                Segments: named.Count > 0 ? named : null));
        }
    }

    private static string FormatCount(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString("N0");
}
