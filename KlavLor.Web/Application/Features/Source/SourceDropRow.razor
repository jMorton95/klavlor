@using KlavLor.Application.Common
@using KlavLor.Application.Features.Source

<div class="flex items-center justify-between gap-2 text-sm bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2">
    <span class="inline-flex items-center gap-1.5 min-w-0">
        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Drop.ItemName)" alt="@Drop.ItemName"
             class="w-4 h-4 inline-block shrink-0" loading="lazy" onerror="this.style.display='none'" />
        <span class="truncate text-slate-700 dark:text-slate-100">@Drop.ItemName</span>
        @if (Drop.TotalQuantity > 1)
        {
            <span class="text-slate-400 dark:text-slate-500 shrink-0">×@Drop.TotalQuantity.ToString("N0")</span>
        }
    </span>
    <span class="flex items-center gap-2 shrink-0">
        @if (!string.IsNullOrEmpty(Drop.Rarity))
        {
            <span class="font-mono text-[10px] text-slate-500 dark:text-slate-400" title="Drop rate">@Drop.Rarity</span>
        }
        <span class="text-amber-600 dark:text-amber-400 font-medium whitespace-nowrap">@GoldFormat.Format(Drop.TotalValue)</span>
    </span>
</div>

@code {
    [Parameter] public required GlobalSourceDrop Drop { get; set; }
}
