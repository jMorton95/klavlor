@using KlavLor.Application.Features.Source

<div id="source-drops-results" class="space-y-1.5">
    @if (Drops.Count == 0)
    {
        <p class="text-sm text-slate-400 dark:text-slate-500 py-2">
            @(string.IsNullOrWhiteSpace(SearchTerm) ? "No drops recorded for this source." : "No items match your search.")
        </p>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-1.5">
            @foreach (var drop in Drops)
            {
                <SourceDropRow Drop="@drop" />
            }
        </div>
        @if (Drops.Count >= GlobalSourceHandler.DropSearchLimit)
        {
            <p class="text-xs text-slate-400 dark:text-slate-500 pt-1">Showing the top @GlobalSourceHandler.DropSearchLimit items — refine your search to narrow down.</p>
        }
    }
</div>

@code {
    [Parameter] public string SourceName { get; set; } = "";
    [Parameter] public List<GlobalSourceDrop> Drops { get; set; } = [];
    [Parameter] public string? SearchTerm { get; set; }
}
