@using KlavLor.Application.Features.Source

<div class="bg-slate-900 rounded-xl shadow-sm border border-slate-700 p-5">
    <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <h2 class="text-lg font-semibold text-slate-100">All drops</h2>
        <div class="relative w-full max-w-xs">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="search" name="searchTerm" value="@SearchTerm" placeholder="Find an item…"
                   autocomplete="off"
                   hx-get="@($"{AppRoutes.SourceItems.FromApi()}?name={Uri.EscapeDataString(SourceName)}")"
                   hx-trigger="keyup changed delay:300ms"
                   hx-target="#source-items-results"
                   hx-select="#source-items-results"
                   hx-swap="outerHTML"
                   class="w-full pl-9 pr-3 py-1.5 text-sm border border-slate-600 bg-slate-800 text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
        </div>
    </div>

    <div id="source-items-results">
        @if (Items.Count == 0)
        {
            <p class="text-sm text-white py-2">
                @(string.IsNullOrWhiteSpace(SearchTerm) ? "No drops recorded for this source." : "No items match your search.")
            </p>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1">
                @foreach (var item in Items)
                {
                    <div class="relative group flex items-center gap-2 text-sm py-1 border-b border-slate-800/60">
                        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.ItemName)" alt="@item.ItemName"
                             class="w-4 h-4 shrink-0" loading="lazy" onerror="this.style.display='none'" />
                        <span class="text-slate-100 truncate flex-1">@item.ItemName</span>
                        <span class="text-white tabular-nums shrink-0">@item.TotalDrops.ToString("N0")</span>

                        @* Per-character breakdown, revealed on hover. *@
                        <div class="hidden group-hover:block absolute z-30 right-0 top-full mt-1 w-56 max-h-64 overflow-y-auto bg-slate-800 border border-slate-600 rounded-lg shadow-lg p-2 space-y-0.5">
                            <p class="text-[10px] font-semibold uppercase tracking-wide text-white px-1 pb-1">By character</p>
                            @foreach (var c in item.Characters.Take(15))
                            {
                                <div class="flex items-center justify-between gap-2 text-xs px-1">
                                    <span class="text-slate-200 truncate">@c.CharacterName</span>
                                    <span class="text-white tabular-nums shrink-0">@c.Drops.ToString("N0")</span>
                                </div>
                            }
                            @if (item.Characters.Count > 15)
                            {
                                <p class="text-[10px] text-white px-1 pt-0.5">+ @(item.Characters.Count - 15) more</p>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Items.Count >= GlobalSourceHandler.ItemFrequencyLimit)
            {
                <p class="text-xs text-white pt-2">Showing the top @GlobalSourceHandler.ItemFrequencyLimit — refine your search to narrow down.</p>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string SourceName { get; set; } = "";
    [Parameter] public List<SourceItemFrequency> Items { get; set; } = [];
    [Parameter] public string? SearchTerm { get; set; }
}
