@using KlavLor.Application.Features.Source

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Collection log coverage</h2>
        @if (Coverage.Total > 0)
        {
            <span class="text-sm font-medium text-slate-600 dark:text-slate-300">@Coverage.Unlocked / @Coverage.Total</span>
        }
    </div>

    @if (Coverage.Total > 0)
    {
        var pct = (int)Math.Round(100.0 * Coverage.Unlocked / Coverage.Total);
        <div class="h-2 w-full rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
            <div class="h-full bg-linear-to-r from-amber-500 to-yellow-400" style="width:@pct%"></div>
        </div>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
            @pct% of this source's collection-log items have been obtained by at least one player.
        </p>
    }
    else
    {
        <p class="text-sm text-slate-400 dark:text-slate-500">No collection-log items are mapped to this source.</p>
    }
</div>

@code {
    [Parameter] public required GlobalSourceCoverage Coverage { get; set; }
}
