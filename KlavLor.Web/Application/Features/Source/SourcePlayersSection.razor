@using KlavLor.Application.Common
@using KlavLor.Application.Features.Source

<div>
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3">Players</h2>
    @if (Players.Count == 0)
    {
        <p class="text-sm text-slate-400 dark:text-white">No tracked players have killed this source yet.</p>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-3">
            @foreach (var (player, index) in Players.Select((p, i) => (p, i)))
            {
                @* Links to this player's own (character-scoped) view of the source. *@
                <a hx-get="@(AppRoutes.LootLogSource.WithId(player.GameCharacterId).FromApi() + "?name=" + Uri.EscapeDataString(SourceName))"
                   hx-target="#hx-page-container"
                   hx-push-url="@(AppRoutes.LootLogSource.WithId(player.GameCharacterId) + "?name=" + Uri.EscapeDataString(SourceName))"
                   hx-swap="innerHTML transition:true"
                   class="block bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 p-4 hover:shadow-md hover:border-amber-200 dark:hover:border-amber-700 transition-all duration-200 cursor-pointer">
                    <div class="flex items-center gap-2 mb-2 min-w-0">
                        <span class="text-xs font-semibold text-slate-400 dark:text-white shrink-0">#@(index + 1)</span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate">@player.CharacterName</p>
                            <p class="text-xs text-slate-400 dark:text-white truncate">@player.UserName</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-white">
                        <span>@player.TotalKills.ToString("N0") kills</span>
                        <span class="font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(player.TotalValue) gp</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string SourceName { get; set; } = "";
    [Parameter] public List<SourcePlayerRow> Players { get; set; } = [];
}
