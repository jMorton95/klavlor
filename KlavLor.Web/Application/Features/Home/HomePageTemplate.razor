@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using KlavLor.Application.Interfaces.Authentication
@using KlavLor.Web.Components.Layout

@inject ISessionStateManager SessionStateManager
@inject NavigationManager NavigationManager

<PageLayout PageTitle="KlavLor" Title="" Description="">
    <div id="home-redirect"></div>
    <script>
        (function() {
            var lastId = localStorage.getItem('lastViewedTemplate');
            if (lastId) {
                window.location.replace('/templates/' + lastId);
            } else {
                window.location.replace('/templates');
            }
        })();
    </script>
</PageLayout>

@code {
    protected override void OnInitialized()
    {
        var userId = SessionStateManager.GetUserSessionId();
        if (userId == null)
        {
            NavigationManager.NavigateTo(AppRoutes.Login);
        }
    }
}
