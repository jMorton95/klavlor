@using KlavLor.Web.Components.Layout

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Home" Title="Dashboard" Description="Your gear progression templates" />
}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
        <div class="flex items-center gap-4">
            <div class="p-3 bg-amber-50 dark:bg-amber-950 rounded-lg">
                <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"/>
                </svg>
            </div>
            <div>
                <p class="text-sm text-slate-500 dark:text-slate-400">My Templates</p>
                <p class="text-2xl font-bold text-slate-900 dark:text-slate-100">0</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool UpdateHeader { get; set; } = true;
}
