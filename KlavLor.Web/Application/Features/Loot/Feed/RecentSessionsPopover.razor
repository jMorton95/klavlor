@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Domain.Entities

@* Contents of the "Recent activity" popover next to the feed filter. Deliberately a dense list
   rather than cards: the point is to fit 48 hours of everyone's grinding into a panel that doesn't
   compete with the swimlanes for attention. Rendered into the popover by its own HTMX request the
   first time it's opened, so the feed page carries none of this cost unless it's asked for. *@

@* One column per character, side by side, separated by a vertical rule; a character's own sessions
   still stack downward inside their column. Columns beat a single tall list here because the
   characters are peers being compared, not one long feed — you can see who has been doing what
   without scrolling past everyone above them.

   Both axes scroll from one container: down when a character has a lot of sessions, across when
   there are more characters than fit. The height cap is viewport-relative so the panel can't run
   off the bottom of a short window. *@
<div class="max-h-[min(42rem,72vh)] overflow-auto themed-scrollbar -mx-1 px-1">
    @if (Panel.Characters.Count == 0)
    {
        <p class="text-xs text-slate-500 dark:text-white py-3 text-center">
            No sessions in the last @Panel.WindowHours hours.
        </p>
    }
    else
    {
        <div class="flex items-stretch divide-x divide-slate-200 dark:divide-slate-700">
            @foreach (var character in Panel.Characters)
            {
                @* flex-1 between a min and a max: a handful of characters spread out to fill the
                   panel with no dead space, while a crowd stops at the min width and overflows into
                   the horizontal scroll instead of being squeezed to nothing. *@
                <div class="flex-1 min-w-[13rem] max-w-[18rem] px-2.5 first:pl-0 last:pr-0">
                    <div class="flex items-baseline justify-between gap-2 mb-1">
                        <a hx-get="@AppRoutes.LootLogCharacter.WithId(character.CharacterId).FromApi()"
                           hx-target="#hx-page-container"
                           hx-push-url="@AppRoutes.LootLogCharacter.WithId(character.CharacterId)"
                           hx-swap="innerHTML transition:true"
                           class="text-xs font-semibold text-slate-800 dark:text-slate-100 hover:text-amber-600 dark:hover:text-amber-400 cursor-pointer truncate">
                            @character.CharacterName
                        </a>
                    </div>
                    <div class="text-[10px] text-slate-500 dark:text-white tabular-nums mb-1.5 truncate">
                        @character.TotalRolls.ToString("N0") rolls · @GoldFormat.Format(character.TotalGp)
                    </div>

                    <ul class="space-y-1">
                        @foreach (var session in character.Sessions)
                        {
                            <li class="border-l-2 @TierStyle.SessionAccentClass(session.BestTier) pl-2 py-0.5">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="inline-flex items-center gap-1.5 min-w-0">
                                        <img src="/api/images/source-icon?name=@Uri.EscapeDataString(session.SourceName)" alt=""
                                             class="w-4 h-4 shrink-0 object-contain rounded" loading="lazy"
                                             onerror="this.style.display='none'" />
                                        <span class="text-[11px] font-medium text-slate-700 dark:text-slate-100 truncate">@session.SourceName</span>
                                        @if (session.ClogCount > 0)
                                        {
                                            <span class="text-[9px] font-semibold px-1 rounded bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 shrink-0"
                                                  title="@($"{session.ClogCount} first-time collection log {(session.ClogCount == 1 ? "item" : "items")} this session")">
                                                @session.ClogCount clog@(session.ClogCount == 1 ? "" : "s")
                                            </span>
                                        }
                                    </span>
                                    <span class="text-[10px] tabular-nums text-slate-600 dark:text-slate-300 shrink-0">
                                        @session.Rolls.ToString("N0") @Noun(session)
                                    </span>
                                </div>
                                <div class="flex items-baseline justify-between gap-2 text-[10px] text-slate-500 dark:text-white">
                                    <span class="truncate">@RelativeTime(session.EndedAt)</span>
                                    <span class="tabular-nums text-amber-600 dark:text-amber-400 font-medium shrink-0">@GoldFormat.Format(session.Gp)</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</div>

<p class="mt-2 pt-2 border-t border-slate-200 dark:border-slate-700 text-[10px] text-slate-500 dark:text-white">
    Last @Panel.WindowHours hours.
    @if (Panel.FilteredOut > 0)
    {
        <span>@Panel.FilteredOut one-off @(Panel.FilteredOut == 1 ? "roll" : "rolls") hidden as incidental — a session needs @LootFeedGrouping.MinNotableSessionRolls rolls, @GoldFormat.Format(LootFeedGrouping.MinOneOffSessionValue) of loot, or a source with a collection log.</span>
    }
    else
    {
        <span>Incidental one-off rolls are hidden.</span>
    }
</p>

@code {
    [Parameter] public required RecentSessionsPanel Panel { get; set; }
    [Parameter] public LootFeedScope Scope { get; set; } = LootFeedScope.Main;

    // Pickpocketing gets its own word; everything else rolls a drop table. Singular matters here
    // because a single raid run is a case the panel deliberately keeps, so "1 rolls" would show often.
    private static string Noun(RecentSession session) => (session.SourceType, session.Rolls) switch
    {
        (LootSourceType.Pickpocket, 1) => "theft",
        (LootSourceType.Pickpocket, _) => "thefts",
        (_, 1) => "roll",
        _ => "rolls"
    };

    // Rendered server-side, so this is "how long ago as of this response". The panel is cached for
    // a minute and reopened on demand, so it never drifts far.
    private static string RelativeTime(DateTimeOffset at)
    {
        var delta = DateTimeOffset.UtcNow - at;
        if (delta < TimeSpan.FromMinutes(1)) return "just now";
        if (delta < TimeSpan.FromHours(1)) return $"{(int)delta.TotalMinutes}m ago";
        if (delta < TimeSpan.FromDays(1)) return $"{(int)delta.TotalHours}h ago";
        return $"{(int)delta.TotalDays}d ago";
    }
}
