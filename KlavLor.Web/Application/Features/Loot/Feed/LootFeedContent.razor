@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Components.Layout

@{
    var isLeagues = Scope == LootFeedScope.Leagues;
    var pageTitle = isLeagues ? "KlavLor - Leagues Feed" : "KlavLor - Loot Feed";
    var title = isLeagues ? "Leagues Feed" : "Loot Feed";
    var description = isLeagues
        ? "Real-time loot drops from leagues characters"
        : "Real-time loot drops from all users";
    var gridUrl = (isLeagues ? AppRoutes.LootFeedLeaguesGrid : AppRoutes.LootFeedGrid).FromApi();
    var sessionsUrl = TierStyle.SessionsRoute(Scope).FromApi();
}

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@pageTitle" Title="@title" Description="@description" />
}

<div class="flex justify-start items-center gap-2 mb-3">
    <div class="relative">
        <button onclick="toggleFeedFilter()"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
            Filter
        </button>
        <div id="feed-filter-panel" class="hidden absolute left-0 mt-1.5 w-48 bg-white dark:bg-slate-800 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-3 z-50">
            <p class="text-[10px] font-semibold text-slate-500 dark:text-white uppercase tracking-wide mb-2">Show Tiers</p>
            <label class="flex items-center gap-1.5 py-0.5 cursor-pointer">
                <input type="checkbox" value="standard" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                <span class="text-xs text-slate-700 dark:text-slate-200">Standard</span>
                <span class="text-[10px] text-slate-400">10K – 100K</span>
            </label>
            <label class="flex items-center gap-1.5 py-0.5 cursor-pointer">
                <input type="checkbox" value="uncommon" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                <span class="text-xs text-green-600 dark:text-green-400">Uncommon</span>
                <span class="text-[10px] text-slate-400">100K – 1M</span>
            </label>
            <label class="flex items-center gap-1.5 py-0.5 cursor-pointer">
                <input type="checkbox" value="rare" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                <span class="text-xs text-blue-600 dark:text-blue-400">Rare</span>
                <span class="text-[10px] text-slate-400">1M – 10M</span>
            </label>
            <label class="flex items-center gap-1.5 py-0.5 cursor-pointer">
                <input type="checkbox" value="epic" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                <span class="text-xs text-purple-600 dark:text-purple-400">Epic</span>
                <span class="text-[10px] text-slate-400">10M – 100M</span>
            </label>
            <label class="flex items-center gap-1.5 py-0.5 cursor-pointer">
                <input type="checkbox" value="legendary" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                <span class="text-xs text-amber-600 dark:text-amber-400">Legendary</span>
                <span class="text-[10px] text-slate-400">100M+</span>
            </label>
            <button onclick="saveFeedFilter()"
                    class="mt-2 w-full px-2.5 py-1 text-xs font-medium rounded-lg bg-amber-600 hover:bg-amber-700 text-white transition-colors">
                Save
            </button>
        </div>
    </div>

    @* Recent activity. The swimlanes only ever show drops that cleared a value floor, so a
       4,000-kill grind that paid out nothing is invisible there even though it was the day's real
       activity. This answers "what has everyone actually been doing" without taking any room from
       the feed itself — it's a popover, loaded only when opened (see toggleFeedSessions). *@
    <div class="relative">
        <button onclick="toggleFeedSessions()"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Recent activity
        </button>
        <div id="feed-sessions-panel"
             data-url="@sessionsUrl"
             class="hidden absolute left-0 mt-1.5 w-[22rem] max-w-[calc(100vw-2rem)] bg-white dark:bg-slate-800 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-3 z-50">
            <p class="text-[10px] font-semibold text-slate-500 dark:text-white uppercase tracking-wide mb-2">Sessions — last 48 hours</p>
            <div id="feed-sessions-body">
                <div class="flex items-center justify-center py-6">
                    <svg class="w-5 h-5 animate-spin text-amber-500 dark:text-amber-400" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

@* The swimlanes load AFTER first paint. This component renders no loot at all, so the page
   shell is served without a single DB round-trip; hx-trigger="load" then fetches the grid,
   which carries both halves of the feed's behaviour together:
     - backfill: the grid endpoint renders the recent entries per tier, and
     - live: the same markup carries sse-connect per column, so htmx opens the EventSources
       as it processes the swapped-in nodes.
   Both therefore survive the move, and there is no new gap between reading history and
   subscribing — the two still happen in one response, as they did when this was server-rendered.

   data-grid-url tells the filter JS which grid endpoint to refresh against — the same site.js
   handles both /loot/feed and /loot/feed/leagues this way. The saved tier filter is appended by
   site.js's htmx:configRequest hook, which matches any /api/loot/feed/**/grid request, so this
   initial fetch already honours the user's filter and needs no follow-up request. *@
<div id="feed-grid-container"
     data-grid-url="@gridUrl"
     hx-get="@gridUrl"
     hx-trigger="load"
     hx-swap="innerHTML">
    @* No skeleton here on purpose. The grid request below is DB-free and returns in a few
       milliseconds with one shell per lane, and each shell carries its own skeleton — so painting
       a second set here just made the feed flash one skeleton, then five. *@

</div>

<div id="feed-no-tiers" class="hidden">
    <div class="flex items-center justify-center py-12">
        <p class="text-xs text-slate-400 dark:text-white">No tiers selected. Use the filter to show loot tiers.</p>
    </div>
</div>

@code {
    // Deliberately takes no loot: this component must never trigger a query. It carries only
    // what the shell needs, which is why the page can render before any DB work happens.
    [Parameter] public LootFeedScope Scope { get; set; } = LootFeedScope.Main;
    [Parameter] public bool UpdateHeader { get; set; } = true;

    // The full five lanes; the skeleton can't know the user's saved filter (it lives in
    // localStorage), and guessing narrower would make the columns jump when the grid lands.
    private const int SkeletonColumns = 5;
}
