@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Repositories
@using KlavLor.Application.Interfaces.Services

@* Swimlane SHELLS only — this component touches no loot and issues no query.

   Each lane then fetches itself from its own per-tier endpoint (LootFeedColumn), so one slow or
   heavy tier can't hold up the rest and no single request carries the whole grid. This shell
   response exists purely to decide WHICH lanes to render, because the active-tier filter lives in
   the browser's localStorage and is sent up as ?tiers=... by site.js's htmx:configRequest hook. *@

@{
    var activeTiers = ActiveTiers ?? ILootFeedService.AllTiers;
    var containerClass = FeedColumnLayout.ContainerClass(activeTiers.Count);
    var colClass = FeedColumnLayout.ColumnClass(activeTiers.Count);
}

@* The character filter's options, swapped OUT-OF-BAND into the toolbar placeholder.

   They ride on this response rather than fetching themselves because this is the one request that
   already fires on page load — so the filter is usable on first paint with no extra round trip, and
   the PAGE route stays query-free, which is the rule that keeps the shell painting in ~15ms.

   site.js restores the saved selection once this lands; rendering `selected` here instead would
   mean the server had to know a preference that lives in the browser. *@
<select id="feed-character-filter" hx-swap-oob="outerHTML"
        onchange="saveFeedCharacter(this.value)"
        class="px-2 py-1 text-xs font-medium rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors cursor-pointer">
    <option value="">All characters</option>
    @foreach (var c in Characters)
    {
        <option value="@c.Id">@c.Name</option>
    }
</select>

<div class="@containerClass">
    @foreach (var tier in activeTiers)
    {
        <div class="@colClass"
             hx-get="@(TierStyle.ColumnRoute(tier, Scope).FromApi() + "?cols=" + activeTiers.Count)"
             hx-trigger="load"
             hx-swap="outerHTML">
            @* Header placeholder only. There were previously four card-shaped blocks here too,
               which read as a second translucent layer sitting on the bordered outlines and, worse,
               reserved a height that never matched the real cards — so the layout jumped when a lane
               landed. A single bar is enough to show the lane is loading. *@
            <div class="h-4 w-24 mb-2 rounded bg-slate-200 dark:bg-slate-800 animate-pulse"></div>
        </div>
    }
</div>

<script>
    (() => {
        // Empty state removal when items arrive via SSE. Runs on every grid/column swap; columns
        // may not exist yet when this executes, so it retries as lanes land.
        const wire = () => {
            for (const col of ['standard', 'uncommon', 'rare', 'epic', 'legendary']) {
                const container = document.getElementById(`feed-col-${col}`);
                if (!container || container.dataset.emptyWatch) continue;
                container.dataset.emptyWatch = '1';

                const observer = new MutationObserver(() => {
                    const empty = container.querySelector('.feed-empty-state');
                    if (empty && container.children.length > 1) empty.remove();
                });
                observer.observe(container, { childList: true });
            }
        };
        wire();
        document.body.addEventListener('htmx:afterSettle', wire);

        // Live-update relative timestamps every 30 seconds. Guarded so repeated grid swaps don't
        // stack up duplicate intervals.
        if (!window.__lootTimestampTicker) {
            window.__lootTimestampTicker = setInterval(() => {
                for (const el of document.querySelectorAll('.loot-timestamp')) {
                    const dt = el.getAttribute('datetime');
                    if (!dt) continue;
                    const diff = (Date.now() - new Date(dt).getTime()) / 1000;
                    if (diff < 60) el.textContent = 'just now';
                    else if (diff < 3600) el.textContent = Math.floor(diff / 60) + 'm ago';
                    else if (diff < 86400) el.textContent = Math.floor(diff / 3600) + 'h ago';
                    else {
                        const d = new Date(dt);
                        const mon = d.toLocaleString('en', { month: 'short' });
                        const day = String(d.getDate()).padStart(2, '0');
                        const time = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
                        const year = d.getFullYear() !== new Date().getFullYear() ? ` ${d.getFullYear()}` : '';
                        el.textContent = `${mon} ${day}${year}, ${time}`;
                    }
                }
            }, 30000);
        }
    })();
</script>

@code {
    [Parameter] public IReadOnlyList<LootFeedTier>? ActiveTiers { get; set; }
    [Parameter] public LootFeedScope Scope { get; set; } = LootFeedScope.Main;
    [Parameter] public List<FeedCharacterOption> Characters { get; set; } = [];
}
