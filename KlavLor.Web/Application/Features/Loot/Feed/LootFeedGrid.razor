@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Components.Layout

@{
    var isLeagues = Scope == LootFeedScope.Leagues;
    var headerTitle = isLeagues ? "Leagues Feed" : "Loot Feed";
    var headerPageTitle = isLeagues ? "KlavLor - Leagues Feed" : "KlavLor - Loot Feed";
    var headerDescription = isLeagues
        ? "Real-time loot drops from leagues characters"
        : "Real-time loot drops from all users";

    // SSE stream URLs differ per scope; everything else (columns, styling, JS) is identical.
    var streamStandard   = (isLeagues ? AppRoutes.LootFeedLeaguesStreamStandard   : AppRoutes.LootFeedStreamStandard).FromApi();
    var streamUncommon   = (isLeagues ? AppRoutes.LootFeedLeaguesStreamUncommon   : AppRoutes.LootFeedStreamUncommon).FromApi();
    var streamRare       = (isLeagues ? AppRoutes.LootFeedLeaguesStreamRare       : AppRoutes.LootFeedStreamRare).FromApi();
    var streamEpic       = (isLeagues ? AppRoutes.LootFeedLeaguesStreamEpic       : AppRoutes.LootFeedStreamEpic).FromApi();
    var streamLegendary  = (isLeagues ? AppRoutes.LootFeedLeaguesStreamLegendary  : AppRoutes.LootFeedStreamLegendary).FromApi();
}

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@headerPageTitle" Title="@headerTitle" Description="@headerDescription" />
}

@{
    var activeTiers = ActiveTiers ?? ILootFeedService.AllTiers;
    var colCount = activeTiers.Count;

    var containerClass = FeedColumnLayout.ContainerClass(colCount);
    var colClass = FeedColumnLayout.ColumnClass(colCount);
}

<div class="@containerClass">
    @if (activeTiers.Contains(LootFeedTier.Standard))
    {
        <div class="@colClass">
            <h2 class="text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2 px-0.5">
                Standard
                <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">10K – 100K</span>
            </h2>
            <div id="feed-col-standard"
                 hx-ext="sse"
                 sse-connect="@streamStandard"
                 sse-swap="message"
                 hx-swap="afterbegin"
                 hx-on::after-settle="if(this.children.length > 50) { while(this.children.length > 50) this.removeChild(this.lastElementChild); }"
                 class="space-y-2">
                @if (StandardEntries is not null && StandardEntries.Count > 0)
                {
                    @foreach (var entry in StandardEntries)
                    {
                        <LootFeedItem Entry="@entry" />
                    }
                }
                else
                {
                    <div class="feed-empty-state bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 p-5 text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400">No standard drops yet.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeTiers.Contains(LootFeedTier.Uncommon))
    {
        <div class="@colClass">
            <h2 class="text-xs font-semibold text-green-600 dark:text-green-400 mb-2 px-0.5">
                Uncommon
                <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">100K – 1M</span>
            </h2>
            <div id="feed-col-uncommon"
                 hx-ext="sse"
                 sse-connect="@streamUncommon"
                 sse-swap="message"
                 hx-swap="afterbegin"
                 hx-on::after-settle="if(this.children.length > 50) { while(this.children.length > 50) this.removeChild(this.lastElementChild); }"
                 class="space-y-2">
                @if (UncommonEntries is not null && UncommonEntries.Count > 0)
                {
                    @foreach (var entry in UncommonEntries)
                    {
                        <LootFeedItem Entry="@entry" />
                    }
                }
                else
                {
                    <div class="feed-empty-state bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-green-200 dark:border-green-900 p-5 text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400">No uncommon drops yet.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeTiers.Contains(LootFeedTier.Rare))
    {
        <div class="@colClass">
            <h2 class="text-xs font-semibold text-blue-600 dark:text-blue-400 mb-2 px-0.5">
                Rare
                <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">1M – 10M</span>
            </h2>
            <div id="feed-col-rare"
                 hx-ext="sse"
                 sse-connect="@streamRare"
                 sse-swap="message"
                 hx-swap="afterbegin"
                 hx-on::after-settle="if(this.children.length > 50) { while(this.children.length > 50) this.removeChild(this.lastElementChild); }"
                 class="space-y-2">
                @if (RareEntries is not null && RareEntries.Count > 0)
                {
                    @foreach (var entry in RareEntries)
                    {
                        <LootFeedItem Entry="@entry" />
                    }
                }
                else
                {
                    <div class="feed-empty-state bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-blue-200 dark:border-blue-900 p-5 text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400">No rare drops yet.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeTiers.Contains(LootFeedTier.Epic))
    {
        <div class="@colClass">
            <h2 class="text-xs font-semibold text-purple-600 dark:text-purple-400 mb-2 px-0.5">
                Epic
                <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">10M – 100M</span>
            </h2>
            <div id="feed-col-epic"
                 hx-ext="sse"
                 sse-connect="@streamEpic"
                 sse-swap="message"
                 hx-swap="afterbegin"
                 hx-on::after-settle="if(this.children.length > 50) { while(this.children.length > 50) this.removeChild(this.lastElementChild); }"
                 class="space-y-2">
                @if (EpicEntries is not null && EpicEntries.Count > 0)
                {
                    @foreach (var entry in EpicEntries)
                    {
                        <LootFeedItem Entry="@entry" />
                    }
                }
                else
                {
                    <div class="feed-empty-state bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-purple-200 dark:border-purple-900 p-5 text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400">No epic drops yet.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeTiers.Contains(LootFeedTier.Legendary))
    {
        <div class="@colClass">
            <h2 class="text-xs font-semibold text-amber-600 dark:text-amber-400 mb-2 px-0.5">
                Legendary
                <span class="text-[10px] font-normal text-slate-400 dark:text-slate-500">100M+</span>
            </h2>
            <div id="feed-col-legendary"
                 hx-ext="sse"
                 sse-connect="@streamLegendary"
                 sse-swap="message"
                 hx-swap="afterbegin"
                 hx-on::after-settle="if(this.children.length > 50) { while(this.children.length > 50) this.removeChild(this.lastElementChild); }"
                 class="space-y-2">
                @if (LegendaryEntries is not null && LegendaryEntries.Count > 0)
                {
                    @foreach (var entry in LegendaryEntries)
                    {
                        <LootFeedItem Entry="@entry" />
                    }
                }
                else
                {
                    <div class="feed-empty-state bg-slate-50 dark:bg-slate-900 rounded-lg shadow-sm border border-amber-200 dark:border-amber-900 p-5 text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400">No legendary drops yet.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    (() => {
        // Empty state removal when items arrive via SSE
        for (const col of ['standard', 'uncommon', 'rare', 'epic', 'legendary']) {
            const container = document.getElementById(`feed-col-${col}`);
            if (!container) continue;

            const observer = new MutationObserver(() => {
                const empty = container.querySelector('.feed-empty-state');
                if (empty && container.children.length > 1) empty.remove();
            });
            observer.observe(container, { childList: true });
        }

        // Live-update relative timestamps every 30 seconds
        setInterval(() => {
            for (const el of document.querySelectorAll('.loot-timestamp')) {
                const dt = el.getAttribute('datetime');
                if (!dt) continue;
                const diff = (Date.now() - new Date(dt).getTime()) / 1000;
                if (diff < 60) el.textContent = 'just now';
                else if (diff < 3600) el.textContent = Math.floor(diff / 60) + 'm ago';
                else if (diff < 86400) el.textContent = Math.floor(diff / 3600) + 'h ago';
                else {
                    const d = new Date(dt);
                    const mon = d.toLocaleString('en', { month: 'short' });
                    const day = String(d.getDate()).padStart(2, '0');
                    const time = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
                    const year = d.getFullYear() !== new Date().getFullYear() ? ` ${d.getFullYear()}` : '';
                    el.textContent = `${mon} ${day}${year}, ${time}`;
                }
            }
        }, 30000);
    })();
</script>

@code {
    [Parameter] public IReadOnlyList<LootFeedEntry>? StandardEntries { get; set; }
    [Parameter] public IReadOnlyList<LootFeedEntry>? UncommonEntries { get; set; }
    [Parameter] public IReadOnlyList<LootFeedEntry>? RareEntries { get; set; }
    [Parameter] public IReadOnlyList<LootFeedEntry>? EpicEntries { get; set; }
    [Parameter] public IReadOnlyList<LootFeedEntry>? LegendaryEntries { get; set; }
    [Parameter] public IReadOnlyList<LootFeedTier>? ActiveTiers { get; set; }
    [Parameter] public LootFeedScope Scope { get; set; } = LootFeedScope.Main;
    [Parameter] public bool UpdateHeader { get; set; } = true;
}
