@page "/loot/feed"
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Repositories
@using KlavLor.Web.Components.Layout

@inject ILootLogRepository LootLogRepository

<PageLayout PageTitle="KlavLor - Loot Feed" Title="Loot Feed" Description="Real-time loot drops from all users">
    <LootFeedGrid StandardEntries="@_standard"
                  NotableEntries="@_notable"
                  EpicEntries="@_epic"
                  LegendaryEntries="@_legendary"
                  UpdateHeader="false" />
</PageLayout>

@code {
    private IReadOnlyList<LootFeedEntry> _standard = [];
    private IReadOnlyList<LootFeedEntry> _notable = [];
    private IReadOnlyList<LootFeedEntry> _epic = [];
    private IReadOnlyList<LootFeedEntry> _legendary = [];

    protected override async Task OnInitializedAsync()
    {
        _standard = await LootLogRepository.GetRecentFeedEntries(50, 10_000, 100_000);
        _notable = await LootLogRepository.GetRecentFeedEntries(50, 100_000, 1_000_000);
        _epic = await LootLogRepository.GetRecentFeedEntries(50, 1_000_000, 10_000_000);
        _legendary = await LootLogRepository.GetRecentFeedEntries(50, 10_000_000);
    }
}
