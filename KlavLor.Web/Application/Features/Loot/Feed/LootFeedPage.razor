@page "/loot/feed"
@using KlavLor.Web.Components.Layout

@* Routable shell for direct browser navigation / refresh. No handler, no OnInitializedAsync and
   no DB work: LootFeedContent renders skeleton swimlanes and fetches the grid itself once the
   page has loaded, so first paint never waits on a query. That grid response carries the backfill
   entries and the SSE subscriptions together. *@
<PageLayout PageTitle="KlavLor - Loot Feed" Title="Loot Feed" Description="Real-time loot drops from all users">
    <LootFeedContent UpdateHeader="false" />
</PageLayout>
