@page "/loot/feed"
@using KlavLor.Web.Components.Layout

<PageLayout PageTitle="KlavLor - Loot Feed" Title="Loot Feed" Description="Real-time loot drops from all users">
    <div class="flex justify-start mb-4">
        <div class="relative">
            <button onclick="toggleFeedFilter()"
                    class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
                Filter
            </button>
            <div id="feed-filter-panel" class="hidden absolute left-0 mt-2 w-56 bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-4 z-50">
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-3">Show Tiers</p>
                <label class="flex items-center gap-2 py-1 cursor-pointer">
                    <input type="checkbox" value="standard" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-slate-700 dark:text-slate-200">Standard</span>
                    <span class="text-xs text-slate-400">10K – 100K</span>
                </label>
                <label class="flex items-center gap-2 py-1 cursor-pointer">
                    <input type="checkbox" value="uncommon" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-green-600 dark:text-green-400">Uncommon</span>
                    <span class="text-xs text-slate-400">100K – 1M</span>
                </label>
                <label class="flex items-center gap-2 py-1 cursor-pointer">
                    <input type="checkbox" value="rare" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-blue-600 dark:text-blue-400">Rare</span>
                    <span class="text-xs text-slate-400">1M – 10M</span>
                </label>
                <label class="flex items-center gap-2 py-1 cursor-pointer">
                    <input type="checkbox" value="epic" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-purple-600 dark:text-purple-400">Epic</span>
                    <span class="text-xs text-slate-400">10M – 100M</span>
                </label>
                <label class="flex items-center gap-2 py-1 cursor-pointer">
                    <input type="checkbox" value="legendary" class="feed-filter-checkbox rounded border-slate-300 dark:border-slate-600" />
                    <span class="text-sm text-amber-600 dark:text-amber-400">Legendary</span>
                    <span class="text-xs text-slate-400">100M+</span>
                </label>
                <button onclick="saveFeedFilter()"
                        class="mt-3 w-full px-3 py-1.5 text-sm font-medium rounded-lg bg-amber-600 hover:bg-amber-700 text-white transition-colors">
                    Save
                </button>
            </div>
        </div>
    </div>

    <div id="feed-grid-container"
         hx-get="@AppRoutes.LootFeed.FromApi()"
         hx-trigger="load"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="flex items-center justify-center py-12">
            <p class="text-sm text-slate-400 dark:text-slate-500">Loading feed...</p>
        </div>
    </div>

    <div id="feed-no-tiers" class="hidden">
        <div class="flex items-center justify-center py-12">
            <p class="text-sm text-slate-400 dark:text-slate-500">No tiers selected. Use the filter to show loot tiers.</p>
        </div>
    </div>
</PageLayout>

<script>
    (() => {
        const ALL_TIERS = ['standard', 'uncommon', 'rare', 'epic', 'legendary'];
        const STORAGE_KEY = 'lootFeedFilter';

        function getActiveTiers() {
            try {
                const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
                if (Array.isArray(saved) && saved.length > 0) return saved;
            } catch {}
            return ALL_TIERS;
        }

        // Initialize checkbox state from localStorage
        const active = getActiveTiers();
        for (const cb of document.querySelectorAll('.feed-filter-checkbox')) {
            cb.checked = active.includes(cb.value);
        }

        // Inject tiers param into HTMX requests for the feed API
        document.body.addEventListener('htmx:configRequest', function(evt) {
            if (evt.detail.path && evt.detail.path.includes('/api/loot/feed') && !evt.detail.path.includes('/stream/')) {
                const tiers = getActiveTiers();
                evt.detail.parameters['tiers'] = tiers.join(',');
            }
        });

        // Handle "no tiers selected" state
        document.body.addEventListener('htmx:beforeRequest', function(evt) {
            if (evt.detail.pathInfo && evt.detail.pathInfo.requestPath && evt.detail.pathInfo.requestPath.includes('/api/loot/feed')) {
                const tiers = getActiveTiers();
                if (tiers.length === 0) {
                    evt.preventDefault();
                    document.getElementById('feed-grid-container').innerHTML = '';
                    document.getElementById('feed-no-tiers').classList.remove('hidden');
                }
            }
        });

        window.toggleFeedFilter = function() {
            document.getElementById('feed-filter-panel').classList.toggle('hidden');
        };

        window.saveFeedFilter = function() {
            const checked = Array.from(document.querySelectorAll('.feed-filter-checkbox:checked')).map(cb => cb.value);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(checked));
            document.getElementById('feed-filter-panel').classList.add('hidden');
            document.getElementById('feed-no-tiers').classList.add('hidden');

            if (checked.length === 0) {
                document.getElementById('feed-grid-container').innerHTML = '';
                document.getElementById('feed-no-tiers').classList.remove('hidden');
                return;
            }

            htmx.ajax('GET', '@AppRoutes.LootFeed.FromApi()' + '?tiers=' + checked.join(','), {
                target: '#feed-grid-container',
                swap: 'innerHTML'
            });
        };

        // Close filter panel when clicking outside
        document.addEventListener('click', function(e) {
            const panel = document.getElementById('feed-filter-panel');
            if (!panel) return;
            if (!panel.classList.contains('hidden') && !e.target.closest('#feed-filter-panel') && !e.target.closest('[onclick="toggleFeedFilter()"]')) {
                panel.classList.add('hidden');
            }
        });
    })();
</script>
