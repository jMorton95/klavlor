@page "/loot/feed"
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Repositories
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Components.Layout

@inject ILootLogRepository LootLogRepository

<PageLayout PageTitle="KlavLor - Loot Feed" Title="Loot Feed" Description="Real-time loot drops from all users">
    <LootFeedContent StandardEntries="@_standard"
                     UncommonEntries="@_uncommon"
                     RareEntries="@_rare"
                     EpicEntries="@_epic"
                     LegendaryEntries="@_legendary"
                     UpdateHeader="false" />
</PageLayout>

@code {
    private IReadOnlyList<LootFeedEntry> _standard = [];
    private IReadOnlyList<LootFeedEntry> _uncommon = [];
    private IReadOnlyList<LootFeedEntry> _rare = [];
    private IReadOnlyList<LootFeedEntry> _epic = [];
    private IReadOnlyList<LootFeedEntry> _legendary = [];

    protected override async Task OnInitializedAsync()
    {
        var tiers = await LootLogRepository.GetAllFeedTiers(50);
        _standard = LootFeedGrouping.CollapseAdjacent(tiers[LootFeedTier.Standard]);
        _uncommon = LootFeedGrouping.CollapseAdjacent(tiers[LootFeedTier.Uncommon]);
        _rare = LootFeedGrouping.CollapseAdjacent(tiers[LootFeedTier.Rare]);
        _epic = LootFeedGrouping.CollapseAdjacent(tiers[LootFeedTier.Epic]);
        _legendary = LootFeedGrouping.CollapseAdjacent(tiers[LootFeedTier.Legendary]);
    }
}
