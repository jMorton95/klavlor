@page "/loot/feed"
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Components.Layout

@inject ILootFeedService FeedService

<PageLayout PageTitle="KlavLor - Loot Feed" Title="Loot Feed" Description="Real-time loot drops from all users">
    <LootFeedGrid StandardEntries="@_standard"
                  NotableEntries="@_notable"
                  EpicEntries="@_epic"
                  LegendaryEntries="@_legendary"
                  UpdateHeader="false" />
</PageLayout>

@code {
    private IReadOnlyList<LootFeedEntry> _standard = [];
    private IReadOnlyList<LootFeedEntry> _notable = [];
    private IReadOnlyList<LootFeedEntry> _epic = [];
    private IReadOnlyList<LootFeedEntry> _legendary = [];

    protected override void OnInitialized()
    {
        _standard = FeedService.GetCurrentEntries(LootFeedTier.Standard);
        _notable = FeedService.GetCurrentEntries(LootFeedTier.Notable);
        _epic = FeedService.GetCurrentEntries(LootFeedTier.Epic);
        _legendary = FeedService.GetCurrentEntries(LootFeedTier.Legendary);
    }
}
