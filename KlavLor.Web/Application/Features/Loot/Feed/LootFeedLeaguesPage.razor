@page "/loot/feed/leagues"
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Web.Application
@using KlavLor.Web.Components.Layout

@inject ISystemSettingsCache SystemSettingsCache
@inject NavigationManager NavigationManager

@* Same lazy shell as the main feed — see LootFeedPage. Reads only the singleton settings cache,
   never the DB, so the leagues feed also paints before any query runs. *@
@if (SystemSettingsCache.IsLeaguesEnabled)
{
    <PageLayout PageTitle="KlavLor - Leagues Feed" Title="Leagues Feed" Description="Real-time loot drops from leagues characters">
        <LootFeedContent Scope="LootFeedScope.Leagues" UpdateHeader="false" />
    </PageLayout>
}

@code {
    protected override void OnInitialized()
    {
        if (!SystemSettingsCache.IsLeaguesEnabled)
            NavigationManager.NavigateTo(AppRoutes.LootFeed, replace: true);
    }
}
