@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services

@inject ILootFeedHighlightTracker HighlightTracker

@{
    var rootAttrs = new Dictionary<string, object>();
    if (IsMerge)
        rootAttrs["hx-swap-oob"] = "outerHTML";

    // Any single drop (Qty × Price) crossing 250M lights the whole card with
    // the legendary electric effect.
    var entryHasLegendaryDrop = Entry.Drops.Any(d => (long)d.Quantity * d.Price >= 250_000_000);
    var legendaryCardClass = entryHasLegendaryDrop ? "legendary-card" : "";

    // Admin-injected untradeable "giga" drops (Infernal Cape, Quiver) light the card with a
    // distinct, differently-coloured spinning electric effect regardless of value.
    var entryHasSpecial = Entry.Drops.Any(d => d.IsSpecial);
    var gigaCardClass = entryHasSpecial ? "giga-card" : "";

    var isHighlight = HighlightTracker.IsHighlight(Entry);
    var highlightLabel = isHighlight ? HighlightTracker.LabelFor(Entry.Tier, Entry.OccurredAt) : null;
    var highlightCardClass = isHighlight ? GetHighlightRingClasses(Entry.Tier) : "";

    // Hover popover only makes sense when the card is tied to a known character —
    // anonymous/historical cards (no GameCharacterId) have nothing to summarise.
    var popoverUrl = Entry.GameCharacterId is not null
        ? AppRoutes.LootFeedSourcePopover.WithId(Entry.GameCharacterId.Value).FromApi()
            + "?name=" + Uri.EscapeDataString(Entry.SourceName)
        : null;
    if (popoverUrl is not null)
    {
        rootAttrs["hx-get"] = popoverUrl;
        // `once` keeps the request to a single fetch per card lifetime; the cached
        // result on the server keeps repeated hovers across cards cheap too. The
        // 500ms delay matches the CSS show-delay on the popover container below, so
        // a passing cursor doesn't trigger either the fetch or the visible reveal.
        rootAttrs["hx-trigger"] = "mouseenter delay:500ms once";
        // Relative `find` selector so multi-tier kills (one DomId appearing on
        // Standard *and* Legendary, say a CoX Twisted-Bow drop) inject into the
        // hovered card's own popover instead of the first matching duplicate id.
        rootAttrs["hx-target"] = "find [data-source-popover]";
        rootAttrs["hx-swap"] = "innerHTML";
    }
}
<div id="@Entry.DomId"
     @attributes="rootAttrs"
     class="group relative hover:z-40 @(Animate ? "loot-feed-new " : "")bg-slate-50 dark:bg-slate-900 rounded-lg shadow border @GetValueTierClasses() p-2.5 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-amber-200 dark:hover:border-amber-700 transition-all duration-200 @legendaryCardClass @gigaCardClass @highlightCardClass">
    @if (isHighlight)
    {
        <span class="absolute -top-2 -right-1 inline-flex items-center justify-center w-5 h-5 rounded-full bg-linear-to-r from-amber-500 to-yellow-400 text-amber-950 shadow ring-1 ring-amber-300/80 select-none"
              title="@highlightLabel"
              aria-label="@highlightLabel">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 4V2h10v2h4v3c0 2.76-2.24 5-5 5h-.21A6.99 6.99 0 0 1 13 14.92V18h3v3H8v-3h3v-3.08A6.99 6.99 0 0 1 7.21 12H7c-2.76 0-5-2.24-5-5V4h5zm0 2H4v1c0 1.65 1.35 3 3 3V6zm10 4c1.65 0 3-1.35 3-3V6h-3v4z"/>
            </svg>
        </span>
    }
    @{
        var sourceQuery = "?name=" + Uri.EscapeDataString(Entry.SourceName);
        var sourceApi = Entry.GameCharacterId is not null
            ? AppRoutes.LootLogSource.WithId(Entry.GameCharacterId.Value).FromApi() + sourceQuery
            : "#";
        var sourceUrl = Entry.GameCharacterId is not null
            ? AppRoutes.LootLogSource.WithId(Entry.GameCharacterId.Value) + sourceQuery
            : "#";
        var kcLabel = FormatKillCount(Entry.MinKillCount, Entry.MaxKillCount)
                      ?? FormatKillOrdinal(Entry.MinKillOrdinal, Entry.MaxKillOrdinal);
        var sessionKills = SessionKillCount();
    }
    <div class="mb-1.5 min-w-0">
        @* Row 1: "{user} rolled {icon} {source}" — source flexes into all remaining width *@
        <div class="flex items-center gap-1 min-w-0">
            @if (Entry.GameCharacterId is not null)
            {
                <a hx-get="@AppRoutes.LootLogCharacter.WithId(Entry.GameCharacterId.Value).FromApi()"
                   hx-target="#hx-page-container"
                   hx-push-url="@AppRoutes.LootLogCharacter.WithId(Entry.GameCharacterId.Value)"
                   hx-swap="innerHTML transition:true"
                   class="text-xs font-semibold text-slate-900 dark:text-slate-100 hover:underline cursor-pointer truncate shrink-0 max-w-[40%]">@(Entry.CharacterName ?? Entry.UserName)</a>
            }
            else
            {
                <span class="text-xs font-semibold text-slate-900 dark:text-slate-100 truncate shrink-0 max-w-[40%]">@Entry.UserName</span>
            }
            <span class="text-[10px] text-slate-500 dark:text-white shrink-0">@(Entry.SourceType switch { KlavLor.Domain.Entities.LootSourceType.Event => "rolled", KlavLor.Domain.Entities.LootSourceType.Pickpocket => "pickpocketed", _ => "rolled" })</span>
            <a hx-get="@sourceApi"
               hx-target="#hx-page-container"
               hx-push-url="@sourceUrl"
               hx-swap="innerHTML transition:true"
               class="inline-flex items-center gap-0.5 text-xs font-medium text-amber-600 dark:text-amber-400 hover:underline cursor-pointer min-w-0 flex-1">
                <img src="/api/images/source-icon?name=@Uri.EscapeDataString(Entry.SourceName)" alt="@Entry.SourceName"
                     class="w-4 h-4 rounded shrink-0"
                     loading="lazy"
                     onerror="this.style.display='none'" />
                @* No bracketed RunCount here: it counted merged loot records, which reads as a
                   kill count but isn't one, and contradicted the KC range on the row below. The
                   session's real kill count is shown next to that range instead. *@
                <span class="truncate">@Entry.SourceName</span>
            </a>
        </div>
        @* Row 2: rolls this session · KC · time *@
        <div class="flex items-center gap-1.5 mt-0.5 text-[10px] text-slate-500 dark:text-slate-300">
            @if (sessionKills is > 1)
            {
                <span class="text-slate-600 dark:text-slate-200 font-medium whitespace-nowrap"
                      title="Rolls in this session, from the roll range below">@sessionKills.Value.ToString("N0") rolls</span>
                <span class="mx-0.5" aria-hidden="true">·</span>
            }
            @if (kcLabel is not null)
            {
                <span class="text-slate-600 dark:text-slate-200 whitespace-nowrap">@kcLabel</span>
                <span class="mx-0.5" aria-hidden="true">·</span>
            }
            <time datetime="@Entry.OccurredAt.UtcDateTime.ToString("o")" class="whitespace-nowrap loot-timestamp">@FormatTime(Entry.OccurredAt)</time>
        </div>
    </div>

    @if (Entry.Drops.Count > 0)
    {
        var grouped = GroupDrops(Entry.Drops);
        @* items-start so each drop is its own block: the chip, with its rate line beneath. *@
        <div class="flex flex-wrap items-start gap-1.5 mt-1.5">
            @foreach (var drop in grouped.Take(8))
            {
                var isNewUnique = drop.IsFirstTime && drop.IsCollectionLogItem;
                var dropTotal = (long)drop.Quantity * drop.Price;
                var isLegendary = dropTotal >= 250_000_000;
                var isSpecial = drop.IsSpecial;
                <span class="flex flex-col min-w-0">
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md text-[10px] border @GetDropTierClasses(drop.Price) text-slate-700 dark:text-slate-200 @((isNewUnique && !isLegendary && !isSpecial) ? GetFirstTimeRingClasses(Entry.Tier) : "") @(isLegendary ? "legendary-item" : "") @(isSpecial ? "giga-item" : "")"
                      title="@(isNewUnique ? "First-time collection log unlock" : null)">
                    @if (isSpecial)
                    {
                        @* Distinct-hued spinning bolt for admin-injected untradeable giga drops.
                           Uses the #giga-electric filter + #giga-electric-grad gradient in App.razor;
                           .giga-border in app.css adds the rotation. *@
                        <svg class="giga-border" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="url(#giga-electric-grad)"
                                  stroke-width="2"
                                  opacity="0.8"
                                  filter="url(#giga-electric)" />
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="#ffffff"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-dasharray="40 160"
                                  filter="url(#giga-electric)">
                                <animate attributeName="stroke-dashoffset" from="0" to="200"
                                         dur="1.1s" repeatCount="indefinite" />
                            </rect>
                        </svg>
                    }
                    @if (isLegendary)
                    {
                        @* Jagged lightning border for the 250M+ pill itself. The global
                           #legendary-electric SVG filter (App.razor) warps the stroked
                           rect into a wiggling bolt; overflow:visible lets it spill out. *@
                        <svg class="legendary-border" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            @* Two-layer bolt: a continuous wobbly baseline so the whole
                               perimeter is always lit, plus a brighter dashed segment
                               travelling on top via animated stroke-dashoffset. The
                               displacement filter wiggles both into a jagged shape. *@
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="url(#legendary-electric-grad)"
                                  stroke-width="2"
                                  opacity="0.75"
                                  filter="url(#legendary-electric)" />
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="#ffffff"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-dasharray="40 160"
                                  filter="url(#legendary-electric)">
                                <animate attributeName="stroke-dashoffset" from="0" to="200"
                                         dur="1.4s" repeatCount="indefinite" />
                            </rect>
                        </svg>
                    }
                    @if (isNewUnique)
                    {
                        <span class="px-1 py-0 text-[9px] font-semibold rounded-sm bg-cyan-700 text-white">NEW</span>
                    }
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.Name)" alt="@drop.Name"
                         class="w-3 h-3 inline-block"
                         loading="lazy"
                         onerror="this.style.display='none'" />
                    @if (drop.Quantity > 1)
                    {
                        <span class="font-medium text-amber-600 dark:text-amber-400">@drop.Quantity.ToString("N0")x</span>
                    }
                    <span>@drop.Name</span>
                    @if (drop.Price > 0)
                    {
                        @if (Entry.RunCount > 1 && drop.Quantity > 1)
                        {
                            <span class="text-slate-700 dark:text-slate-200">(@GoldFormat.Format(drop.Price) ea)</span>
                        }
                        else
                        {
                            <span class="text-slate-700 dark:text-slate-200">(@GoldFormat.Format((long)drop.Quantity * drop.Price))</span>
                        }
                    }
                </span>
                @if (LuckLabel(drop) is { } luckLabel)
                {
                    @* Rate + how this drop landed, on its own line UNDER the item rather than
                       crowding the name. Collection-log items only, and only when we hold a rate
                       for this item AT THIS SOURCE - see LuckLabel. The figures come from
                       SourceLootService, so they match the character page and the leaderboard. *@
                    <span class="mt-1 pl-1 text-[9px] leading-tight text-slate-500 dark:text-white whitespace-nowrap"
                          title="@luckLabel.Title">
                        @luckLabel.Text
                        @if (luckLabel.Verdict is { } verdict)
                        {
                            <span class="mx-0.5" aria-hidden="true">·</span>
                            <span class="font-medium @luckLabel.VerdictClass">@verdict</span>
                        }
                    </span>
                }
                </span>
            }
            @if (grouped.Count > 8)
            {
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-white">
                    +@(grouped.Count - 8) more
                </span>
            }
        </div>
    }

    @if (Entry.Drops.Count > 1 && Entry.TotalValue > 0)
    {
        <div class="mt-1.5 text-[10px] text-slate-500 dark:text-white">
            Total: <span class="font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(Entry.TotalValue) gp</span>
        </div>
    }

    @if (popoverUrl is not null)
    {
        @* Empty hover popover container — HTMX fills its innerHTML on the first
           hover (500ms delay, once-only). Show is gated by an asymmetric CSS delay:
           500ms on the way in (so a passing cursor doesn't reveal anything), 0ms
           on the way out (so it disappears immediately when the cursor moves away).
           Targeted via the data attribute so multi-tier kills don't collide on a
           duplicated id. *@
        <div data-source-popover
             class="opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-[opacity,visibility] duration-100 [transition-delay:0ms] group-hover:[transition-delay:500ms] absolute top-full left-0 right-0 z-30 mt-1"></div>
    }
</div>

@code {
    [Parameter] public required LootFeedEntry Entry { get; set; }
    [Parameter] public bool Animate { get; set; }
    [Parameter] public bool IsMerge { get; set; }

    private string GetValueTierClasses() => Entry.Tier switch
    {
        LootFeedTier.Legendary => "border-amber-400 ring-1 ring-amber-400/40",
        LootFeedTier.Epic => "border-purple-400 ring-1 ring-purple-400/30",
        LootFeedTier.Rare => "border-blue-400 ring-1 ring-blue-400/30",
        LootFeedTier.Uncommon => "border-green-400",
        _ => "border-slate-200 dark:border-slate-700"
    };

    private static string GetDropTierClasses(long dropValue) => dropValue switch
    {
        >= 100_000_000 => "bg-amber-100 dark:bg-amber-950 border-amber-400",
        >= 10_000_000 => "bg-purple-100 dark:bg-purple-950 border-purple-400",
        >= 1_000_000 => "bg-blue-100 dark:bg-blue-950 border-blue-400",
        >= 100_000 => "bg-green-100 dark:bg-green-950 border-green-400",
        _ => "bg-slate-200 dark:bg-slate-800 border-slate-300 dark:border-slate-700"
    };

    private static string GetFirstTimeRingClasses(LootFeedTier tier) => tier switch
    {
        LootFeedTier.Legendary => "ring-2 ring-amber-400 dark:ring-amber-500/80",
        LootFeedTier.Epic => "ring-2 ring-purple-400 dark:ring-purple-500/80",
        LootFeedTier.Rare => "ring-2 ring-blue-400 dark:ring-blue-500/80",
        LootFeedTier.Uncommon => "ring-2 ring-green-400 dark:ring-green-500/80",
        _ => "ring-2 ring-slate-400 dark:ring-slate-500/80"
    };

    // Ring sits at ring-2 so it visually beats the tier's existing ring-1 from GetValueTierClasses().
    // Colours match the tier border, so the highlight feels like the swimlane "endorsing" the card.
    private static string GetHighlightRingClasses(LootFeedTier tier) => tier switch
    {
        LootFeedTier.Legendary => "ring-2 ring-amber-400/70 dark:ring-amber-300/60",
        LootFeedTier.Epic => "ring-2 ring-purple-400/70 dark:ring-purple-300/60",
        LootFeedTier.Rare => "ring-2 ring-blue-400/70 dark:ring-blue-300/60",
        LootFeedTier.Uncommon => "ring-2 ring-green-400/70 dark:ring-green-300/60",
        _ => "ring-2 ring-slate-400/70 dark:ring-slate-300/60"
    };

    // Collapse repeats of the same item into one chip. Every flag must be carried through:
    // dropping IsSpecial/ExpectedKc/EffectiveRarity here would silently strip the giga-effect
    // marker and the rate label from any card that happened to list an item twice.
    private static List<LootFeedDrop> GroupDrops(List<LootFeedDrop> drops) =>
        drops
            .GroupBy(d => d.Name)
            .Select(g => new LootFeedDrop(
                g.Key,
                g.Sum(d => d.Quantity),
                g.First().Price,
                g.Any(d => d.IsFirstTime),
                g.Any(d => d.IsCollectionLogItem),
                g.Any(d => d.IsSpecial),
                g.Select(d => d.ExpectedKc).FirstOrDefault(k => k is > 0),
                g.Select(d => d.EffectiveRarity).FirstOrDefault(r => !string.IsNullOrEmpty(r)),
                // The EARLIEST roll this item landed on within the card. One chip can stand for
                // several receipts, and the luck statement is about when it first arrived, not the
                // last time it happened to drop. Both the reported count and the derived ordinal are
                // carried, because a card can mix records that reported one with records that didn't.
                g.Select(d => d.KillCount).Where(k => k is > 0).Min(),
                g.Select(d => d.KillOrdinal).Where(k => k is > 0).Min(),
                g.Select(d => d.OccurredAt).Where(t => t is not null).Min()))
            .OrderByDescending(d => (long)d.Quantity * d.Price)
            .ToList();

    private sealed record DropLuck(string Text, string? Verdict, string VerdictClass, string Title);

    // The line under an item: "KC 4,312 . 1/5,000" plus a lucky/dry verdict.
    //
    // Collection-log items ONLY. A snapdragon seed or rune platelegs has a drop rate but nobody is
    // tracking their luck on it, and showing one on every common drop buries the interesting ones.
    // Null also when we hold no rate for this item at this source: ExpectedKc/EffectiveRarity are
    // resolved per (source, item) so an item that drops from several bosses is always rated against
    // the one that actually dropped it, never a blend.
    private DropLuck? LuckLabel(LootFeedDrop drop)
    {
        if (!drop.IsCollectionLogItem) return null;
        if (drop.ExpectedKc is not > 0 || string.IsNullOrEmpty(drop.EffectiveRarity)) return null;

        var expected = drop.ExpectedKc.Value;
        // THIS drop's own roll number — the roll it actually landed on. Not the card's: a card
        // covers a whole play session, so judging a drop against the card's numbers is wrong in both
        // directions. Against the Max, a Venator fang that came on rate at roll 20 was re-judged
        // against roll 126 and reported 6.7x dry. Against the Min, four Lunar Chest uniques spread
        // across rolls 197-420 all claimed roll 197 and read as equally lucky.
        //
        // KillCount is RuneLite's figure; KillOrdinal is this record's own chronological position,
        // used when RuneLite sent no count (routine for chest sources). The card range is only a
        // last resort for a drop carrying neither.
        //
        // Runs, for every source including depth-modelled ones: ExpectedKc is expected RUNS (see
        // SourceLootService.EffectiveRate), so the two sides are already on the same scale and any
        // conversion here would skew the ratio. The character page compares the same pair.
        var observed = drop.KillCount ?? drop.KillOrdinal ?? Entry.MinKillCount ?? Entry.MinKillOrdinal;
        var title = $"Effective rate {drop.EffectiveRarity} (~{Math.Round(expected):N0} expected), "
                    + "after this source's loot model and any admin rate adjustment";

        // No kill count to compare against: still worth showing the rate.
        if (observed is not > 0)
            return new DropLuck(drop.EffectiveRarity!, null, "", title);

        var text = $"#{observed.Value:N0} · {drop.EffectiveRarity}";
        var ratio = observed.Value / expected;
        var (verdict, verdictClass) = ratio switch
        {
            <= 0.50 => ($"{1 / ratio:0.#}x lucky", "text-emerald-600 dark:text-emerald-400"),
            <= 1.50 => ("on rate", "text-slate-500 dark:text-white"),
            <= 3.00 => ($"{ratio:0.#}x dry", "text-amber-600 dark:text-amber-400"),
            _ => ($"{ratio:0.#}x dry", "text-rose-600 dark:text-rose-400")
        };
        return new DropLuck(text, verdict, verdictClass, $"{title}. This drop came at roll {observed.Value:N0}.");
    }


    // How many rolls this session actually spans, derived from the same bounds the KC range is
    // printed from so the two numbers can never disagree. Min and Max are the kill counts of the
    // first and last kill IN the session (see GetSessionBounds), so the span is inclusive: a
    // session from 4,000 to 5,000 is 1,001 kills, and a single-kill session is 1, not 0.
    // Prefers RuneLite's reported KC and falls back to our chronological ordinals.
    private int? SessionKillCount()
    {
        var span = Span(Entry.MinKillCount, Entry.MaxKillCount) ?? Span(Entry.MinKillOrdinal, Entry.MaxKillOrdinal);
        return span;

        static int? Span(int? min, int? max)
        {
            if (min is null || max is null || max.Value < min.Value) return null;
            return max.Value - min.Value + 1;
        }
    }

    private static string? FormatKillCount(int? min, int? max)
    {
        if (min is null && max is null) return null;
        var lo = min ?? max;
        var hi = max ?? min;
        return lo == hi ? $"#{lo:N0}" : $"#{lo:N0}–{hi:N0}";
    }

    private static string? FormatKillOrdinal(int? min, int? max)
    {
        if (min is null && max is null) return null;
        var lo = min ?? max;
        var hi = max ?? min;
        return lo == hi ? $"#{lo:N0}" : $"#{lo:N0}–{hi:N0}";
    }

    private static string FormatTime(DateTimeOffset time)
    {
        var ago = DateTimeOffset.UtcNow - time;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        var local = IngestTimezone.ToZoneTime(time);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM dd yyyy, HH:mm")
            : local.ToString("MMM dd, HH:mm");
    }
}
