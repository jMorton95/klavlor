@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Feed
@using KlavLor.Application.Interfaces.Services

@{
    Dictionary<string, object>? oobAttrs = IsMerge
        ? new Dictionary<string, object> { ["hx-swap-oob"] = "outerHTML" }
        : null;

    // Any single drop (Qty × Price) crossing 250M lights the whole card with
    // the legendary electric effect.
    var entryHasLegendaryDrop = Entry.Drops.Any(d => (long)d.Quantity * d.Price >= 250_000_000);
    var legendaryCardClass = entryHasLegendaryDrop ? "legendary-card" : "";
}
<div id="@Entry.DomId"
     @attributes="oobAttrs"
     class="@(Animate ? "loot-feed-new " : "")bg-white dark:bg-slate-900 rounded-lg shadow border @GetValueTierClasses() p-2.5 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-amber-200 dark:hover:border-amber-700 transition-all duration-200 @legendaryCardClass">
    @{
        var sourceQuery = "?name=" + Uri.EscapeDataString(Entry.SourceName);
        var sourceApi = Entry.GameCharacterId is not null
            ? AppRoutes.LootLogSource.WithId(Entry.GameCharacterId.Value).FromApi() + sourceQuery
            : "#";
        var sourceUrl = Entry.GameCharacterId is not null
            ? AppRoutes.LootLogSource.WithId(Entry.GameCharacterId.Value) + sourceQuery
            : "#";
        var kcLabel = FormatKillCount(Entry.MinKillCount, Entry.MaxKillCount)
                      ?? FormatKillOrdinal(Entry.MinKillOrdinal, Entry.MaxKillOrdinal);
    }
    <div class="mb-1.5 min-w-0">
        @* Row 1: "{user} killed {icon} {source}" — source flexes into all remaining width *@
        <div class="flex items-center gap-1 min-w-0">
            @if (Entry.GameCharacterId is not null)
            {
                <a hx-get="@AppRoutes.LootLogCharacter.WithId(Entry.GameCharacterId.Value).FromApi()"
                   hx-target="#hx-page-container"
                   hx-push-url="@AppRoutes.LootLogCharacter.WithId(Entry.GameCharacterId.Value)"
                   hx-swap="innerHTML transition:true"
                   class="text-xs font-semibold text-slate-900 dark:text-slate-100 hover:underline cursor-pointer truncate shrink-0 max-w-[40%]">@(Entry.CharacterName ?? Entry.UserName)</a>
            }
            else
            {
                <span class="text-xs font-semibold text-slate-900 dark:text-slate-100 truncate shrink-0 max-w-[40%]">@Entry.UserName</span>
            }
            <span class="text-[10px] text-slate-400 shrink-0">@(Entry.SourceType switch { KlavLor.Domain.Entities.LootSourceType.Event => "rolled", KlavLor.Domain.Entities.LootSourceType.Pickpocket => "pickpocketed", _ => "killed" })</span>
            <a hx-get="@sourceApi"
               hx-target="#hx-page-container"
               hx-push-url="@sourceUrl"
               hx-swap="innerHTML transition:true"
               class="inline-flex items-center gap-0.5 text-xs font-medium text-amber-600 dark:text-amber-400 hover:underline cursor-pointer min-w-0 flex-1">
                <img src="/api/images/source-icon?name=@Uri.EscapeDataString(Entry.SourceName)" alt="@Entry.SourceName"
                     class="w-4 h-4 rounded shrink-0"
                     loading="lazy"
                     onerror="this.style.display='none'" />
                <span class="truncate">@Entry.SourceName@(Entry.RunCount > 1 ? $" ({Entry.RunCount})" : "")</span>
            </a>
        </div>
        @* Row 2: KC · time *@
        <div class="flex items-center gap-1.5 mt-0.5 text-[10px] text-slate-400 dark:text-slate-500">
            @if (kcLabel is not null)
            {
                <span class="text-slate-500 dark:text-slate-400 whitespace-nowrap">@kcLabel</span>
                <span aria-hidden="true">·</span>
            }
            <time datetime="@Entry.OccurredAt.UtcDateTime.ToString("o")" class="whitespace-nowrap loot-timestamp">@FormatTime(Entry.OccurredAt)</time>
        </div>
    </div>

    @if (Entry.Drops.Count > 0)
    {
        var grouped = GroupDrops(Entry.Drops);
        <div class="flex flex-wrap gap-1.5 mt-1.5">
            @foreach (var drop in grouped.Take(8))
            {
                var isNewUnique = drop.IsFirstTime && drop.IsCollectionLogItem;
                var dropTotal = (long)drop.Quantity * drop.Price;
                var isLegendary = dropTotal >= 250_000_000;
                <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md text-[10px] border @GetDropTierClasses(drop.Price) text-slate-700 dark:text-slate-200 @((isNewUnique && !isLegendary) ? GetFirstTimeRingClasses(Entry.Tier) : "") @(isLegendary ? "legendary-item" : "")"
                      title="@(isNewUnique ? "First-time collection log unlock" : null)">
                    @if (isLegendary)
                    {
                        @* Jagged lightning border for the 250M+ pill itself. The global
                           #legendary-electric SVG filter (App.razor) warps the stroked
                           rect into a wiggling bolt; overflow:visible lets it spill out. *@
                        <svg class="legendary-border" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            @* Two-layer bolt: a continuous wobbly baseline so the whole
                               perimeter is always lit, plus a brighter dashed segment
                               travelling on top via animated stroke-dashoffset. The
                               displacement filter wiggles both into a jagged shape. *@
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="url(#legendary-electric-grad)"
                                  stroke-width="2"
                                  opacity="0.75"
                                  filter="url(#legendary-electric)" />
                            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6"
                                  fill="none"
                                  stroke="#ffffff"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-dasharray="40 160"
                                  filter="url(#legendary-electric)">
                                <animate attributeName="stroke-dashoffset" from="0" to="200"
                                         dur="1.4s" repeatCount="indefinite" />
                            </rect>
                        </svg>
                    }
                    @if (isNewUnique)
                    {
                        <span class="px-1 py-0 text-[9px] font-semibold rounded-sm bg-cyan-700 text-white">NEW</span>
                    }
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.Name)" alt="@drop.Name"
                         class="w-3 h-3 inline-block"
                         loading="lazy"
                         onerror="this.style.display='none'" />
                    @if (drop.Quantity > 1)
                    {
                        <span class="font-medium text-amber-600 dark:text-amber-400">@drop.Quantity.ToString("N0")x</span>
                    }
                    <span>@drop.Name</span>
                    @if (drop.Price > 0)
                    {
                        @if (Entry.RunCount > 1 && drop.Quantity > 1)
                        {
                            <span class="text-slate-700 dark:text-slate-200">(@GoldFormat.Format(drop.Price) ea)</span>
                        }
                        else
                        {
                            <span class="text-slate-700 dark:text-slate-200">(@GoldFormat.Format((long)drop.Quantity * drop.Price))</span>
                        }
                    }
                </span>
            }
            @if (grouped.Count > 8)
            {
                <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                    +@(grouped.Count - 8) more
                </span>
            }
        </div>
    }

    @if (Entry.Drops.Count > 1 && Entry.TotalValue > 0)
    {
        <div class="mt-1.5 text-[10px] text-slate-500 dark:text-slate-400">
            Total: <span class="font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(Entry.TotalValue) gp</span>
        </div>
    }
</div>

@code {
    [Parameter] public required LootFeedEntry Entry { get; set; }
    [Parameter] public bool Animate { get; set; }
    [Parameter] public bool IsMerge { get; set; }

    private string GetValueTierClasses() => Entry.Tier switch
    {
        LootFeedTier.Legendary => "border-amber-400 ring-1 ring-amber-400/40",
        LootFeedTier.Epic => "border-purple-400 ring-1 ring-purple-400/30",
        LootFeedTier.Rare => "border-blue-400 ring-1 ring-blue-400/30",
        LootFeedTier.Uncommon => "border-green-400",
        _ => "border-slate-200 dark:border-slate-700"
    };

    private static string GetDropTierClasses(long dropValue) => dropValue switch
    {
        >= 100_000_000 => "bg-amber-50 dark:bg-amber-950 border-amber-400",
        >= 10_000_000 => "bg-purple-50 dark:bg-purple-950 border-purple-400",
        >= 1_000_000 => "bg-blue-50 dark:bg-blue-950 border-blue-400",
        >= 100_000 => "bg-green-50 dark:bg-green-950 border-green-400",
        _ => "bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700"
    };

    private static string GetFirstTimeRingClasses(LootFeedTier tier) => tier switch
    {
        LootFeedTier.Legendary => "ring-2 ring-amber-400 dark:ring-amber-500/80",
        LootFeedTier.Epic => "ring-2 ring-purple-400 dark:ring-purple-500/80",
        LootFeedTier.Rare => "ring-2 ring-blue-400 dark:ring-blue-500/80",
        LootFeedTier.Uncommon => "ring-2 ring-green-400 dark:ring-green-500/80",
        _ => "ring-2 ring-slate-400 dark:ring-slate-500/80"
    };

    private static List<LootFeedDrop> GroupDrops(List<LootFeedDrop> drops) =>
        drops
            .GroupBy(d => d.Name)
            .Select(g => new LootFeedDrop(g.Key, g.Sum(d => d.Quantity), g.First().Price, g.Any(d => d.IsFirstTime), g.Any(d => d.IsCollectionLogItem)))
            .OrderByDescending(d => (long)d.Quantity * d.Price)
            .ToList();

    private static string? FormatKillCount(int? min, int? max)
    {
        if (min is null && max is null) return null;
        var lo = min ?? max;
        var hi = max ?? min;
        return lo == hi ? $"KC #{lo:N0}" : $"KC #{lo:N0}–{hi:N0}";
    }

    private static string? FormatKillOrdinal(int? min, int? max)
    {
        if (min is null && max is null) return null;
        var lo = min ?? max;
        var hi = max ?? min;
        return lo == hi ? $"Kill #{lo:N0}" : $"Kill #{lo:N0}–{hi:N0}";
    }

    private static string FormatTime(DateTimeOffset time)
    {
        var ago = DateTimeOffset.UtcNow - time;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        var local = IngestTimezone.ToZoneTime(time);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM dd yyyy, HH:mm")
            : local.ToString("MMM dd, HH:mm");
    }
}
