@using KlavLor.Application.Features.Loot.Feed

<div class="@(Animate ? "loot-feed-new " : "")bg-white dark:bg-slate-900 rounded-xl shadow border @GetValueTierClasses() p-4 hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-amber-200 dark:hover:border-amber-700 transition-all duration-200">
    <div class="flex items-start justify-between mb-2">
        <div class="flex items-center gap-2">
            <a hx-get="@AppRoutes.LootLogUser.WithId(Entry.UserId).FromApi()"
               hx-target="#hx-page-container"
               hx-push-url="@AppRoutes.LootLogUser.WithId(Entry.UserId)"
               hx-swap="innerHTML transition:true"
               class="text-sm font-semibold text-slate-900 dark:text-slate-100 hover:underline cursor-pointer">@Entry.UserName</a>
            <span class="text-xs text-slate-400 dark:text-slate-400">@(Entry.SourceType switch { KlavLor.Domain.Entities.LootSourceType.Event => "rolled", KlavLor.Domain.Entities.LootSourceType.Pickpocket => "pickpocketed", _ => "killed" })</span>
            <a hx-get="@(AppRoutes.LootLogSource.WithId(Entry.UserId).FromApi() + "?name=" + Uri.EscapeDataString(Entry.SourceName))"
               hx-target="#hx-page-container"
               hx-push-url="@(AppRoutes.LootLogSource.WithId(Entry.UserId) + "?name=" + Uri.EscapeDataString(Entry.SourceName))"
               hx-swap="innerHTML transition:true"
               class="inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 dark:text-amber-400 hover:underline cursor-pointer">
                <img src="/api/images/source-icon?name=@Uri.EscapeDataString(Entry.SourceName)"
                     class="w-5 h-5 inline-block rounded"
                     loading="lazy"
                     onerror="this.style.display='none'" />
                @Entry.SourceName
            </a>
        </div>
        <time datetime="@Entry.OccurredAt.UtcDateTime.ToString("o")" class="text-xs text-slate-400 dark:text-slate-400 whitespace-nowrap ml-2 loot-timestamp">@FormatTime(Entry.OccurredAt)</time>
    </div>

    @if (Entry.Drops.Count > 0)
    {
        var grouped = GroupDrops(Entry.Drops);
        <div class="flex flex-wrap gap-2 mt-2">
            @foreach (var drop in grouped.Take(8))
            {
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs border @GetDropTierClasses((long)drop.Quantity * drop.Price) text-slate-700 dark:text-slate-200">
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.Name)"
                         class="w-4 h-4 inline-block"
                         loading="lazy"
                         onerror="this.style.display='none'" />
                    @if (drop.Quantity > 1)
                    {
                        <span class="font-medium text-amber-600 dark:text-amber-400">@drop.Quantity.ToString("N0")x</span>
                    }
                    <span>@drop.Name</span>
                    @if (drop.Price > 0)
                    {
                        <span class="text-slate-700 dark:text-slate-200">(@FormatGold((long)drop.Quantity * drop.Price))</span>
                    }
                </span>
            }
            @if (grouped.Count > 8)
            {
                <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                    +@(grouped.Count - 8) more
                </span>
            }
        </div>
    }

    @if (Entry.TotalValue > 0)
    {
        <div class="mt-2 text-xs text-slate-500 dark:text-slate-400">
            Total: <span class="font-medium text-amber-600 dark:text-amber-400">@FormatGold(Entry.TotalValue) gp</span>
        </div>
    }
</div>

@code {
    [Parameter] public required LootFeedEntry Entry { get; set; }
    [Parameter] public bool Animate { get; set; }

    private string GetValueTierClasses() => Entry.TotalValue switch
    {
        >= 10_000_000 => "border-amber-400 ring-2 ring-amber-400/40",
        >= 1_000_000 => "border-purple-400 ring-1 ring-purple-400/30",
        >= 100_000 => "border-green-400",
        _ => "border-slate-200 dark:border-slate-700"
    };

    private static string GetDropTierClasses(long dropValue) => dropValue switch
    {
        >= 10_000_000 => "bg-amber-50 dark:bg-amber-950 border-amber-400",
        >= 1_000_000 => "bg-purple-50 dark:bg-purple-950 border-purple-400",
        >= 100_000 => "bg-green-50 dark:bg-green-950 border-green-400",
        _ => "bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700"
    };

    private static List<LootFeedDrop> GroupDrops(List<LootFeedDrop> drops) =>
        drops
            .GroupBy(d => d.Name)
            .Select(g => new LootFeedDrop(g.Key, g.Sum(d => d.Quantity), g.First().Price))
            .OrderByDescending(d => (long)d.Quantity * d.Price)
            .ToList();

    private static string FormatGold(long value)
    {
        if (value >= 1_000_000_000) return $"{value / 1_000_000_000.0:F1}B";
        if (value >= 1_000_000) return $"{value / 1_000_000.0:F1}M";
        if (value >= 1_000) return $"{value / 1_000.0:F1}K";
        return value.ToString("N0");
    }

    private static string FormatTime(DateTimeOffset time)
    {
        var ago = DateTimeOffset.UtcNow - time;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        return time.ToString("MMM dd, HH:mm");
    }
}
