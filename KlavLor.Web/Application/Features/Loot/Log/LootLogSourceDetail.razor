@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Domain.Entities
@using KlavLor.Web.Application.Features.Loot.Log.Profile
@using KlavLor.Web.Components.Layout

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@($"KlavLor - {Detail?.SourceName ?? "Source Detail"}")" Title="@(Detail?.SourceName ?? "Source Detail")" Description="Individual drop log for a source" />
}

<div class="space-y-6">
    <a hx-get="@AppRoutes.LootLogCharacter.WithId(CharacterId).FromApi()"
       hx-target="#hx-page-container"
       hx-push-url="@AppRoutes.LootLogCharacter.WithId(CharacterId)"
       hx-swap="innerHTML transition:true"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 dark:text-slate-400 dark:hover:text-amber-400 cursor-pointer transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Sources
    </a>

    @if (Detail is not null)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 inline-flex items-center gap-2">
                        <img src="/api/images/source-icon?name=@Uri.EscapeDataString(Detail.SourceName)" alt="@Detail.SourceName"
                             class="w-6 h-6 inline-block rounded shrink-0"
                             loading="lazy"
                             onerror="this.style.display='none'" />
                        @Detail.SourceName
                    </h2>
                    <div class="flex items-center gap-4 mt-1 text-sm text-slate-500 dark:text-slate-400">
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium @GetSourceTypeBadgeClasses()">@Detail.SourceType</span>
                        <span>@Detail.TotalKills.ToString("N0") @(Detail.SourceType == LootSourceType.Event ? "rolls" : "kills")</span>
                        <span class="font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(Detail.TotalValue) gp total</span>
                    </div>
                </div>
            </div>

            @if (Detail.AllDrops.Count > 0)
            {
                <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">All Drops (aggregated)</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2">
                    @foreach (var drop in Detail.AllDrops)
                    {
                        <div class="flex items-center justify-between text-xs bg-slate-50 dark:bg-slate-800 rounded-lg px-3 py-2">
                            <span class="text-slate-700 dark:text-slate-100 truncate mr-2 inline-flex items-center gap-1">
                                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.Name)" alt="@drop.Name"
                                     class="w-4 h-4 inline-block shrink-0"
                                     loading="lazy"
                                     onerror="this.style.display='none'" />
                                @drop.Name
                                @if (drop.TotalQuantity > 1)
                                {
                                    <span class="ml-1 text-slate-400 dark:text-slate-400">x@(drop.TotalQuantity.ToString("N0"))</span>
                                }
                            </span>
                            <span class="text-amber-600 dark:text-amber-400 font-medium whitespace-nowrap">@GoldFormat.Format(drop.TotalValue)</span>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Detail.NotableDrops is not null && Detail.NotableDrops.Count > 0)
        {
            <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-3 inline-flex items-center gap-2">
                    <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Notable Drops
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                    @foreach (var kill in Detail.NotableDrops)
                    {
                        <LootLogKillEntry Kill="@kill" Highlighted="true" />
                    }
                </div>
            </div>
        }

        @if (View != "kills" && Collection is not null && (Collection.Entries.Count > 0 || Collection.MissingItems.Count > 0))
        {
            <SourceCollectionPanel Collection="Collection" CharacterId="CharacterId" />
        }
        else if (Detail.Kills.Count > 0)
        {
            @* Kill-log view. Tabs live inside #source-tab-content so swap-on-click brings
               the active-state styling along with the content. *@
            <div id="source-tab-content">
                <div class="border-b border-slate-200 dark:border-slate-700 flex items-center gap-1 mb-3">
                    <button type="button"
                            hx-get="@GetCollectionTabUrl()"
                            hx-target="#source-tab-content"
                            hx-swap="outerHTML"
                            class="px-3 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 cursor-pointer">
                        Collection Log
                    </button>
                    <button type="button"
                            hx-get="@GetKillTabUrl()"
                            hx-target="#source-tab-content"
                            hx-select="#source-tab-content"
                            hx-swap="outerHTML"
                            class="px-3 py-2 text-sm font-medium border-b-2 border-amber-500 text-amber-600 dark:text-amber-400">
                        Kill Log
                    </button>
                </div>
                <div id="kill-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                    @foreach (var kill in Detail.Kills)
                    {
                        <LootLogKillEntry Kill="@kill" />
                    }
                </div>
                @if (Detail.HasMore)
                {
                    <LootLogShowMore Url="@GetShowMoreUrl(2)" Id="show-more-kills" TargetSelector="#kill-list" TotalCount="@Detail.TotalCount" CurrentlyShown="@Detail.Kills.Count" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public LootSourceDetail? Detail { get; set; }
    [Parameter] public SourceCollection? Collection { get; set; }
    [Parameter] public string? View { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public bool UpdateHeader { get; set; } = true;

    private string GetShowMoreUrl(int page)
    {
        return AppRoutes.LootLogSource.WithId(CharacterId).FromApi()
            + $"?name={Uri.EscapeDataString(Detail?.SourceName ?? "")}&pageNumber={page}&pageSize={PageSize}";
    }

    private string GetCollectionTabUrl()
    {
        return AppRoutes.LootLogSourceCollection.WithId(CharacterId).FromApi()
            + $"?name={Uri.EscapeDataString(Detail?.SourceName ?? "")}";
    }

    private string GetKillTabUrl()
    {
        return AppRoutes.LootLogSource.WithId(CharacterId).FromApi()
            + $"?name={Uri.EscapeDataString(Detail?.SourceName ?? "")}&view=kills";
    }

    private string GetSourceTypeBadgeClasses() => Detail?.SourceType switch
    {
        LootSourceType.Npc => "bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300",
        LootSourceType.Event => "bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300",
        LootSourceType.Pickpocket => "bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300",
        LootSourceType.Player => "bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-300",
        _ => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"
    };
}
