@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

<div class="bg-slate-50 dark:bg-slate-900 rounded-lg border p-3 @(Highlighted ? "border-amber-300 dark:border-amber-600 ring-1 ring-amber-300/30 dark:ring-amber-600/30" : "border-slate-200 dark:border-slate-700")">
    <div class="flex items-center justify-between gap-2 mb-2">
        <time datetime="@Kill.OccurredAt.UtcDateTime.ToString("o")" class="text-xs text-slate-400 dark:text-slate-400 loot-timestamp">@FormatTime(Kill.OccurredAt)</time>
        @if (Kill.KillCount is not null)
        {
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                KC #@Kill.KillCount.Value.ToString("N0")
            </span>
        }
        else if (Kill.KillOrdinal is not null)
        {
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400" title="Position in your kill log (RuneLite didn't report an in-game kill count)">
                Kill #@Kill.KillOrdinal.Value.ToString("N0")
            </span>
        }
        @if (Kill.TotalValue > 0)
        {
            <span class="text-xs font-medium text-amber-600 dark:text-amber-400">@GoldFormat.Format(Kill.TotalValue) gp</span>
        }
    </div>
    <div class="flex flex-wrap gap-1.5">
        @foreach (var drop in Kill.Drops)
        {
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 @(drop.IsFirstTime ? "ring-2 ring-cyan-400 dark:ring-cyan-500/70" : "")"
                  title="@(drop.IsFirstTime ? "First time received" : null)">
                @if (drop.IsFirstTime)
                {
                    <span class="px-1 py-0 text-[9px] font-semibold rounded-sm bg-cyan-700 text-white">NEW</span>
                }
                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.Name)" alt="@drop.Name"
                     class="w-4 h-4 inline-block"
                     loading="lazy"
                     onerror="this.style.display='none'" />
                @if (drop.Quantity > 1)
                {
                    <span class="font-medium text-amber-600 dark:text-amber-400">@(drop.Quantity.ToString("N0"))x</span>
                }
                @drop.Name
                @if (drop.Price > 0)
                {
                    <span class="text-slate-400 dark:text-slate-400">(@GoldFormat.Format((long)drop.Quantity * drop.Price))</span>
                }
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public required LootKillEntry Kill { get; set; }
    [Parameter] public bool Highlighted { get; set; }

    private static string FormatTime(DateTimeOffset time)
    {
        var ago = DateTimeOffset.UtcNow - time;
        if (ago.TotalMinutes < 1) return "just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24)
        {
            var hours = (int)ago.TotalHours;
            var minutes = (int)(ago.TotalMinutes % 60);
            return minutes > 0 ? $"{hours}h {minutes}m ago" : $"{hours}h ago";
        }
        var local = IngestTimezone.ToZoneTime(time);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM dd yyyy, HH:mm")
            : local.ToString("MMM dd, HH:mm");
    }
}
