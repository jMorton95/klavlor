@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

@* Roll history for one character at one source: a cumulative roll line (long-term progression)
   with per-week roll bars overlaid (short-term grind density — gaps are weeks the character didn't
   touch the source). Loaded via its own HTMX request.

   Weekly, not monthly: a steady 1k-a-day grind produces twelve indistinguishable monthly bars,
   where weekly buckets show which weeks were actually played. The two series get separate axes
   because they diverge without limit — a year of that grind puts the cumulative line near 400k
   while a week is ~7k, and on one shared axis every weekly bar would be a couple of pixels tall.
   Each week's bar also prints its own count when the range is short enough for the numbers to fit. *@
@if (_points.Count >= 2 && _lifetimeTotal > 0)
{
    <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
        <div class="flex items-start justify-between gap-2 mb-4 flex-wrap">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Roll history</h2>
                <p class="text-xs text-slate-500 dark:text-white mt-0.5">
                    @_lifetimeTotal.ToString("N0") logged rolls all time · @_windowTotal.ToString("N0") in this window
                    @if (_activeWeeks > 0)
                    {
                        <span> · @_perActiveWeek.ToString("N0") per active week</span>
                    }
                </p>
            </div>
            <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
                @foreach (var (value, label) in Ranges)
                {
                    <button type="button"
                            hx-get="@GetUrl(value)"
                            hx-target="closest div.bg-slate-50"
                            hx-swap="outerHTML"
                            class="px-2 py-1 @(NormalisedRange == value ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                        @label
                    </button>
                }
            </div>
        </div>

        <TrendLineChart Points="@_points"
                        FormatValue="@FormatCount"
                        FormatSecondaryValue="@FormatCount"
                        ChartHeightPx="220"
                        PrimaryName="Cumulative rolls"
                        SecondaryName="Rolls that week"
                        SecondaryAsBars="true"
                        SecondaryOwnAxis="true"
                        ShowSecondaryLabels="true" />

        <p class="text-xs text-slate-500 dark:text-white mt-3">
            The line is cumulative progress at this source and keeps its lifetime total even when the window starts later; the bars are that week's rolls on their own scale, so a quiet week is still visibly different from a heavy one. The final bar is hatched while the week is still in progress.
        </p>
    </div>
}

@code {
    [Parameter] public required SourceKillTrend Trend { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public string? Range { get; set; }

    // 13 weeks is the default because it's the widest window where every bar can still carry its
    // own printed number — the "how many am I doing per week" question the panel exists to answer.
    // The longer ranges trade those labels for the shape of the cumulative climb.
    private const string DefaultRange = "13w";

    private static readonly (string Value, string Label)[] Ranges =
    {
        ("13w", "13 weeks"),
        ("52w", "52 weeks"),
        ("all", "All time")
    };

    private string NormalisedRange => Ranges.Any(r => r.Value == Range) ? Range! : DefaultRange;

    private int? WindowWeeks => NormalisedRange switch
    {
        "13w" => 13,
        "52w" => 52,
        _ => null
    };

    private List<TrendLineChart.Point> _points = [];
    private long _lifetimeTotal;
    private long _windowTotal;
    private int _activeWeeks;
    private long _perActiveWeek;

    protected override void OnParametersSet()
    {
        _points = [];
        _lifetimeTotal = Trend.Weeks.Sum(w => (long)w.Kills);
        _windowTotal = 0;
        _activeWeeks = 0;
        _perActiveWeek = 0;
        if (Trend.Weeks.Count == 0 || _lifetimeTotal == 0) return;

        // Densify from the first logged week through the current one, so idle weeks are visible
        // gaps rather than being skipped (which would silently compress a break into nothing).
        var byWeek = Trend.Weeks.ToDictionary(w => w.WeekStart);

        // Start one week BEFORE the first logged roll. The cumulative line then opens at zero and
        // climbs, instead of appearing part-way up the axis at whatever the first week happened to
        // total — which on a character with two weeks of history read as a line floating in mid-air.
        // A real, empty week rather than a synthetic point: the character genuinely had no rolls
        // here, so it is true, it dates correctly on the axis, and it needs no special case
        // anywhere downstream.
        //
        // It also fixes the shaded area stopping half way across. The fill ends at the boundary
        // before the in-progress week, so with only two columns that boundary WAS the middle of
        // the chart. A third column moves it where it belongs.
        //
        // Only ever visible when the window reaches back to the beginning; a 13-week view of a
        // long-running character still opens at its true carried total, as it should.
        var first = Trend.Weeks[0].WeekStart.AddDays(-7);
        var last = MondayOf(DateOnly.FromDateTime(IngestTimezone.ToZoneTime(DateTimeOffset.UtcNow).DateTime));
        if (last < Trend.Weeks[^1].WeekStart) last = Trend.Weeks[^1].WeekStart;

        // Walk every week accumulating the running total, then keep only the window's tail. The
        // running total is carried across the cut, so a 13-week view still opens at the true
        // lifetime figure instead of restarting from zero.
        var all = new List<(DateOnly Week, int Kills, long Value, long Running)>();
        long running = 0;
        for (var cursor = first; cursor <= last; cursor = cursor.AddDays(7))
        {
            byWeek.TryGetValue(cursor, out var w);
            running += w?.Kills ?? 0;
            all.Add((cursor, w?.Kills ?? 0, w?.Value ?? 0, running));
        }

        var window = WindowWeeks is { } n && all.Count > n
            ? all.GetRange(all.Count - n, n)
            : all;

        _windowTotal = window.Sum(w => (long)w.Kills);
        _activeWeeks = window.Count(w => w.Kills > 0);
        _perActiveWeek = _activeWeeks > 0 ? _windowTotal / _activeWeeks : 0;

        // Label density: every week when the window is short, otherwise monthly-ish marks, so the
        // axis never becomes a smear of overlapping dates.
        var labelEvery = window.Count <= 16 ? 1 : window.Count <= 40 ? 2 : 4;

        // The week we're currently in is only partly elapsed, so its bar is not comparable with the
        // completed ones beside it. Flagged rather than hidden: dropping it would lose today's kills.
        var currentWeek = MondayOf(DateOnly.FromDateTime(IngestTimezone.ToZoneTime(DateTimeOffset.UtcNow).DateTime));

        for (var i = 0; i < window.Count; i++)
        {
            var (week, kills, value, cumulative) = window[i];
            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(week.Month);
            // Anchor the labelling on the newest week so the right-hand edge is always dated.
            var fromEnd = window.Count - 1 - i;
            var label = fromEnd % labelEvery == 0 ? $"{week.Day} {monthShort}" : "";
            var isPartial = week == currentWeek;

            _points.Add(new TrendLineChart.Point(
                Label: label,
                Value: cumulative,
                Title: $"Week of {week.Day} {monthShort} {week.Year}" + (isPartial ? " (in progress)" : ""),
                ValueText: $"{cumulative:N0} total rolls",
                Detail: kills > 0 ? $"{GoldFormat.Format(value)} gp that week" : null,
                SecondaryValue: kills,
                // "this week so far" for the week we're in, "that week" for a finished one.
                SecondaryText: kills > 0
                    ? isPartial ? $"+{kills:N0} rolls this week so far" : $"+{kills:N0} rolls that week"
                    : isPartial ? "no rolls this week yet" : "no rolls that week",
                IsPartial: isPartial));
        }
    }

    private static DateOnly MondayOf(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));

    private static string FormatCount(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString("N0");

    private string GetUrl(string range) =>
        AppRoutes.LootLogSourceKillTrend.WithId(CharacterId).FromApi()
        + $"?name={Uri.EscapeDataString(Trend.SourceName)}&range={range}";
}
