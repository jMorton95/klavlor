@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

@* Kill history for one character at one source: a cumulative kill line (long-term progression)
   with a per-month kills series overlaid (short-term burstiness / grind density — flat stretches
   are months the character didn't touch the source). Loaded via its own HTMX request. *@
@if (_cumulative.Count >= 2 && _total > 0)
{
    <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
        <div class="flex items-baseline justify-between gap-2 mb-4">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Kill history</h2>
            <span class="text-xs text-slate-400 dark:text-white">all time at this source</span>
        </div>

        <TrendLineChart Points="@_cumulative" FormatValue="@FormatCount" ChartHeightPx="180"
                        PrimaryName="Cumulative kills" SecondaryName="Kills that month" />

        <p class="text-xs text-slate-400 dark:text-white mt-3">
            @_total.ToString("N0") logged kills over @_cumulative.Count months — the line tracks cumulative progress; the per-month series shows how bursty the grind is (flat stretches are idle months).
        </p>
    </div>
}

@code {
    [Parameter] public required SourceKillTrend Trend { get; set; }

    private List<TrendLineChart.Point> _cumulative = [];
    private long _total;

    protected override void OnParametersSet()
    {
        _cumulative = [];
        _total = Trend.Months.Sum(m => (long)m.Kills);
        if (Trend.Months.Count == 0 || _total == 0) return;

        // Densify: idle months render as flat line segments rather than being skipped.
        var byMonth = Trend.Months.ToDictionary(m => (m.Year, m.Month));
        var first = new DateOnly(Trend.Months[0].Year, Trend.Months[0].Month, 1);
        var last = new DateOnly(Trend.Months[^1].Year, Trend.Months[^1].Month, 1);
        var totalMonths = (last.Year - first.Year) * 12 + (last.Month - first.Month) + 1;

        long running = 0;
        int? lastYearLabelled = null;
        var index = 0;
        for (var cursor = first; cursor <= last; cursor = cursor.AddMonths(1))
        {
            byMonth.TryGetValue((cursor.Year, cursor.Month), out var m);
            var kills = m?.Kills ?? 0;
            var value = m?.Value ?? 0;
            running += kills;

            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(cursor.Month);
            // With many months, label only the first point and year boundaries to avoid collisions.
            var atYearMark = index == 0 || lastYearLabelled != cursor.Year;
            var label = atYearMark
                ? $"{monthShort} '{(cursor.Year % 100):D2}"
                : totalMonths <= 14 ? monthShort : "";
            lastYearLabelled = cursor.Year;

            _cumulative.Add(new TrendLineChart.Point(
                Label: label,
                Value: running,
                Title: $"{monthShort} {cursor.Year}",
                ValueText: $"{running:N0} total kills",
                Detail: kills > 0 ? $"{GoldFormat.Format(value)} gp that month" : null,
                SecondaryValue: kills,
                SecondaryText: kills > 0 ? $"+{kills:N0} kills that month" : "no kills that month"));
            index++;
        }
    }

    private static string FormatCount(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString("N0");
}
