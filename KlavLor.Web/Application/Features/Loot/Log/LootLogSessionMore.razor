@using KlavLor.Application.Features.Loot.Log

@foreach (var session in Sessions.Sessions)
{
    <LootLogSessionCard Session="@session" CharacterId="CharacterId" SourceName="@Sessions.SourceName" SourceType="Sessions.SourceType" />
}

@{
    var shown = PageNumber * KlavLor.Application.Features.Loot.Log.LootLogHandler.SessionsPageSize;
    if (shown > Sessions.TotalSessions) shown = Sessions.TotalSessions;
}
@if (Sessions.HasMore)
{
    <div id="show-more-sessions" hx-swap-oob="true"
         class="flex justify-center py-2"
         hx-get="@GetNextUrl()" hx-target="#session-list" hx-swap="beforeend" hx-trigger="click">
        <button type="button"
                class="px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            Showing @shown of @Sessions.TotalSessions sessions
        </button>
    </div>
}
else
{
    <div id="show-more-sessions" hx-swap-oob="true"></div>
}

@code {
    [Parameter] public required LootSourceSessions Sessions { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public int PageNumber { get; set; }

    private string GetNextUrl() =>
        AppRoutes.LootLogSource.WithId(CharacterId).FromApi()
        + $"?name={Uri.EscapeDataString(Sessions.SourceName)}&view=kills&pageNumber={PageNumber + 1}";
}
