@page "/loot/log"
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

@inject LootLogHandler LogHandler

<PageLayout PageTitle="KlavLor - Drop Logs" Title="Drop Logs" Description="Browse loot history by character">
    @if (_characters is not null)
    {
        <LootLogUsersGrid Characters="@_characters" UpdateHeader="false" />
    }
</PageLayout>

@code {
    private List<LootLogCharacterSummary>? _characters;

    protected override async Task OnInitializedAsync()
    {
        var result = await LogHandler.HandleCharacters();
        if (result.IsSuccess)
        {
            _characters = result.Value;
        }
    }
}
