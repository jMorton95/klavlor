@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Sources" Title="@HeaderText" Description="Every source this character has loot from" />
}

<div class="space-y-4 pb-24">
    <a hx-get="@AppRoutes.LootLogCharacter.WithId(CharacterId).FromApi()"
       hx-target="#hx-page-container"
       hx-push-url="@AppRoutes.LootLogCharacter.WithId(CharacterId)"
       hx-swap="innerHTML transition:true"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 dark:text-white dark:hover:text-amber-400 cursor-pointer transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to character
    </a>

    <SourceTableView Table="@Table" CharacterId="@CharacterId" />
</div>

@code {
    [Parameter] public required SourceTable Table { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public string? CharacterName { get; set; }
    [Parameter] public bool UpdateHeader { get; set; } = true;

    private string HeaderText => string.IsNullOrEmpty(CharacterName) ? "Sources" : $"{CharacterName}'s sources";
}
