@using KlavLor.Application.Features.Loot.Log

<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
    <td class="px-4 py-3">
        <span class="text-sm font-medium text-slate-900 dark:text-slate-100">@Item.ItemName</span>
    </td>
    <td class="px-4 py-3">
        <div class="flex items-center gap-2">
            <span class="text-sm text-slate-700 dark:text-slate-300">@Item.SourceName</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium @GetSourceTypeBadgeClasses()">
                @Item.SourceType
            </span>
        </div>
    </td>
    <td class="px-4 py-3 text-right">
        <span class="text-sm text-slate-700 dark:text-slate-300">@Item.TotalQuantity.ToString("N0")</span>
    </td>
    <td class="px-4 py-3 text-right">
        <span class="text-sm font-medium text-amber-600 dark:text-amber-400">@FormatGold(Item.TotalItemValue)</span>
    </td>
</tr>

@code {
    [Parameter] public required LootItemMatch Item { get; set; }

    private string GetSourceTypeBadgeClasses() => Item.SourceType switch
    {
        "Npc" => "bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300",
        "Event" => "bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300",
        "Pickpocket" => "bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300",
        "Player" => "bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-300",
        _ => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"
    };

    private static string FormatGold(long value)
    {
        if (value >= 1_000_000_000) return $"{value / 1_000_000_000.0:F1}B";
        if (value >= 1_000_000) return $"{value / 1_000_000.0:F1}M";
        if (value >= 1_000) return $"{value / 1_000.0:F1}K";
        return value.ToString("N0");
    }
}
