@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

<details class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden">
    <summary class="flex items-center gap-3 px-4 py-2.5 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors list-none">
        <svg class="w-3 h-3 text-slate-400 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Item.ItemName)" alt="@Item.ItemName"
             class="w-5 h-5 inline-block shrink-0"
             loading="lazy"
             onerror="this.style.display='none'" />
        <span class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate flex-1">@Item.ItemName</span>
        <span class="text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap">@Item.SourceCount @(Item.SourceCount == 1 ? "source" : "sources")</span>
        <span class="text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap tabular-nums">@Item.TotalQuantity.ToString("N0") qty</span>
        <span class="text-sm font-semibold text-amber-600 dark:text-amber-400 whitespace-nowrap tabular-nums w-20 text-right">@GoldFormat.Format(Item.TotalValue)</span>
    </summary>
    <div class="border-t border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/30 divide-y divide-slate-200 dark:divide-slate-700/50">
        @foreach (var source in Item.Sources)
        {
            var query = "?name=" + Uri.EscapeDataString(source.SourceName);
            <a hx-get="@(AppRoutes.LootLogSource.WithId(CharacterId).FromApi() + query)"
               hx-target="#hx-page-container"
               hx-push-url="@(AppRoutes.LootLogSource.WithId(CharacterId) + query)"
               hx-swap="innerHTML transition:true"
               class="flex items-center gap-3 px-4 py-1.5 pl-12 text-xs cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
                <img src="/api/images/source-icon?name=@Uri.EscapeDataString(source.SourceName)" alt="@source.SourceName"
                     class="w-4 h-4 inline-block rounded shrink-0"
                     loading="lazy"
                     onerror="this.style.display='none'" />
                <span class="text-slate-700 dark:text-slate-200 truncate flex-1 hover:text-amber-600 dark:hover:text-amber-400">@source.SourceName</span>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium @GetSourceTypeBadgeClasses(source.SourceType)">@source.SourceType</span>
                <span class="text-slate-500 dark:text-slate-400 whitespace-nowrap tabular-nums">@source.TotalKills.ToString("N0") @(source.SourceType == "Event" ? "rolls" : "kills")</span>
                <span class="text-slate-500 dark:text-slate-400 whitespace-nowrap tabular-nums">@source.Quantity.ToString("N0") qty</span>
                <span class="text-amber-600 dark:text-amber-400 font-medium whitespace-nowrap tabular-nums w-20 text-right">@GoldFormat.Format(source.Value)</span>
            </a>
        }
    </div>
</details>

@code {
    [Parameter] public required LootItemAggregate Item { get; set; }
    [Parameter] public required int CharacterId { get; set; }

    private static string GetSourceTypeBadgeClasses(string sourceType) => sourceType switch
    {
        "Npc" => "bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300",
        "Event" => "bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300",
        "Pickpocket" => "bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300",
        "Player" => "bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-300",
        _ => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400"
    };
}
