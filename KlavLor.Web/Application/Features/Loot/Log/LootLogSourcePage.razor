@page "/loot/log/{Id:int}/source"
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

@inject LootLogHandler LogHandler

<PageLayout PageTitle="KlavLor - Source Detail" Title="Source Detail" Description="Individual drop log for a source">
    @if (_detail is not null)
    {
        <LootLogSourceDetail Detail="@_detail" UserId="@Id" PageSize="@(PageSizeParam ?? 25)" />
    }
</PageLayout>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "name")] public string? NameParam { get; set; }
    [SupplyParameterFromQuery(Name = "pageNumber")] public int? PageNumberParam { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public int? PageSizeParam { get; set; }

    private LootSourceDetail? _detail;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(NameParam))
        {
            var result = await LogHandler.HandleSource(Id, NameParam, PageNumberParam ?? 1, PageSizeParam ?? 25);
            if (result.IsSuccess)
            {
                _detail = result.Value;
            }
        }
    }
}
