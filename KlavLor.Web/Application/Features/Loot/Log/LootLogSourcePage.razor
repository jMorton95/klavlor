@page "/loot/log/{Id:int}/source"
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

@inject LootLogHandler LogHandler
@inject LootCharacterProfileHandler ProfileHandler

<PageLayout PageTitle="@($"KlavLor - {HeaderText}")" Title="@HeaderText" Description="Individual drop log for a source">
    @if (_detail is not null)
    {
        <LootLogSourceDetail Detail="@_detail"
                             Sessions="@_sessions"
                             Collection="@_collection"
                             View="@ViewParam"
                             CharacterId="@Id"
                             UpdateHeader="false" />
    }
</PageLayout>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "name")] public string? NameParam { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    [SupplyParameterFromQuery(Name = "pageNumber")] public int? PageNumberParam { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public int? PageSizeParam { get; set; }

    private LootSourceDetail? _detail;
    private LootSourceSessions? _sessions;
    private SourceCollection? _collection;

    private string HeaderText => _detail switch
    {
        { CharacterName: { Length: > 0 } name, SourceName: var src } => $"{name}'s loot from {src}",
        { SourceName: var src } => src,
        _ => "Source Detail"
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(NameParam)) return;

        // Sequential awaits — the scoped DbContext isn't safe under concurrent use.
        var detailResult = await LogHandler.HandleSource(Id, NameParam);
        if (detailResult.IsSuccess) _detail = detailResult.Value;

        // Only build the data the active tab actually renders (see LootLogSourceDetail): the
        // Kill Sessions view needs sessions, every other view needs the collection. Loading both
        // made the page pay for the (heavy) collection aggregate even when showing kills.
        if (string.Equals(ViewParam, "kills", StringComparison.OrdinalIgnoreCase))
        {
            var sessionsResult = await LogHandler.HandleSourceSessions(Id, NameParam);
            if (sessionsResult.IsSuccess) _sessions = sessionsResult.Value;
        }
        else
        {
            var collectionResult = await ProfileHandler.HandleSourceCollection(Id, NameParam);
            if (collectionResult.IsSuccess) _collection = collectionResult.Value;
        }
    }
}
