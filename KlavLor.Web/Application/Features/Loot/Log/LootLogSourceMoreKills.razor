@using KlavLor.Application.Features.Loot.Log

@foreach (var kill in Detail.Kills)
{
    <LootLogKillEntry Kill="@kill" />
}

@if (Detail.HasMore)
{
    <div id="show-more-kills" hx-swap-oob="true"
         class="flex justify-center py-2"
         hx-get="@GetNextUrl()" hx-target="#kill-list" hx-swap="beforeend" hx-trigger="click">
        <button type="button"
                class="px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            Show More
        </button>
    </div>
}
else
{
    <div id="show-more-kills" hx-swap-oob="true"></div>
}

@code {
    [Parameter] public required LootSourceDetail Detail { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public int PageNumber { get; set; }
    [Parameter] public int PageSize { get; set; }

    private string GetNextUrl()
    {
        return AppRoutes.LootLogSource.WithId(UserId).FromApi()
            + $"?name={Uri.EscapeDataString(Detail.SourceName)}&pageNumber={PageNumber + 1}&pageSize={PageSize}";
    }
}
