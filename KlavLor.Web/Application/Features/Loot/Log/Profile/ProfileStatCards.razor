@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

@if (Windows.AllTime.Kills == 0)
{
    @if (Embedded)
    {
        <div class="text-center py-4">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                No kills logged yet. Install <span class="font-medium text-slate-600 dark:text-slate-300">klavlor-sync</span> to start tracking drops.
            </p>
        </div>
    }
    else
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-8 text-center">
            <svg class="w-10 h-10 mx-auto text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <h3 class="mt-3 text-sm font-semibold text-slate-700 dark:text-slate-200">No kills logged yet</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                Install and run <span class="font-medium text-slate-600 dark:text-slate-300">klavlor-sync</span> to start tracking this character's drops.
            </p>
        </div>
    }
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        @RenderWindow("Last 7 days", Windows.Last7d)
        @RenderWindow("Last 30 days", Windows.Last30d)
        @RenderWindow("All time", Windows.AllTime)
    </div>
}

@code {
    [Parameter] public required ProfileWindowStats Windows { get; set; }
    [Parameter] public bool Embedded { get; set; }

    private RenderFragment RenderWindow(string label, WindowStats w) => __builder =>
    {
        var wrapClass = Embedded
            ? "rounded-lg bg-slate-100/50 dark:bg-slate-800/30 px-3 py-2"
            : "bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4";
        <div class="@wrapClass">
            <div class="flex items-baseline justify-between mb-1">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">@label</span>
                <span class="text-[10px] text-slate-400 dark:text-slate-500">~@w.ActiveHours.ToString("N0")h</span>
            </div>
            <div class="grid grid-cols-4 gap-2 text-center tabular-nums">
                @Cell("Kills", w.Kills.ToString("N0"), null)
                @Cell("GP", GoldFormat.Format(w.Gp), "amber")
                @Cell("GP/hr", GoldFormat.Format(w.GpPerHour), "amber")
                @Cell("New", w.NewItems.ToString("N0"), "cyan")
            </div>
        </div>
    };

    private RenderFragment Cell(string label, string value, string? accent) => __builder =>
    {
        var cls = accent switch
        {
            "amber" => "text-amber-600 dark:text-amber-400",
            "cyan" => "text-cyan-700 dark:text-cyan-300",
            _ => "text-slate-900 dark:text-slate-100"
        };
        <div class="leading-tight">
            <div class="text-sm font-semibold @cls">@value</div>
            <div class="text-[9px] uppercase tracking-wider text-slate-500 dark:text-slate-400">@label</div>
        </div>
    };
}
