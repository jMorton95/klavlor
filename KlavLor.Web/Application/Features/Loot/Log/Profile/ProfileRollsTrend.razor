@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

@* Rolls per month, stacked by source — the volume companion to the value chart above it.
   A roll is one logged kill or claim, i.e. one turn of a source's drop table. The two charts
   answer genuinely different questions: a month can be the year's biggest by gp off a single
   drop while barely registering here, and a 40k-kill Lizardman Shaman grind dominates this
   chart while contributing modestly to the value one. Same months, same positions, so the
   pair can be read together. *@

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-start justify-between mb-3 flex-wrap gap-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">@Title</h3>
            <p class="text-lg font-bold mt-0.5 leading-tight">
                <span class="text-emerald-600 dark:text-emerald-400 tabular-nums">@TotalRolls.ToString("N0")</span>
                <span class="text-xs font-normal text-slate-500 dark:text-white">
                    rolls across @ActiveMonths active @(ActiveMonths == 1 ? "month" : "months")@(ActiveMonths > 0 ? $" · {TotalRolls / ActiveMonths:N0} per active month" : "")
                </span>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
                <button type="button"
                        hx-get="@GetUrl("12m", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "12m" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    12 months
                </button>
                <button type="button"
                        hx-get="@GetUrl("all", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "all" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    All time
                </button>
            </div>
            <button type="button"
                    hx-get="@GetUrl(Trend.Range, !Expanded)"
                    hx-target="closest div.bg-slate-50"
                    hx-swap="outerHTML"
                    title="@(Expanded ? "Back to the standard chart" : $"Expand: double the height, naming the top {ExpandedMinPerMonth} sources in every month instead of {StandardMinPerMonth}")"
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 dark:border-slate-700 text-[11px] @(Expanded ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    @if (Expanded)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 9L4 4m0 0v4m0-4h4m7 5l5-5m0 0v4m0-4h-4M9 15l-5 5m0 0v-4m0 4h4m7-5l5 5m0 0v-4m0 4h-4" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 1v4m0 0h-4m4 0l-5-5" />
                    }
                </svg>
                @(Expanded ? "Collapse" : "Expand")
            </button>
        </div>
    </div>

    @if (Trend.Months.Count == 0 || TotalRolls == 0)
    {
        <p class="text-xs text-slate-500 dark:text-white">No rolls in this window yet.</p>
    }
    else
    {
        @* Detailed by default, matching ProfileMonthlyTrend — the short linear compact view is gone.
           Expanded doubles the height, which is what makes room for twice as many named sources. *@
        <HistogramBars Bars="@_bars" FormatValue="@FormatCount"
                       ChartHeightPx="@(Expanded ? ExpandedHeightPx : StandardHeightPx)"
                       ShowInlineLabels="true"
                       MinSegmentPx="16"
                       MaxSegmentFraction="0.35"
                       Scale="HistogramBars.BarScaleMode.Compressed" />

        <p class="text-[10px] text-slate-500 dark:text-white mt-2">
            Bar heights use a compressed scale so a light month is still readable next to a heavy one — the order is unchanged and every bar prints its true total above itself.
            @if (DelveSources.Count > 0)
            {
                @($" {string.Join(" and ", DelveSources)} counts delves rather than claims, since one claim covers every level a run cleared.")
            }
        </p>

        @* No legend on either view — every named block carries its own icon and source name. *@
    }
</div>

@code {
    [Parameter] public required MonthlyRollTrend Trend { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public bool Expanded { get; set; }

    private const int StandardHeightPx = 900;
    private const int ExpandedHeightPx = 1800;

    // A character grinds far fewer distinct sources than it receives distinct items, so these can sit
    // below the value chart's equivalents and still name essentially everything.
    private const int StandardTopN = 28;
    private const int ExpandedTopN = 56;
    private const int StandardMinPerMonth = 6;
    private const int ExpandedMinPerMonth = 12;

    private int TopN => Expanded ? ExpandedTopN : StandardTopN;
    private int MinPerMonth => Expanded ? ExpandedMinPerMonth : StandardMinPerMonth;

    private long TotalRolls => Trend.Months.Sum(m => (long)m.Rolls);
    private int ActiveMonths => Trend.Months.Count(m => m.Rolls > 0);

    // Sources this chart is counting in delves instead of claims, named in the footnote so the
    // blended total below the heading is explained rather than just being slightly surprising.
    private List<string> DelveSources => Trend.Months
        .SelectMany(m => m.TopSources)
        .Where(s => s.DelvesPerRun is > 1)
        .Select(s => s.SourceName)
        .Distinct(StringComparer.Ordinal)
        .OrderBy(n => n, StringComparer.Ordinal)
        .ToList();

    private string Title => Trend.Range == "all" ? "Rolls per month — all time" : "Rolls per month — last 12 months";

    private List<HistogramBars.Bar> _bars = [];


    protected override void OnParametersSet()
    {
        var perMonth = Trend.Months
            .Select(m => (IReadOnlyList<(string Key, long Value)>)m.TopSources
                .Select(s => (s.SourceName, (long)s.Rolls))
                .ToList())
            .ToList();

        var top = StackPalette.Assign(perMonth, TopN, MinPerMonth);
        var styleBySource = top.ToDictionary(t => t.Key, t => t.Style, StringComparer.Ordinal);

        _bars = new List<HistogramBars.Bar>(Trend.Months.Count);
        int? lastYearLabelled = null;
        for (var i = 0; i < Trend.Months.Count; i++)
        {
            var m = Trend.Months[i];
            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month);
            var label = (i == 0 || m.Month == 1 || lastYearLabelled != m.Year)
                ? $"{monthShort} '{(m.Year % 100):D2}"
                : monthShort;
            lastYearLabelled = m.Year;

            var segments = new List<HistogramBars.BarSegment>();
            var outsiders = new List<HistogramBars.BarSegment>();
            long namedTotal = 0;
            foreach (var seg in m.TopSources.OrderByDescending(s => s.Rolls).ThenBy(s => s.SourceName, StringComparer.Ordinal))
            {
                var share = m.Rolls > 0 ? (double)seg.Rolls / m.Rolls * 100.0 : 0;
                // A depth-modelled source is counted in delves, not claims — the handler has already
                // scaled Rolls, and DelvesPerRun being set is what says so. Branching on that rather
                // than on a source name keeps the view out of the depth model entirely.
                var perRun = seg.DelvesPerRun is > 1 ? seg.DelvesPerRun.Value : 0;
                var valueText = $"{seg.Rolls:N0} {(perRun > 0 ? "delves" : "rolls")}";
                var detail = perRun > 0
                    ? $"{seg.SourceName} — {seg.Rolls:N0} delves ({share:F1}%) across {seg.Rolls / perRun:N0} runs at an average depth of {perRun}, for {GoldFormat.Format(seg.Gp)}"
                    : $"{seg.SourceName} — {seg.Rolls:N0} rolls ({share:F1}%) for {GoldFormat.Format(seg.Gp)}";

                if (styleBySource.TryGetValue(seg.SourceName, out var style))
                {
                    segments.Add(new HistogramBars.BarSegment(
                        Label: detail,
                        Value: seg.Rolls,
                        FillClass: style.Fill,
                        // ItemName carries whatever names the block; here that's the source, and
                        // the icon endpoint switches to source-icon to match.
                        ItemName: seg.SourceName,
                        SourceName: GoldFormat.Format(seg.Gp) + " earned",
                        ValueText: valueText,
                        IconUrl: "/api/images/source-icon?name=" + Uri.EscapeDataString(seg.SourceName),
                        TextClass: style.Text));
                    namedTotal += seg.Rolls;
                }
                else
                {
                    outsiders.Add(new HistogramBars.BarSegment(
                        Label: detail,
                        Value: seg.Rolls,
                        FillClass: StackPalette.Other.Fill,
                        ItemName: seg.SourceName,
                        SourceName: GoldFormat.Format(seg.Gp) + " earned",
                        ValueText: valueText,
                        TextClass: StackPalette.Other.Text));
                }
            }

            var other = Math.Max(0, m.Rolls - namedTotal);
            if (other > 0)
            {
                segments.Add(new HistogramBars.BarSegment(
                    Label: $"Other — {other:N0} rolls",
                    Value: other,
                    FillClass: StackPalette.Other.Fill,
                    ItemName: "Other",
                    SourceName: "everything else this month",
                    ValueText: $"{other:N0} rolls",
                    OverflowItems: outsiders.Count > 0 ? outsiders : null,
                    TextClass: StackPalette.Other.Text));
            }

            _bars.Add(new HistogramBars.Bar(
                Label: label,
                Value: m.Rolls,
                Tooltip: $"{monthShort} {m.Year} — {m.Rolls:N0} rolls · {GoldFormat.Format(m.Gp)}",
                Segments: segments.Count > 0 ? segments : null));
        }
    }

    private static string FormatCount(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString("N0");

    private string GetUrl(string range, bool expanded) =>
        AppRoutes.LootLogCharacterRolls.WithId(CharacterId).FromApi()
        + "?range=" + range + (expanded ? "&size=expanded" : "");
}
