@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

<div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3 min-w-0">
            <div class="w-12 h-12 rounded-full bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center shrink-0">
                <span class="text-lg font-semibold text-amber-700 dark:text-amber-300">@GetInitial()</span>
            </div>
            <div class="min-w-0">
                <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 truncate">@Header.CharacterName</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@Header.UserName</p>
                @if (Header.FirstSeenAt is not null && Header.LastSeenAt is not null)
                {
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">
                        Active @FormatLocal(Header.FirstSeenAt.Value) – @FormatLocal(Header.LastSeenAt.Value)
                    </p>
                }
            </div>
        </div>

        <div class="flex gap-4 flex-wrap text-sm">
            <Stat Label="Lifetime kills" Value="@Header.TotalKills.ToString("N0")" />
            <Stat Label="Sources" Value="@Header.TotalSources.ToString("N0")" />
            <Stat Label="Lifetime GP" Value="@GoldFormat.Format(Header.TotalGp)" Accent="amber" />
        </div>
    </div>
</div>

@code {
    [Parameter] public required ProfileHeader Header { get; set; }

    private string GetInitial() =>
        string.IsNullOrEmpty(Header.CharacterName) ? "?" : Header.CharacterName[0].ToString().ToUpperInvariant();

    private static string FormatLocal(DateTimeOffset t)
    {
        var local = IngestTimezone.ToZoneTime(t);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM d yyyy")
            : local.ToString("MMM d");
    }
}
