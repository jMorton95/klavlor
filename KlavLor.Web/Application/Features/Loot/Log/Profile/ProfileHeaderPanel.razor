@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

@if (Embedded)
{
    @RenderBody()
}
else
{
    <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
        @RenderBody()
    </div>
}

@code {
    [Parameter] public required ProfileHeader Header { get; set; }
    [Parameter] public bool Embedded { get; set; }

    private RenderFragment RenderBody() => __builder =>
    {
        <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-full bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center shrink-0">
                    <span class="text-sm font-semibold text-amber-700 dark:text-amber-300">@GetInitial()</span>
                </div>
                <div class="min-w-0 leading-tight">
                    <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 truncate">@Header.CharacterName</h2>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
                        @Header.UserName
                        @if (Header.FirstSeenAt is not null && Header.LastSeenAt is not null)
                        {
                            <span class="text-slate-400 dark:text-slate-600"> · @FormatLocal(Header.FirstSeenAt.Value) – @FormatLocal(Header.LastSeenAt.Value)</span>
                        }
                    </p>
                </div>
            </div>

            <div class="flex gap-4 text-xs flex-wrap items-baseline">
                @InlineStat("Lifetime kills", Header.TotalKills.ToString("N0"), null)
                @InlineStat("Sources", Header.TotalSources.ToString("N0"), null)
                @InlineStat("Lifetime GP", GoldFormat.Format(Header.TotalGp), "amber")
            </div>
        </div>
    };

    private RenderFragment InlineStat(string label, string value, string? accent) => __builder =>
    {
        var valueClass = accent switch
        {
            "amber" => "text-amber-600 dark:text-amber-400",
            _ => "text-slate-900 dark:text-slate-100"
        };
        <span class="inline-flex items-baseline gap-1.5">
            <span class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">@label</span>
            <span class="text-sm font-semibold @valueClass">@value</span>
        </span>
    };

    private string GetInitial() =>
        string.IsNullOrEmpty(Header.CharacterName) ? "?" : Header.CharacterName[0].ToString().ToUpperInvariant();

    private static string FormatLocal(DateTimeOffset t)
    {
        var local = IngestTimezone.ToZoneTime(t);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM d yyyy")
            : local.ToString("MMM d");
    }
}
