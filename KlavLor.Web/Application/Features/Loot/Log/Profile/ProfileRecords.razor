@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

<div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200 mb-3 inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Personal records
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
        @if (Records.BiggestKill is not null)
        {
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
                <div class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">Biggest kill</div>
                <div class="text-base font-semibold text-amber-600 dark:text-amber-400 mt-0.5">@FormatGold(Records.BiggestKill.TotalValue)</div>
                <div class="text-xs text-slate-700 dark:text-slate-200 mt-1 truncate">@(Records.BiggestKillSource ?? "Unknown source")</div>
                <div class="text-[10px] text-slate-400 dark:text-slate-500">@FormatLocal(Records.BiggestKill.OccurredAt)</div>
            </div>
        }

        @if (Records.BiggestDay is not null)
        {
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
                <div class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">Biggest day</div>
                <div class="text-base font-semibold text-amber-600 dark:text-amber-400 mt-0.5">@FormatGold(Records.BiggestDay.Gp)</div>
                <div class="text-xs text-slate-700 dark:text-slate-200 mt-1">@Records.BiggestDay.Kills.ToString("N0") kills</div>
                <div class="text-[10px] text-slate-400 dark:text-slate-500">@Records.BiggestDay.Day.ToString("MMM d, yyyy")</div>
            </div>
        }

        @if (Records.BestHour is not null)
        {
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
                <div class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">Best 1h window</div>
                <div class="text-base font-semibold text-amber-600 dark:text-amber-400 mt-0.5">@FormatGold(Records.BestHour.Gp)</div>
                <div class="text-xs text-slate-700 dark:text-slate-200 mt-1">@Records.BestHour.Kills.ToString("N0") kills</div>
                <div class="text-[10px] text-slate-400 dark:text-slate-500">from @FormatLocal(Records.BestHour.WindowStart)</div>
            </div>
        }

        @if (Records.TopKcSource is not null)
        {
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
                <div class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">Top KC source</div>
                <div class="text-base font-semibold text-slate-900 dark:text-slate-100 mt-0.5 truncate">@Records.TopKcSource.SourceName</div>
                <div class="text-xs text-slate-700 dark:text-slate-200 mt-1">@Records.TopKcSource.Kills.ToString("N0") kills</div>
                <div class="text-[10px] text-amber-600 dark:text-amber-400">@FormatGold(Records.TopKcSource.Gp) total</div>
            </div>
        }

        @if (Records.BiggestItem is not null)
        {
            <div class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-3">
                <div class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400">Biggest single item</div>
                <div class="text-base font-semibold text-amber-600 dark:text-amber-400 mt-0.5">@FormatGold(Records.BiggestItem.Value)</div>
                <div class="text-xs text-slate-700 dark:text-slate-200 mt-1 truncate inline-flex items-center gap-1">
                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Records.BiggestItem.ItemName)"
                         class="w-4 h-4 inline-block" loading="lazy" onerror="this.style.display='none'" />
                    @(Records.BiggestItem.Quantity > 1 ? $"{Records.BiggestItem.Quantity:N0}x " : "")@Records.BiggestItem.ItemName
                </div>
                <div class="text-[10px] text-slate-400 dark:text-slate-500">from @Records.BiggestItem.SourceName · @FormatLocal(Records.BiggestItem.OccurredAt)</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public required PersonalRecords Records { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private static string FormatLocal(DateTimeOffset t)
    {
        var local = IngestTimezone.ToZoneTime(t);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM d yyyy")
            : local.ToString("MMM d, HH:mm");
    }

    private static string FormatGold(long value)
    {
        if (value >= 1_000_000_000) return $"{value / 1_000_000_000.0:F2}B";
        if (value >= 1_000_000) return $"{value / 1_000_000.0:F1}M";
        if (value >= 1_000) return $"{value / 1_000.0:F1}K";
        return value.ToString("N0");
    }
}
