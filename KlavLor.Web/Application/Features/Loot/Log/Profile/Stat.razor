<div class="flex flex-col">
    <span class="text-[10px] uppercase tracking-wider text-white">@Label</span>
    <span class="text-base font-semibold @ValueClass">@Value</span>
    @if (!string.IsNullOrEmpty(Sub))
    {
        <span class="text-[10px] text-white">@Sub</span>
    }
</div>

@code {
    [Parameter] public required string Label { get; set; }
    [Parameter] public required string Value { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public string? Accent { get; set; }

    private string ValueClass => Accent switch
    {
        "amber" => "text-amber-400",
        "cyan" => "text-cyan-300",
        _ => "text-slate-100"
    };
}
