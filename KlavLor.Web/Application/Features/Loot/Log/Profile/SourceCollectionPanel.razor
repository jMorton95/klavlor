@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

<div id="source-tab-content">
    @* Tab strip mirrors the one in LootLogSourceDetail; lives inside the swap target
       so clicking either tab brings its active-state along with the content. *@
    <div class="border-b border-slate-200 dark:border-slate-700 flex items-center gap-1 mb-3">
        <button type="button"
                hx-get="@GetCollectionTabUrl()"
                hx-target="#source-tab-content"
                hx-swap="outerHTML"
                onclick="history.replaceState(history.state, '', '@GetCollectionPageUrl()')"
                class="px-3 py-2 text-sm font-medium border-b-2 border-amber-500 text-amber-600 dark:text-amber-400">
            Collection Log
        </button>
        <button type="button"
                hx-get="@GetKillTabUrl()"
                hx-target="#source-tab-content"
                hx-select="#source-tab-content"
                hx-swap="outerHTML"
                onclick="history.replaceState(history.state, '', '@GetKillPageUrl()')"
                class="px-3 py-2 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:text-white dark:hover:text-slate-200 cursor-pointer">
            Kill Sessions
        </button>
    </div>

    @if (Collection.Entries.Count == 0 && Collection.MissingItems.Count == 0)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 p-6 text-center">
            <p class="text-sm text-slate-500 dark:text-white">No collection-log data for this source yet.</p>
        </div>
    }
    else
    {
        var unlocked = Collection.Entries.Count;
        var total = unlocked + Collection.MissingItems.Count;
        @* Drop overflow-hidden so the distribution-chart popovers can escape upward
           past the table header. The thead retains visible rounding via its own
           rounded-t-xl on the first/last header cells. *@
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
            <div class="px-4 py-2 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs">
                <span class="text-slate-600 dark:text-slate-300 font-medium">
                    @if (Collection.MissingItems.Count > 0)
                    {
                        @($"{unlocked} / {total} unlocked")
                    }
                    else
                    {
                        @($"{unlocked} unlocked")
                    }
                </span>
                <span class="text-slate-500 dark:text-white">
                    @* Depth-modelled sources (Doom) are counted in delve levels, the unit their
                       drop rates are defined in: one run can be four delves or twenty, so a run
                       count cannot be compared against a per-level rate. *@
                    @if (Collection.IsDepthModelled)
                    {
                        <text>@Collection.CharacterKc.ToString("N0") @(Collection.CharacterKc == 1 ? "run" : "runs") @@ delve @Collection.DelvesPerRun (@Collection.TotalDelves.ToString("N0") delves)</text>
                    }
                    else
                    {
                        <text>@Collection.CharacterKc.ToString("N0") @(Collection.CharacterKc == 1 ? "kill" : "kills") at this source</text>
                    }
                </span>
            </div>
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-4 py-2 text-left text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Item</th>
                        <th class="px-3 py-2 text-left text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Rate</th>
                        <th class="px-3 py-2 text-left text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Luck</th>
                        <th class="px-3 py-2 text-right text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Drops</th>
                        <th class="px-3 py-2 text-right text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">KC</th>
                        <th class="px-3 py-2 text-right text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Total qty</th>
                        <th class="px-4 py-2 text-right text-[10px] uppercase tracking-wider text-slate-500 dark:text-white">Total value</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700/50">
                    @foreach (var e in Collection.Entries)
                    {
                        // Use the character's current in-game KC at this source so the
                        // luck statistic is "drops received vs expected at where you are
                        // now" — coherent for both single-drop spoons (1 in 17 KC at
                        // 1/1024 still flags strongly) and multi-drop items (8 in 515 KC
                        // at 1/50 lands as Dry, not a bogus Lucky-30x).
                        var luck = ComputeReceivedLuck(Collection.LuckObserved, e.TotalDrops, e.Rolls, e.RarityDenominator, e.RarityNumerator, e.EffectiveKcPerDrop);
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                            <td class="px-4 py-2 text-slate-800 dark:text-slate-100">
                                <span class="inline-flex items-center gap-1.5">
                                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(e.ItemName)" alt="@e.ItemName"
                                         class="w-4 h-4" loading="lazy" onerror="this.style.display='none'" />
                                    <span>@e.ItemName</span>
                                    @if (e.MarkedFirstTime)
                                    {
                                        <span class="ml-1 px-1 py-0 text-[9px] font-semibold rounded-sm bg-cyan-700 text-white">NEW</span>
                                    }
                                </span>
                            </td>
                            <td class="px-3 py-2 text-slate-500 dark:text-white text-xs font-mono">
                                @RenderRate(e.EffectiveRarity, e.Rarity, e.RarityNumerator, e.RarityDenominator, e.Rolls, e.EffectiveKcPerDrop)
                            </td>
                            <td class="px-3 py-2">
                                @if (luck is not null)
                                {
                                    <span class="relative group inline-block">
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium cursor-help @luck.PillClasses">@luck.Text</span>
                                        @RenderDistributionPopover(e.ItemName, Collection.LuckObserved, e.TotalDrops, e.Rolls, e.RarityNumerator, e.RarityDenominator, isReceived: true, firstDropKc: e.KillCount ?? e.KillOrdinal, effectiveKc: e.EffectiveKcPerDrop)
                                    </span>
                                }
                            </td>
                            <td class="px-3 py-2 text-right tabular-nums text-slate-700 dark:text-slate-200 text-xs">
                                <span title="Number of times this item dropped">×@e.TotalDrops</span>
                            </td>
                            <td class="px-3 py-2 text-right tabular-nums text-xs">
                                <span class="relative group inline-block">
                                    <span class="cursor-help">@RenderKcRange(e)</span>
                                    @RenderDropEventsPopover(e)
                                </span>
                            </td>
                            <td class="px-3 py-2 text-right tabular-nums text-slate-700 dark:text-slate-200 text-xs">@e.TotalQuantity.ToString("N0")</td>
                            <td class="px-4 py-2 text-right tabular-nums text-amber-600 dark:text-amber-400 font-medium text-xs">@GoldFormat.Format(e.TotalValue)</td>
                        </tr>
                    }
                    @foreach (var item in Collection.MissingItems)
                    {
                        var luck = ComputeMissingLuck(Collection.LuckObserved, item.Rolls, item.RarityDenominator, item.RarityNumerator, item.EffectiveKcPerDrop);
                        <tr class="opacity-60 hover:opacity-100 hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-opacity">
                            <td class="px-4 py-2 text-slate-500 dark:text-white">
                                <span class="inline-flex items-center gap-1.5">
                                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.ItemName)" alt="@item.ItemName"
                                         class="w-4 h-4 grayscale" loading="lazy" onerror="this.style.display='none'" />
                                    <span>@item.ItemName</span>
                                </span>
                            </td>
                            <td class="px-3 py-2 text-slate-500 dark:text-white text-xs font-mono">
                                @RenderRate(item.EffectiveRarity, item.Rarity, item.RarityNumerator, item.RarityDenominator, item.Rolls, item.EffectiveKcPerDrop)
                            </td>
                            <td class="px-3 py-2">
                                @if (luck is not null)
                                {
                                    <span class="relative group inline-block">
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium cursor-help @luck.PillClasses">@luck.Text</span>
                                        @RenderDistributionPopover(item.ItemName, Collection.LuckObserved, 0, item.Rolls, item.RarityNumerator, item.RarityDenominator, isReceived: false, firstDropKc: null, effectiveKc: item.EffectiveKcPerDrop)
                                    </span>
                                }
                            </td>
                            <td class="px-3 py-2 text-right text-slate-400 dark:text-white text-xs">×0</td>
                            <td class="px-3 py-2 text-right text-slate-400 dark:text-white text-xs">—</td>
                            <td class="px-3 py-2 text-right text-slate-400 dark:text-white text-xs">—</td>
                            <td class="px-4 py-2 text-right text-slate-400 dark:text-white text-xs">—</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public required SourceCollection Collection { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private string GetKillTabUrl() =>
        AppRoutes.LootLogSource.WithId(CharacterId).FromApi()
        + "?name=" + Uri.EscapeDataString(Collection.SourceName) + "&view=kills";

    private string GetCollectionTabUrl() =>
        AppRoutes.LootLogSourceCollection.WithId(CharacterId).FromApi()
        + "?name=" + Uri.EscapeDataString(Collection.SourceName);

    // User-facing page URLs written to the address bar (via inline history.replaceState on click)
    // so the active tab is reflected in the URL and survives refresh / is shareable — without
    // adding a history entry, so the page's Back button still returns to where the user came from.
    // (replaceState rather than hx-replace-url: the latter pushes a new entry when combined with
    // the Kill Log tab's hx-select, which would make Back step through tab switches.)
    private string GetCollectionPageUrl() =>
        AppRoutes.LootLogSource.WithId(CharacterId)
        + "?name=" + Uri.EscapeDataString(Collection.SourceName) + "&view=collection";

    private string GetKillPageUrl() =>
        AppRoutes.LootLogSource.WithId(CharacterId)
        + "?name=" + Uri.EscapeDataString(Collection.SourceName) + "&view=kills";

    // The Rate column shows the EFFECTIVE rate — the one the luck maths actually used, after the
    // source model (raid unique-table shares, Doom's per-run delve model) and any admin rate
    // modifier. That makes depth-modelled sources show a rate at all (they have no stored wiki
    // rate) and makes an admin override visible instead of silently applied. When the effective
    // rate differs from the raw wiki rate, the wiki value is kept alongside it so the override is
    // legible rather than looking like bad data.
    private RenderFragment RenderRate(string? effectiveRarity, string? wikiRarity, int? numerator, int? denominator, int rolls, double? effectiveKc) => __builder =>
    {
        var shown = !string.IsNullOrEmpty(effectiveRarity) ? effectiveRarity : wikiRarity;
        if (string.IsNullOrEmpty(shown)) return;

        // For a depth-modelled source the stored wiki value is ONE delve level's rate — Avernic
        // treads at 1/1,350 is the level-4 figure, improving every level to 1/540 by level 9 — so it
        // isn't comparable to a per-run figure and printing it alongside one reads as a contradiction.
        var overridden = !Collection.IsDepthModelled
                         && !string.IsNullOrEmpty(effectiveRarity)
                         && !string.IsNullOrEmpty(wikiRarity)
                         && !string.Equals(effectiveRarity, wikiRarity, StringComparison.OrdinalIgnoreCase);

        <span class="relative group inline-block">
            <span class="@(rolls > 1 ? "cursor-help underline decoration-dotted decoration-slate-400/50 underline-offset-2" : "")">@shown</span>
            @if (overridden)
            {
                <span class="ml-1 text-[10px] text-slate-400 dark:text-white" title="Wiki rate before this source's loot model and any admin rate adjustment">(wiki @wikiRarity)</span>
            }
            @RenderRollsPopover(shown, numerator, denominator, rolls, effectiveKc)
        </span>;
    };

    // Pre-computed factorials for the Poisson PMF — drop-rate charts never need k > 15
    // (kMax is capped at 12 visually), so a small fixed table is plenty.
    private static readonly double[] Factorials = InitFactorials();
    private static double[] InitFactorials()
    {
        var arr = new double[20];
        arr[0] = 1;
        for (var i = 1; i < arr.Length; i++) arr[i] = arr[i - 1] * i;
        return arr;
    }

    private static double PoissonPmf(int k, double lambda)
    {
        if (lambda <= 0) return k == 0 ? 1 : 0;
        if (k < 0 || k >= Factorials.Length) return 0;
        return Math.Exp(-lambda) * Math.Pow(lambda, k) / Factorials[k];
    }

    // Hover popover with two side-by-side charts telling distinct stories:
    //   • First-drop timing — geometric distribution centred at the expected first-
    //     drop KC (1/p_effective), marker at FirstKillCount for received items or at
    //     current KC for missing items. Answers "how lucky was the first drop, or how
    //     overdue am I?"
    //   • Drop count distribution — Poisson PMF for the count of drops at the
    //     character's current KC, bar at the actual count highlighted. Answers "given
    //     where I am, am I above or below the typical drop count?"
    // SVG bodies are emitted via MarkupString because Razor otherwise commandeers the
    // inner SVG <text> elements as its own markup escape.
    private RenderFragment RenderDistributionPopover(string itemName, int kc, int totalDrops, int rolls, int? numerator, int? denominator, bool isReceived, int? firstDropKc, double? effectiveKc) => __builder =>
    {
        if (kc <= 0) return;
        // Prefer the source-model-normalised expected KC (raids, multi-roll tables); fall back
        // to the raw per-roll rate only when the facade couldn't produce one.
        double pEffective;
        double expectedKc;
        if (effectiveKc is > 0)
        {
            expectedKc = effectiveKc.Value;
            pEffective = 1.0 / expectedKc;
        }
        else
        {
            if (denominator is null or 0) return;
            var num = numerator ?? 1;
            pEffective = (double)rolls * num / denominator.Value;
            if (pEffective <= 0) return;
            expectedKc = 1.0 / pEffective;
        }

        var firstChartMarker = isReceived && firstDropKc.HasValue ? firstDropKc.Value : kc;
        var firstChartCaption = isReceived ? "Got at KC " : "You · KC ";
        var firstSvg = BuildFirstDropSvg(expectedKc, firstChartMarker, firstChartCaption);
        var countSvg = BuildDropCountSvg(kc, pEffective, totalDrops);

        <div class="hidden group-hover:block absolute bottom-full left-0 z-40 pb-2 w-[800px]" role="tooltip">
            <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 shadow-xl p-3 space-y-2">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200 truncate">@itemName</span>
                    <span class="text-[11px] text-slate-500 dark:text-white whitespace-nowrap">
                        @totalDrops @(totalDrops == 1 ? "drop" : "drops") · KC @kc.ToString("N0")
                        @if (isReceived && firstDropKc.HasValue && firstDropKc.Value != kc)
                        {
                            <text> · first at @firstDropKc.Value.ToString("N0")</text>
                        }
                    </span>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-white mb-1">First drop timing</div>
                        @((MarkupString)firstSvg)
                    </div>
                    <div>
                        <div class="text-[10px] uppercase tracking-wide text-slate-500 dark:text-white mb-1">Drop count at @kc.ToString("N0") KC</div>
                        @((MarkupString)countSvg)
                    </div>
                </div>
            </div>
        </div>;
    };

    // Hover popover anchored to the KC column listing every individual drop event
    // (date + RuneLite KC or chronological ordinal). Empty for items where DropEvents
    // wasn't populated — keeps the cell behaving like a plain text cell.
    private RenderFragment RenderDropEventsPopover(CollectionEntry e) => __builder =>
    {
        if (e.DropEvents is null || e.DropEvents.Count == 0) return;

        <div class="hidden group-hover:block absolute bottom-full right-0 z-40 pb-2 w-[260px]" role="tooltip">
            <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 shadow-xl p-3 space-y-1.5 text-left">
                <div class="flex items-center justify-between text-[11px]">
                    <span class="font-semibold text-slate-700 dark:text-slate-200 truncate">@e.ItemName</span>
                    <span class="text-slate-500 dark:text-white">@e.TotalDrops.ToString("N0") @(e.TotalDrops == 1 ? "drop" : "drops")</span>
                </div>
                <ul class="max-h-72 overflow-y-auto themed-scrollbar divide-y divide-slate-200 dark:divide-slate-700/50 text-[11px]">
                    @foreach (var ev in e.DropEvents)
                    {
                        <li class="flex items-center justify-between gap-2 py-1">
                            <span class="text-slate-500 dark:text-white">@FormatLocal(ev.OccurredAt)</span>
                            <span class="font-mono tabular-nums">
                                @if (ev.KillCount is not null)
                                {
                                    <span class="text-slate-700 dark:text-slate-200">KC #@ev.KillCount.Value.ToString("N0")</span>
                                }
                                else if (ev.KillOrdinal is not null)
                                {
                                    <span class="text-slate-500 dark:text-white" title="Logged position (RuneLite didn't report KC)">#@ev.KillOrdinal.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-slate-400 dark:text-white">—</span>
                                }
                            </span>
                        </li>
                    }
                </ul>
                @if (e.TotalDrops > e.DropEvents.Count)
                {
                    <div class="text-[10px] text-slate-400 dark:text-white text-center pt-1.5 border-t border-slate-200 dark:border-slate-700/50">
                        Showing latest @e.DropEvents.Count of @e.TotalDrops.ToString("N0")
                    </div>
                }
            </div>
        </div>;
    };

    // Rolls popover — explains why the chart's expected KC isn't simply the row's
    // displayed denominator. Wiki rates are per-roll; many sources roll the rare
    // table multiple times per kill (Zulrah ×2, Vorkath ×2 for certain unique
    // tables, etc.). Only shown when rolls > 1 — single-roll items don't need
    // the clarification.
    private RenderFragment RenderRollsPopover(string rarity, int? numerator, int? denominator, int rolls, double? effectiveKc) => __builder =>
    {
        if (rolls <= 1) return;

        // Use the expected KC the row was already given by SourceLootService rather than
        // recomputing rolls x num/den here: a hand-rolled figure ignores the source model and
        // any admin rate modifier, so this popover would contradict the Rate column above it.
        // Falls back to the raw per-roll maths only when no effective rate could be derived.
        double? expectedKc = effectiveKc is > 0 ? effectiveKc : null;
        if (expectedKc is null && denominator is > 0 && numerator is > 0)
        {
            var p = (double)rolls * numerator.Value / denominator.Value;
            if (p > 0) expectedKc = 1.0 / p;
        }

        <div class="hidden group-hover:block absolute bottom-full left-0 z-40 pb-2 w-[260px]" role="tooltip">
            <div class="bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 shadow-xl p-3 space-y-1 text-[11px]">
                <div class="flex items-center justify-between font-semibold">
                    <span class="text-slate-700 dark:text-slate-200">Drop rate</span>
                    <span class="text-slate-500 dark:text-white">@rolls rolls / kill</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-slate-500 dark:text-white">Per roll</span>
                    <span class="font-mono text-slate-700 dark:text-slate-200">@rarity</span>
                </div>
                @if (expectedKc is not null)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500 dark:text-white">Per kill (≈)</span>
                        <span class="font-mono text-amber-600 dark:text-amber-400">1 / @expectedKc!.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-500 dark:text-white">Expected first drop</span>
                        <span class="font-mono text-slate-700 dark:text-slate-200">KC @expectedKc.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                }
                <div class="pt-1 mt-1 border-t border-slate-200 dark:border-slate-700/50 text-[10px] text-slate-500 dark:text-white">
                    Each kill rolls the rare table @rolls times, so the per-kill chance is roughly the per-roll rate × rolls.
                </div>
            </div>
        </div>;
    };

    // Chart A — first-drop distribution: a smooth normal-approximation bell of the
    // geometric "KC at first drop" distribution, with the character's relevant KC
    // (first-drop KC for received items, current KC for missing) marked in amber.
    private static string BuildFirstDropSvg(double expectedKc, int markerKc, string markerCaption)
    {
        // σ is a visual heuristic — the true variance of the geometric distribution is
        // (1-p)/p² ≈ expectedKc² which gives a wildly wide curve dominated by its tail.
        // Halving it produces a recognisable bell while keeping the character's KC in
        // a meaningful position relative to "expected".
        var sigma = Math.Max(expectedKc * 0.5, 1.0);
        const double xMin = 0.0;
        var xMax = Math.Max(expectedKc + 3 * sigma, Math.Max(markerKc * 1.05, expectedKc * 1.5));

        const int W = 380;
        const int H = 220;
        const int PadL = 16;
        const int PadR = 16;
        const int PadT = 24;
        const int PadB = 32;
        var plotW = W - PadL - PadR;
        var plotH = H - PadT - PadB;
        var inv = System.Globalization.CultureInfo.InvariantCulture;

        const int samples = 80;
        var line = new System.Text.StringBuilder();
        var area = new System.Text.StringBuilder();
        area.Append(PadL.ToString(inv)).Append(',').Append((PadT + plotH).ToString(inv)).Append(' ');
        for (var i = 0; i <= samples; i++)
        {
            var t = i / (double)samples;
            var x = xMin + t * (xMax - xMin);
            var f = Math.Exp(-Math.Pow(x - expectedKc, 2) / (2 * sigma * sigma));
            var px = PadL + t * plotW;
            var py = PadT + (1 - f) * plotH;
            if (i > 0) line.Append(' ');
            line.Append(px.ToString("0.##", inv)).Append(',').Append(py.ToString("0.##", inv));
            area.Append(px.ToString("0.##", inv)).Append(',').Append(py.ToString("0.##", inv)).Append(' ');
        }
        area.Append((PadL + plotW).ToString(inv)).Append(',').Append((PadT + plotH).ToString(inv));

        double XToPx(double x) => PadL + Math.Clamp((x - xMin) / (xMax - xMin), 0, 1) * plotW;
        var expectedX = XToPx(expectedKc);
        var markerX = XToPx(markerKc);
        var markerInRange = markerKc <= xMax + 0.5;

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 ").Append(W).Append(' ').Append(H).Append("\" class=\"w-full h-auto\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Drop rate distribution\">");
        sb.Append("<line x1=\"").Append(PadL).Append("\" y1=\"").Append(PadT + plotH).Append("\" x2=\"").Append(PadL + plotW).Append("\" y2=\"").Append(PadT + plotH).Append("\" stroke=\"#cbd5e1\" stroke-width=\"1\" />");
        sb.Append("<polygon points=\"").Append(area).Append("\" fill=\"#94a3b8\" opacity=\"0.18\" />");
        sb.Append("<polyline points=\"").Append(line).Append("\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.5\" />");
        // Expected first-drop KC (1/p_effective) — dashed slate marker
        sb.Append("<line x1=\"").Append(expectedX.ToString("0.##", inv)).Append("\" y1=\"").Append(PadT).Append("\" x2=\"").Append(expectedX.ToString("0.##", inv)).Append("\" y2=\"").Append(PadT + plotH).Append("\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"4 3\" />");
        sb.Append("<text x=\"").Append(expectedX.ToString("0.##", inv)).Append("\" y=\"").Append(PadT - 8).Append("\" text-anchor=\"middle\" font-size=\"12\" fill=\"#94a3b8\">Expected KC ").Append(expectedKc.ToString("0", inv)).Append("</text>");
        // Character marker — solid amber line, label depends on received vs missing.
        if (markerInRange)
        {
            sb.Append("<line x1=\"").Append(markerX.ToString("0.##", inv)).Append("\" y1=\"").Append(PadT).Append("\" x2=\"").Append(markerX.ToString("0.##", inv)).Append("\" y2=\"").Append(PadT + plotH).Append("\" stroke=\"#f59e0b\" stroke-width=\"2\" />");
            sb.Append("<text x=\"").Append(markerX.ToString("0.##", inv)).Append("\" y=\"").Append(PadT + plotH + 16).Append("\" text-anchor=\"middle\" font-size=\"12\" fill=\"#f59e0b\" font-weight=\"bold\">").Append(markerCaption).Append(markerKc.ToString("N0", inv)).Append("</text>");
        }
        else
        {
            sb.Append("<text x=\"").Append(PadL + plotW - 4).Append("\" y=\"").Append(PadT + 16).Append("\" text-anchor=\"end\" font-size=\"12\" fill=\"#f59e0b\" font-weight=\"bold\">").Append(markerCaption).Append(markerKc.ToString("N0", inv)).Append(" (off-chart →)</text>");
        }
        sb.Append("<text x=\"").Append(PadL).Append("\" y=\"").Append(H - 16).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#94a3b8\">0</text>");
        sb.Append("<text x=\"").Append(PadL + plotW).Append("\" y=\"").Append(H - 16).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#94a3b8\">").Append(xMax.ToString("0", inv)).Append("</text>");
        sb.Append("<text x=\"").Append(PadL + plotW / 2.0).Append("\" y=\"").Append(H - 4).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">kills</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    // Chart B — Poisson PMF over drop counts at the character's current KC. Each bar
    // is the probability of receiving exactly k drops; the bar at the character's
    // actual count is amber, the rest slate. Tells the user where they sit on the
    // overall-luck distribution given how many kills they've actually done.
    private static string BuildDropCountSvg(int kc, double pEffective, int totalDrops)
    {
        if (kc <= 0 || pEffective <= 0) return string.Empty;

        var lambda = kc * pEffective;
        var sigma = Math.Sqrt(lambda);
        // Cover the visible mass (~3σ each side of the peak) and always include the
        // character's actual count even if they're spectacularly spooned.
        var kMax = (int)Math.Ceiling(Math.Max(lambda + 3 * sigma, Math.Max(totalDrops + 1.5, 4)));
        kMax = Math.Min(kMax, 30);

        var pmf = new double[kMax + 1];
        var maxP = 0.0;
        for (var k = 0; k <= kMax; k++)
        {
            pmf[k] = PoissonPmf(k, lambda);
            if (pmf[k] > maxP) maxP = pmf[k];
        }
        if (maxP <= 0) return string.Empty;

        const int W = 380;
        const int H = 220;
        const int PadL = 16;
        const int PadR = 16;
        const int PadT = 24;
        const int PadB = 32;
        var plotW = W - PadL - PadR;
        var plotH = H - PadT - PadB;
        var inv = System.Globalization.CultureInfo.InvariantCulture;

        var barSlot = (double)plotW / (kMax + 1);
        var barW = barSlot * 0.75;
        var actualK = Math.Min(totalDrops, kMax);
        var actualInRange = totalDrops <= kMax;

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 ").Append(W).Append(' ').Append(H).Append("\" class=\"w-full h-auto\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Drop count distribution\">");
        // Baseline
        sb.Append("<line x1=\"").Append(PadL).Append("\" y1=\"").Append(PadT + plotH).Append("\" x2=\"").Append(PadL + plotW).Append("\" y2=\"").Append(PadT + plotH).Append("\" stroke=\"#cbd5e1\" stroke-width=\"1\" />");

        // Expected (λ) — dashed slate vertical at the continuous λ position.
        var lambdaX = PadL + Math.Min(lambda / (kMax + 1), 1.0) * plotW + barSlot / 2;
        sb.Append("<line x1=\"").Append(lambdaX.ToString("0.##", inv)).Append("\" y1=\"").Append(PadT).Append("\" x2=\"").Append(lambdaX.ToString("0.##", inv)).Append("\" y2=\"").Append(PadT + plotH).Append("\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"4 3\" />");
        sb.Append("<text x=\"").Append(lambdaX.ToString("0.##", inv)).Append("\" y=\"").Append(PadT - 8).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#94a3b8\">Expected ").Append(lambda.ToString("0.0", inv)).Append("</text>");

        // Bars
        for (var k = 0; k <= kMax; k++)
        {
            var h = pmf[k] / maxP * (plotH - 4);
            if (h < 0.6) h = 0.6;
            var x = PadL + k * barSlot + (barSlot - barW) / 2;
            var y = PadT + plotH - h;
            var isActual = actualInRange && k == actualK;
            sb.Append("<rect x=\"").Append(x.ToString("0.##", inv)).Append("\" y=\"").Append(y.ToString("0.##", inv)).Append("\" width=\"").Append(barW.ToString("0.##", inv)).Append("\" height=\"").Append(h.ToString("0.##", inv)).Append("\" fill=\"").Append(isActual ? "#f59e0b" : "#94a3b8").Append("\" opacity=\"").Append(isActual ? "1" : "0.45").Append("\" rx=\"1\" />");
        }

        // Actual count caption — under the highlighted bar.
        if (actualInRange)
        {
            var actualX = PadL + actualK * barSlot + barSlot / 2;
            sb.Append("<text x=\"").Append(actualX.ToString("0.##", inv)).Append("\" y=\"").Append(PadT + plotH + 14).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#f59e0b\" font-weight=\"bold\">You · ").Append(totalDrops).Append("</text>");
        }
        else
        {
            sb.Append("<text x=\"").Append(PadL + plotW - 4).Append("\" y=\"").Append(PadT + 14).Append("\" text-anchor=\"end\" font-size=\"11\" fill=\"#f59e0b\" font-weight=\"bold\">You · ").Append(totalDrops).Append(" (off-chart →)</text>");
        }

        // Axis endpoints
        sb.Append("<text x=\"").Append(PadL + barSlot / 2).Append("\" y=\"").Append(H - 16).Append("\" text-anchor=\"middle\" font-size=\"10\" fill=\"#94a3b8\">0</text>");
        sb.Append("<text x=\"").Append(PadL + plotW - barSlot / 2).Append("\" y=\"").Append(H - 16).Append("\" text-anchor=\"middle\" font-size=\"10\" fill=\"#94a3b8\">").Append(kMax).Append("</text>");
        sb.Append("<text x=\"").Append(PadL + plotW / 2.0).Append("\" y=\"").Append(H - 4).Append("\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">drops received</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    private RenderFragment RenderKcRange(CollectionEntry e) => __builder =>
    {
        // Depth-modelled sources are measured in delves everywhere else on this page, so a drop's
        // position must be converted too — a run number printed beside a per-delve rate invites
        // exactly the wrong comparison.
        var scale = Collection.DelvesPerRun;
        var first = (e.KillCount ?? e.KillOrdinal) * scale;
        var last = (e.LastKillCount ?? e.LastKillOrdinal) * scale;
        if (first is null && last is null)
        {
            <text><span class="text-slate-400 dark:text-white">—</span></text>
            return;
        }
        if (last is null || first == last)
        {
            <text><span class="text-slate-700 dark:text-slate-200">#@first!.Value.ToString("N0")</span></text>
            return;
        }
        <text>
            <span class="text-slate-500 dark:text-white">#@first!.Value.ToString("N0")</span>
            <span class="text-slate-400 dark:text-white"> → </span>
            <span class="text-slate-700 dark:text-slate-200">#@last.Value.ToString("N0")</span>
        </text>;
    };

    private sealed record LuckLabel(string Text, string PillClasses);

    // For items the character has received: compare actual count vs expected at current KC.
    // Always show when we have any drops + rate data — being spooned at low expected is the
    // most interesting case (e.g. a 1/3000 drop at 17 KC is a story worth telling).
    private static LuckLabel? ComputeReceivedLuck(int kc, int totalDrops, int rolls, int? denominator, int? numerator, double? effectiveKc)
    {
        if (kc <= 0 || totalDrops <= 0) return null;
        double expected;
        if (effectiveKc is > 0)
        {
            // Source-model expected drop count = current KC / expected kills-per-drop.
            expected = kc / effectiveKc.Value;
        }
        else
        {
            if (denominator is null or 0) return null;
            var num = numerator ?? 1;
            expected = (double)kc * rolls * num / denominator.Value;
        }
        if (expected <= 0) return null;
        var ratio = totalDrops / expected;
        if (ratio >= 1.5) return new LuckLabel($"Lucky {ratio:0.0}×", "bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300");
        if (ratio >= 0.85) return new LuckLabel("On rate", "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300");
        var dryRatio = 1.0 / Math.Max(ratio, 0.01);
        return new LuckLabel($"Dry {dryRatio:0.0}×", "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300");
    }

    // For missing items: only flag when meaningfully dry. Anything below 0.5 expected is
    // within normal variance and a pill would just add noise — leave the cell empty.
    private static LuckLabel? ComputeMissingLuck(int kc, int rolls, int? denominator, int? numerator, double? effectiveKc)
    {
        if (kc <= 0) return null;
        double expected;
        if (effectiveKc is > 0)
        {
            expected = kc / effectiveKc.Value;
        }
        else
        {
            if (denominator is null or 0) return null;
            var num = numerator ?? 1;
            expected = (double)kc * rolls * num / denominator.Value;
        }
        if (expected < 1.0) return null;
        if (expected < 2) return new LuckLabel($"Dry · {expected:0.0} expected", "bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300");
        return new LuckLabel($"Very dry · {expected:0.0} expected", "bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300");
    }

    private static string FormatLocal(DateTimeOffset t)
    {
        var local = IngestTimezone.ToZoneTime(t);
        return local.Year != DateTimeOffset.UtcNow.Year
            ? local.ToString("MMM d yyyy")
            : local.ToString("MMM d, HH:mm");
    }
}
