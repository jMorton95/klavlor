@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@($"KlavLor - {Header?.CharacterName ?? "Character"}")" Title="" Description="" />

<div class="space-y-6">
    @if (Header is not null)
    {
        <ProfileHeaderPanel Header="@Header" />
    }

    @if (Windows is not null)
    {
        <ProfileStatCards Windows="@Windows" />
    }

    <div hx-get="@(AppRoutes.LootLogCharacterHeatmap.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-32 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    <div hx-get="@(AppRoutes.LootLogCharacterRecords.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-24 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    @if (SearchResult is not null)
    {
        <LootLogGrid Result="@SearchResult" CharacterId="@CharacterId" UpdateHeader="false" Embedded="true" DryStreaks="@DryStreaks" />
    }

    <div hx-get="@(AppRoutes.LootLogCharacterRecentFirsts.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-28 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    <div hx-get="@(AppRoutes.LootLogCharacterTopItems.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-40 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public ProfileHeader? Header { get; set; }
    [Parameter] public ProfileWindowStats? Windows { get; set; }
    [Parameter] public LootLogSearchResult? SearchResult { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int>? DryStreaks { get; set; }
}
