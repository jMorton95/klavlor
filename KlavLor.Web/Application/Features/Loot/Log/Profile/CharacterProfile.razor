@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@($"KlavLor - {Header?.CharacterName ?? "Character"}")" Title="" Description="" />

<div class="space-y-6 pb-24">
    @* One full-width lifetime card: character header strip on top, last-7d / last-
       30d / all-time stats grid below. Inner panels render frameless via Embedded so
       there's a single visible card frame around the whole band. *@
    @if (Header is not null && Windows is not null)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 px-4 py-3 space-y-2.5">
            <ProfileHeaderPanel Header="@Header" Embedded="true" />
            <div class="border-t border-slate-200 dark:border-slate-700/60 pt-2.5">
                <ProfileStatCards Windows="@Windows" Embedded="true" />
            </div>
        </div>
    }
    else if (Header is not null)
    {
        <ProfileHeaderPanel Header="@Header" />
    }
    else if (Windows is not null)
    {
        <ProfileStatCards Windows="@Windows" />
    }

    @* Latest collection logs (recent firsts) *@
    <div hx-get="@(AppRoutes.LootLogCharacterRecentFirsts.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-60 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    @* Activity heatmap — kept silently because it pairs naturally with the trend chart. *@
    <div hx-get="@(AppRoutes.LootLogCharacterHeatmap.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="flex items-start justify-between mb-3 gap-2">
                <div class="space-y-2">
                    <div class="h-4 w-48 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
                    <div class="h-5 w-32 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
                </div>
                <div class="h-7 w-28 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
            <div class="h-[11.75rem] animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            <div class="mt-3 h-[15px] w-72 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    @* Monthly trend *@
    <div hx-get="@(AppRoutes.LootLogCharacterMonthly.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="flex items-start justify-between mb-3 gap-2">
                <div class="space-y-2">
                    <div class="h-4 w-44 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
                    <div class="h-5 w-56 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
                </div>
                <div class="h-7 w-36 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            </div>
            <div class="h-72 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
            <div class="mt-4 h-8 animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    @* Session history (lazy) — cross-source play sessions, newest first *@
    <div hx-get="@(AppRoutes.LootLogCharacterSessions.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-[26rem] animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>

    @* Link to the full per-character sources database, directly beneath the session history. *@
    <div class="flex justify-center">
        <a hx-get="@AppRoutes.LootLogCharacterSources.WithId(CharacterId).FromApi()"
           hx-target="#hx-page-container"
           hx-push-url="@AppRoutes.LootLogCharacterSources.WithId(CharacterId)"
           hx-swap="innerHTML transition:true"
           class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:border-amber-200 dark:hover:border-amber-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 cursor-pointer transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
            View all sources &amp; item search
        </a>
    </div>

    @* Lifetime item ranking *@
    <div hx-get="@(AppRoutes.LootLogCharacterTopItems.WithId(CharacterId).FromApi())"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
            <div class="h-[34rem] animate-pulse bg-slate-100 dark:bg-slate-800 rounded"></div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public ProfileHeader? Header { get; set; }
    [Parameter] public ProfileWindowStats? Windows { get; set; }
    [Parameter] public LootLogSearchResult? SearchResult { get; set; }
}
