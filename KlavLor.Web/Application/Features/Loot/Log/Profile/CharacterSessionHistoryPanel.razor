@using System.Linq
@using KlavLor.Application.Features.Loot.Log

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">Session history</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
        Recent play sessions across every source — consecutive kills grouped like the live feed. Click a session to see its kills.
    </p>

    @if (History.Sessions.Count == 0)
    {
        <p class="text-sm text-slate-400 dark:text-slate-500">No sessions recorded yet.</p>
    }
    else
    {
        <div id="char-session-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 items-start">
            @foreach (var cs in History.Sessions)
            {
                <LootLogSessionCard Session="cs.Session" CharacterId="CharacterId"
                                    SourceName="@cs.SourceName" SourceType="cs.SourceType"
                                    ShowSource="true" DomKey="@CharacterSessionKey.For(cs)" />
            }
        </div>
        @if (History.HasMore)
        {
            <div id="char-session-more" class="flex justify-center py-2 mt-1"
                 hx-get="@MoreUrl(2)" hx-target="#char-session-list" hx-swap="beforeend" hx-trigger="click">
                <button type="button"
                        class="px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                    Showing @History.Sessions.Count of @History.TotalSessions sessions
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public required CharacterSessionHistory History { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private string MoreUrl(int page) =>
        AppRoutes.LootLogCharacterSessions.WithId(CharacterId).FromApi() + $"?pageNumber={page}";
}
