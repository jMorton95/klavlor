@using System.Linq
@using KlavLor.Application.Features.Loot.Log

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-1">Session history</h2>
    <p class="text-sm text-slate-500 dark:text-white mb-3">
        Recent play sessions across every source — consecutive rolls grouped like the live feed. Click a session to see its rolls.
    </p>

    <CharacterSessionList History="History" CharacterId="CharacterId" PageNumber="1" />
</div>

@code {
    [Parameter] public required CharacterSessionHistory History { get; set; }
    [Parameter] public int CharacterId { get; set; }
}
