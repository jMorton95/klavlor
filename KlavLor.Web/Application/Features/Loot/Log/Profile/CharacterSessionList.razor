@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

@* Day-grouped session timeline: sessions stream newest-first down a single column, with a faint
   date header whenever the day changes, so the eye follows the history top-to-bottom. "Load more"
   re-renders this whole section (cumulative) so the day grouping stays correct across pages. *@
<div id="char-session-section">
    @if (History.Sessions.Count == 0)
    {
        <p class="text-sm text-slate-400 dark:text-white">No sessions recorded yet.</p>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var dayGroup in GroupedByDay)
            {
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-xs font-semibold text-slate-500 dark:text-white whitespace-nowrap">@DayLabel(dayGroup.Key)</span>
                        <span class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-2 items-start">
                        @foreach (var cs in dayGroup)
                        {
                            <LootLogSessionCard Session="cs.Session" CharacterId="CharacterId"
                                                SourceName="@cs.SourceName" SourceType="cs.SourceType"
                                                ShowSource="true" />
                        }
                    </div>
                </div>
            }
        </div>

        @if (History.HasMore)
        {
            <div class="flex justify-center py-2 mt-1"
                 hx-get="@MoreUrl(PageNumber + 1)" hx-target="#char-session-section" hx-swap="outerHTML" hx-trigger="click">
                <button type="button"
                        class="px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
                    Showing @History.Sessions.Count of @History.TotalSessions sessions
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public required CharacterSessionHistory History { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public int PageNumber { get; set; } = 1;

    // Sessions arrive newest-first; GroupBy preserves that order both across day-keys and within
    // each day, so days read newest-first and each day's sessions stay newest-first.
    private IEnumerable<IGrouping<DateOnly, CharacterSession>> GroupedByDay =>
        History.Sessions.GroupBy(cs => DateOnly.FromDateTime(IngestTimezone.ToZoneTime(cs.Session.StartedAt).DateTime));

    private static readonly DateOnly TodayLocal =
        DateOnly.FromDateTime(IngestTimezone.ToZoneTime(DateTimeOffset.UtcNow).DateTime);

    private static string DayLabel(DateOnly day)
    {
        if (day == TodayLocal) return "Today";
        if (day == TodayLocal.AddDays(-1)) return "Yesterday";
        var d = day.ToDateTime(TimeOnly.MinValue);
        return day.Year == TodayLocal.Year ? d.ToString("ddd d MMM") : d.ToString("ddd d MMM yyyy");
    }

    private string MoreUrl(int page) =>
        AppRoutes.LootLogCharacterSessions.WithId(CharacterId).FromApi() + $"?pageNumber={page}";
}
