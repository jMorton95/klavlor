@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log

@{
    var byDay = Data.Days.ToDictionary(d => d.Day);
    var dayCount = Data.To.DayNumber - Data.From.DayNumber + 1;

    // Align grid so the first column is the Monday of the week containing From.
    var firstDow = ((int)Data.From.DayOfWeek + 6) % 7; // Mon = 0 … Sun = 6
    var totalSlots = firstDow + dayCount;
    var weekCount = (totalSlots + 6) / 7;

    const int cell = 11;
    const int gap = 2;
    const int leftPad = 18; // weekday labels
    const int topPad = 14;  // month labels

    var width = leftPad + weekCount * (cell + gap);
    var height = topPad + 7 * (cell + gap);
}

<svg viewBox="0 0 @width @height" class="w-full" preserveAspectRatio="xMinYMid meet"
     aria-label="Activity heatmap" role="img">
    @for (var i = 0; i < dayCount; i++)
    {
        var day = Data.From.AddDays(i);
        var slot = firstDow + i;
        var col = slot / 7;
        var row = slot % 7;
        var x = leftPad + col * (cell + gap);
        var y = topPad + row * (cell + gap);

        var bucket = byDay.TryGetValue(day, out var b) ? b : new DayBucket(day, 0, 0);
        var fill = Data.Mode == HeatmapMode.Gp
            ? GetGpFill(bucket.Gp)
            : GetClogsFill(bucket.Clogs);
        var milestone = Data.Mode == HeatmapMode.Gp ? GetMilestoneStroke(bucket.Gp) : "";
        var dateLabel = day.ToString("ddd, d MMM yyyy");

        @if (bucket.Kills > 0)
        {
            <rect x="@x" y="@y" width="@cell" height="@cell" rx="2" class="heatmap-cell @fill @milestone cursor-pointer"
                  data-date="@dateLabel" data-gp="@GoldFormat.Format(bucket.Gp)" data-kills="@bucket.Kills.ToString("N0")" data-clogs="@bucket.Clogs.ToString("N0")"
                  hx-get="@AppRoutes.LootLogCharacterDay.WithId(CharacterId).WithDate(day).FromApi()"
                  hx-target="#hx-page-container"
                  hx-push-url="@AppRoutes.LootLogCharacterDay.WithId(CharacterId).WithDate(day)"
                  hx-swap="innerHTML transition:true" />
        }
        else
        {
            <rect x="@x" y="@y" width="@cell" height="@cell" rx="2" class="heatmap-cell @fill"
                  data-date="@dateLabel" data-empty="true" />
        }
    }

    @* Weekday labels: Mon / Wed / Fri *@
    <svg:text x="0" y="@(topPad + cell)" class="fill-slate-500 dark:fill-slate-400 text-[9px]">M</svg:text>
    <svg:text x="0" y="@(topPad + 2 * (cell + gap) + cell)" class="fill-slate-500 dark:fill-slate-400 text-[9px]">W</svg:text>
    <svg:text x="0" y="@(topPad + 4 * (cell + gap) + cell)" class="fill-slate-500 dark:fill-slate-400 text-[9px]">F</svg:text>
</svg>

<div class="flex items-center flex-wrap gap-x-3 gap-y-1 mt-3 text-[10px] text-slate-500 dark:text-white">
    @if (Data.Mode == HeatmapMode.Gp)
    {
        <span class="font-medium">GP / day</span>
        <span>Less</span>
        @foreach (var fill in GpLegend)
        {
            <svg width="10" height="10" class="shrink-0" aria-hidden="true"><rect width="10" height="10" rx="2" class="@fill" /></svg>
        }
        <span>More</span>
        <span class="text-slate-300 dark:text-slate-600" aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
            <svg width="12" height="12" class="shrink-0" aria-hidden="true"><rect x="1" y="1" width="10" height="10" rx="2" class="fill-transparent stroke-amber-500 dark:stroke-amber-400 stroke-1" /></svg>
            100M+
        </span>
        <span class="inline-flex items-center gap-1">
            <svg width="12" height="12" class="shrink-0" aria-hidden="true"><rect x="1" y="1" width="10" height="10" rx="2" class="fill-transparent stroke-purple-500 dark:stroke-purple-400 stroke-1" /></svg>
            250M+
        </span>
    }
    else
    {
        <span class="font-medium">New clogs / day</span>
        @foreach (var (label, fill) in ClogsLegend)
        {
            <span class="inline-flex items-center gap-1">
                <svg width="10" height="10" class="shrink-0" aria-hidden="true"><rect width="10" height="10" rx="2" class="@fill" /></svg>
                @label
            </span>
        }
    }
</div>

@code {
    [Parameter] public required HeatmapData Data { get; set; }
    [Parameter] public int CharacterId { get; set; }

    // Legend swatches reuse the exact fill classes used by the cells so colors stay in
    // lockstep and Tailwind already emits the classes.
    private static readonly string[] GpLegend =
    {
        "fill-emerald-200 dark:fill-emerald-900",
        "fill-emerald-300 dark:fill-emerald-800",
        "fill-emerald-400 dark:fill-emerald-700",
        "fill-emerald-500 dark:fill-emerald-600",
        "fill-emerald-600 dark:fill-emerald-500",
        "fill-emerald-700 dark:fill-emerald-400",
        "fill-emerald-800 dark:fill-emerald-300",
        "fill-emerald-900 dark:fill-emerald-200",
    };

    private static readonly (string Label, string Fill)[] ClogsLegend =
    {
        ("1", "fill-cyan-300 dark:fill-cyan-900"),
        ("2", "fill-cyan-400 dark:fill-cyan-700"),
        ("3", "fill-cyan-500 dark:fill-cyan-600"),
        ("4", "fill-cyan-600 dark:fill-cyan-500"),
        ("5+", "fill-cyan-700 dark:fill-cyan-400"),
    };

    // Daily GP ramp: starts at a visible emerald (not near-white) and climbs through many
    // explicit steps between 0 and 100M+ so the gradient rises slowly rather than maxing fast.
    private static string GetGpFill(long gp) => gp switch
    {
        <= 0            => "fill-slate-100 dark:fill-slate-800",
        < 50_000        => "fill-emerald-200 dark:fill-emerald-900",
        < 250_000       => "fill-emerald-300 dark:fill-emerald-800",
        < 1_000_000     => "fill-emerald-400 dark:fill-emerald-700",
        < 5_000_000     => "fill-emerald-500 dark:fill-emerald-600",
        < 25_000_000    => "fill-emerald-600 dark:fill-emerald-500",
        < 100_000_000   => "fill-emerald-700 dark:fill-emerald-400",
        < 500_000_000   => "fill-emerald-800 dark:fill-emerald-300",
        _               => "fill-emerald-900 dark:fill-emerald-200"
    };

    // New collection-log items that day — small absolute counts, cyan to match the "NEW" theme.
    private static string GetClogsFill(int clogs) => clogs switch
    {
        <= 0 => "fill-slate-100 dark:fill-slate-800",
        1    => "fill-cyan-300 dark:fill-cyan-900",
        2    => "fill-cyan-400 dark:fill-cyan-700",
        3    => "fill-cyan-500 dark:fill-cyan-600",
        4    => "fill-cyan-600 dark:fill-cyan-500",
        _    => "fill-cyan-700 dark:fill-cyan-400"
    };

    // Big-loot milestone ring around the day cell (GP mode only):
    // amber for 100M+, purple for 250M+ (purple takes precedence).
    private static string GetMilestoneStroke(long gp) => gp switch
    {
        >= 250_000_000 => "stroke-purple-500 dark:stroke-purple-400 stroke-1",
        >= 100_000_000 => "stroke-amber-500 dark:stroke-amber-400 stroke-1",
        _              => ""
    };
}
