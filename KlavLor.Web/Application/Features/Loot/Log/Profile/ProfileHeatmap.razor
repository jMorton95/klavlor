@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

<div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-start justify-between mb-3 flex-wrap gap-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Activity — last 365 days</h3>
            <p class="text-lg font-bold mt-0.5 leading-tight">
                @if (Data.Mode == HeatmapMode.Gp)
                {
                    <span class="text-amber-600 dark:text-amber-400 tabular-nums">@GoldFormat.Format(TotalGp)</span>
                    <span class="text-xs font-normal text-slate-400 dark:text-slate-500">earned</span>
                }
                else
                {
                    <span class="text-cyan-700 dark:text-cyan-300 tabular-nums">@TotalClogs.ToString("N0")</span>
                    <span class="text-xs font-normal text-slate-400 dark:text-slate-500">new collection log @(TotalClogs == 1 ? "item" : "items")</span>
                }
            </p>
        </div>
        <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
            <button type="button"
                    hx-get="@GetModeUrl(HeatmapMode.Gp)"
                    hx-target="closest div.bg-white"
                    hx-swap="outerHTML"
                    class="px-2 py-1 @(Data.Mode == HeatmapMode.Gp ? "bg-amber-500 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                GP
            </button>
            <button type="button"
                    hx-get="@GetModeUrl(HeatmapMode.Clogs)"
                    hx-target="closest div.bg-white"
                    hx-swap="outerHTML"
                    class="px-2 py-1 @(Data.Mode == HeatmapMode.Clogs ? "bg-cyan-600 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                Clogs
            </button>
        </div>
    </div>

    <HeatmapGrid Data="@Data" CharacterId="@CharacterId" />
</div>

@code {
    [Parameter] public required HeatmapData Data { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private long TotalGp => Data.Days.Sum(d => d.Gp);
    private int TotalClogs => Data.Days.Sum(d => d.Clogs);

    private string GetModeUrl(HeatmapMode mode) =>
        AppRoutes.LootLogCharacterHeatmap.WithId(CharacterId).FromApi()
        + "?mode=" + (mode == HeatmapMode.Gp ? "gp" : "clogs");
}
