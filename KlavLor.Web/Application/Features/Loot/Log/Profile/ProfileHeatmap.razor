@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

<div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Activity — last 365 days</h3>
        <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
            <button type="button"
                    hx-get="@GetModeUrl(HeatmapMode.Gp)"
                    hx-target="closest div.bg-white"
                    hx-swap="outerHTML"
                    class="px-2 py-1 @(Data.Mode == HeatmapMode.Gp ? "bg-amber-500 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                GP
            </button>
            <button type="button"
                    hx-get="@GetModeUrl(HeatmapMode.Kills)"
                    hx-target="closest div.bg-white"
                    hx-swap="outerHTML"
                    class="px-2 py-1 @(Data.Mode == HeatmapMode.Kills ? "bg-amber-500 text-white" : "bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                Kills
            </button>
        </div>
    </div>

    <HeatmapGrid Data="@Data" />
</div>

@code {
    [Parameter] public required HeatmapData Data { get; set; }
    [Parameter] public int CharacterId { get; set; }

    private string GetModeUrl(HeatmapMode mode) =>
        AppRoutes.LootLogCharacterHeatmap.WithId(CharacterId).FromApi()
        + "?mode=" + (mode == HeatmapMode.Gp ? "gp" : "kills");
}
