@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-start justify-between mb-3 flex-wrap gap-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">@Title</h3>
            <p class="text-lg font-bold mt-0.5 leading-tight">
                <span class="text-amber-600 dark:text-amber-400 tabular-nums">@GoldFormat.Format(TotalGp)</span>
                <span class="text-xs font-normal text-slate-500 dark:text-white">across @Trend.Months.Count(m => m.Kills > 0) active @(Trend.Months.Count(m => m.Kills > 0) == 1 ? "month" : "months")</span>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
                <button type="button"
                        hx-get="@GetTrendUrl("12m", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "12m" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    12 months
                </button>
                <button type="button"
                        hx-get="@GetTrendUrl("all", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "all" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    All time
                </button>
            </div>
            <button type="button"
                    hx-get="@GetTrendUrl(Trend.Range, !Expanded)"
                    hx-target="closest div.bg-slate-50"
                    hx-swap="outerHTML"
                    title="@(Expanded ? "Collapse to the compact chart" : $"Expand: every month at equal height for a per-item breakdown, naming the top {ExpandedTopN} items")"
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 dark:border-slate-700 text-[11px] @(Expanded ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    @if (Expanded)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 9L4 4m0 0v4m0-4h4m7 5l5-5m0 0v4m0-4h-4M9 15l-5 5m0 0v-4m0 4h4m7-5l5 5m0 0v-4m0 4h-4" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 1v4m0 0h-4m4 0l-5-5" />
                    }
                </svg>
                @(Expanded ? "Compact" : "Expand")
            </button>
        </div>
    </div>

    @if (Trend.Months.Count == 0 || TotalGp == 0)
    {
        <p class="text-xs text-slate-500 dark:text-white">No activity in this window yet.</p>
    }
    else
    {
        <HistogramBars Bars="@_bars" FormatValue="@(v => GoldFormat.Format(v))" ChartHeightPx="@(Expanded ? 810 : 270)" ShowInlineLabels="true" MinSegmentPx="@(Expanded ? 16 : 4)" MaxSegmentFraction="@(Expanded ? (double?)0.25 : null)" Normalize="@Expanded" />

        @if (_legend.Count > 0)
        {
            <div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-[10px] text-slate-500 dark:text-white">
                @foreach (var entry in _legend)
                {
                    <span class="inline-flex items-center gap-1.5">
                        <span class="inline-block w-2.5 h-2.5 rounded-sm @entry.FillClass"></span>
                        <span class="text-slate-600 dark:text-slate-300">@entry.ItemName</span>
                        <span class="text-slate-400 dark:text-white">· @entry.SourceName</span>
                    </span>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public required MonthlyTrend Trend { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public bool Expanded { get; set; }

    private const int CompactTopN = 10;
    private const int ExpandedTopN = 34;
    private int TopN => Expanded ? ExpandedTopN : CompactTopN;

    private long TotalGp => Trend.Months.Sum(m => m.Gp);

    private string Title => Trend.Range == "all" ? "Monthly trend — all time" : "Monthly trend — last 12 months";

    // Distinguishable Tailwind palette entries. Listed literally so Tailwind's
    // content scanner emits the classes (computed names wouldn't be picked up).
    // Order matters — earliest = top of legend = biggest globally-contributing item.
    // Compact mode uses the first 10 (all distinct hues); expanded mode continues
    // through the remaining hues, then darker shades of the same wheel. No pale
    // (-200/-300) shades: they wash out against the panel background.
    private static readonly string[] SegmentPalette =
    {
        "bg-amber-500 dark:bg-amber-400",
        "bg-emerald-500 dark:bg-emerald-400",
        "bg-cyan-500 dark:bg-cyan-400",
        "bg-violet-500 dark:bg-violet-400",
        "bg-rose-500 dark:bg-rose-400",
        "bg-blue-500 dark:bg-blue-400",
        "bg-orange-500 dark:bg-orange-400",
        "bg-pink-500 dark:bg-pink-400",
        "bg-teal-500 dark:bg-teal-400",
        "bg-lime-500 dark:bg-lime-400",
        "bg-red-500 dark:bg-red-400",
        "bg-yellow-500 dark:bg-yellow-400",
        "bg-green-500 dark:bg-green-400",
        "bg-sky-500 dark:bg-sky-400",
        "bg-indigo-500 dark:bg-indigo-400",
        "bg-purple-500 dark:bg-purple-400",
        "bg-fuchsia-500 dark:bg-fuchsia-400",
        "bg-amber-700 dark:bg-amber-600",
        "bg-emerald-700 dark:bg-emerald-600",
        "bg-cyan-700 dark:bg-cyan-600",
        "bg-violet-700 dark:bg-violet-600",
        "bg-rose-700 dark:bg-rose-600",
        "bg-blue-700 dark:bg-blue-600",
        "bg-orange-700 dark:bg-orange-600",
        "bg-pink-700 dark:bg-pink-600",
        "bg-teal-700 dark:bg-teal-600",
        "bg-lime-700 dark:bg-lime-600",
        "bg-red-700 dark:bg-red-600",
        "bg-yellow-700 dark:bg-yellow-600",
        "bg-green-700 dark:bg-green-600",
        "bg-sky-700 dark:bg-sky-600",
        "bg-indigo-700 dark:bg-indigo-600",
        "bg-purple-700 dark:bg-purple-600",
        "bg-fuchsia-700 dark:bg-fuchsia-600",
    };
    // Mid-grey both ways: slate-600 on the slate-900 panel read as "background",
    // making the (often large) Other block look like empty chart space.
    private const string OtherFill = "bg-slate-400 dark:bg-slate-500";

    private List<HistogramBars.Bar> _bars = [];
    private List<LegendEntry> _legend = [];

    private sealed record LegendEntry(string ItemName, string SourceName, string FillClass);

    protected override void OnParametersSet()
    {
        // Aggregate each (item, source) across visible months so we can pick a stable
        // top-N for colouring. Anything outside the top-N collapses into "Other" within
        // each bar — keeps the legend readable for multi-year all-time views.
        var totals = new Dictionary<(string Item, string Source), long>();
        foreach (var month in Trend.Months)
        {
            foreach (var seg in month.TopSegments)
            {
                var key = (seg.ItemName, seg.SourceName);
                totals.TryGetValue(key, out var existing);
                totals[key] = existing + seg.Value;
            }
        }

        var top = totals
            .OrderByDescending(kv => kv.Value)
            .Take(Math.Min(TopN, SegmentPalette.Length))
            .Select((kv, i) => (kv.Key, FillClass: SegmentPalette[i]))
            .ToList();

        var fillByKey = top.ToDictionary(t => t.Key, t => t.FillClass);

        _legend = top
            .Select(t => new LegendEntry(t.Key.Item, t.Key.Source, t.FillClass))
            .ToList();

        _bars = new List<HistogramBars.Bar>(Trend.Months.Count);
        int? lastYearLabelled = null;
        for (var i = 0; i < Trend.Months.Count; i++)
        {
            var m = Trend.Months[i];
            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month);
            var label = (i == 0 || m.Month == 1 || lastYearLabelled != m.Year)
                ? $"{monthShort} '{(m.Year % 100):D2}"
                : monthShort;
            lastYearLabelled = m.Year;

            // Stack: named segments first (descending value), "Other" at top to absorb
            // everything not in the global top-N including non-top-10 long-tail items.
            var segments = new List<HistogramBars.BarSegment>();
            var outsiders = new List<HistogramBars.BarSegment>();
            long namedTotal = 0;
            foreach (var seg in m.TopSegments.OrderByDescending(s => s.Value))
            {
                if (fillByKey.TryGetValue((seg.ItemName, seg.SourceName), out var fill))
                {
                    segments.Add(new HistogramBars.BarSegment(
                        Label: $"{seg.ItemName} · {seg.SourceName} — {GoldFormat.Format(seg.Value)}",
                        Value: seg.Value,
                        FillClass: fill,
                        ItemName: seg.ItemName,
                        SourceName: seg.SourceName,
                        ValueText: GoldFormat.Format(seg.Value),
                        IconUrl: "/api/images/item-icon?name=" + Uri.EscapeDataString(seg.ItemName)));
                    namedTotal += seg.Value;
                }
                else
                {
                    outsiders.Add(new HistogramBars.BarSegment(
                        Label: $"{seg.ItemName} · {seg.SourceName} — {GoldFormat.Format(seg.Value)}",
                        Value: seg.Value,
                        FillClass: OtherFill,
                        ItemName: seg.ItemName,
                        SourceName: seg.SourceName,
                        ValueText: GoldFormat.Format(seg.Value)));
                }
            }
            var other = Math.Max(0, m.Gp - namedTotal);
            if (other > 0)
            {
                segments.Add(new HistogramBars.BarSegment(
                    Label: $"Other — {GoldFormat.Format(other)}",
                    Value: other,
                    FillClass: OtherFill,
                    ItemName: "Other",
                    SourceName: $"items outside the top {TopN}",
                    ValueText: GoldFormat.Format(other),
                    OverflowItems: outsiders.Count > 0 ? outsiders : null));
            }

            var tooltip = $"{monthShort} {m.Year} — {GoldFormat.Format(m.Gp)} gp · {m.Kills:N0} kills"
                + (m.Clogs > 0 ? $" · {m.Clogs:N0} clog{(m.Clogs == 1 ? "" : "s")}" : "");

            _bars.Add(new HistogramBars.Bar(
                Label: label,
                Value: m.Gp,
                Tooltip: tooltip,
                Segments: segments.Count > 0 ? segments : null));
        }
    }

    private string GetTrendUrl(string range, bool expanded) =>
        AppRoutes.LootLogCharacterMonthly.WithId(CharacterId).FromApi()
        + "?range=" + range + (expanded ? "&size=expanded" : "");
}
