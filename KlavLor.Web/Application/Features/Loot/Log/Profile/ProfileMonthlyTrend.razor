@using System.Globalization
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Log
@using KlavLor.Web.Application.Features.Loot.Log.Profile.Svg

<div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
    <div class="flex items-start justify-between mb-3 flex-wrap gap-2">
        <div>
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">@Title</h3>
            <p class="text-lg font-bold mt-0.5 leading-tight">
                <span class="text-amber-600 dark:text-amber-400 tabular-nums">@GoldFormat.Format(TotalGp)</span>
                <span class="text-xs font-normal text-slate-500 dark:text-white">across @Trend.Months.Count(m => m.Kills > 0) active @(Trend.Months.Count(m => m.Kills > 0) == 1 ? "month" : "months")</span>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-[11px]">
                <button type="button"
                        hx-get="@GetTrendUrl("12m", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "12m" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    12 months
                </button>
                <button type="button"
                        hx-get="@GetTrendUrl("all", Expanded)"
                        hx-target="closest div.bg-slate-50"
                        hx-swap="outerHTML"
                        class="px-2 py-1 @(Trend.Range == "all" ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                    All time
                </button>
            </div>
            <button type="button"
                    hx-get="@GetTrendUrl(Trend.Range, !Expanded)"
                    hx-target="closest div.bg-slate-50"
                    hx-swap="outerHTML"
                    title="@(Expanded ? "Back to the standard chart" : $"Expand: double the height, naming the top {ExpandedMinPerMonth} items in every month instead of {StandardMinPerMonth}")"
                    class="inline-flex items-center gap-1 px-2 py-1 rounded-md border border-slate-200 dark:border-slate-700 text-[11px] @(Expanded ? "bg-amber-500 text-white" : "bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300")">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    @if (Expanded)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 9L4 4m0 0v4m0-4h4m7 5l5-5m0 0v4m0-4h-4M9 15l-5 5m0 0v-4m0 4h4m7-5l5 5m0 0v-4m0 4h-4" />
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 1v4m0 0h-4m4 0l-5-5" />
                    }
                </svg>
                @(Expanded ? "Collapse" : "Expand")
            </button>
        </div>
    </div>

    @if (Trend.Months.Count == 0 || TotalGp == 0)
    {
        <p class="text-xs text-slate-500 dark:text-white">No activity in this window yet.</p>
    }
    else
    {
        @* The detailed chart IS the default now — the old short, linear, mostly-unlabelled compact
           view is gone. Expanded doubles the height on top of that, which is what buys room for
           twice as many named items per month. Both use the compressed scale and the 16px minimum
           segment, so a block is always tall enough to carry its own icon and name. *@
        <HistogramBars Bars="@_bars" FormatValue="@(v => GoldFormat.Format(v))"
                       ChartHeightPx="@(Expanded ? ExpandedHeightPx : StandardHeightPx)"
                       ShowInlineLabels="true"
                       MinSegmentPx="16"
                       MaxSegmentFraction="0.25"
                       Scale="HistogramBars.BarScaleMode.Compressed" />

        <p class="text-[10px] text-slate-500 dark:text-white mt-2">
            Bar heights use a compressed scale so a quiet month is still readable next to a record one — the order is unchanged and every bar prints its true total above itself. Within a bar, no single item takes more than a quarter of the height; its real share is on the tooltip.
        </p>

        @* No legend on either view. Every named block carries its own icon and label, so a list of
           40-odd swatches was pure noise — and by that depth the palette reuses shades, which would
           make the swatches actively misleading. *@
    }
</div>

@code {
    [Parameter] public required MonthlyTrend Trend { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public bool Expanded { get; set; }

    // The standard view is what used to be the expanded one. Expanded now doubles both the height
    // and how much gets named, so the two differ only in scale — there is no longer a coarse,
    // unlabelled glance mode.
    private const int StandardHeightPx = 900;
    private const int ExpandedHeightPx = 1800;

    private const int StandardTopN = 40;
    private const int ExpandedTopN = 80;
    private int TopN => Expanded ? ExpandedTopN : StandardTopN;

    // Minimum named items per month, on top of the global top-N. Without this a month whose
    // contributors all sat outside the overall top-N drew as a single grey "Other" block, so the
    // chart could be almost entirely unnamed. This is the figure the toggle actually advertises,
    // because it is the one guaranteed per bar — the global top-N competes with it for palette slots.
    private const int StandardMinPerMonth = 8;
    private const int ExpandedMinPerMonth = 16;
    private int MinPerMonth => Expanded ? ExpandedMinPerMonth : StandardMinPerMonth;

    private long TotalGp => Trend.Months.Sum(m => m.Gp);

    private string Title => Trend.Range == "all" ? "Monthly trend — all time" : "Monthly trend — last 12 months";

    private List<HistogramBars.Bar> _bars = [];

    protected override void OnParametersSet()
    {
        // Colour is keyed on the ITEM ALONE, deliberately. Segments are grouped per item across
        // sources now, so the source field is a description of that aggregate ("3 sources") and can
        // legitimately differ from month to month for the same item — keying on it would give Coins
        // one colour in a month it came from one source and another in a month it came from five.
        var perMonth = Trend.Months
            .Select(m => (IReadOnlyList<((string Item, string Source) Key, long Value)>)m.TopSegments
                .Select(s => (((string, string))(s.ItemName, ""), s.Value))
                .ToList())
            .ToList();

        var top = StackPalette.Assign(perMonth, TopN, MinPerMonth);
        var styleByKey = top.ToDictionary(t => t.Key, t => t.Style);

        _bars = new List<HistogramBars.Bar>(Trend.Months.Count);
        int? lastYearLabelled = null;
        for (var i = 0; i < Trend.Months.Count; i++)
        {
            var m = Trend.Months[i];
            var monthShort = CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Month);
            var label = (i == 0 || m.Month == 1 || lastYearLabelled != m.Year)
                ? $"{monthShort} '{(m.Year % 100):D2}"
                : monthShort;
            lastYearLabelled = m.Year;

            // Stack: named segments first (descending value), "Other" at top to absorb
            // everything unnamed, including the long tail the query didn't return.
            var segments = new List<HistogramBars.BarSegment>();
            var outsiders = new List<HistogramBars.BarSegment>();
            long namedTotal = 0;
            foreach (var seg in m.TopSegments.OrderByDescending(s => s.Value))
            {
                if (styleByKey.TryGetValue((seg.ItemName, ""), out var style))
                {
                    segments.Add(new HistogramBars.BarSegment(
                        Label: $"{seg.ItemName} · {seg.SourceName} — {GoldFormat.Format(seg.Value)}",
                        Value: seg.Value,
                        FillClass: style.Fill,
                        ItemName: seg.ItemName,
                        SourceName: seg.SourceName,
                        ValueText: GoldFormat.Format(seg.Value),
                        IconUrl: "/api/images/item-icon?name=" + Uri.EscapeDataString(seg.ItemName),
                        TextClass: style.Text));
                    namedTotal += seg.Value;
                }
                else
                {
                    outsiders.Add(new HistogramBars.BarSegment(
                        Label: $"{seg.ItemName} · {seg.SourceName} — {GoldFormat.Format(seg.Value)}",
                        Value: seg.Value,
                        FillClass: StackPalette.Other.Fill,
                        ItemName: seg.ItemName,
                        SourceName: seg.SourceName,
                        ValueText: GoldFormat.Format(seg.Value),
                        TextClass: StackPalette.Other.Text));
                }
            }
            var other = Math.Max(0, m.Gp - namedTotal);
            if (other > 0)
            {
                segments.Add(new HistogramBars.BarSegment(
                    Label: $"Other — {GoldFormat.Format(other)}",
                    Value: other,
                    FillClass: StackPalette.Other.Fill,
                    ItemName: "Other",
                    SourceName: "everything else this month",
                    ValueText: GoldFormat.Format(other),
                    OverflowItems: outsiders.Count > 0 ? outsiders : null,
                    TextClass: StackPalette.Other.Text));
            }

            var tooltip = $"{monthShort} {m.Year} — {GoldFormat.Format(m.Gp)} gp · {m.Kills:N0} rolls"
                + (m.Clogs > 0 ? $" · {m.Clogs:N0} clog{(m.Clogs == 1 ? "" : "s")}" : "");

            _bars.Add(new HistogramBars.Bar(
                Label: label,
                Value: m.Gp,
                Tooltip: tooltip,
                Segments: segments.Count > 0 ? segments : null));
        }
    }

    private string GetTrendUrl(string range, bool expanded) =>
        AppRoutes.LootLogCharacterMonthly.WithId(CharacterId).FromApi()
        + "?range=" + range + (expanded ? "&size=expanded" : "");
}
