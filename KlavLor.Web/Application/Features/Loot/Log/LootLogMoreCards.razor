@using KlavLor.Application.Features.Loot.Log

@foreach (var source in Result.SourceMatches)
{
    <LootSourceCard Source="@source" CharacterId="@CharacterId" />
}

@if (Result.HasMore)
{
    <div id="show-more-sources" hx-swap-oob="true"
         class="flex justify-center py-2"
         hx-get="@GetNextUrl()" hx-target="#source-cards" hx-swap="beforeend" hx-trigger="click">
        <button type="button"
                class="px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer">
            @if (Result.TotalCount > 0)
            {
                <span>Showing @(PageNumber * Result.SourceMatches.Count) of @Result.TotalCount</span>
            }
            else
            {
                <span>Show More</span>
            }
        </button>
    </div>
}
else
{
    <div id="show-more-sources" hx-swap-oob="true"></div>
}

@code {
    [Parameter] public required LootLogSearchResult Result { get; set; }
    [Parameter] public int CharacterId { get; set; }
    [Parameter] public int PageNumber { get; set; }

    private string GetNextUrl()
    {
        var url = AppRoutes.LootLogCharacter.WithId(CharacterId).FromApi() + $"?pageNumber={PageNumber + 1}";
        if (!string.IsNullOrEmpty(Result.SearchTerm))
            url += $"&searchTerm={Uri.EscapeDataString(Result.SearchTerm)}";
        return url;
    }
}
