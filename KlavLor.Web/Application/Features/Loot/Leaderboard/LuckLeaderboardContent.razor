@{
    var spoonUrl = AppRoutes.LootLeaderboardResults.FromApi() + "?board=Spoon";
    var dryUrl = AppRoutes.LootLeaderboardResults.FromApi() + "?board=DryStreak";
}

<div class="max-w-3xl mx-auto p-4 sm:p-6">
    <p class="text-sm text-slate-500 dark:text-white mb-4">
        The luckiest spoons and the driest streaks across every tracked account. Collection-log items only, ranked by how many multiples off the expected kill count each drop was, with rarer grinds winning ties. Dry streaks include items players are still chasing. Rebuilt hourly.
    </p>

    <div class="inline-flex rounded-md border border-slate-200 dark:border-slate-700 overflow-hidden text-sm mb-4">
        <button type="button"
                hx-get="@spoonUrl"
                hx-target="#lb-results"
                hx-swap="innerHTML"
                class="lb-tab px-3 py-1.5 bg-amber-500 text-white">
            Spoons
        </button>
        <button type="button"
                hx-get="@dryUrl"
                hx-target="#lb-results"
                hx-swap="innerHTML"
                class="lb-tab px-3 py-1.5 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300">
            Dry streaks
        </button>
    </div>

    <div id="lb-results" hx-get="@spoonUrl" hx-trigger="load" hx-swap="innerHTML">
        <div class="h-24 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-lg"></div>
    </div>
</div>
