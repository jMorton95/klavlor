@using KlavLor.Application.Features.Loot.Superiors
@using KlavLor.Web.Application.Features.Loot.Feed

@* EVERY UNIQUE-TABLE RECEIPT, newest first, as a commit history.

   THIS IS THE PAGE'S ONLY REAL CONTENT, in the sense that it is the only thing here not determined
   by one constant. Superior counts are base-monster kills over a fixed 190:1 — measured at r² 0.9997
   across 134 cells — so the table beside this restates a single quantity however it is drawn. A
   receipt is a rare event with real variance: who got it, from what, on which kill, and when.

   It is a HISTORY, not a list of kills. The table already says how many superiors everyone has
   killed; repeating that here in another shape would be the third spelling of one number. What this
   carries is the payoff — 25 events across five months — and the gaps between them, which is the
   part nobody can read off a count.

   Drawn as a rail with a node per receipt, after PropelVulnerabilityTracker's ScanHistoryTimeline:
   the node is the item itself, so the column can be skimmed for "what fell" without reading a word,
   and a month divider gives the run of them a sense of pace. Each entry names its SOURCE, because
   the feed runs across all 38 monsters — that is what a per-row column could not do, and it is why
   this reads as the clan's history rather than one monster's footnote. *@

@* No card. It sits flush against the table as the continuation of the same band, with only the
   divider between them, because it stands in for a column of that table rather than accompanying
   it. Its header lines up with the table's header row: the same background, the same height. *@
<section>
    @* ONE BAND, not two. The title and the tally used to be separate rows with a rule between
       them, so this side of the seam ruled twice — at 220px and 254px — against the table's single
       rule at 248px. Both bands now live inside one header whose height is pinned to the table's
       (.superior-head, see app.css), so the two halves rule once, together. *@
    <header class="superior-head-panel flex flex-col justify-center gap-1 px-4 bg-slate-100 dark:bg-slate-800
                   border-y border-slate-200 dark:border-slate-700">
        <div class="flex items-baseline justify-between gap-3">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-white">
                Unique table history
            </span>
            <span class="text-[11px] font-semibold tabular-nums text-amber-600 dark:text-amber-400">
                @Drops.Count received
            </span>
        </div>

        @if (Drops.Count > 0)
        {
            @* A tally before the history: four items, and which of them the clan has actually seen
               is a faster read than counting down the entries. *@
            <div class="flex flex-wrap items-center gap-x-4 gap-y-0.5 overflow-hidden">
                @foreach (var item in SuperiorSlayerMonsters.UniqueTable)
                {
                    var count = Drops.Count(d => string.Equals(d.ItemName, item, StringComparison.OrdinalIgnoreCase));
                    <span class="inline-flex items-center gap-1.5 text-[11px] @(count > 0 ? "text-slate-700 dark:text-slate-200" : "text-slate-400 dark:text-slate-600")">
                        <span class="w-1.5 h-1.5 rounded-full @DotClasses(item, count > 0)"></span>
                        @item
                        <span class="font-semibold tabular-nums">@count</span>
                    </span>
                }
            </div>
        }
    </header>

    @if (Drops.Count == 0)
    {
        <p class="px-4 py-8 text-center text-xs text-slate-500 dark:text-white">
            No unique-table drops yet. They are rare enough that the first one is an event.
        </p>
    }
    else
    {
        <div class="superior-timeline relative px-4 py-4">
            @* THE RAIL. One absolutely-positioned element rather than a border on every node.
               Its offset is derived (.superior-rail = gutter + half a node), not measured, so it
               cannot drift off the nodes when the padding or the node size changes — which is
               exactly how the month dots ended up 16px to the right of it. *@
            <div class="superior-rail absolute top-[1.5625rem] bottom-[2.3125rem] w-px
                        bg-slate-200 dark:bg-slate-600"></div>

            @foreach (var month in Drops.GroupBy(d => new DateTime(d.OccurredAt.ToLocalTime().Year, d.OccurredAt.ToLocalTime().Month, 1)))
            {
                @* The "Commits on ..." divider. It carries the month's own count, so a quiet month
                   reads as quiet rather than just short.

                   It sits in the SAME node slot an entry uses, so its dot lands on the rail and its
                   label starts on the same left edge as every card below it. It used to position
                   the dot with its own margin, which was measured from the content box while the
                   rail is measured from the border box — one page gutter apart, every time. *@
                <div class="relative flex items-center gap-3 mb-2 first:mt-0 mt-4">
                    <span class="superior-node-slot">
                        <span class="relative z-10 w-[1.125rem] h-[1.125rem] rounded-full
                                     border-2 border-slate-300 dark:border-slate-500 bg-white dark:bg-slate-900"></span>
                    </span>
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-white">
                        @month.Key.ToString("MMMM yyyy")
                    </span>
                    <span class="text-[11px] tabular-nums text-slate-400 dark:text-white">
                        @month.Count() received
                    </span>
                </div>

                <div class="space-y-1.5">
                    @foreach (var drop in month)
                    {
                        <div class="relative flex items-center gap-3">

                            @* THE NODE IS THE ITEM. A ring of coloured dots would need a key; the
                               icon needs none, and it is what makes the column skimmable for "what
                               fell" without reading a line of it. *@
                            <span class="superior-node-slot">
                                <span class="relative z-10 w-[2.625rem] h-[2.625rem] rounded-full flex items-center justify-center
                                             border-2 @NodeClasses(drop)">
                                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(drop.ItemName)" alt=""
                                         class="w-6 h-6 object-contain" loading="lazy"
                                         onerror="this.style.visibility='hidden'" />
                                </span>
                            </span>

                            @* A GRID, not a flex row. Four fixed-width columns and a flex-1 in the
                               middle gave the source a 506px cell to hold about 120px of text, so
                               every line had a hole in it and the dates floated alone at the far
                               edge. Fractional tracks spread the surplus across all four instead,
                               which is what makes the columns read as columns. The minmax floors
                               stop them collapsing when this segment is narrow. *@
                            <div class="superior-receipt flex-1 min-w-0 rounded-lg border px-3.5 py-2 transition-colors @CardClasses(drop)">

                                <span class="text-[13px] font-semibold truncate @NameClasses(drop)">@drop.ItemName</span>

                                @* The character in their own colour, the same assignment the live
                                   ticker uses - RollChipHues is a process-lifetime map, so a name is
                                   the same hue on both surfaces. *@
                                <span class="min-w-0 flex items-center gap-1.5 roll-name-text @RollChipHues.ClassFor(drop.CharacterName)">
                                    <span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>
                                    <span class="text-[12px] font-medium truncate">@drop.CharacterName</span>
                                </span>

                                <span class="min-w-0 text-[12px] text-slate-500 dark:text-white truncate">
                                    @drop.SourceName
                                    @if (drop.KillOrdinal > 0)
                                    {
                                        @* Their Nth of that superior, which is the figure that says
                                           whether this was a quick one or a long wait. *@
                                        <span class="ml-1 font-mono tabular-nums text-amber-600 dark:text-amber-400">#@drop.KillOrdinal.ToString("N0")</span>
                                    }
                                </span>

                                <span class="text-right text-[11px] tabular-nums text-slate-400 dark:text-white">
                                    @drop.OccurredAt.ToLocalTime().ToString("d MMM yy")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<SuperiorUniqueDrop> Drops { get; set; } = [];

    /// The two rare ones carry the amber the page uses for a receipt; the battlestaves are common
    /// enough that giving them equal weight would make an Imbued heart look like a Tuesday.
    private static bool IsRare(SuperiorUniqueDrop drop) => SuperiorSlayerMonsters.UniqueRank(drop.ItemName) <= 1;

    private static string NameClasses(SuperiorUniqueDrop drop) =>
        IsRare(drop) ? "text-amber-600 dark:text-amber-400" : "text-slate-800 dark:text-slate-100";

    /// The node carries the whole rarity cue, so an Imbued heart is findable by glancing down the
    /// rail rather than by reading names.
    private static string NodeClasses(SuperiorUniqueDrop drop) => IsRare(drop)
        ? "border-amber-400 bg-amber-50 dark:bg-amber-500/15 shadow-[0_0_0_3px_rgba(251,191,36,0.18)]"
        : "border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900";

    private static string CardClasses(SuperiorUniqueDrop drop) => IsRare(drop)
        ? "border-amber-300/70 dark:border-amber-500/40 bg-amber-50/60 dark:bg-amber-500/5"
        : "border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800/60";

    private static string DotClasses(string item, bool seen)
    {
        if (!seen) return "bg-slate-300 dark:bg-slate-700";
        return SuperiorSlayerMonsters.UniqueRank(item) <= 1
            ? "bg-amber-400 dark:bg-amber-300"
            : "bg-sky-400 dark:bg-sky-300";
    }
}
