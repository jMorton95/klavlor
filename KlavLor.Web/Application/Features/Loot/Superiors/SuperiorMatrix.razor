@using KlavLor.Application.Features.Loot.Superiors

@* The comparison itself: one row per superior anyone has killed, one column per character.

   THE COLUMNS ARE TIGHT AND THE SHARE BAR TAKES THE REST. This is the fourth layout and the first
   that spends the width on something rather than on padding. The first stretched fixed columns and
   dumped the surplus into an empty trailing SPACER — a third of the page blank. The second split
   the rows into two blocks side by side, which filled the page by cutting the comparison in half.
   The third gave the surplus to the data columns as percentages, which is what the original note
   warned about: it did not remove the gap, it moved it inside the cells, leaving a two-digit number
   floating in a 326px column. Measured, 6.8% of the table's area had any text on it.

   So the counts get only the width they need and the bar column is given no width at all — under
   table-fixed an unsized column absorbs whatever is left, so the bar grows with the window and the
   table meets both edges at any size, with the extra pixels carrying information rather than air.

   THERE IS NO CHART COLUMN. It was an activity sparkline, and before that four different bar
   metrics, all of them chasing the same problem: superior counts are base kills over a fixed
   190:1, so every magnitude derived from them is one quantity restated. The receipts are the only
   thing on this page not determined by that constant, and they now have a panel of their own
   beside the table rather than a marker squeezed onto a line - see SuperiorsContent.

   What survives from the chart is its HOVER CARD, moved onto the monster name: the per-character
   breakdown it carries is the one thing the grid genuinely cannot show, because a cell has room
   for a number and nothing else.

   Monster names are deliberately NOT links. The global source page (/source?name=…) is behind the
   User policy while this page is anonymous, so a link would 401-redirect a signed-out visitor. *@

<div class="overflow-x-auto themed-scrollbar">
    <table class="w-full table-fixed border-collapse text-sm" style="min-width:@MinWidth">
        <colgroup>
            <col style="width:16rem" />
            @foreach (var _ in Comparison.Characters)
            {
                <col style="width:8.5rem" />
            }
            @* No width: table-fixed hands this column everything left over. *@
            <col />
        </colgroup>
        <thead>
            @* NOT sticky, and it cannot be. The overflow-x wrapper above is a scroll container, so
               it — not the viewport — is what a sticky header inside it resolves against: `top-16`
               offset the header 64px DOWN from the table's own top instead of pinning it to the
               page, leaving a blank band above it at scroll zero. *@
            @* Every header sorts. The link carries the whole sort in the query string and pushes it,
               so a sorted view is linkable, survives a refresh and steps back through Back. Clicking
               the column you are already sorted by flips the direction. *@
            <tr>
                <th class="@HeadCell text-left border-y border-slate-200 dark:border-slate-700">
                    <a hx-get="@SortUrl(null).FromApi()" hx-target="#hx-page-container"
                       hx-push-url="@SortUrl(null)" hx-swap="innerHTML transition:true"
                       href="@SortUrl(null)"
                       title="Sort by Slayer level, hardest first"
                       class="inline-flex items-center gap-1 cursor-pointer text-[11px] font-semibold uppercase tracking-wide @(Sort.IsByLevel ? "text-amber-600 dark:text-amber-400" : "text-slate-500 dark:text-white hover:text-amber-600 dark:hover:text-amber-400") transition-colors">
                        Superior @SortMark(Sort.IsByLevel)
                    </a>
                </th>
                @foreach (var character in Comparison.Characters)
                {
                    <th class="@HeadCell text-center border-y border-slate-200 dark:border-slate-700">
                        <a hx-get="@SortUrl(character.GameCharacterId).FromApi()" hx-target="#hx-page-container"
                           hx-push-url="@SortUrl(character.GameCharacterId)" hx-swap="innerHTML transition:true"
                           href="@SortUrl(character.GameCharacterId)"
                           class="block cursor-pointer group">
                            @* No colour key any more: the bar stopped being per character, so a dot
                               here would key nothing. *@
                            <div class="text-xs font-semibold truncate transition-colors @(Sort.IsBy(character.GameCharacterId) ? "text-amber-600 dark:text-amber-400" : "text-slate-800 dark:text-slate-100 group-hover:text-amber-600 dark:group-hover:text-amber-400")">
                                @character.CharacterName @SortMark(Sort.IsBy(character.GameCharacterId))
                            </div>
                            @* The column's own total, which is why there is no footer. *@
                            <div class="text-[10px] font-normal tabular-nums text-slate-500 dark:text-white">@character.TotalKills.ToString("N0") kills</div>
                            @* THE OUTCOME, next to the effort. The only figure in this header that
                               is not the kill count restated. *@
                            @if (character.UniquesReceived.Count > 0)
                            {
                                <div class="text-[10px] font-medium tabular-nums text-amber-600 dark:text-amber-400"
                                     title="@UniquesTitle(character)">
                                    @character.UniquesReceived.Count @(character.UniquesReceived.Count == 1 ? "unique" : "uniques")
                                </div>
                            }
                            else
                            {
                                <div class="text-[10px] font-normal text-slate-400 dark:text-white">no uniques yet</div>
                            }
                        </a>
                    </th>
                }
                @* Clan total per monster. Without it nothing totals a ROW. *@
                <th class="@HeadCell text-center border-y border-slate-200 dark:border-slate-700">
                    <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-white">Clan</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Comparison.Rows)
            {
                <tr class="border-b border-slate-200/60 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
                    @* THE HOVER TARGET, now that the chart it used to hang off is gone. The card is
                       pre-rendered and hidden here; site.js lifts it into a fixed panel, which it
                       has to, because the overflow-x wrapper around this table is a scroll
                       container and would clip an absolutely positioned one. *@
                    <td class="px-4 py-2.5">
                        <div class="superior-card hidden">
                            <div class="sc-head">
                                <span class="sc-name">@row.Name</span>
                                <span class="sc-sub">Slayer @row.SlayerLevel &middot; from @string.Join(" / ", row.BaseMonsters)</span>
                            </div>

                            <table class="sc-table">
                                <thead>
                                    <tr>
                                        <th>Character</th>
                                        <th class="sc-num">Kills</th>
                                        <th class="sc-num">Uniques</th>
                                        <th>First</th>
                                        <th>Last</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var character in Comparison.Characters)
                                    {
                                        var cell = row.CellFor(character.GameCharacterId);
                                        var theirs = row.Uniques.Where(u => u.GameCharacterId == character.GameCharacterId).ToList();
                                        <tr class="@(cell is null ? "sc-absent" : null)">
                                            <td>@character.CharacterName</td>
                                            <td class="sc-num">@(cell is null ? "–" : cell.Kills.ToString("N0"))</td>
                                            <td class="sc-num @(theirs.Count > 0 ? "sc-got" : null)">
                                                @(theirs.Count > 0 ? theirs.Count.ToString() : "–")
                                            </td>
                                            <td>@(cell is null ? "never on task" : cell.FirstKilled.ToLocalTime().ToString("d MMM yy"))</td>
                                            <td>@(cell is null ? "" : cell.LastKilled.ToLocalTime().ToString("d MMM yy"))</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Clan</td>
                                        <td class="sc-num">@row.TotalKills.ToString("N0")</td>
                                        <td class="sc-num @(row.Uniques.Count > 0 ? "sc-got" : null)">
                                            @(row.Uniques.Count > 0 ? row.Uniques.Count.ToString() : "–")
                                        </td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>

                            @* The receipts in full. A count of three says nothing about whether it
                               was three battlestaves or a heart. *@
                            @if (row.Uniques.Count > 0)
                            {
                                <div class="sc-drops">
                                    @foreach (var drop in row.Uniques)
                                    {
                                        <div class="sc-drop">
                                            <span class="sc-dot @(SuperiorSlayerMonsters.UniqueRank(drop.ItemName) <= 1 ? "sc-rare" : "sc-common")"></span>
                                            <span class="sc-item">@drop.ItemName</span>
                                            <span class="sc-who">@drop.CharacterName</span>
                                            <span class="sc-when">@drop.OccurredAt.ToLocalTime().ToString("d MMM yy")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="superior-chart flex items-center gap-2.5 min-w-0">
                            <img src="/api/images/source-icon?name=@Uri.EscapeDataString(row.Name)" alt=""
                                 class="w-6 h-6 object-contain shrink-0" loading="lazy" onerror="this.style.visibility='hidden'" />
                            <div class="min-w-0">
                                <div class="text-[13px] font-medium text-slate-800 dark:text-slate-100 truncate leading-tight">@row.Name</div>
                                @* Just the name. How many of the base monster have been killed is a
                                   per-player figure and lives in each player's own cell — a single
                                   roster total here could not say whose grind it was. *@
                                <div class="text-[10px] text-slate-500 dark:text-white truncate leading-tight">
                                    from @string.Join(" / ", row.BaseMonsters)
                                </div>
                            </div>
                        </div>
                    </td>

                    @foreach (var character in Comparison.Characters)
                    {
                        var cell = row.CellFor(character.GameCharacterId);
                        var baseKills = row.BaseKillsFor(character.GameCharacterId);
                        @* Every count reads the same. Highlighting the row leader turned a set of
                           facts into a scoreboard, which is not what this page is for. *@
                        <td class="px-2 py-2.5 text-center tabular-nums text-[13px] text-slate-700 dark:text-slate-200"
                            title="@CellTitle(row, character, cell, baseKills)">
                            @* A zero and a never-killed are the same fact here, and a wall of zeros
                               buries the counts that matter — so both render as a dash. *@
                            @if (cell is null || cell.Kills == 0)
                            {
                                <span class="text-slate-300 dark:text-slate-700">–</span>
                            }
                            else
                            {
                                <span class="font-medium">@cell.Kills.ToString("N0")</span>
                                @* THIS player's kills of the base monster, on the SAME LINE — the
                                   grind their superior count sits on top of. "from N", not "of N":
                                   68 superiors turned up over the course of 12,920 Hydra, which
                                   "of" made read as a fraction of a total. Abbreviated because
                                   inline it has to share a cell; the exact figure is in the
                                   tooltip. Omitted, never zeroed, when we hold nothing there. *@
                                @if (baseKills > 0)
                                {
                                    <span class="ml-1 text-[10px] font-normal text-slate-400 dark:text-white">from @Compact(baseKills)</span>
                                }
                            }
                        </td>
                    }

                    @* The roster's total for this monster, which is the row's own sum. It briefly
                       lived inside the chart cell as that bar's label, and came back out to a
                       column of its own when the chart went. *@
                    <td class="px-4 py-2.5 text-center tabular-nums text-[13px] font-medium text-slate-600 dark:text-slate-300">
                        @row.TotalKills.ToString("N0")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public SuperiorComparison Comparison { get; set; } = SuperiorComparison.Empty;

    /// The ordering the rows are actually in, which the comparison carries so it cannot disagree
    /// with them — an unknown character id falls back to Slayer level inside the handler.
    private SuperiorSort Sort => Comparison.Ordering;

    /// The two rare ones are worth their own colour; the battlestaves are common enough that giving
    /// them the same weight would make an Imbued heart look like a Tuesday.
    private static string UniqueClasses(SuperiorUniqueDrop drop) =>
        SuperiorSlayerMonsters.UniqueRank(drop.ItemName) <= 1
            ? "bg-amber-400 dark:bg-amber-300"
            : "bg-sky-400/90 dark:bg-sky-300/90";

    /// Every receipt spelled out, because a count of 13 says nothing about whether it was thirteen
    /// battlestaves or two hearts.
    private static string UniquesTitle(SuperiorCharacterColumn character) =>
        $"{character.CharacterName}: "
      + string.Join(", ", character.UniquesReceived
            .GroupBy(u => u.ItemName)
            .OrderBy(g => SuperiorSlayerMonsters.UniqueRank(g.Key))
            .Select(g => $"{g.Count()}x {g.Key}"))
      + $" from {character.TotalKills:N0} superiors";

    /// The named columns plus a floor for the bar, below which the table scrolls inside its wrapper
    /// rather than squeezing the counts. The bar is the column that gives, because it is the only
    /// one whose meaning survives being narrower.
    private string MinWidth => $"{24 + Comparison.Characters.Count * 8.5:0.##}rem";

    /// Shared by every header cell.
    private const string HeadCell = "bg-slate-100 dark:bg-slate-800 px-3 py-2";

    /// Base-monster counts share a cell with the superior count now, so they are abbreviated. The
    /// exact figure is one hover away and the rounded one is all the line is really saying: that
    /// the superior came out of a grind of about this size.
    private static string Compact(long value) => value switch
    {
        >= 1_000_000 => $"{value / 1_000_000d:0.#}m",
        >= 10_000 => $"{value / 1_000d:0}k",
        >= 1_000 => $"{value / 1_000d:0.#}k",
        _ => value.ToString("N0")
    };

    /// Clicking the active column flips direction; clicking any other switches to it, descending —
    /// "most first" is what you want from a fresh column, every time.
    private string SortUrl(int? characterId)
    {
        var active = characterId is null ? Sort.IsByLevel : Sort.IsBy(characterId.Value);
        var ascending = active && !Sort.Ascending;

        var query = new List<string>();
        if (characterId is { } id) query.Add($"characterId={id}");
        if (ascending) query.Add("asc=true");

        return query.Count == 0
            ? AppRoutes.LootSuperiors
            : $"{AppRoutes.LootSuperiors}?{string.Join("&", query)}";
    }

    private MarkupString SortMark(bool active) =>
        new(active ? (Sort.Ascending ? "&uarr;" : "&darr;") : "");

    // First and last killed live in the tooltip rather than in columns of their own, along with
    // the Slayer level and the unabbreviated base-monster count.
    private static string CellTitle(
        SuperiorMonsterRow row, SuperiorCharacterColumn character, SuperiorCell? cell, long baseKills)
    {
        var bases = string.Join(" / ", row.BaseMonsters);

        if (cell is null)
        {
            return baseKills > 0
                ? $"{character.CharacterName} has killed {baseKills:N0} {bases} and never seen a {row.Name}"
                : $"{character.CharacterName} has not killed a {row.Name}";
        }

        var grind = baseKills > 0 ? $" from {baseKills:N0} {bases} killed" : "";
        return $"{character.CharacterName} got {cell.Kills:N0} {row.Name}{grind} · "
             + $"first {Date(cell.FirstKilled)}, last {Date(cell.LastKilled)} · Slayer {row.SlayerLevel}";
    }

    private static string Date(DateTimeOffset at) => at.ToLocalTime().ToString("d MMM yyyy");
}
