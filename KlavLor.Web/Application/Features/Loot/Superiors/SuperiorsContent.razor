@using KlavLor.Application.Common
@using KlavLor.Application.Features.Loot.Superiors
@using KlavLor.Web.Components.Layout

@* Emitted only when served as a standalone content fragment (in-app HTMX nav), so it OOB-swaps the
   top-bar title/heading. The routable page passes UpdateHeader=false because PageLayout already set
   them on the first full render. *@
@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Superior Slayer Monsters"
                    Title="Superior Slayer Monsters"
                    Description="Every superior slayer monster by Slayer level, across every tracked character" />
}

@* TRULY full bleed. "Full bleed" used to mean only that no max-width container was added — the
   app-wide 16px page gutter on #hx-page-container still held the table off both edges, which on a
   page that is one wide table read as a mistake. The negative margin cancels that gutter for this
   page alone; every other page keeps it.

   The page is now a HEADER STRIP over a two-column body. It was a bare table on the raw page
   background, which is what made it read as unfinished: nothing framed it, nothing summarised it,
   and the wide screen had nowhere to put anything. The strip states the totals a visitor wants
   before reading 38 rows; the body gives the table the width it needs and the receipts the rest. *@
<div class="pb-32 -mx-4">

    @if (Comparison.Rows.Count == 0)
    {
        <div class="mx-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-12 text-center">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">No superiors tracked yet</h3>
            <p class="text-sm text-slate-500 dark:text-white max-w-lg mx-auto">
                Nothing has killed a superior slayer monster since tracking began. They spawn rarely,
                so it can take a while for the first one to appear.
            </p>
        </div>
    }
    else
    {
        @* ONE FLUSH BAND: the table takes the width of its columns, the receipts segment takes
           everything to the right of them, and the pair meets both edges of the page. No page
           padding and no gap between them - the segment sits exactly where the chart column used to,
           which is what it replaced. A gap and a rounded card made it read as a separate widget
           parked beside the table rather than as part of it.

           Stacks below xl, where the two can no longer share a line. *@
        @* .superior-band draws the two horizontal rules of the header band ITSELF, across the full
           width, rather than letting each half draw its own — see app.css. *@
        <div class="superior-band flex flex-col xl:flex-row items-stretch">
            <div class="shrink-0 max-w-full">
                <SuperiorMatrix Comparison="Comparison" />
            </div>
            <div class="flex-1 min-w-0 border-t xl:border-t-0 xl:border-l border-slate-200 dark:border-slate-800">
                <SuperiorUniquesPanel Drops="Comparison.RecentUniques" />
            </div>
        </div>
    }
</div>

@code {
    /// True when served as an HTMX fragment (emits the OOB header); false inside PageLayout, which
    /// renders the header itself. Without this an in-app navigation draws the title twice.
    [Parameter] public bool UpdateHeader { get; set; } = true;

    [Parameter] public SuperiorComparison Comparison { get; set; } = SuperiorComparison.Empty;
}
