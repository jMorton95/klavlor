@using KlavLor.Application.Features.Loot.Superiors
@using KlavLor.Web.Components.Layout

@* Emitted only when served as a standalone content fragment (in-app HTMX nav), so it OOB-swaps the
   top-bar title/heading. The routable page passes UpdateHeader=false because PageLayout already set
   them on the first full render. *@
@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Superior Slayer Monsters"
                    Title="Superior Slayer Monsters"
                    Description="Every superior slayer monster by Slayer level, across every tracked character" />
}

@* THE SHELL, AND IT ASKS THE DATABASE NOTHING. Both halves fetch themselves on load, each in its
   own request scope, so the page paints immediately and the two queries run in parallel. It used to
   render everything during SSR: nothing appeared at all until every query had run and 239KB of
   markup had been built — measured at 1.25s on a cold process.

   The two halves share one cached aggregate, so the pair still costs one set of queries — see
   SuperiorSlayerEndpoint.

   TRULY full bleed. "Full bleed" used to mean only that no max-width container was added — the
   app-wide 16px page gutter on #hx-page-container still held the table off both edges, which on a
   page that is one wide table read as a mistake. The negative margin cancels that gutter for this
   page alone; every other page keeps it. *@
<div class="pb-32 -mx-4">

    @* .superior-band draws the two horizontal rules of the header band ITSELF, across the full
       width, rather than letting each half draw its own — see app.css. It lives on the SHELL, so
       the rules are in place before either half arrives and do not move when they do. *@
    <div class="superior-band flex flex-col xl:flex-row items-stretch">

        @* Each placeholder carries the id and the layout classes its panel re-declares, so an
           outerHTML swap lands in exactly the same box. The skeletons are sized to the real thing
           rather than to a spinner: this band is the whole page, and a frame that collapses and
           re-expands is worse than a still one. *@
        <div id="superiors-table"
             class="shrink-0 max-w-full"
             hx-get="@(AppRoutes.LootSuperiorsTable.FromApi() + SortQuery())"
             hx-trigger="load"
             hx-swap="outerHTML">
            <div class="superior-head bg-slate-100 dark:bg-slate-800"></div>
            <div class="w-[55rem] max-w-full px-4 py-3 space-y-3">
                @for (var i = 0; i < 12; i++)
                {
                    <div class="h-6 rounded bg-slate-100 dark:bg-slate-800/60"></div>
                }
            </div>
        </div>

        <div id="superiors-receipts"
             class="flex-1 min-w-0"
             hx-get="@AppRoutes.LootSuperiorsReceipts.FromApi()"
             hx-trigger="load"
             hx-swap="outerHTML">
            <div class="superior-head-panel bg-slate-100 dark:bg-slate-800"></div>
            <div class="px-4 py-4 space-y-2">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="h-10 rounded-lg bg-slate-100 dark:bg-slate-800/60"></div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// True when served as an HTMX fragment (emits the OOB header); false inside PageLayout, which
    /// renders the header itself. Without this an in-app navigation draws the title twice.
    [Parameter] public bool UpdateHeader { get; set; } = true;

    /// The sort, carried through to the table's own fetch so a direct load of a sorted URL and an
    /// in-app navigation to it request the same ordering. The receipts take no sort — an ordering
    /// only reorders the table.
    [Parameter] public int? CharacterId { get; set; }

    [Parameter] public bool? Asc { get; set; }

    private string SortQuery()
    {
        var parts = new List<string>();
        if (CharacterId is { } id) parts.Add($"characterId={id}");
        if (Asc == true) parts.Add("asc=true");
        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }
}
