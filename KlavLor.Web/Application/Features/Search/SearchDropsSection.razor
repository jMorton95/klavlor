@using KlavLor.Application.Common
@using KlavLor.Application.Features.Search

<SearchSectionFrame Title="Drops" Count="Results.Count">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-2">
        @foreach (var d in Results)
        {
            <a hx-get="@SourceUrl(d.TopSourceName).FromApi()"
               hx-target="#hx-page-container"
               hx-push-url="@SourceUrl(d.TopSourceName)"
               hx-swap="innerHTML transition:true"
               class="flex items-center gap-2 bg-slate-50 dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700 px-3 py-2 hover:border-amber-200 dark:hover:border-amber-700 transition-colors cursor-pointer">
                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(d.ItemName)" alt="@d.ItemName"
                     class="w-5 h-5 shrink-0" loading="lazy" onerror="this.style.display='none'" />
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate">
                            @d.ItemName
                            @if (d.TotalQuantity > 1)
                            {
                                <span class="text-slate-400 dark:text-slate-500 font-normal">×@d.TotalQuantity.ToString("N0")</span>
                            }
                        </span>
                        <span class="text-amber-600 dark:text-amber-400 font-medium text-xs whitespace-nowrap shrink-0">@GoldFormat.Format(d.TotalValue)</span>
                    </div>
                    <span class="block text-xs text-slate-400 dark:text-slate-500 truncate">
                        @if (d.SourceCount > 1)
                        {
                            <text>@d.SourceCount sources · mostly @d.TopSourceName</text>
                        }
                        else
                        {
                            <text>from @d.TopSourceName</text>
                        }
                    </span>
                </div>
            </a>
        }
    </div>
</SearchSectionFrame>

@code {
    [Parameter] public List<SearchDropResult> Results { get; set; } = [];

    private static string SourceUrl(string sourceName) => AppRoutes.Source + "?name=" + Uri.EscapeDataString(sourceName);
}
