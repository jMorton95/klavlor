@using KlavLor.Application.Features.Characters
@using KlavLor.Web.Components.Layout

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Characters" Title="My Characters" Description="Manage your RuneLite characters" />
}

<div class="space-y-4">
    @if (Characters is not null && Characters.Count > 0)
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">
            Characters are automatically created when your sync tool sends loot data. Set a display name and control visibility below.
        </p>
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">RuneLite ID</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Display Name</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Visible</th>
                        @if (Characters.Any(c => c.IsAdminHidden))
                        {
                            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Admin Hidden</th>
                        }
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var character in Characters)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                            <td class="px-4 py-3 text-sm font-mono text-slate-700 dark:text-slate-300">@character.RuneLiteId</td>
                            <td class="px-4 py-3">
                                <form hx-post="@AppRoutes.CharacterUpdateName.WithId(character.Id).FromApi()"
                                      hx-target="#hx-page-container"
                                      hx-swap="innerHTML transition:true"
                                      class="flex items-center gap-2">
                                    <input type="text" name="displayName" value="@character.DisplayName"
                                           placeholder="Enter display name..."
                                           class="px-2 py-1 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded focus:ring-1 focus:ring-amber-500 focus:border-amber-500 outline-none w-40" />
                                    <button type="submit" class="px-2 py-1 text-xs font-medium text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300 cursor-pointer">Save</button>
                                </form>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button hx-post="@AppRoutes.CharacterToggleVisibility.WithId(character.Id).FromApi()"
                                        hx-target="#hx-page-container"
                                        hx-swap="innerHTML transition:true"
                                        class="cursor-pointer">
                                    @if (character.IsVisible)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300">Visible</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">Hidden</span>
                                    }
                                </button>
                            </td>
                            @if (Characters.Any(c => c.IsAdminHidden))
                            {
                                <td class="px-4 py-3 text-center">
                                    @if (character.IsAdminHidden)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-900/50 text-red-700 dark:text-red-300">Admin Hidden</span>
                                    }
                                </td>
                            }
                            <td class="px-4 py-3 text-right">
                                <button hx-post="@AppRoutes.AdminCharacterAssign.WithId(character.Id).FromApi()"
                                        hx-target="#hx-page-container"
                                        hx-swap="innerHTML transition:true"
                                        class="text-xs text-slate-500 hover:text-amber-600 dark:text-slate-400 dark:hover:text-amber-400 cursor-pointer"
                                        title="Assign all unassigned loot records to this character">
                                    Assign Unassigned
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <div class="flex justify-center mb-4">
                <div class="p-4 bg-amber-50 dark:bg-amber-950 rounded-full">
                    <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">No characters yet</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">Characters will appear here once you sync loot data using the klavlor-sync tool.</p>
        </div>
    }
</div>

@code {
    [Parameter] public List<CharacterSummary>? Characters { get; set; }
    [Parameter] public bool UpdateHeader { get; set; } = true;
}
