@using KlavLor.Application.Features.Characters
@using KlavLor.Web.Components.Layout

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Characters" Title="My Characters" Description="Manage your game characters" />
}

<div class="space-y-6">
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 rounded-lg p-3">
            <p class="text-sm text-red-700 dark:text-red-300">@ErrorMessage</p>
        </div>
    }

    @if (Characters is not null && Characters.Count > 0)
    {
        <p class="text-sm text-slate-500 dark:text-slate-400">
            Characters are created automatically when your sync tool sends loot data. Give each one a display name so others can identify you.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
            @foreach (var character in Characters)
            {
                <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-5 space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-linear-to-br from-amber-500 to-orange-600 rounded-full flex items-center justify-center">
                                <span class="text-white font-bold text-sm">@(IsPlaceholderName(character.DisplayName) ? "?" : character.DisplayName![0])</span>
                            </div>
                            <div>
                                <h3 class="font-semibold @(IsPlaceholderName(character.DisplayName) ? "text-slate-400 dark:text-slate-500 italic" : "text-slate-900 dark:text-slate-100")">@(IsPlaceholderName(character.DisplayName) ? "Set a display name" : character.DisplayName)</h3>
                                <p class="text-xs text-slate-400 dark:text-slate-500 font-mono">@character.RuneLiteId</p>
                            </div>
                        </div>
                        <button hx-post="@AppRoutes.CharacterToggleVisibility.WithId(character.Id).FromApi()"
                                hx-target="#hx-page-container"
                                hx-swap="innerHTML transition:true"
                                class="cursor-pointer"
                                title="Toggle visibility in the loot feed and drop logs">
                            @if (character.IsVisible)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                                    Visible
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"/><path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"/></svg>
                                    Hidden
                                </span>
                            }
                        </button>
                    </div>

                    @if (character.IsAdminHidden)
                    {
                        <div class="bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                            <p class="text-xs text-red-600 dark:text-red-400">Hidden by administrator</p>
                        </div>
                    }

                    <form hx-post="@AppRoutes.CharacterUpdateName.WithId(character.Id).FromApi()"
                          hx-target="#hx-page-container"
                          hx-swap="innerHTML transition:true"
                          class="space-y-2">
                        <label class="block text-xs font-medium text-slate-500 dark:text-slate-400">Display Name</label>
                        <div class="flex gap-2">
                            <input type="text" name="displayName" value="@(IsPlaceholderName(character.DisplayName) ? "" : character.DisplayName)"
                                   placeholder="Enter a name for this character..."
                                   class="flex-1 px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
                            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors cursor-pointer">Save</button>
                        </div>
                    </form>

                    @if (UnassignedCount > 0)
                    {
                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                            <div class="flex items-center justify-between">
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    You have <span class="font-medium text-amber-600 dark:text-amber-400">@UnassignedCount.ToString("N0")</span> loot record@(UnassignedCount != 1 ? "s" : "") from before character tracking was enabled.
                                </p>
                                <button hx-post="@AppRoutes.AdminCharacterAssign.WithId(character.Id).FromApi()"
                                        hx-target="#hx-page-container"
                                        hx-swap="innerHTML transition:true"
                                        class="ml-3 shrink-0 px-3 py-1.5 text-xs font-medium text-amber-600 hover:text-amber-700 dark:text-amber-400 border border-amber-300 dark:border-amber-700 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-950 transition-colors cursor-pointer">
                                    Assign to this character
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <div class="flex justify-center mb-4">
                <div class="p-4 bg-amber-50 dark:bg-amber-950 rounded-full">
                    <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">No characters yet</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">Characters will appear here once you sync loot data using the klavlor-sync tool.</p>
        </div>
    }
</div>

@code {
    [Parameter] public List<CharacterSummary>? Characters { get; set; }
    [Parameter] public int UnassignedCount { get; set; }
    [Parameter] public bool UpdateHeader { get; set; } = true;
    [Parameter] public string? ErrorMessage { get; set; }

    private static bool IsPlaceholderName(string? name) =>
        string.IsNullOrEmpty(name) || Guid.TryParse(name, out _);
}
