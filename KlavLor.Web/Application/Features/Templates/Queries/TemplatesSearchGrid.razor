@using KlavLor.Application.Common
@using KlavLor.Application.Features.Templates.Search

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <input type="text" name="searchTerm" placeholder="Search templates..." value="@Result?.SearchTerm"
                   hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-trigger="keyup changed delay:300ms" hx-target="#hx-page-container" hx-swap="innerHTML transition:true"
                   hx-include="[name='sortBy'], [name='sortDirection']"
                   class="px-4 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
        </div>
        <div class="flex items-center gap-2">
            <a href="@AppRoutes.TemplatesCreate" hx-get="@AppRoutes.TemplatesCreate.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesCreate" hx-swap="innerHTML transition:true"
               class="inline-flex items-center px-4 py-2 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                New Template
            </a>
        </div>
    </div>

    @if (Result?.Items.Any() == true)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var template in Result.Items)
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-amber-200 transition-all duration-200 overflow-hidden">
                    <div class="p-5">
                        <div class="flex items-start justify-between mb-3">
                            <h3 class="text-lg font-semibold text-slate-900 truncate">@template.Name</h3>
                            <div class="flex items-center gap-1 ml-2 shrink-0">
                                @if (template.IsPublic)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Public</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">Private</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(template.Description))
                        {
                            <p class="text-sm text-slate-600 mb-3 line-clamp-2">@template.Description</p>
                        }
                        else
                        {
                            <p class="text-sm text-slate-400 italic mb-3">No description</p>
                        }

                        <div class="flex items-center gap-4 text-xs text-slate-500">
                            <span class="flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/></svg>
                                @template.NodeCount nodes
                            </span>
                            <span class="flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/></svg>
                                @template.SavedAt.ToString("MMM dd, yyyy")
                            </span>
                            @if (!template.IsOwner)
                            {
                                <span class="text-slate-400">by @template.CreatedByName</span>
                            }
                        </div>
                    </div>

                    <div class="px-5 py-3 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <a hx-get="@AppRoutes.TemplatesView.WithId(template.Id).FromApi()"
                               hx-target="#hx-page-container"
                               hx-push-url="@AppRoutes.TemplatesView.WithId(template.Id)"
                               hx-swap="innerHTML transition:true"
                               class="text-sm font-medium text-amber-600 hover:text-amber-800 cursor-pointer">
                                View
                            </a>
                            @if (template.IsOwner)
                            {
                                <a hx-get="@AppRoutes.Builder.WithId(template.Id).FromApi()"
                                   hx-target="#hx-page-container"
                                   hx-push-url="@AppRoutes.Builder.WithId(template.Id)"
                                   hx-swap="innerHTML transition:true"
                                   class="text-sm font-medium text-amber-600 hover:text-amber-800 cursor-pointer">
                                    Open Builder
                                </a>
                            }
                        </div>
                        @if (template.IsOwner)
                        {
                            <div class="flex items-center gap-3">
                                <a hx-get="@AppRoutes.TemplatesEdit.WithId(template.Id).FromApi()"
                                   hx-target="#hx-page-container"
                                   hx-push-url="@AppRoutes.TemplatesEdit.WithId(template.Id)"
                                   hx-swap="innerHTML transition:true"
                                   class="text-sm text-slate-500 hover:text-slate-700 cursor-pointer">Edit</a>
                                <button hx-get="@AppRoutes.TemplatesDelete.WithId(template.Id).FromApi()"
                                        hx-target="#hx-modal-container"
                                        hx-swap="innerHTML"
                                        class="text-sm text-red-500 hover:text-red-700 cursor-pointer">Delete</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center">
            <div class="flex justify-center mb-4">
                <div class="p-4 bg-amber-50 rounded-full">
                    <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"/>
                    </svg>
                </div>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">No templates yet</h3>
            <p class="text-sm text-slate-500 mb-6">Create your first gear progression template to get started.</p>
            <a href="@AppRoutes.TemplatesCreate" hx-get="@AppRoutes.TemplatesCreate.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesCreate" hx-swap="innerHTML transition:true"
               class="inline-flex items-center px-4 py-2 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Create Your First Template
            </a>
        </div>
    }
</div>

@code {
    [Parameter] public PagedList<TemplateSearchResponse>? Result { get; set; }
}
