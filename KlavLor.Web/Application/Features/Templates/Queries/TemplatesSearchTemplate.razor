@page "/templates"
@using KlavLor.Application.Common
@using KlavLor.Application.Features.Templates.Search
@using KlavLor.Application.Interfaces.Authentication
@using KlavLor.Web.Components.Layout

@inject TemplateSearchHandler SearchHandler
@inject ISessionStateManager SessionStateManager

<PageLayout PageTitle="KlavLor - Templates" Title="Templates" Description="Browse gear progression templates">
    @if (_result is not null)
    {
        <TemplatesSearchGrid Result="@_result" IsAuthenticated="@_isAuthenticated" />
    }
</PageLayout>

@code {
    private PagedList<TemplateSearchResponse>? _result;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = SessionStateManager.IsAuthenticated();

        var result = await SearchHandler.Handle(new TemplateSearchQuery());
        if (result.IsSuccess)
        {
            _result = result.Value;
        }
    }
}
