@using KlavLor.Application.Features.Import
@using KlavLor.Web.Components.Generic.Form
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="KlavLor - Import Template" Title="Import Template" Description="Import a progression from ladlorchart.com format" />

<CascadingValue Value="ValidationErrors">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
            }

            <form hx-post="@AppRoutes.TemplatesImport.FromApi()" hx-target="#hx-page-container" hx-swap="innerHTML transition:true">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Template Name</label>
                        <input type="text" name="Name" value="@Command.Name" maxlength="100"
                               class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                               placeholder="My Gear Progression" />
                        <FormMemberValidationError TModel="ImportTemplateCommand" For="@(x => x.Name)" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Description (optional)</label>
                        <input type="text" name="Description" value="@Command.Description" maxlength="500"
                               class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                               placeholder="Imported from ladlorchart.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Progression Data (JSON)</label>
                        <textarea name="JsonData" rows="10"
                                  class="w-full px-3 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                                  placeholder="@("[\n  [\"Iron scimitar\", \"Amulet of strength\"],\n  [\"Steel scimitar\"],\n  [\"Mithril scimitar\", \"Amulet of power\"]\n]")">@Command.JsonData</textarea>
                        <p class="mt-1 text-xs text-slate-500">Paste a JSON array of arrays. Each inner array is a group of items at the same progression step.</p>
                        <FormMemberValidationError TModel="ImportTemplateCommand" For="@(x => x.JsonData)" />
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                    <a hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesSearch" hx-swap="innerHTML transition:true"
                       class="px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors cursor-pointer">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-4 py-2 text-sm font-semibold text-white bg-amber-600 rounded-lg hover:bg-amber-700 transition-colors">
                        Import & Build
                    </button>
                </div>
            </form>
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public ImportTemplateCommand Command { get; set; } = new();
    [Parameter] public Dictionary<string, string[]>? ValidationErrors { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
}
