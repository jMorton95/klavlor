@using KlavLor.Domain.Entities
@using KlavLor.Web.Application

<div class="flex items-center justify-between bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-4 py-2 rounded-t-lg">
    <div class="flex items-center gap-3">
        <a hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesSearch" hx-swap="innerHTML transition:true"
           class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center gap-1 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Templates
        </a>
        <span class="text-slate-300 dark:text-slate-600">|</span>
        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">@TemplateName</span>
    </div>
    <div class="flex items-center gap-2">
        <button type="button"
                hx-get="@($"/api/templates/{TemplateId}/builder/nodes/create")"
                hx-target="#hx-modal-container"
                hx-swap="innerHTML"
                hx-vals="js:{posX: getCanvasViewportCenter().x, posY: getCanvasViewportCenter().y}"
                class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-md border border-amber-300 dark:border-amber-600 text-amber-700 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950 transition-colors cursor-pointer">
            + Add Node
        </button>
        <a hx-get="@AppRoutes.TemplatesView.WithId(TemplateId).FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesView.WithId(TemplateId)" hx-swap="innerHTML transition:true"
           class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-amber-600 dark:text-amber-400 border border-amber-300 dark:border-amber-600 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-950 transition-colors cursor-pointer">
            View Template
        </a>
    </div>
</div>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public string TemplateName { get; set; } = "";
}
