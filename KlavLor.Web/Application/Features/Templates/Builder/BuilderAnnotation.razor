@using KlavLor.Domain.Entities
@using KlavLor.Web.Application

<div id="builder-annotation-@Annotation.Id"
     class="builder-annotation absolute select-none cursor-grab group"
     data-annotation-id="@Annotation.Id"
     data-template-id="@TemplateId"
     style="left: @(Annotation.PositionX)px; top: @(Annotation.PositionY)px; z-index: 2;">

    <div class="relative px-2 py-1 rounded bg-white/60 dark:bg-slate-800/60 border border-dashed border-purple-300 dark:border-purple-600 hover:border-purple-400 dark:hover:border-purple-500 transition-colors max-w-[250px]">
        <p class="@GetFontSizeClass() text-slate-700 dark:text-slate-300 whitespace-pre-wrap break-words">@Annotation.Text</p>

        @* Hover controls *@
        <div class="absolute -top-2 -right-2 hidden group-hover:flex items-center gap-0.5">
            <button type="button"
                    hx-get="@($"/api/templates/{TemplateId}/builder/annotations/{Annotation.Id}/edit")"
                    hx-target="#hx-modal-container"
                    hx-swap="innerHTML"
                    class="w-5 h-5 flex items-center justify-center rounded-full bg-purple-500 text-white text-xs hover:bg-purple-600 cursor-pointer shadow-sm"
                    title="Edit annotation">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            </button>
            <button type="button"
                    class="builder-annotation-delete w-5 h-5 flex items-center justify-center rounded-full bg-red-500 text-white text-xs hover:bg-red-600 cursor-pointer shadow-sm"
                    data-template-id="@TemplateId"
                    data-annotation-id="@Annotation.Id"
                    title="Delete annotation">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public required CanvasAnnotation Annotation { get; set; }
    [Parameter] public int TemplateId { get; set; }

    private string GetFontSizeClass() => Annotation.FontSize switch
    {
        "small" => "text-lg",
        "large" => "text-2xl",
        _ => "text-xl"
    };
}
