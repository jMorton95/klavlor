@using KlavLor.Domain.Entities

<div id="modal-element" class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"
         onclick="document.getElementById('modal-element').remove()"></div>
    <div class="relative bg-slate-50 dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Add Node</h3>
        @{
            var hxTarget = GroupId.HasValue ? $"#builder-group-{GroupId.Value}" : "#builder-canvas-inner";
            var hxSwap = GroupId.HasValue ? "outerHTML" : "beforeend";
        }
        <form hx-post="@($"/api/templates/{TemplateId}/builder/nodes")"
              hx-target="@hxTarget" hx-swap="@hxSwap"
              hx-on::after-request="if(event.detail.elt===this) this.closest('#modal-element')?.remove()">
            <input type="hidden" name="TemplateId" value="@TemplateId" />
            <input type="hidden" name="Label" value="@DefaultLabel" />
            <input type="hidden" name="IconUrl" value="" />
            <input type="hidden" name="PositionX" value="@PositionX" />
            <input type="hidden" name="PositionY" value="@PositionY" />
            <input type="hidden" name="NodeType" value="0" />
            <input type="hidden" name="Color" id="node-color-input" value="@DefaultColor" />
            @if (GroupId.HasValue)
            {
                <input type="hidden" name="GroupId" value="@GroupId.Value" />
            }
            <div class="space-y-3">
                @* OSRS Wiki Search *@
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Item / Search</label>
                    <div class="relative">
                        <input type="text" id="osrs-search-input"
                               hx-get="@($"/api/osrs/search")"
                               hx-trigger="input changed delay:300ms"
                               hx-target="#osrs-search-results"
                               hx-swap="innerHTML"
                               name="q"
                               value=""
                               placeholder="Search OSRS Wiki..."
                               autocomplete="off"
                               class="w-full px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none dark:bg-slate-800" />
                        <div id="osrs-search-results" class="relative"></div>
                    </div>
                </div>

                @* Colour Picker *@
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Colour</label>
                    <div class="flex items-center gap-2" id="color-swatch-picker">
                        @foreach (var color in AvailableColors)
                        {
                            var isSelected = color == DefaultColor;
                            var swatchClasses = GetSwatchClasses(color);
                            var ringClass = isSelected ? GetRingClass(color) : "";
                            <button type="button"
                                    onclick="selectNodeColor(this, '@color')"
                                    class="node-color-swatch w-6 h-6 rounded-full @swatchClasses cursor-pointer transition-all @ringClass"
                                    data-color="@color"
                                    data-ring-class="@GetRingClass(color)"
                                    title="@color"></button>
                        }
                    </div>
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-5">
                <button type="button" onclick="this.closest('#modal-element').remove()"
                        class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-amber-600 rounded-lg hover:bg-amber-700">
                    Add
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Auto-focus search input when modal opens
    (function() {
        var input = document.getElementById('osrs-search-input');
        if (input) setTimeout(function() { input.focus(); }, 100);
    })();

    function selectNodeColor(btn, color) {
        document.getElementById('node-color-input').value = color;
        document.querySelectorAll('#color-swatch-picker .node-color-swatch').forEach(function(s) {
            var ring = s.dataset.ringClass;
            if (ring) s.classList.remove(...ring.split(' '));
        });
        var ring = btn.dataset.ringClass;
        if (ring) btn.classList.add(...ring.split(' '));
    }
</script>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public string DefaultLabel { get; set; } = "Item";
    [Parameter] public string DefaultColor { get; set; } = "amber";
    [Parameter] public double PositionX { get; set; } = 400;
    [Parameter] public double PositionY { get; set; } = 300;
    [Parameter] public int? GroupId { get; set; }

    private static readonly string[] AvailableColors = ["amber", "blue", "purple", "green", "orange", "red", "indigo"];

    private static string GetSwatchClasses(string color) => color switch
    {
        "amber" => "bg-amber-400 border-2 border-amber-500",
        "blue" => "bg-blue-400 border-2 border-blue-500",
        "purple" => "bg-purple-400 border-2 border-purple-500",
        "green" => "bg-green-400 border-2 border-green-500",
        "orange" => "bg-orange-400 border-2 border-orange-500",
        "red" => "bg-red-400 border-2 border-red-500",
        "indigo" => "bg-indigo-400 border-2 border-indigo-500",
        _ => "bg-slate-400 border-2 border-slate-500"
    };

    private static string GetRingClass(string color) => color switch
    {
        "amber" => "ring-2 ring-offset-2 ring-amber-400",
        "blue" => "ring-2 ring-offset-2 ring-blue-400",
        "purple" => "ring-2 ring-offset-2 ring-purple-400",
        "green" => "ring-2 ring-offset-2 ring-green-400",
        "orange" => "ring-2 ring-offset-2 ring-orange-400",
        "red" => "ring-2 ring-offset-2 ring-red-400",
        "indigo" => "ring-2 ring-offset-2 ring-indigo-400",
        _ => "ring-2 ring-offset-2 ring-slate-400"
    };
}
