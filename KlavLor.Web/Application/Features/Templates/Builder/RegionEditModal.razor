@using KlavLor.Web.Application

<div id="modal-element" class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"
         onclick="document.getElementById('modal-element').remove()"></div>
    <div class="relative bg-white dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Edit Region</h3>
        <form hx-put="@($"/api/templates/{TemplateId}/builder/regions/{RegionId}")"
              hx-target="#builder-region-@RegionId" hx-swap="outerHTML"
              hx-on::after-request="if(event.detail.elt===this) this.closest('#modal-element')?.remove()">
            <input type="hidden" name="TemplateId" value="@TemplateId" />
            <input type="hidden" name="RegionId" value="@RegionId" />
            <input type="hidden" name="Color" id="region-color-input" value="@CurrentColor" />
            <div class="space-y-3">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Label</label>
                    <input type="text" name="Label" value="@Label" maxlength="100" placeholder="Optional label..."
                           class="w-full px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none dark:bg-slate-800" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Colour</label>
                    <div class="flex items-center gap-2" id="region-color-picker">
                        @foreach (var color in AvailableColors)
                        {
                            var isSelected = color == CurrentColor;
                            var swatchClasses = GetSwatchClasses(color);
                            var ringClass = isSelected ? GetRingClass(color) : "";
                            <button type="button"
                                    onclick="selectRegionColor(this, '@color')"
                                    class="region-color-swatch w-6 h-6 rounded-full @swatchClasses cursor-pointer transition-all @ringClass"
                                    data-color="@color"
                                    data-ring-class="@GetRingClass(color)"
                                    title="@color"></button>
                        }
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Opacity</label>
                    <input type="range" name="Opacity" min="0.05" max="0.5" step="0.05" value="@CurrentOpacity"
                           class="w-full" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-5">
                <button type="button" onclick="this.closest('#modal-element').remove()"
                        class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700">
                    Save
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function selectRegionColor(btn, color) {
        document.getElementById('region-color-input').value = color;
        document.querySelectorAll('#region-color-picker .region-color-swatch').forEach(function(s) {
            var ring = s.dataset.ringClass;
            if (ring) s.classList.remove(...ring.split(' '));
        });
        var ring = btn.dataset.ringClass;
        if (ring) btn.classList.add(...ring.split(' '));
    }
</script>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public int RegionId { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string CurrentColor { get; set; } = "slate";
    [Parameter] public double CurrentOpacity { get; set; } = 0.15;

    private static readonly string[] AvailableColors = ["slate", "amber", "blue", "purple", "green", "orange", "red", "indigo"];

    private static string GetSwatchClasses(string color) => color switch
    {
        "amber" => "bg-amber-400 border-2 border-amber-500",
        "blue" => "bg-blue-400 border-2 border-blue-500",
        "purple" => "bg-purple-400 border-2 border-purple-500",
        "green" => "bg-green-400 border-2 border-green-500",
        "orange" => "bg-orange-400 border-2 border-orange-500",
        "red" => "bg-red-400 border-2 border-red-500",
        "indigo" => "bg-indigo-400 border-2 border-indigo-500",
        _ => "bg-slate-400 border-2 border-slate-500"
    };

    private static string GetRingClass(string color) => color switch
    {
        "amber" => "ring-2 ring-offset-2 ring-amber-400",
        "blue" => "ring-2 ring-offset-2 ring-blue-400",
        "purple" => "ring-2 ring-offset-2 ring-purple-400",
        "green" => "ring-2 ring-offset-2 ring-green-400",
        "orange" => "ring-2 ring-offset-2 ring-orange-400",
        "red" => "ring-2 ring-offset-2 ring-red-400",
        "indigo" => "ring-2 ring-offset-2 ring-indigo-400",
        _ => "ring-2 ring-offset-2 ring-slate-400"
    };
}
