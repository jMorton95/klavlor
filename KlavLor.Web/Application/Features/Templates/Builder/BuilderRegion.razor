@using KlavLor.Domain.Entities
@using KlavLor.Web.Application

<div id="builder-region-@Region.Id"
     class="builder-region absolute select-none cursor-grab group"
     data-region-id="@Region.Id"
     data-template-id="@TemplateId"
     style="left: @(Region.PositionX)px; top: @(Region.PositionY)px; width: @(Region.Width)px; height: @(Region.Height)px; z-index: 0;">

    <div class="relative w-full h-full rounded-lg border-2 @GetBorderColorClass()"
         style="background-color: @GetBackgroundColor();">

        @if (!string.IsNullOrEmpty(Region.Label))
        {
            <span class="absolute top-1 left-2 text-xs font-medium @GetLabelColorClass() select-none pointer-events-none">@Region.Label</span>
        }

        @* Hover controls *@
        <div class="absolute -top-2 -right-2 hidden group-hover:flex items-center gap-0.5" style="z-index: 5;">
            <button type="button"
                    hx-get="@($"/api/templates/{TemplateId}/builder/regions/{Region.Id}/edit")"
                    hx-target="#hx-modal-container"
                    hx-swap="innerHTML"
                    class="w-5 h-5 flex items-center justify-center rounded-full bg-green-500 text-white text-xs hover:bg-green-600 cursor-pointer shadow-sm"
                    title="Edit region">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            </button>
            <button type="button"
                    class="builder-region-delete w-5 h-5 flex items-center justify-center rounded-full bg-red-500 text-white text-xs hover:bg-red-600 cursor-pointer shadow-sm"
                    data-template-id="@TemplateId"
                    data-region-id="@Region.Id"
                    title="Delete region">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        @* Resize handles at corners *@
        <div class="builder-resize-handle absolute -bottom-1 -right-1 w-3 h-3 bg-slate-400 dark:bg-slate-500 border border-white dark:border-slate-900 rounded-sm cursor-nwse-resize opacity-0 group-hover:opacity-100 transition-opacity" data-corner="se" style="z-index: 5;"></div>
        <div class="builder-resize-handle absolute -bottom-1 -left-1 w-3 h-3 bg-slate-400 dark:bg-slate-500 border border-white dark:border-slate-900 rounded-sm cursor-nesw-resize opacity-0 group-hover:opacity-100 transition-opacity" data-corner="sw" style="z-index: 5;"></div>
        <div class="builder-resize-handle absolute -top-1 -right-1 w-3 h-3 bg-slate-400 dark:bg-slate-500 border border-white dark:border-slate-900 rounded-sm cursor-nesw-resize opacity-0 group-hover:opacity-100 transition-opacity" data-corner="ne" style="z-index: 5;"></div>
        <div class="builder-resize-handle absolute -top-1 -left-1 w-3 h-3 bg-slate-400 dark:bg-slate-500 border border-white dark:border-slate-900 rounded-sm cursor-nwse-resize opacity-0 group-hover:opacity-100 transition-opacity" data-corner="nw" style="z-index: 5;"></div>
    </div>
</div>

@code {
    [Parameter] public required CanvasRegion Region { get; set; }
    [Parameter] public int TemplateId { get; set; }

    private string GetBorderColorClass() => Region.Color switch
    {
        "amber" => "border-amber-400 dark:border-amber-600",
        "blue" => "border-blue-400 dark:border-blue-600",
        "purple" => "border-purple-400 dark:border-purple-600",
        "green" => "border-green-400 dark:border-green-600",
        "orange" => "border-orange-400 dark:border-orange-600",
        "red" => "border-red-400 dark:border-red-600",
        "indigo" => "border-indigo-400 dark:border-indigo-600",
        _ => "border-slate-400 dark:border-slate-600"
    };

    private string GetLabelColorClass() => Region.Color switch
    {
        "amber" => "text-amber-700 dark:text-amber-400",
        "blue" => "text-blue-700 dark:text-blue-400",
        "purple" => "text-purple-700 dark:text-purple-400",
        "green" => "text-green-700 dark:text-green-400",
        "orange" => "text-orange-700 dark:text-orange-400",
        "red" => "text-red-700 dark:text-red-400",
        "indigo" => "text-indigo-700 dark:text-indigo-400",
        _ => "text-slate-700 dark:text-slate-400"
    };

    private string GetBackgroundColor() => Region.Color switch
    {
        "amber" => $"rgba(245, 158, 11, {Region.Opacity})",
        "blue" => $"rgba(59, 130, 246, {Region.Opacity})",
        "purple" => $"rgba(168, 85, 247, {Region.Opacity})",
        "green" => $"rgba(34, 197, 94, {Region.Opacity})",
        "orange" => $"rgba(249, 115, 22, {Region.Opacity})",
        "red" => $"rgba(239, 68, 68, {Region.Opacity})",
        "indigo" => $"rgba(99, 102, 241, {Region.Opacity})",
        _ => $"rgba(100, 116, 139, {Region.Opacity})"
    };
}
