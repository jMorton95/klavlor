@using KlavLor.Web.Application

<div id="modal-element" class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"
         onclick="document.getElementById('modal-element').remove()"></div>
    <div class="relative bg-slate-50 dark:bg-slate-900 rounded-xl shadow-xl w-full max-w-sm mx-4 p-6">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4">Add Text Annotation</h3>
        <form hx-post="@($"/api/templates/{TemplateId}/builder/annotations")"
              hx-target="#builder-canvas" hx-swap="outerHTML"
              hx-on::after-request="if(event.detail.elt===this) this.closest('#modal-element')?.remove()">
            <input type="hidden" name="TemplateId" value="@TemplateId" />
            <input type="hidden" name="PositionX" value="@PositionX" />
            <input type="hidden" name="PositionY" value="@PositionY" />
            <div class="space-y-3">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Text</label>
                    <textarea name="Text" rows="3" maxlength="500" placeholder="Enter annotation text..."
                              class="w-full px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none dark:bg-slate-800 resize-none"
                              id="annotation-text-input"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Font Size</label>
                    <select name="FontSize"
                            class="w-full px-3 py-2 text-sm border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none dark:bg-slate-800">
                        <option value="small">Small</option>
                        <option value="medium" selected>Medium</option>
                        <option value="large">Large</option>
                    </select>
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-5">
                <button type="button" onclick="this.closest('#modal-element').remove()"
                        class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 text-sm font-medium text-white bg-purple-600 rounded-lg hover:bg-purple-700">
                    Add
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function() {
        var input = document.getElementById('annotation-text-input');
        if (input) setTimeout(function() { input.focus(); }, 100);
    })();
</script>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public double PositionX { get; set; } = 400;
    [Parameter] public double PositionY { get; set; } = 300;
}
