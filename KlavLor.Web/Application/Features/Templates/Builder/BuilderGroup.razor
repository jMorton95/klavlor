@using KlavLor.Domain.Entities

<div id="builder-group-@Group.Id" class="builder-group group absolute select-none cursor-grab active:cursor-grabbing"
     style="left: @(Group.PositionX)px; top: @(Group.PositionY)px; z-index: 2;"
     data-group-id="@Group.Id"
     data-template-id="@TemplateId">

    @* Ports — all four sides *@
    <div class="builder-port absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-400 dark:border-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-crosshair"
         data-group-id="@Group.Id" style="z-index: 3;"></div>
    <div class="builder-port absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-400 dark:border-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-crosshair"
         data-group-id="@Group.Id" style="z-index: 3;"></div>
    <div class="builder-port absolute left-1/2 -top-2 -translate-x-1/2 w-4 h-4 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-400 dark:border-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-crosshair"
         data-group-id="@Group.Id" style="z-index: 3;"></div>
    <div class="builder-port absolute left-1/2 -bottom-2 -translate-x-1/2 w-4 h-4 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-400 dark:border-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 cursor-crosshair"
         data-group-id="@Group.Id" style="z-index: 3;"></div>

    <div class="relative bg-white/90 dark:bg-slate-800/90 rounded-lg border-2 border-slate-400 dark:border-slate-500 shadow-md hover:border-slate-500 dark:hover:border-slate-400 transition-colors min-h-[48px]">
        @* Delete group button *@
        <button type="button"
                class="builder-confirm-delete absolute -top-2 -right-2 p-0.5 bg-white dark:bg-slate-800 rounded-full border border-slate-300 dark:border-slate-600 text-slate-400 dark:text-slate-500 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-opacity"
                data-delete-url="@($"/api/templates/{TemplateId}/builder/groups/{Group.Id}")"
                data-delete-message="Delete this group and all its items?"
                style="z-index: 4;" title="Delete group">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        @* List view (icon + text) *@
        <div class="view-list p-1.5 space-y-0.5">
            @foreach (var node in GroupedNodes)
            {
                var borderColor = GetNodeBorderColor(node.NodeType);
                <div class="flex items-center gap-1.5 px-1.5 py-1 rounded shadow-sm group/item border-2 @borderColor bg-white dark:bg-slate-800"
                     data-node-id="@node.Id" data-grouped="true">
                    @if (!string.IsNullOrEmpty(node.IconUrl))
                    {
                        <img src="@node.IconUrl" alt="" class="w-5 h-5 object-contain flex-shrink-0"
                             onerror="this.style.display='none'" />
                    }
                    <span class="text-[11px] font-medium text-slate-800 dark:text-slate-200 truncate flex-1" title="@node.Label">@node.Label</span>
                    <div class="flex items-center gap-1 opacity-0 group-hover/item:opacity-100 transition-opacity">
                        <button type="button"
                                hx-get="@($"/api/templates/{TemplateId}/builder/nodes/{node.Id}/edit")"
                                hx-target="#hx-modal-container"
                                hx-swap="innerHTML"
                                class="p-1 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 cursor-pointer" title="Edit">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </button>
                        <button type="button"
                                class="builder-delete-node p-1 text-slate-400 dark:text-slate-500 hover:text-red-400 cursor-pointer"
                                data-template-id="@TemplateId"
                                data-node-id="@node.Id"
                                data-group-id="@Group.Id"
                                title="Delete">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </button>
                    </div>
                </div>
            }
        </div>

        @* Icon-only view (compact grid) *@
        <div class="view-icons hidden p-1.5">
            <div class="flex flex-wrap gap-1">
                @foreach (var node in GroupedNodes)
                {
                    var borderColor = GetNodeBorderColor(node.NodeType);
                    <div class="group/item relative rounded border-2 @borderColor bg-white dark:bg-slate-800 shadow-sm w-8 h-8 flex items-center justify-center"
                         data-node-id="@node.Id" data-grouped="true" title="@node.Label">
                        @if (!string.IsNullOrEmpty(node.IconUrl))
                        {
                            <img src="@node.IconUrl" alt="" class="w-6 h-6 object-contain"
                                 onerror="this.style.display='none'" />
                        }
                        else
                        {
                            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">@node.Label[..Math.Min(2, node.Label.Length)]</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Add item dropdown *@
        <div class="px-1.5 pb-1.5">
            <div class="relative builder-add-item-container">
                <button type="button"
                        class="builder-add-item-toggle w-full px-2 py-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 rounded border border-dashed border-slate-400 dark:border-slate-500 transition-colors text-center cursor-pointer">
                    + Add item
                </button>
                <div class="builder-add-item-dropdown hidden absolute left-0 top-full mt-1 bg-white dark:bg-slate-800 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-1 w-full" style="z-index: 50;">
                    @foreach (var nodeType in Enum.GetValues<NodeType>())
                    {
                        <button type="button"
                                hx-get="@($"/api/templates/{TemplateId}/builder/nodes/create?nodeType={(int)nodeType}&posX={Group.PositionX}&posY={Group.PositionY}&groupId={Group.Id}")"
                                hx-target="#hx-modal-container" hx-swap="innerHTML"
                                class="w-full text-left px-2 py-1 text-[11px] rounded hover:bg-slate-50 dark:hover:bg-slate-700 cursor-pointer @GetNodeTypeTextColor(nodeType)">
                            @nodeType
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public required TemplateNodeGroup Group { get; set; }
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public List<TemplateNode> GroupedNodes { get; set; } = [];

    private static string GetNodeBorderColor(NodeType nodeType) => nodeType switch
    {
        NodeType.Item => "border-amber-400",
        NodeType.Skill => "border-blue-400",
        NodeType.Prayer => "border-purple-400",
        NodeType.Quest => "border-green-400",
        NodeType.Construction => "border-orange-400",
        NodeType.Slayer => "border-red-400",
        NodeType.Spell => "border-indigo-400",
        _ => "border-slate-300"
    };

    private static string GetNodeTypeTextColor(NodeType nodeType) => nodeType switch
    {
        NodeType.Item => "text-amber-700",
        NodeType.Skill => "text-blue-700",
        NodeType.Prayer => "text-purple-700",
        NodeType.Quest => "text-green-700",
        NodeType.Construction => "text-orange-700",
        NodeType.Slayer => "text-red-700",
        NodeType.Spell => "text-indigo-700",
        _ => "text-slate-700"
    };
}
