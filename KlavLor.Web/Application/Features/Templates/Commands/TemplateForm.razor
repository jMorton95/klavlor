@using Microsoft.AspNetCore.Components.Forms
@using KlavLor.Application.Features.Templates.Create
@using KlavLor.Application.Features.Templates.Edit
@using KlavLor.Application.Features.Templates.Search
@using KlavLor.Web.Components.Generic.Form
@using KlavLor.Web.Components.Layout

<TopBarMetaData PageTitle="@(IsEditing ? "KlavLor - Edit Template" : "KlavLor - New Template")"
               Title="@(IsEditing ? "Edit Template" : "New Template")"
               Description="@(IsEditing ? "Update template details" : "Create a new gear progression template")" />

<CascadingValue Value="ValidationErrors">
    @if (IsEditing)
    {
        var editCommand = Command as TemplateEditCommand;
        var editRoute = AppRoutes.TemplatesEdit.WithId(editCommand!.Id).FromApi();

        <EditForm EditContext="_editContext" hx-post="@editRoute" hx-target="#hx-page-container" hx-swap="innerHTML transition:true" class="max-w-2xl space-y-6">
            @RenderFormFields()

            @if (ErrorMessage != null)
            {
                <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
            }

            <div class="flex gap-3">
                <button type="submit" class="px-6 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">Save Changes</button>
                <a href="@AppRoutes.TemplatesSearch" hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesSearch" class="px-6 py-2.5 text-slate-600 dark:text-white text-sm font-medium border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Cancel</a>
            </div>
        </EditForm>
    }
    else
    {
        var createCommand = Command as TemplateCreateCommand;

        <EditForm EditContext="_editContext" hx-post="@AppRoutes.TemplatesCreate.FromApi()" hx-target="#hx-page-container" hx-swap="innerHTML transition:true" class="max-w-2xl space-y-6">
            @RenderFormFields()

            @if (CloneOptions.Any())
            {
                <div class="group">
                    <label for="sourceTemplateId" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Clone from existing template</label>
                    <select name="SourceTemplateId" id="sourceTemplateId"
                            class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none">
                        <option value="">Start from scratch</option>
                        @foreach (var option in CloneOptions)
                        {
                            var label = option.IsOwner ? option.Name : $"{option.Name} (by {option.CreatedByName})";
                            <option value="@option.Id" selected="@(createCommand!.SourceTemplateId == option.Id)">@label</option>
                        }
                    </select>
                    <p class="mt-1 text-xs text-slate-500 dark:text-white">Optionally copy all nodes, groups, and connections from an existing template.</p>
                </div>
            }

            @if (ErrorMessage != null)
            {
                <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
            }

            <div class="flex gap-3">
                <button type="submit" class="px-6 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">Create Template</button>
                <a href="@AppRoutes.TemplatesSearch" hx-get="@AppRoutes.TemplatesSearch.FromApi()" hx-target="#hx-page-container" hx-push-url="@AppRoutes.TemplatesSearch" class="px-6 py-2.5 text-slate-600 dark:text-white text-sm font-medium border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">Cancel</a>
            </div>
        </EditForm>
    }
</CascadingValue>

@code {
    [Parameter] public object Command { get; set; } = new TemplateCreateCommand();
    [Parameter] public Dictionary<string, string[]>? ValidationErrors { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public List<TemplateCloneOption> CloneOptions { get; set; } = [];

    private EditContext? _editContext;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Command);
    }

    private RenderFragment RenderFormFields() => __builder =>
    {
        <div class="group">
            <label for="name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Template Name</label>
            @if (IsEditing)
            {
                var cmd = (TemplateEditCommand)Command;
                <InputText @bind-Value="cmd.Name" Name="Name" id="name"
                           class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                           placeholder="e.g. Ironman Melee Progression" />
                <FormMemberValidationError TModel="TemplateEditCommand" For="@(x => x.Name)" />
            }
            else
            {
                var cmd = (TemplateCreateCommand)Command;
                <InputText @bind-Value="cmd.Name" Name="Name" id="name"
                           class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                           placeholder="e.g. Ironman Melee Progression" />
                <FormMemberValidationError TModel="TemplateCreateCommand" For="@(x => x.Name)" />
            }
        </div>

        <div class="group">
            <label for="description" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Description</label>
            @if (IsEditing)
            {
                var cmd = (TemplateEditCommand)Command;
                <InputTextArea @bind-Value="cmd.Description" Name="Description" id="description" rows="3"
                               class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                               placeholder="Describe your gear progression..." />
                <FormMemberValidationError TModel="TemplateEditCommand" For="@(x => x.Description)" />
            }
            else
            {
                var cmd = (TemplateCreateCommand)Command;
                <InputTextArea @bind-Value="cmd.Description" Name="Description" id="description" rows="3"
                               class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all outline-none"
                               placeholder="Describe your gear progression..." />
                <FormMemberValidationError TModel="TemplateCreateCommand" For="@(x => x.Description)" />
            }
        </div>

        <div class="group">
            <label class="flex items-center gap-2">
                @if (IsEditing)
                {
                    var cmd = (TemplateEditCommand)Command;
                    <InputCheckbox @bind-Value="cmd.IsPublic" Name="IsPublic" class="w-4 h-4 text-amber-600 border-slate-300 rounded" />
                }
                else
                {
                    var cmd = (TemplateCreateCommand)Command;
                    <InputCheckbox @bind-Value="cmd.IsPublic" Name="IsPublic" class="w-4 h-4 text-amber-600 border-slate-300 rounded" />
                }
                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Make this template public</span>
            </label>
            <p class="mt-1 text-xs text-slate-500 dark:text-white ml-6">Public templates can be viewed and cloned by other users.</p>
        </div>
    };
}
