@using KlavLor.Application.Features.Login
@using KlavLor.Web.Components.Generic.Form
@using Microsoft.AspNetCore.Components.Forms

<CascadingValue Value="ValidationErrors">
    <div id="modal-element"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in">

        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm"
             onclick="document.getElementById('modal-element').remove()"></div>

        <div class="relative bg-slate-50/90 dark:bg-slate-900/90 backdrop-blur-xl rounded-2xl border border-white/30 dark:border-slate-700 shadow-[0_8px_30px_rgb(0,0,0,0.12)] max-w-md w-full overflow-hidden animate-scale-in">
            <div class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-slate-900 to-amber-600"></div>

            <div class="px-6 py-5 flex items-start justify-between">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-linear-to-br from-amber-600 to-orange-500 rounded-xl shadow-lg">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Sign In</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Enter your credentials to continue</p>
                    </div>
                </div>
                <button type="button" onclick="this.closest('.fixed').remove()" class="p-2 text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-200/40 dark:hover:bg-slate-700/40 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <EditForm EditContext="_editContext"
                      hx-post="@AppRoutes.LoginModal.FromApi()"
                      hx-target="#modal-element"
                      hx-swap="outerHTML"
                      class="px-6 pb-6 space-y-5">

                <div class="group">
                    <label for="modal-email" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Email address</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="w-5 h-5 text-slate-400 dark:text-slate-500 group-focus-within:text-amber-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                            </svg>
                        </div>
                        <InputText @bind-Value="LoginCommand.Email"
                                   Name="@nameof(LoginCommand.Email)"
                                   type="email" id="modal-email"
                                   class="w-full pl-11 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all duration-200 outline-none"
                                   placeholder="you@example.com"/>
                    </div>
                    <FormMemberValidationError TModel="LoginCommand" For="@(x => x.Email)" />
                </div>

                <div class="group">
                    <label for="modal-password" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="w-5 h-5 text-slate-400 dark:text-slate-500 group-focus-within:text-amber-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        <InputText @bind-Value="LoginCommand.Password"
                                   Name="@nameof(LoginCommand.Password)"
                                   id="modal-password" type="password"
                                   class="w-full pl-11 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-600 dark:text-slate-200 rounded-xl focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all duration-200 outline-none"
                                   placeholder="••••••••"/>
                    </div>
                    <FormMemberValidationError TModel="LoginCommand" For="@(x => x.Password)" />
                </div>

                @if (ErrorMessage != null)
                {
                    <ErrorMessageComponent ErrorMessage="@ErrorMessage" />
                }

                <button type="submit"
                        class="w-full flex justify-center items-center py-2.5 px-4 border border-transparent rounded-xl text-sm font-semibold text-white bg-linear-to-r from-amber-700 to-slate-600 hover:from-amber-700 hover:to-orange-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 shadow-lg hover:shadow-xl transition-all duration-500 transform hover:-translate-y-0.5">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                    </svg>
                    Sign In
                </button>
            </EditForm>
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public LoginCommand LoginCommand { get; set; } = new();
    [Parameter] public Dictionary<string, string[]>? ValidationErrors { get; set; } = new();
    [Parameter] public string? ErrorMessage { get; set; }

    private EditContext _editContext = null!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(LoginCommand);
    }
}
