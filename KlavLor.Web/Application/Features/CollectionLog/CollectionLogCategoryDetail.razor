@using KlavLor.Application.Features.CollectionLog
@using KlavLor.Web.Components.Layout

@* One category compared across the roster: a panel per character side by side, each listing every
   item in the category vertically with its icon, name and quantity.

   Not a table. A table put one shared item column down the left and a bare number per character,
   which lost the icons entirely and read as a spreadsheet. Repeating the icon and name inside each
   character's panel costs some width but means a column can be read on its own — you can see what
   someone has and hasn't without tracking back to a header row. Missing items keep their place,
   greyed, so every panel stays in the same order and the columns line up by eye. *@

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@($"KlavLor - {Comparison?.DisplayName ?? "Collection Log"}")"
                Title="@(Comparison?.DisplayName ?? "Collection Log")" Description="Category comparison" />
}

<div class="space-y-5 pb-32">
    <a onclick="history.back()"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 dark:text-white dark:hover:text-amber-400 cursor-pointer transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
    </a>

    @if (Comparison is null)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Category not found</h3>
            <p class="text-sm text-slate-500 dark:text-white">No collection log category called &ldquo;@Slug&rdquo;.</p>
        </div>
    }
    else
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 px-4 py-3">
            <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1.5">@Comparison.DisplayName</h1>
            <div class="flex items-center gap-x-4 gap-y-1 flex-wrap text-sm">
                <span class="inline-flex items-baseline gap-1">
                    <span class="font-semibold tabular-nums text-slate-900 dark:text-slate-100">@Comparison.Total</span>
                    <span class="text-[11px] text-slate-500 dark:text-white">items</span>
                </span>
                <span class="text-[11px] text-slate-500 dark:text-white">@Comparison.GroupName</span>
            </div>
        </div>

        @if (Comparison.Standings.Count == 0)
        {
            <div class="bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 px-3 py-8 text-center text-sm text-slate-400 dark:text-white">
                No collection log data for any character yet.
            </div>
        }
        else
        {
            @* Panels run side by side and scroll horizontally together when the roster outgrows the
               screen, so each character stays a single readable column. *@
            <div class="flex gap-3 overflow-x-auto pb-2 themed-scrollbar items-start">
                @foreach (var standing in Comparison.Standings)
                {
                    var complete = standing.Total > 0 && standing.Obtained >= standing.Total;
                    <div class="shrink-0 w-64 rounded-xl border overflow-hidden @(complete ? "border-emerald-300 dark:border-emerald-700" : "border-slate-200 dark:border-slate-700")">
                        <div class="px-3 py-2.5 border-b @(complete ? "border-emerald-300 dark:border-emerald-700 bg-emerald-50/70 dark:bg-emerald-900/20" : "border-slate-200 dark:border-slate-700 bg-slate-100/70 dark:bg-slate-800/40")">
                            <a hx-get="@CharacterUrl(standing.GameCharacterId).FromApi()" hx-target="#hx-page-container"
                               hx-push-url="@CharacterUrl(standing.GameCharacterId)" hx-swap="innerHTML transition:true"
                               class="block text-sm font-semibold text-amber-600 dark:text-amber-400 hover:underline cursor-pointer truncate">@standing.CharacterName</a>
                            <div class="flex items-center gap-2 mt-1">
                                <div class="h-1 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                                    <div class="h-full rounded-full @(complete ? "bg-emerald-500" : "bg-amber-500")"
                                         style="width:@Percent(standing).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <span class="text-[10px] tabular-nums shrink-0 @(complete ? "text-emerald-600 dark:text-emerald-400 font-semibold" : "text-slate-500 dark:text-white")">@standing.Obtained/@standing.Total</span>
                            </div>
                        </div>

                        <div class="bg-slate-50 dark:bg-slate-900 divide-y divide-slate-200/70 dark:divide-slate-800">
                            @foreach (var item in Comparison.Items)
                            {
                                var has = standing.Has(item.ItemId);
                                var count = standing.CountOf(item.ItemId);
                                <a hx-get="@ItemUrl(item.ItemId).FromApi()" hx-target="#hx-page-container"
                                   hx-push-url="@ItemUrl(item.ItemId)" hx-swap="innerHTML transition:true"
                                   title="@CellTitle(standing.CharacterName, item.Name, has, count)"
                                   class="flex items-center gap-2 px-2.5 py-1 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-colors">
                                    @* Missing items keep their row and grey out — icon desaturated,
                                       name dimmed — so the panels stay aligned row for row. *@
                                    <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.Name)" alt=""
                                         class="w-5 h-5 object-contain shrink-0 @(has ? "" : "grayscale opacity-40")"
                                         loading="lazy" onerror="this.style.visibility='hidden'" />
                                    <span class="text-[11px] truncate flex-1 min-w-0 @(has ? "text-slate-700 dark:text-slate-200" : "text-slate-400 dark:text-slate-600")">@item.Name</span>
                                    @if (has && count > 0)
                                    {
                                        <span class="text-[11px] font-semibold tabular-nums shrink-0 text-emerald-600 dark:text-emerald-400">@count.ToString("N0")</span>
                                    }
                                    else if (has)
                                    {
                                        @* Owned but the upstream reports no count — a tick, not a zero,
                                           which would read as "has none". *@
                                        <svg class="w-3 h-3 shrink-0 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    /// True when served as an HTMX fragment (emits the OOB header); false inside PageLayout,
    /// which renders the header itself. Without this an in-app navigation drew the title twice.
    [Parameter] public bool UpdateHeader { get; set; } = true;

    [Parameter] public CollectionLogCategoryComparison? Comparison { get; set; }
    [Parameter] public string Slug { get; set; } = "";

    private static string CharacterUrl(int id) => AppRoutes.CollectionLogCharacter.WithId(id);

    private static string ItemUrl(int itemId) => AppRoutes.CollectionLogItem.Replace("{itemId:int}", itemId.ToString());

    private static double Percent(CollectionLogCategoryStanding s) =>
        s.Total > 0 ? s.Obtained * 100.0 / s.Total : 0;

    private static string CellTitle(string character, string item, bool has, int count) => has
        ? count > 1 ? $"{character} — {item} ×{count:N0}" : $"{character} — {item}"
        : $"{character} — {item} not obtained";
}
