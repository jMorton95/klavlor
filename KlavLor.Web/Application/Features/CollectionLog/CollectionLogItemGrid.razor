@using KlavLor.Application.Features.CollectionLog

@* The focused panel: one category's items for one character, swapped into the middle of the grid.

   The panel is a large cell, so the items are sized to fill it rather than sitting as a small
   top-left clump: bigger tiles, bigger icons, readable names, and the grid centred horizontally
   while anchored to the top, so a four-item category sits under the header instead of floating in
   the middle of a tall panel.

   clog-focus-panel gives it an amber ring and glow. It sits surrounded by dark slate category
   cards, so anything slate-on-slate simply vanished into them — this is deliberately the one warm,
   saturated element on the page.

   Missing items are shown greyed rather than omitted — a collection log that only listed what you
   already own would be pointless, and the gaps are the whole point of looking. *@
@* The wrapper is part of the response, not just the target, because the CELL WIDTH depends on the
   category: a 25-item log needs more room than a 4-item one. The buttons swap this whole element
   (outerHTML), so each response brings its own span with it. *@
<div id="clog-focus" class="clog-focus @(IsWide ? "is-wide" : "")">
<div class="clog-focus-panel rounded-xl overflow-hidden h-full flex flex-col">
    <div class="clog-focus-header flex items-center gap-2 px-3 py-2.5 shrink-0">
        @if (IconName is { Length: > 0 } icon)
        {
            <img src="@IconUrl" alt="" class="w-7 h-7 shrink-0 object-contain" loading="lazy" onerror="this.style.visibility='hidden'" />
        }
        <div class="min-w-0 flex-1">
            <div class="text-sm font-bold text-amber-900 dark:text-amber-100 truncate">@DisplayName</div>
            <div class="text-[11px] tabular-nums @(IsComplete ? "text-emerald-600 dark:text-emerald-400" : "text-slate-600 dark:text-slate-300")">
                @Obtained of @Items.Count obtained@(IsComplete ? " · complete" : "")
            </div>
        </div>
        <a hx-get="@CompareUrl.FromApi()" hx-target="#hx-page-container" hx-push-url="@CompareUrl" hx-swap="innerHTML transition:true"
           class="shrink-0 text-[11px] font-medium px-2 py-1 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 hover:bg-amber-500/30 cursor-pointer whitespace-nowrap transition-colors">Compare</a>
    </div>

    @if (Items.Count == 0)
    {
        <div class="px-3 py-8 text-center text-sm text-slate-400 dark:text-white grow">No items in this category.</div>
    }
    else
    {
        @* grow + min-h-0 makes the scroll area take exactly the height the grid cell gives the
           panel, which is what .clog-tiles' stretching rows resolve against. The tiles are sized
           by the panel (see .clog-tiles in app.css): the column count comes from the item count so
           a four-item category gets four large tiles filling the box rather than four small ones in
           its top-left corner, and the rows stretch to the panel's height until there are more of
           them than fits, at which point this container scrolls. *@
        <div class="clog-focus-body grow min-h-0 overflow-y-auto themed-scrollbar px-3 pt-3 pb-2">
            <div class="clog-tiles" style="--clog-cols:@Columns;--clog-rows:@Rows">
                @foreach (var item in Items)
                {
                    <a hx-get="@ItemUrl(item.ItemId).FromApi()" hx-target="#hx-page-container"
                       hx-push-url="@ItemUrl(item.ItemId)" hx-swap="innerHTML transition:true"
                       title="@Tooltip(item)"
                       class="clog-tile relative flex flex-col items-center justify-center rounded-lg border cursor-pointer transition-colors @(item.Obtained ? "border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/50 hover:border-amber-400" : "border-slate-200/80 dark:border-slate-700/80 bg-slate-100/70 dark:bg-slate-950/40 hover:border-amber-400")">
                        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.Name)" alt=""
                             class="clog-tile-icon object-contain @(item.Obtained ? "" : "grayscale opacity-70")" loading="lazy" onerror="this.style.display='none'" />
                        <span class="clog-tile-name text-center line-clamp-2 @(item.Obtained ? "text-slate-700 dark:text-slate-200" : "text-slate-500 dark:text-slate-400")">@item.Name</span>

                        @* The roll it landed on, from OUR loot records, attributed to the source
                           that actually dropped it. Absent for anything obtained before tracking
                           began, and omitted rather than shown as zero. *@
                        @if (item.FirstReceipt is { KillCount: > 0 } receipt)
                        {
                            <span class="clog-tile-roll font-semibold tabular-nums text-amber-600 dark:text-amber-400">#@receipt.KillCount!.Value.ToString("N0")</span>
                        }

                        @if (item.Obtained && item.Count > 1)
                        {
                            <span class="absolute top-0.5 right-1 text-[10px] font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@item.Count</span>
                        }
                    </a>
                }
            </div>
        </div>
    }
</div>
</div>

@code {
    [Parameter] public List<CollectionLogItemState> Items { get; set; } = [];
    [Parameter] public string CategorySlug { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public CollectionLogIconKind IconKind { get; set; }
    [Parameter] public string? IconName { get; set; }

    /// <summary>
    /// Categories from this size up get the wider cell. Six rather than ten, now that the tiles are
    /// squares sized to the panel: in the standard cell six of them come out two across and three
    /// down at ~114px, where the wide cell fits them three across at the 9.25rem ceiling. The old
    /// threshold was set when tiles were a fixed width and the narrow cell held a six-item log
    /// without wrapping, so there was nothing to gain from the extra tracks.
    /// </summary>
    private const int WideThreshold = 6;

    private bool IsWide => Items.Count >= WideThreshold;

    /// <summary>
    /// The panel's tile grid: how many columns, and therefore how many rows. Both go to the CSS,
    /// which sizes one square tile to fit the panel in both directions.
    /// </summary>
    /// <remarks>
    /// The count has to come from the ITEM COUNT, not from the available width: an auto-fill grid
    /// puts four items in one row of small tiles however wide the panel is, which is what started
    /// this. Given square tiles, a c×r arrangement in a cell of aspect A (width over height) admits
    /// a tile of side min(A/c, 1/r) in units of the cell's height — so the best layout is simply the
    /// candidate column count that MAXIMISES that, and it is cheap enough to search directly rather
    /// than approximate with sqrt(n · A).
    ///
    /// The aspect depends on which cell the panel got, and <see cref="IsWide"/> is what decides
    /// that. Measured at the 8-column breakpoint the standard cell is markedly TALLER than it is
    /// wide (~0.62) and the wide one is about 2:1, and the optimum genuinely differs between them:
    /// three items want a single column in the tall cell and a single row in the wide one.
    ///
    /// Ties go to the layout leaving the fewest empty cells, since a ragged last row reads as a
    /// mistake next to a full one. Eight columns is the ceiling: past that the tiles are smaller
    /// than the fixed size this replaced, and scrolling is the better answer for a 100-item log.
    /// </remarks>
    private int Columns => ColumnsFor(Items.Count, IsWide);

    private int Rows => (int)Math.Ceiling(Items.Count / (double)Columns);

    internal static int ColumnsFor(int count, bool isWide)
    {
        if (count <= 1) return 1;

        var panelAspect = isWide ? 2.0 : 0.62;
        const int maxColumns = 8;

        var best = 1;
        var bestSide = 0.0;
        var bestEmpty = int.MaxValue;

        for (var columns = 1; columns <= Math.Min(count, maxColumns); columns++)
        {
            var rows = (int)Math.Ceiling(count / (double)columns);
            var side = Math.Min(panelAspect / columns, 1.0 / rows);
            var empty = columns * rows - count;

            // A hair of tolerance, so a layout that is a fraction of a percent smaller but fills
            // its rows completely is preferred to a ragged one.
            if (side > bestSide * 1.02 || (side > bestSide * 0.98 && empty < bestEmpty))
            {
                best = columns;
                bestSide = Math.Max(bestSide, side);
                bestEmpty = empty;
            }
        }

        return best;
    }

    private int Obtained => Items.Count(i => i.Obtained);
    private bool IsComplete => Items.Count > 0 && Obtained == Items.Count;

    private string IconUrl => IconKind == CollectionLogIconKind.Source
        ? $"/api/images/source-icon?name={Uri.EscapeDataString(IconName!)}"
        : $"/api/images/item-icon?name={Uri.EscapeDataString(IconName!)}";

    private string CompareUrl => $"{AppRoutes.CollectionLogCategory}?slug={Uri.EscapeDataString(CategorySlug)}";

    private static string ItemUrl(int itemId) => AppRoutes.CollectionLogItem.Replace("{itemId:int}", itemId.ToString());

    /// A missing obtained date is normal — the upstream often has none for items logged before the
    /// player started syncing — so it reads as "date unknown" rather than being left blank. The roll
    /// number is appended only when our own loot data can attribute it.
    private static string Tooltip(CollectionLogItemState item)
    {
        if (!item.Obtained) return $"{item.Name} — not obtained";

        var parts = new List<string> { item.Name };
        parts.Add(item.ObtainedAt is { } at ? $"obtained {at:d MMM yyyy}" : "obtained, date unknown");
        if (item.Count > 1) parts.Add($"{item.Count}×");
        if (item.FirstReceipt is { KillCount: > 0 } r)
            parts.Add($"first on roll {r.KillCount!.Value:N0} at {r.SourceName}");
        else if (item.FirstReceipt is { } s)
            parts.Add($"from {s.SourceName}");

        return string.Join(" — ", parts);
    }
}
