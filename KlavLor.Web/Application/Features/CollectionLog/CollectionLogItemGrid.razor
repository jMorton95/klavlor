@using KlavLor.Application.Features.CollectionLog

@* The focused panel: one category's items for one character, swapped into the middle of the grid.

   The panel is a large cell, so the items are sized to fill it rather than sitting as a small
   top-left clump: bigger tiles, bigger icons, readable names, and the grid centred horizontally
   while anchored to the top, so a four-item category sits under the header instead of floating in
   the middle of a tall panel.

   clog-focus-panel gives it an amber ring and glow. It sits surrounded by dark slate category
   cards, so anything slate-on-slate simply vanished into them — this is deliberately the one warm,
   saturated element on the page.

   Missing items are shown greyed rather than omitted — a collection log that only listed what you
   already own would be pointless, and the gaps are the whole point of looking. *@
<div class="clog-focus-panel rounded-xl overflow-hidden h-full flex flex-col">
    <div class="clog-focus-header flex items-center gap-2 px-3 py-2.5 shrink-0">
        @if (IconName is { Length: > 0 } icon)
        {
            <img src="@IconUrl" alt="" class="w-7 h-7 shrink-0 object-contain" loading="lazy" onerror="this.style.visibility='hidden'" />
        }
        <div class="min-w-0 flex-1">
            <div class="text-sm font-bold text-amber-900 dark:text-amber-100 truncate">@DisplayName</div>
            <div class="text-[11px] tabular-nums @(IsComplete ? "text-emerald-600 dark:text-emerald-400" : "text-slate-600 dark:text-slate-300")">
                @Obtained of @Items.Count obtained@(IsComplete ? " · complete" : "")
            </div>
        </div>
        <a hx-get="@CompareUrl.FromApi()" hx-target="#hx-page-container" hx-push-url="@CompareUrl" hx-swap="innerHTML transition:true"
           class="shrink-0 text-[11px] font-medium px-2 py-1 rounded-full bg-amber-500/15 text-amber-700 dark:text-amber-300 hover:bg-amber-500/30 cursor-pointer whitespace-nowrap transition-colors">Compare</a>
    </div>

    @if (Items.Count == 0)
    {
        <div class="px-3 py-8 text-center text-sm text-slate-400 dark:text-white grow">No items in this category.</div>
    }
    else
    {
        @* grow + min-h-0 makes the scroll area take exactly the height the grid cell gives the
           panel. justify-center centres the tiles; content-start pins them to the top. *@
        <div class="grow min-h-0 overflow-y-auto themed-scrollbar px-3 pt-3 pb-2">
            <div class="flex flex-wrap justify-center content-start gap-2">
                @foreach (var item in Items)
                {
                    <a hx-get="@ItemUrl(item.ItemId).FromApi()" hx-target="#hx-page-container"
                       hx-push-url="@ItemUrl(item.ItemId)" hx-swap="innerHTML transition:true"
                       title="@Tooltip(item)"
                       class="relative w-[5.25rem] flex flex-col items-center gap-1 rounded-lg border px-1.5 py-2 cursor-pointer transition-colors @(item.Obtained ? "border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-800/50 hover:border-amber-400" : "border-slate-200/80 dark:border-slate-700/80 bg-slate-100/70 dark:bg-slate-950/40 hover:border-amber-400")">
                        <img src="/api/images/item-icon?name=@Uri.EscapeDataString(item.Name)" alt=""
                             class="w-9 h-9 object-contain @(item.Obtained ? "" : "grayscale opacity-70")" loading="lazy" onerror="this.style.display='none'" />
                        <span class="text-[10px] leading-tight text-center line-clamp-2 @(item.Obtained ? "text-slate-700 dark:text-slate-200" : "text-slate-500 dark:text-slate-400")">@item.Name</span>

                        @* The roll it landed on, from OUR loot records, attributed to the source
                           that actually dropped it. Absent for anything obtained before tracking
                           began, and omitted rather than shown as zero. *@
                        @if (item.FirstReceipt is { KillCount: > 0 } receipt)
                        {
                            <span class="text-[10px] font-semibold tabular-nums text-amber-600 dark:text-amber-400">#@receipt.KillCount!.Value.ToString("N0")</span>
                        }

                        @if (item.Obtained && item.Count > 1)
                        {
                            <span class="absolute top-0.5 right-1 text-[10px] font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@item.Count</span>
                        }
                    </a>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<CollectionLogItemState> Items { get; set; } = [];
    [Parameter] public string CategorySlug { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public CollectionLogIconKind IconKind { get; set; }
    [Parameter] public string? IconName { get; set; }

    private int Obtained => Items.Count(i => i.Obtained);
    private bool IsComplete => Items.Count > 0 && Obtained == Items.Count;

    private string IconUrl => IconKind == CollectionLogIconKind.Source
        ? $"/api/images/source-icon?name={Uri.EscapeDataString(IconName!)}"
        : $"/api/images/item-icon?name={Uri.EscapeDataString(IconName!)}";

    private string CompareUrl => $"{AppRoutes.CollectionLogCategory}?slug={Uri.EscapeDataString(CategorySlug)}";

    private static string ItemUrl(int itemId) => AppRoutes.CollectionLogItem.Replace("{itemId:int}", itemId.ToString());

    /// A missing obtained date is normal — the upstream often has none for items logged before the
    /// player started syncing — so it reads as "date unknown" rather than being left blank. The roll
    /// number is appended only when our own loot data can attribute it.
    private static string Tooltip(CollectionLogItemState item)
    {
        if (!item.Obtained) return $"{item.Name} — not obtained";

        var parts = new List<string> { item.Name };
        parts.Add(item.ObtainedAt is { } at ? $"obtained {at:d MMM yyyy}" : "obtained, date unknown");
        if (item.Count > 1) parts.Add($"{item.Count}×");
        if (item.FirstReceipt is { KillCount: > 0 } r)
            parts.Add($"first on roll {r.KillCount!.Value:N0} at {r.SourceName}");
        else if (item.FirstReceipt is { } s)
            parts.Add($"from {s.SourceName}");

        return string.Join(" — ", parts);
    }
}
