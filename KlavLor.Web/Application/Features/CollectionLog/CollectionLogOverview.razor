@using KlavLor.Application.Features.CollectionLog
@using KlavLor.Web.Components.Layout

@* The clan board. Cards in a grid rather than full-bleed rows: a row per character stretched a
   handful of short facts across the whole viewport, so the eye had to travel the width of the
   screen to read one entry and the podium had no weight.

   One row per character straight off the state table, so this renders from a single scan however
   many items each character owns. *@

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="KlavLor - Collection Log" Title="Collection Log" Description="Collection log progress across every character" />
}

<div class="max-w-6xl mx-auto space-y-6 pb-32">
    <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Clan standings</h2>
        <p class="text-sm text-slate-500 dark:text-white">Collection log completion across every tracked character.</p>
    </div>

    @if (Standings.Count == 0)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">No collection log data</h3>
            <p class="text-sm text-slate-500 dark:text-white max-w-lg mx-auto">
                Nothing has been collected yet. A character needs its display name to match its RuneScape name,
                and its collection log has to have been shared at least once. Data refreshes hourly.
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            @* Rank is counted over characters that actually have data. Ranking the whole list gave a
               silver medal to an account we hold nothing for, which reads as a placing it hasn't
               earned — those sort last and show no rank at all. *@
            @foreach (var standing in Ordered)
            {
                var rank = RankOf(standing);
                <a hx-get="@CharacterUrl(standing).FromApi()" hx-target="#hx-page-container"
                   hx-push-url="@CharacterUrl(standing)" hx-swap="innerHTML transition:true"
                   class="group relative flex flex-col gap-3 rounded-xl border bg-slate-50 dark:bg-slate-900 p-4 cursor-pointer transition-all hover:-translate-y-0.5 @CardClasses(rank, standing)">

                    @* The leader gets a medal rather than a number; everyone else a quiet ordinal. *@
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5 min-w-0">
                                <span class="text-sm font-semibold text-slate-900 dark:text-slate-100 truncate group-hover:text-amber-600 dark:group-hover:text-amber-400">@standing.CharacterName</span>
                                @if (GameModeLabel(standing.GameMode) is { } mode)
                                {
                                    <span class="text-[9px] px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 shrink-0">@mode</span>
                                }
                            </div>
                            <CollectionLogFreshnessBadge Freshness="standing.Freshness" />
                        </div>
                        @if (rank is { } r)
                        {
                            <span class="shrink-0 text-lg leading-none @RankClasses(r)">@RankGlyph(r)</span>
                        }
                    </div>

                    @* A ring reads as a completion figure at a glance in a way a bar in a wide row
                       never did, and it anchors the card. *@
                    <div class="flex items-center gap-3">
                        <div class="relative w-14 h-14 shrink-0">
                            <svg class="w-14 h-14 -rotate-90" viewBox="0 0 36 36" aria-hidden="true">
                                <circle cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="3" class="text-slate-200 dark:text-slate-800" />
                                <circle cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                                        class="@RingClasses(rank)"
                                        stroke-dasharray="@Dash(standing.Percent)" />
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-[11px] font-semibold tabular-nums text-slate-700 dark:text-slate-200">@standing.Percent.ToString("0")%</span>
                        </div>

                        <div class="min-w-0 space-y-0.5">
                            <div class="text-base font-bold tabular-nums text-slate-900 dark:text-slate-100 leading-none">
                                @standing.Obtained.ToString("N0")<span class="text-xs font-normal text-slate-400 dark:text-white">/@standing.Available.ToString("N0")</span>
                            </div>
                            <div class="text-[11px] text-slate-500 dark:text-white tabular-nums">@standing.CategoriesFinished/@standing.CategoriesAvailable tabs complete</div>
                            @if (standing.HiscoresRank is { } hiscores)
                            {
                                <div class="text-[11px] text-slate-400 dark:text-white tabular-nums">rank #@hiscores.ToString("N0")</div>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }

    @* Below the roster, and titled, on purpose. Sitting at the top it appeared immediately under the
       site-wide search in the header, and the two read as the same control. *@
    <div class="pt-4 border-t border-slate-200 dark:border-slate-700">
        <div class="flex items-end justify-between gap-3 flex-wrap mb-3">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Find an item</h2>
                <p class="text-sm text-slate-500 dark:text-white">Search the collection log to see who has what.</p>
            </div>
            <div class="relative w-full sm:w-80">
                <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="search" name="searchTerm" placeholder="e.g. Abyssal whip" autocomplete="off"
                       hx-get="@AppRoutes.CollectionLogSearch.FromApi()"
                       hx-trigger="keyup changed delay:300ms"
                       hx-target="#clog-search-results"
                       hx-swap="innerHTML"
                       class="w-full pl-9 pr-3 py-2 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
            </div>
        </div>
        <div id="clog-search-results"></div>
    </div>
</div>

@code {
    /// True when served as an HTMX fragment (emits the OOB header); false inside PageLayout,
    /// which renders the header itself. Without this an in-app navigation drew the title twice.
    [Parameter] public bool UpdateHeader { get; set; } = true;

    [Parameter] public List<CollectionLogStanding> Standings { get; set; } = [];

    private static string CharacterUrl(CollectionLogStanding s) =>
        AppRoutes.CollectionLogCharacter.WithId(s.GameCharacterId);

    /// Ironman status changes what a comparison means, so it is labelled rather than hidden.
    private static string? GameModeLabel(int mode) => mode switch
    {
        1 => "IM", 2 => "UIM", 3 => "HCIM", _ => null
    };

    /// Ranked characters first (by count), then everything we hold no data for.
    private IEnumerable<CollectionLogStanding> Ordered =>
        Standings.Where(s => s.Freshness.HasData).Concat(Standings.Where(s => !s.Freshness.HasData));

    /// Null for a character with no data — it takes no placing.
    private int? RankOf(CollectionLogStanding standing)
    {
        if (!standing.Freshness.HasData) return null;
        var ranked = Standings.Where(s => s.Freshness.HasData).ToList();
        return ranked.IndexOf(standing) + 1;
    }

    // The top three get progressively warmer framing; a character with no data is muted so it
    // can't be mistaken for one sitting at genuine zero.
    // A character with no data tints its BACKGROUND and nothing else — the previous 60% opacity on
    // the whole card washed out its name, border and ring along with it.
    private static string CardClasses(int? rank, CollectionLogStanding s) => !s.Freshness.HasData
        ? "border-slate-200/80 dark:border-slate-700/80 bg-slate-100/60 dark:bg-slate-950/40 hover:border-amber-300 dark:hover:border-amber-600"
        : rank switch
        {
            1 => "border-amber-300 dark:border-amber-600 shadow-md shadow-amber-500/10 hover:border-amber-400",
            2 or 3 => "border-slate-300 dark:border-slate-600 hover:border-amber-300 dark:hover:border-amber-600",
            _ => "border-slate-200 dark:border-slate-700 hover:border-amber-300 dark:hover:border-amber-600"
        };

    private static string RankGlyph(int rank) => rank switch
    {
        1 => "🥇", 2 => "🥈", 3 => "🥉", _ => $"#{rank}"
    };

    private static string RankClasses(int rank) =>
        rank <= 3 ? "" : "text-xs font-semibold tabular-nums text-slate-300 dark:text-slate-600 pt-1";

    private static string RingClasses(int? rank) =>
        rank == 1 ? "text-amber-500" : "text-amber-500/70 dark:text-amber-400/70";

    /// SVG dash for a percentage on an r=15.5 circle (circumference ≈ 97.4).
    private static string Dash(double percent)
    {
        const double circumference = 97.4;
        var filled = Math.Clamp(percent, 0, 100) / 100.0 * circumference;
        return $"{filled.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
    }
}
