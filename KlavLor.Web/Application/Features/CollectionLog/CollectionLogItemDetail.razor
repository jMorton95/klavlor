@using KlavLor.Application.Features.CollectionLog
@using KlavLor.Web.Components.Layout

@* One item across the roster: who has it, when, and — from OUR loot data, not the collection log —
   where their rolls have gone.

   Cards rather than full-width rows: a row per character stretched four short facts across the
   viewport. Two columns on desktop, so a roster reads as a block instead of a ladder. *@

@if (UpdateHeader)
{
    <TopBarMetaData PageTitle="@($"KlavLor - {Comparison?.Name ?? "Collection Log"}")"
                    Title="@(Comparison?.Name ?? "Collection Log")" Description="Who has this item" />
}

<div class="max-w-5xl mx-auto space-y-5 pb-32">
    <a onclick="history.back()"
       class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-amber-600 dark:text-white dark:hover:text-amber-400 cursor-pointer transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
    </a>

    @if (Comparison is null)
    {
        <div class="bg-slate-50 dark:bg-slate-900 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-12 text-center">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-2">Item not found</h3>
            <p class="text-sm text-slate-500 dark:text-white">That item isn't in the collection log.</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-4 py-3">
            <div class="flex items-center gap-2 min-w-0 mb-1.5">
                <img src="/api/images/item-icon?name=@Uri.EscapeDataString(Comparison.Name)" alt=""
                     class="w-7 h-7 shrink-0 object-contain" loading="lazy" onerror="this.style.display='none'" />
                <h1 class="text-lg font-bold text-slate-900 dark:text-slate-100 truncate">@Comparison.Name</h1>
            </div>
            <div class="flex items-center gap-x-4 gap-y-1 flex-wrap text-sm">
                <span class="inline-flex items-baseline gap-1 whitespace-nowrap">
                    <span class="font-semibold tabular-nums text-slate-900 dark:text-slate-100">@Comparison.ObtainedBy/@Comparison.Holders.Count</span>
                    <span class="text-[11px] text-slate-500 dark:text-white">have it</span>
                </span>
                @* Straight through to the existing global drop page, which owns rates, values and
                   the full source breakdown — this page deliberately duplicates none of that. *@
                <a hx-get="@DropUrl.FromApi()" hx-target="#hx-page-container" hx-push-url="@DropUrl" hx-swap="innerHTML transition:true"
                   class="text-[11px] text-amber-600 dark:text-amber-400 hover:underline cursor-pointer">
                    Drop rates, values and sources →
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
            @foreach (var holder in Comparison.Holders)
            {
                <div class="rounded-xl border px-3 py-2.5 @(holder.Obtained ? "border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900" : "border-slate-200/80 dark:border-slate-700/80 bg-slate-100/60 dark:bg-slate-950/40")">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="shrink-0">
                            @if (holder.Obtained)
                            {
                                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/></svg>
                            }
                        </span>
                        <a hx-get="@CharacterUrl(holder.GameCharacterId).FromApi()" hx-target="#hx-page-container"
                           hx-push-url="@CharacterUrl(holder.GameCharacterId)" hx-swap="innerHTML transition:true"
                           class="text-sm font-semibold text-amber-600 dark:text-amber-400 hover:underline cursor-pointer truncate flex-1 min-w-0">@holder.CharacterName</a>

                        @if (holder.Obtained && holder.Count > 1)
                        {
                            <span class="text-[11px] tabular-nums text-slate-500 dark:text-white shrink-0">@holder.Count.ToString("N0")×</span>
                        }
                        <span class="text-[11px] tabular-nums shrink-0 whitespace-nowrap @(holder.Obtained ? "text-slate-500 dark:text-white" : "text-slate-400 dark:text-slate-500")">
                            @Obtained(holder)
                        </span>
                    </div>

                    @* Rolls. For a holder these are the source that ACTUALLY dropped it; for someone
                       still chasing, their biggest few sources that can drop it. Never a bare total,
                       because an item with several sources makes one meaningless. *@
                    @if (!holder.HasRollData)
                    {
                        <p class="text-[11px] text-slate-400 dark:text-slate-500 pl-6">Rolls unknown — no tracked loot at a source that drops this.</p>
                    }
                    else
                    {
                        <div class="pl-6 space-y-0.5">
                            @foreach (var source in holder.RollSources)
                            {
                                <div class="flex items-baseline justify-between gap-2 text-[11px]">
                                    <span class="inline-flex items-center gap-1 min-w-0">
                                        <img src="/api/images/source-icon?name=@Uri.EscapeDataString(source.SourceName)" alt=""
                                             class="w-3.5 h-3.5 rounded shrink-0" loading="lazy" onerror="this.style.display='none'" />
                                        <span class="truncate @(source.DroppedIt ? "text-emerald-600 dark:text-emerald-400" : "text-slate-500 dark:text-white")">@source.SourceName</span>
                                    </span>
                                    <span class="tabular-nums whitespace-nowrap shrink-0 @(source.DroppedIt ? "text-emerald-600 dark:text-emerald-400 font-medium" : "text-slate-400 dark:text-slate-400")">
                                        @source.Rolls.ToString("N0") rolls
                                    </span>
                                </div>
                            }
                            @if (!holder.Obtained && holder.RollSources.Count > 1)
                            {
                                <div class="text-[10px] text-slate-400 dark:text-slate-500 pt-0.5">@holder.TotalRolls.ToString("N0") rolls across these</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public CollectionLogItemComparison? Comparison { get; set; }
    [Parameter] public bool UpdateHeader { get; set; } = true;

    private string DropUrl => $"{AppRoutes.Drop}?name={Uri.EscapeDataString(Comparison!.Name)}";

    private static string CharacterUrl(int id) => AppRoutes.CollectionLogCharacter.WithId(id);

    private static string Obtained(CollectionLogItemHolder h) => h switch
    {
        { Obtained: false } => "not obtained",
        { ObtainedAt: null } => "date unknown",
        _ => h.ObtainedAt!.Value.ToString("d MMM yyyy")
    };
}
