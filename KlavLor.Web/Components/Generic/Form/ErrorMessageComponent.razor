@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="rounded-lg bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 p-4">
        <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <p class="text-sm font-medium text-red-800 dark:text-red-300">@ErrorMessage</p>
        </div>
    </div>
}

@code {
    [Parameter] public string? ErrorMessage { get; set; }
}
