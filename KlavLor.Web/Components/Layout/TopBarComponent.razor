@using KlavLor.Application.Interfaces.Authentication
@using KlavLor.Web.Application

@inject ISessionStateManager SessionStateManager

<header class="sticky top-0 z-30 bg-slate-50/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-700">
    <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8 space-x-4">
        <button data-toggle="sidebar"
                class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <div id="metadata-container" class="flex-1 min-w-0 px-2 text-center">
            <TopBarMetaData Title="@TitleDefaults" Description="@DescriptionDefaults" PageTitle="@PageTitleDefaults" />
        </div>

        @if (_isAuthenticated)
        {
            <div class="hidden md:block relative w-full max-w-xs ml-auto">
                <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="search" name="searchTerm" placeholder="Search… (Enter)"
                       autocomplete="off"
                       hx-get="@AppRoutes.Search.FromApi()"
                       hx-trigger="keyup[key=='Enter']"
                       hx-target="#hx-page-container"
                       hx-swap="innerHTML transition:true"
                       class="w-full pl-9 pr-3 py-1.5 text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none" />
            </div>
        }

        <div class="flex items-center space-x-3 shrink-0">
            <button data-toggle="dark-mode"
                    class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg cursor-pointer"
                    title="Toggle dark mode">
                @* Sun icon (shown in dark mode) *@
                <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                @* Moon icon (shown in light mode) *@
                <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                </svg>
            </button>
            @if (_isAuthenticated)
            {
                <button hx-trigger="click" hx-post="@AppRoutes.Logout.FromApi()"
                        class="inline-flex cursor-pointer items-center px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950 rounded-lg transition-colors whitespace-nowrap">
                    <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Logout
                </button>
            }
            else
            {
                <button hx-get="@AppRoutes.LoginModal.FromApi()"
                        hx-target="#hx-modal-container"
                        hx-swap="innerHTML"
                        class="inline-flex cursor-pointer items-center px-4 py-2 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors whitespace-nowrap">
                    <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                    </svg>
                    Sign In
                </button>
            }
        </div>
    </div>
</header>

@code {
    [Parameter] public string TitleDefaults { get; set; } = "";
    [Parameter] public string DescriptionDefaults { get; set; } = "";
    [Parameter] public string? PageTitleDefaults { get; set; }

    private bool _isAuthenticated;

    protected override void OnInitialized()
    {
        _isAuthenticated = SessionStateManager.IsAuthenticated();
    }
}
