@using KlavLor.Web.Application
<header class="sticky top-0 z-30 bg-white/80 backdrop-blur-md border-b border-slate-200">
    <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8 space-x-4">
        <button data-toggle="sidebar"
                class="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <div id="metadata-container">
            <TopBarMetaData Title="@TitleDefaults" Description="@DescriptionDefaults" PageTitle="@PageTitleDefaults" />
        </div>

        <div class="flex items-center space-x-3 shrink-0">
            <button hx-trigger="click" hx-post="@AppRoutes.Logout.FromApi()"
                    class="inline-flex cursor-pointer items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors whitespace-nowrap">
                <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Logout
            </button>
        </div>
    </div>
</header>

@code {
    [Parameter] public string TitleDefaults { get; set; } = "";
    [Parameter] public string DescriptionDefaults { get; set; } = "";
    [Parameter] public string? PageTitleDefaults { get; set; }
}
