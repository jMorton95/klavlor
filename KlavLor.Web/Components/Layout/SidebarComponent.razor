@using KlavLor.Application.Interfaces.Authentication
@using KlavLor.Application.Interfaces.Services
@using KlavLor.Domain.Shared
@using KlavLor.Web.Application

@inject ISessionStateManager SessionStateManager
@inject ISystemSettingsCache SystemSettingsCache

<span id="sidebar">
    <aside id="mobile-sidebar"
           class="fixed inset-y-0 left-0 z-50 w-64 bg-linear-to-b from-slate-900 to-slate-800 shadow-xl transform -translate-x-full transition-transform duration-300 ease-in-out">
        <div class="flex flex-col h-full overflow-y-auto">
            <div class="flex items-center justify-between h-16 px-6 border-b border-slate-700">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-linear-to-br from-amber-500 to-orange-600 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <span class="text-xl font-bold text-white">KlavLor</span>
                </div>
                <button data-toggle="sidebar" class="p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <nav class="flex-1 px-4 py-6 space-y-1">
                @foreach (var item in GetNavItems())
                {
                    <a href="@item.Route" data-section="@item.ActiveArea" hx-get="@item.HxRoute" hx-swap="innerHTML transition:true" hx-target="#hx-page-container" hx-push-url="@item.Route" class="@GetNavItemClasses()">
                        @item.Icon
                        <span class="ml-3">@item.Label</span>
                    </a>
                }

                @if (IsAuthenticated)
                {
                    <div class="pt-4 mt-4 border-t border-slate-700">
                        <span class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Account</span>
                        <a href="@AppRoutes.Characters" data-section="characters" hx-get="@AppRoutes.Characters.FromApi()" hx-swap="innerHTML transition:true" hx-target="#hx-page-container" hx-push-url="@AppRoutes.Characters" class="@GetNavItemClasses()">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="ml-3">Manage your account</span>
                        </a>

                        @if (IsUserAdministrator)
                        {
                            <a href="@AppRoutes.UsersSearch" data-section="users" hx-get="@AppRoutes.UsersSearch.FromApi()" hx-swap="innerHTML transition:true" hx-target="#hx-page-container" hx-push-url="@AppRoutes.UsersSearch" class="@GetNavItemClasses()">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                                <span class="ml-3">User Management</span>
                            </a>
                        }

                        @* Sync Logs is visible to Auditors and Admins (Admin supersedes the Auditor role). *@
                        @if (IsUserAdministrator || IsAuditor)
                        {
                            <a href="@AppRoutes.SyncLog" data-section="sync-log" hx-get="@AppRoutes.SyncLog.FromApi()" hx-swap="innerHTML transition:true" hx-target="#hx-page-container" hx-push-url="@AppRoutes.SyncLog" class="@GetNavItemClasses()">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <span class="ml-3">Sync Logs</span>
                            </a>
                        }
                    </div>
                }
            </nav>
        </div>
    </aside>
</span>

@code {
    private bool IsAuthenticated { get; set; }
    private bool IsUserAdministrator { get; set; }
    private bool IsAuditor { get; set; }

    protected override void OnInitialized()
    {
        IsAuthenticated = SessionStateManager.IsAuthenticated();
        IsUserAdministrator = SessionStateManager.IsUserSessionAdministrator();
        IsAuditor = SessionStateManager.IsInRole(RoleName.Auditor);
    }

    private record NavItem(string Route, string HxRoute, string Label, RenderFragment Icon, string ActiveArea);

    private NavItem[] GetNavItems()
    {
        var items = new List<NavItem>
        {
            new(AppRoutes.TemplatesSearch, AppRoutes.TemplatesSearch.FromApi(), "Templates",
                @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>,
                "templates"),
            new(AppRoutes.LootFeed, AppRoutes.LootFeed.FromApi(), "Loot Feed",
                @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>,
                "loot-feed"),
        };

        if (SystemSettingsCache.IsLeaguesEnabled)
        {
            items.Add(new(AppRoutes.LootFeedLeagues, AppRoutes.LootFeedLeagues.FromApi(), "Leagues Feed",
                @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 008 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>,
                "loot-feed-leagues"));
        }

        items.Add(new(AppRoutes.LootLog, AppRoutes.LootLog.FromApi(), "Characters",
            @<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>,
            "loot-log"));

        return items.ToArray();
    }

    private string GetNavItemClasses() => "cursor-pointer group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-all duration-150 text-slate-300 hover:bg-slate-700/50 hover:text-white aria-[current=page]:text-amber-400 aria-[current=page]:bg-slate-700/50";
}
