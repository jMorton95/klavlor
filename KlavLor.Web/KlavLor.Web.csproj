<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>KlavLor.Web</RootNamespace>
        <DisableScopedCssBundling>true</DisableScopedCssBundling>
        <!-- .NET 10 SDK currently emits static-asset compression manifests
             with unresolved {0} placeholders in dev builds, causing empty
             responses. Disable pre-compression in Debug; the runtime serves
             the uncompressed source files directly. -->
        <CompressionEnabled Condition="'$(Configuration)' == 'Debug'">false</CompressionEnabled>
    </PropertyGroup>

    <Target Name="TailwindOnBuild" BeforeTargets="Compile">
        <Exec Command="npx tailwindcss -i wwwroot/app.css -o wwwroot/styles.css --minify"
              Condition="'$(Configuration)' == 'Debug'" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\KlavLor.Domain\KlavLor.Domain.csproj" />
        <ProjectReference Include="..\KlavLor.Infrastructure\KlavLor.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
