<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>KlavLor.Application</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <!-- The ingest handler's ticker cap is a pure selection rule over a list, unit-testable on
             its own; constructing the handler itself would mean standing up thirteen dependencies. -->
        <InternalsVisibleTo Include="KlavLor.UnitTests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\KlavLor.Domain\KlavLor.Domain.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    </ItemGroup>
</Project>
